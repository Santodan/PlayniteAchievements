<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers;assembly=PlayniteAchievements"
                    xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls;assembly=PlayniteAchievements"
                    xmlns:vm="clr-namespace:PlayniteAchievements.ViewModels;assembly=PlayniteAchievements">
    <!--
        Default achievement toast template. Single source of truth: this same file is what the
        plugin renders when no theme override or custom template applies, and what the "Export
        default template (.xaml)" button writes out, so the exported starting point is always
        exactly the live default. Edit here to change the built-in default.

        Merges NotificationResources.xaml (below) for the shared brushes, converters, content
        shadow, badges, logo, and the reorderable text-line templates the toast binds to, so it
        renders standalone on any machine and theme. Keep the x:Key and DataType exactly as below;
        see the wiki "Toast and Frame overrides" page for every available binding.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/NotificationResources.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <DataTemplate x:Key="PlayAch.Template.AchievementToast"
                  DataType="{x:Type vm:AchievementToastViewModel}">
        <Grid Width="{Binding ToastCardWidth}"
              Height="{Binding ToastCardHeight}"
              MinHeight="64"
              Margin="{Binding ToastGlowMargin}">
            <!-- One loaded Image owns background decoding. Its Source is a stable mutable bitmap
                 for GIFs; the single background brush below consumes that object. It remains in
                 the visual tree at zero size because XamlAnimatedGif stops an unloaded Image. -->
            <Image x:Name="ToastBackgroundSourceHost"
                   Width="0"
                   Height="0"
                   Opacity="0"
                   IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   helpers:AsyncImage.Uri="{Binding ToastBackgroundRenderSource}"
                   helpers:AsyncImage.DecodePixel="768"
                   helpers:AsyncImage.PhaseLock="{Binding IsPreview}"/>
            <!-- Rays around the card itself, behind everything. No SubjectUri: there is no artwork to
                 trace here, so the burst rides the card's own rectangle. The reach is a small multiple
                 because it scales with the subject, and the card is far larger than an icon; the
                 surrounding margin widens to match so the arrows are not clipped by the window. -->
            <controls:RarityRayBurst Rarity="{Binding Rarity}"
                                     UseCompletedColors="{Binding IsGameCompleted}"
                                     IsActive="{Binding AnimateRarityGlows}"
                                     PhaseLock="{Binding IsPreview}"
                                     BurstScale="1.14"
                                     CornerRadiusRatio="0.09"
                                     Visibility="{Binding ShowRayBurst, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <!-- Background and shadow / glow layer. The background is rendered once: its border
                 carries the effect as well as the visible image. Text and icons remain in the
                 separate effect-free content layer below, so they stay crisp at every DPI. -->
            <Grid helpers:RarityGlowPulse.Target="Effect"
                  helpers:RarityGlowPulse.PhaseLock="{Binding IsPreview}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="12"
                                                  ShadowDepth="3"
                                                  Direction="300"
                                                  Opacity="0.5"
                                                  Color="#000000"/>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasBorderGlow}" Value="True">
                                <Setter Property="Effect" Value="{Binding BorderGlowEffect}"/>
                            </DataTrigger>
                            <!-- Fade the outer border glow in and out when AnimateRarityGlows is on. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasBorderGlow}" Value="True"/>
                                    <Condition Binding="{Binding AnimateRarityGlows}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="helpers:RarityGlowPulse.IsActive" Value="True"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <!-- Opaque card surface: the shadow caster for a normal card. Goes transparent when
                     a user background image defines the card shape, so the drop shadow / glow then
                     wraps the image's own (possibly rounded/transparent) alpha via the blurred
                     backing image below, instead of a solid rectangle. -->
                <Border CornerRadius="8"
                        BorderBrush="{DynamicResource PlayAch.Brush.PopupBorder}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.PopupSurface}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasToastBackground}" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <!-- Backing copy of the user background, present so the shadow / glow wraps the
                     image's real shape instead of a solid rectangle. Not what the user sees: this one
                     is inside the effect, so it renders through an effect intermediate. The crisp copy
                     sits directly on top of it in the content layer below. Both consume the single
                     decoding Image above, so there is one decode and one animation clock. -->
                <Border CornerRadius="8"
                        Visibility="{Binding HasToastBackground, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Background>
                        <ImageBrush Stretch="UniformToFill"
                                    ImageSource="{Binding Source, ElementName=ToastBackgroundSourceHost}"/>
                    </Border.Background>
                </Border>
            </Grid>

            <!-- Content layer: no effect, so every text line and icon renders as a crisp vector.
                 Clipped to the card's rounded shape. -->
            <Border CornerRadius="8"
                    ClipToBounds="True">
                <Grid>
                    <!-- Crisp user background image (what is actually seen), full-bleed behind the
                         content and covering the backing copy above. It is here rather than reusing
                         that copy because this layer carries no effect: content inside an effect is
                         rasterized to an intermediate first, and the card's DPI compensation applies a
                         fractional LayoutTransform, so an intermediate would resample the image.
                         Shares the decoding Image above, so animated backgrounds stay in step with the
                         backing copy for free. -->
                    <Border CornerRadius="8"
                            Visibility="{Binding HasToastBackground, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border.Background>
                            <ImageBrush Stretch="UniformToFill"
                                        ImageSource="{Binding Source, ElementName=ToastBackgroundSourceHost}"/>
                        </Border.Background>
                    </Border>

                    <!-- User left/right card padding insets the content; the background image above
                         stays full-bleed (it is a sibling outside this Border). -->
                    <Border Padding="{Binding ToastContentPadding}">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Single content row. The countdown bar is a pure bottom overlay (below) that
                     reserves no layout space, so it can never enlarge the card; it draws over the
                     bottom of the content if the card is too short. The rarity accent is NOT here:
                     it is a card-edge spine below (outside this padding border) so it reaches the
                     very left edge. -->

                <!-- Right column: the provider icon, or (when the rarity badge is placed on the
                     right) a larger badge with an optional percent under it that stands in for the
                     provider icon. The two are mutually exclusive by their visibility gates.
                     Images carry the image shadow; the percent text carries the two text-shadow
                     layers so it matches the text lines at every strength. -->
                <Grid Grid.Column="1"
                      Grid.Row="0"
                      Margin="2,0,10,0"
                      VerticalAlignment="Center">
                    <Image Width="{Binding ToastProviderIconSize}"
                           Height="{Binding ToastProviderIconSize}"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Effect="{Binding ToastImageShadow}"
                           Visibility="{Binding ShowProviderIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Image.Source>
                            <MultiBinding Converter="{StaticResource ProviderIconConverter}">
                                <Binding Path="ProviderIconKey"/>
                                <Binding Path="ProviderColorHex"/>
                            </MultiBinding>
                        </Image.Source>
                    </Image>
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding ShowRightBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <!-- Center the badge (not the badge+percent group): top spacer = the
                             percent's height balances the percent hanging below. -->
                        <Border Height="{Binding ActualHeight, ElementName=ToastRightPercent}"
                                IsHitTestVisible="False"/>
                        <!-- Reuses the shared badge source, so animated GIF badges animate. -->
                        <Image helpers:AsyncImage.Uri="{Binding ToastBadgeSource}"
                               helpers:AsyncImage.PhaseLock="{Binding IsPreview}"
                               helpers:AsyncImage.DecodePixel="96"
                               Width="{Binding ToastRightBadgeSize}"
                               Height="{Binding ToastRightBadgeSize}"
                               HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Effect="{Binding ToastImageShadow}"/>
                        <Grid Effect="{Binding ToastContentShadow}"
                              HorizontalAlignment="Center"
                              Margin="0,2,0,0"
                              Visibility="{Binding ShowRightPercent, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock x:Name="ToastRightPercent"
                                       Text="{Binding PercentText}"
                                       Style="{DynamicResource PlayAch.TextBlock.BaseStyle}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       FontSize="{Binding ToastRarityText.FontSize}"
                                       FontFamily="{Binding ToastRarityText.FontFamily}"
                                       FontWeight="{Binding ToastRarityText.FontWeight}"
                                       FontStyle="{Binding ToastRarityText.FontStyle}"
                                       TextDecorations="{Binding ToastRarityText.TextDecorations}"
                                       Effect="{Binding ToastContentShadowInner}"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Symmetric top/bottom inset so the icon and text center truly on the row
                     (an asymmetric inset biased the content downward). -->
                <Grid Grid.Column="0" Grid.Row="0" Margin="14,8,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                <!-- Left: the icon (no box) with rarity glow, badge + percent below. The whole
                     icon+footer group is centered on the row as a unit (StackPanel VerticalAlignment
                     Center), so a bare icon and an icon-with-footer both sit centered against the
                     text lines. -->
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="0,0,14,0">
                    <Grid Width="{Binding ToastIconSize}"
                          Height="{Binding ToastIconSize}"
                          ClipToBounds="False"
                          HorizontalAlignment="Center">
                        <!-- Rays glow style: arrows riding the icon's own silhouette, behind the soft
                             halo on the backing layer below, which keeps rendering under both styles.
                             PhaseLock is off for live waves so every notification (and its
                             screenshot/clip) starts from the same point in the cycle. A completion
                             notification swaps in a prebuilt badge image with no path to trace, and
                             falls back to a rounded rectangle. -->
                        <controls:RarityRayBurst Rarity="{Binding Rarity}"
                                                 UseCompletedColors="{Binding IsGameCompleted}"
                                                 IsActive="{Binding AnimateRarityGlows}"
                                                 PhaseLock="{Binding IsPreview}"
                                                 SubjectUri="{Binding IconPath}"
                                                 Visibility="{Binding ShowRayBurst, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <!-- Completion's other half: game and category art stack two copies, one glow
                             thrown from each corner, and it is the pair that reads as the completion
                             gradient. Only shown for completion, so a normal unlock is unaffected. -->
                        <Image Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               helpers:AsyncImage.DecodePixel="160"
                               IsHitTestVisible="False">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGameCompleted}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="helpers:AsyncImage.Uri" Value="{Binding ToastCompletedBadgeSource}"/>
                                            <Setter Property="Effect" Value="{Binding CompletedGlowStartEffect}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <!-- Completion notifications swap the achievement icon for the
                             completed-game badge and the completed glow. The glow lives on this
                             backing layer (a crisp front copy sits on top); it renders un-cached so
                             the halo always appears once the async icon loads, and the pulse fades
                             this layer's opacity. -->
                        <Image Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               helpers:AsyncImage.DecodePixel="160"
                               helpers:RarityGlowPulse.PhaseLock="{Binding IsPreview}"
                               IsHitTestVisible="False">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="helpers:AsyncImage.Uri" Value="{Binding IconPath}"/>
                                    <Setter Property="helpers:AsyncImage.PhaseLock" Value="{Binding IsPreview}"/>
                                    <Setter Property="Effect" Value="{Binding RarityGlowEffect}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGameCompleted}" Value="True">
                                            <Setter Property="helpers:AsyncImage.Uri" Value="{Binding ToastCompletedBadgeSource}"/>
                                            <Setter Property="Effect" Value="{Binding CompletedGlowEffect}"/>
                                        </DataTrigger>
                                        <!-- Fade in/out pulse when AnimateRarityGlows is on. -->
                                        <DataTrigger Binding="{Binding AnimateRarityGlows}" Value="True">
                                            <Setter Property="helpers:RarityGlowPulse.IsActive" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <!-- Edge that comes with the rays: the same drop shadow as the halo above at a
                             small blur, so it reads as a line along the artwork. A blur of the picture
                             itself, so it hugs the alpha whatever shape it is. -->
                        <Image Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               helpers:AsyncImage.DecodePixel="160"
                               IsHitTestVisible="False">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="helpers:AsyncImage.Uri" Value="{Binding IconPath}"/>
                                    <Setter Property="helpers:AsyncImage.PhaseLock" Value="{Binding IsPreview}"/>
                                    <Setter Property="Effect" Value="{Binding RarityEdgeEffect}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGameCompleted}" Value="True">
                                            <Setter Property="helpers:AsyncImage.Uri" Value="{Binding ToastCompletedBadgeSource}"/>
                                            <!-- The effect has to swap too. Swapping only the picture
                                                 left a rarity-coloured edge around a completion glow. -->
                                            <Setter Property="Effect" Value="{Binding CompletedEdgeEffect}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <!-- Front icon: crisp, no glow. -->
                        <Image Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               helpers:AsyncImage.DecodePixel="160">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="helpers:AsyncImage.Uri" Value="{Binding IconPath}"/>
                                    <Setter Property="helpers:AsyncImage.PhaseLock" Value="{Binding IsPreview}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGameCompleted}" Value="True">
                                            <Setter Property="helpers:AsyncImage.Uri" Value="{Binding ToastCompletedBadgeSource}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <!-- Hardcore RetroAchievements unlocks: crisp rarity border instead of glow. -->
                        <Border Margin="-2"
                                BorderThickness="2"
                                Background="Transparent"
                                BorderBrush="{Binding IconBorderBrush}"
                                Visibility="{Binding ShowShineBorder, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <!-- Preview only: a thin gold outline marks the icon's full boundary so the
                             icon size and surrounding padding are easy to judge in the mockup. -->
                        <!-- The preview glows the icon shape, same as the live toast (see the
                             backing image's RarityGlowEffect above); no separate example-only glow. -->
                        <Border BorderThickness="1"
                                BorderBrush="#FFD4AF37"
                                Background="Transparent"
                                Visibility="{Binding IsPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>

                    <!-- The badge/percent footer under the icon. The icon->footer gap lives once
                         here as this border's top padding, so the spacer above can mirror this
                         border's full measured height. Collapses entirely when nothing shows, so a
                         bare icon centers with no phantom gap. -->
                    <Border x:Name="ToastIconExtras"
                            Padding="0,4,0,0"
                            HorizontalAlignment="Center"
                            Visibility="{Binding HasIconFooter, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <!-- User badge images replace the drawn badge; a string source keeps
                                 animated GIF badges animating. -->
                            <Image helpers:AsyncImage.Uri="{Binding ToastBadgeSource}"
                                   helpers:AsyncImage.PhaseLock="{Binding IsPreview}"
                                   helpers:AsyncImage.DecodePixel="64"
                                   Width="{Binding ToastBadgeSize}"
                                   Height="{Binding ToastBadgeSize}"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Effect="{Binding ToastImageShadow}"
                                   Visibility="{Binding ShowBadge, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <!-- The percent carries both text-shadow layers so it matches the
                                 text lines at every strength. -->
                            <Grid Effect="{Binding ToastContentShadow}"
                                  VerticalAlignment="Center"
                                  Margin="4,0,0,0"
                                  Visibility="{Binding ShowPercent, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding PercentText}"
                                           Style="{DynamicResource PlayAch.TextBlock.BaseStyle}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           FontSize="{Binding ToastRarityText.FontSize}"
                                           FontFamily="{Binding ToastRarityText.FontFamily}"
                                           FontWeight="{Binding ToastRarityText.FontWeight}"
                                           FontStyle="{Binding ToastRarityText.FontStyle}"
                                           TextDecorations="{Binding ToastRarityText.TextDecorations}"
                                           Effect="{Binding ToastContentShadowInner}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: the reorderable text lines (header, name, description,
                     game/category), rendered via the shared line templates in the user's
                     order. -->
                <ItemsControl Grid.Column="1"
                              VerticalAlignment="Center"
                              IsTabStop="False"
                              ClipToBounds="True"
                              ItemsSource="{Binding ToastLines}">
                    <ItemsControl.ItemContainerStyle>
                        <!-- Per-line left indent for the name-line offset (see LeftIndent). The
                             container itself collapses when the line has no content, so its margin
                             / line padding never leaves an empty gap. -->
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="{Binding LeftIndentMargin}"/>
                            <Setter Property="Visibility" Value="{Binding LineVisibility}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
                </Grid>

                </Grid>
                </Border>

                <!-- Countdown bar: depletes over the toast's display duration. A direct child of the
                     content grid (outside the padding border) so it ignores the user's left/right
                     card padding and spans the full card width. A pure bottom overlay that reserves
                     no layout space, so it never enlarges the card (it draws over the bottom of the
                     content when the card is too short). The service runs
                     PlayAch.Storyboard.ToastCountdown against this ScaleX; the transform is
                     reassigned in code before animating (a frozen template transform can't be
                     animated), so this inline transform is a no-op placeholder. -->
                <Border x:Name="PART_ToastCountdown"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Stretch"
                        Height="3"
                        Margin="8,0,8,6"
                        CornerRadius="2"
                        Background="{Binding CountdownBarBrush}"
                        Visibility="{Binding ShowCountdownBar, Converter={StaticResource BooleanToVisibilityConverter}}"
                        RenderTransformOrigin="0,0">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1"
                                        ScaleY="1"/>
                    </Border.RenderTransform>
                </Border>

                <!-- Rarity accent: a full-height spine on the card's very left edge. It lives here
                     (outside the content padding) so it reaches the edge, and is declared after the
                     countdown bar so it draws on top; the bar's left margin also clears its width,
                     so the two never overlap. Capstone/completion color takes precedence. -->
                <Border HorizontalAlignment="Left"
                        Width="4"
                        CornerRadius="8,0,0,8"
                        Visibility="{Binding ShowAccentStrip, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{Binding AccentBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGameCompleted}" Value="True">
                                    <Setter Property="Background" Value="{Binding CompletedBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
