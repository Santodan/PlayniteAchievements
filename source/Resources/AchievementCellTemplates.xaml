<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:PlayniteAchievements.Models.Achievements"
                    xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
                    xmlns:converters="clr-namespace:PlayniteAchievements.Views.Converters"
                    xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
                    xmlns:settings="clr-namespace:PlayniteAchievements.Models.Settings">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/RarityBadges.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/TrophyBadges.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <converters:AchievementStatusToolTipConverter x:Key="AchievementStatusToolTipConverter"/>

    <!-- =======================
         COMPLETION BADGE AND FRAME
         ======================= -->

    <!-- The finish badge, keyed off the row's own ShowCompletionBadge and
         ShowPlatinumInCompletionSpot (GameSummaryItem). When the row's capstones are exactly its
         platinum trophies and the host prefers trophy badges, the badge becomes the platinum
         itself. The host states that preference once on its root through the inherited
         helpers:CompletionBadge.PreferTrophyBadges, so the swap is a property trigger and the
         style works under any host. Shared by the game summaries progress footer, the Cover
         column's completion frame and the showcase Game Mosaic tiles; each sets its own size. -->
    <Style x:Key="CompletionBadgeImageStyle" TargetType="Image" BasedOn="{StaticResource RarityIcon}">
        <Setter Property="Effect" Value="{StaticResource BadgeShadow}"/>
        <Setter Property="Source" Value="{DynamicResource BadgeRarityCompleted}"/>
        <Setter Property="ToolTip" Value="{DynamicResource LOCPlayAch_Completed}"/>
        <Setter Property="Visibility" Value="{Binding ShowCompletionBadge, Converter={StaticResource BoolToVis}}"/>
        <Setter Property="helpers:CompletionBadge.ShowsPlatinum" Value="{Binding ShowPlatinumInCompletionSpot}"/>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="helpers:CompletionBadge.ShowsPlatinum" Value="True"/>
                    <Condition Property="helpers:CompletionBadge.PreferTrophyBadges" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Source" Value="{DynamicResource TrophyPlatinum}"/>
                <Setter Property="ToolTip" Value="{DynamicResource LOCPlayAch_Trophy_Platinum}"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- Fully transparent black, the clear end of the frame's scrim. The shared transparent
         overlay token is transparent white, which greys a gradient toward black. -->
    <Color x:Key="CompletionFrameScrimClear">#00000000</Color>

    <!-- Two laurel branches, tips outward, each a stem with four pairs of leaves and a tip leaf.
         The stems stop short of the middle, where the completion frame's emblem sits over them. -->
    <Geometry x:Key="CompletionFrameLaurelGeometry">F1 M30,5.4 L3,5.4 L3,6.6 L30,6.6 Z M28,6 C27,1.5 23,0 20.5,0.5 C22,3.5 25,5.5 28,6 Z M28,6 C27,10.5 23,12 20.5,11.5 C22,8.5 25,6.5 28,6 Z M22,6 C21,1.5 17,0 14.5,0.5 C16,3.5 19,5.5 22,6 Z M22,6 C21,10.5 17,12 14.5,11.5 C16,8.5 19,6.5 22,6 Z M16,6 C15,1.5 11,0 8.5,0.5 C10,3.5 13,5.5 16,6 Z M16,6 C15,10.5 11,12 8.5,11.5 C10,8.5 13,6.5 16,6 Z M10,6 C9,1.5 5,0 2.5,0.5 C4,3.5 7,5.5 10,6 Z M10,6 C9,10.5 5,12 2.5,11.5 C4,8.5 7,6.5 10,6 Z M4,6 C2.5,3.8 0.5,4.5 0,6 C0.5,7.5 2.5,8.2 4,6 Z M34,5.4 L61,5.4 L61,6.6 L34,6.6 Z M36,6 C37,1.5 41,0 43.5,0.5 C42,3.5 39,5.5 36,6 Z M36,6 C37,10.5 41,12 43.5,11.5 C42,8.5 39,6.5 36,6 Z M42,6 C43,1.5 47,0 49.5,0.5 C48,3.5 45,5.5 42,6 Z M42,6 C43,10.5 47,12 49.5,11.5 C48,8.5 45,6.5 42,6 Z M48,6 C49,1.5 53,0 55.5,0.5 C54,3.5 51,5.5 48,6 Z M48,6 C49,10.5 53,12 55.5,11.5 C54,8.5 51,6.5 48,6 Z M54,6 C55,1.5 59,0 61.5,0.5 C60,3.5 57,5.5 54,6 Z M54,6 C55,10.5 59,12 61.5,11.5 C60,8.5 57,6.5 54,6 Z M60,6 C61.5,3.8 63.5,4.5 64,6 C63.5,7.5 61.5,8.2 60,6 Z</Geometry>

    <!-- Metallic sheen laid over the frame's completed-brush shapes: light toward the top left,
         clear through the middle, shaded toward the bottom right. The clear stops are transparent
         white and transparent black so neither half greys toward the other. -->
    <LinearGradientBrush x:Key="CompletionFrameSheenBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource PlayAch.Color.Overlay.Tint.40}"/>
        <GradientStop Offset="0.45" Color="{StaticResource PlayAch.Color.Overlay.Transparent}"/>
        <GradientStop Offset="0.55" Color="{StaticResource CompletionFrameScrimClear}"/>
        <GradientStop Offset="1" Color="{StaticResource PlayAch.Color.Overlay.Shade.42}"/>
    </LinearGradientBrush>

    <!-- Opaque fill for the frame's silhouette layer, which only serves as the gradient's mask
         and is covered by it. -->
    <SolidColorBrush x:Key="CompletionFrameMaskBrush" Color="{StaticResource PlayAch.Color.Shadow}"/>

    <!-- Completion frame, drawn on the cover art in the style of a mythic cover frame: a light
         scrim along the bottom, a square-cornered band on the cover's edge (heavier along the
         bottom), and a diamond emblem carrying the completion badge on the bottom border between
         two laurel branches.
         The band and laurels are drawn once as a silhouette (FrameShapes) that masks a single
         completed-gradient fill and sheen, so the start-to-end sweep runs across the whole frame
         instead of restarting in each piece.
         The template sits in an OverlayLayoutHost, so the frame never takes part in the cover's
         measure: the crest's natural width would otherwise widen narrow covers' cells.
         Hosts place a Control with this template over the art, its DataContext the game summary
         row, and set helpers:CompletionBadge.FrameBadgeSize on it. -->
    <ControlTemplate x:Key="CompletionFrameTemplate" TargetType="Control">
        <controls:OverlayLayoutHost>
            <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Border IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.75" Color="{StaticResource CompletionFrameScrimClear}"/>
                            <GradientStop Offset="1" Color="{StaticResource PlayAch.Color.Overlay.Shade.42}"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Grid x:Name="FrameShapes" IsHitTestVisible="False">
                    <Border BorderThickness="3,3,3,4"
                            BorderBrush="{StaticResource CompletionFrameMaskBrush}"/>
                    <!-- The laurels fill only the width the frame is given, so a narrow cover
                         shrinks them rather than widening the frame; the row's height is their
                         12px plus the 5px they sit above the bottom edge. -->
                    <Grid VerticalAlignment="Bottom" Margin="7,0" Height="17">
                        <controls:OverlayLayoutHost>
                            <Path Data="{StaticResource CompletionFrameLaurelGeometry}"
                                  Stretch="Uniform"
                                  MaxHeight="12"
                                  Margin="0,0,0,5"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Bottom"
                                  Fill="{StaticResource CompletionFrameMaskBrush}"/>
                        </controls:OverlayLayoutHost>
                    </Grid>
                </Grid>
                <Rectangle IsHitTestVisible="False"
                           Fill="{DynamicResource PlayAch.Brush.CompletedGlowBloom}">
                    <Rectangle.OpacityMask>
                        <VisualBrush Visual="{Binding ElementName=FrameShapes}"/>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle IsHitTestVisible="False"
                           Fill="{StaticResource CompletionFrameSheenBrush}">
                    <Rectangle.OpacityMask>
                        <VisualBrush Visual="{Binding ElementName=FrameShapes}"/>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <!-- The emblem: a diamond in the completed gradient with the band's sheen and a
                     dark edge, and the badge, in one cell so both share the same centre. Layout
                     rounding is off here so neither snaps half a pixel away from the other. -->
                <Grid VerticalAlignment="Bottom"
                      HorizontalAlignment="Center"
                      UseLayoutRounding="False">
                    <Grid IsHitTestVisible="False">
                        <Grid.LayoutTransform>
                            <RotateTransform Angle="45"/>
                        </Grid.LayoutTransform>
                        <Rectangle Margin="3"
                                   Width="{TemplateBinding helpers:CompletionBadge.FrameBadgeSize}"
                                   Height="{TemplateBinding helpers:CompletionBadge.FrameBadgeSize}"/>
                        <Border Background="{DynamicResource PlayAch.Brush.CompletedGlowBloom}"
                                CornerRadius="2"/>
                        <Border Background="{StaticResource CompletionFrameSheenBrush}"
                                BorderBrush="{DynamicResource PlayAch.Brush.Overlay.Shade.54}"
                                BorderThickness="1"
                                CornerRadius="2"/>
                    </Grid>
                    <Image Style="{StaticResource CompletionBadgeImageStyle}"
                           Width="{TemplateBinding helpers:CompletionBadge.FrameBadgeSize}"
                           Height="{TemplateBinding helpers:CompletionBadge.FrameBadgeSize}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </controls:OverlayLayoutHost>
    </ControlTemplate>

    <!-- =======================
         ACHIEVEMENT TEMPLATES
         ======================= -->

    <!-- The fill of the status column's locks (padlock and capstone hexagon), following the
         grid's StatusColor. Outside an achievement grid (the Manage Achievements editor) the mode
         falls back to Missable and Unobtainable. Later triggers win: a tag's own color overrides
         the missable red. -->
    <Style x:Key="AchievementLockedStatusFillStyle" TargetType="Path">
        <Setter Property="Fill" Value="{DynamicResource PlayAch.Brush.Glyph}"/>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding StatusColor, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}, FallbackValue={x:Static settings:AchievementStatusColorMode.MissableUnobtainable}}"
                               Value="{x:Static settings:AchievementStatusColorMode.MissableUnobtainable}"/>
                    <Condition Binding="{Binding IsMissable, FallbackValue=False}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Fill" Value="{DynamicResource PlayAch.Brush.MissableLock}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding StatusColor, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}, FallbackValue={x:Static settings:AchievementStatusColorMode.MissableUnobtainable}}"
                               Value="{x:Static settings:AchievementStatusColorMode.MissableUnobtainable}"/>
                    <Condition Binding="{Binding IsUnobtainable, FallbackValue=False}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Fill" Value="{DynamicResource PlayAch.Brush.MissableLock}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding StatusColor, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}, FallbackValue={x:Static settings:AchievementStatusColorMode.MissableUnobtainable}}"
                               Value="{x:Static settings:AchievementStatusColorMode.AllTags}"/>
                    <Condition Binding="{Binding IsMissable, FallbackValue=False}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Fill" Value="{DynamicResource PlayAch.Brush.MissableLock}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding StatusColor, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}, FallbackValue={x:Static settings:AchievementStatusColorMode.MissableUnobtainable}}"
                               Value="{x:Static settings:AchievementStatusColorMode.AllTags}"/>
                    <Condition Binding="{Binding IsUnobtainable, FallbackValue=False}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Fill" Value="{DynamicResource PlayAch.Brush.MissableLock}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding StatusColor, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}, FallbackValue={x:Static settings:AchievementStatusColorMode.MissableUnobtainable}}"
                               Value="{x:Static settings:AchievementStatusColorMode.MissableUnobtainable}"/>
                    <Condition Binding="{Binding HasMissableStatusBrush, FallbackValue=False}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Fill" Value="{Binding MissableStatusBrush}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding StatusColor, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}, FallbackValue={x:Static settings:AchievementStatusColorMode.MissableUnobtainable}}"
                               Value="{x:Static settings:AchievementStatusColorMode.AllTags}"/>
                    <Condition Binding="{Binding HasTagBrush, FallbackValue=False}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Fill" Value="{Binding TagBrush}"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Achievement Status Template: Checkmark, padlock, or capstone badge -->
    <DataTemplate x:Key="AchievementStatusTemplate">
        <!-- The filter conditions below fall back to False on purpose: only the merged editor's
             rows carry these flags, because every other grid projects filtered achievements out
             before they reach a row. Without the fallback the binding resolves to unset there,
             never equals False, and every glyph silently stays collapsed.

             Sized natively like the image columns: the Uniform Viewbox is bounded by the cell's
             content box, so it respects cell padding and grows with the column instead of being
             given computed dimensions that ignore both. -->
        <Viewbox Stretch="Uniform"
                 Margin="2"
                 VerticalAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellVerticalAlignment)}"
                 HorizontalAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellHorizontalAlignment)}"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True">
            <!-- Transparent background so the whole icon box, not just the glyph ink, shows the
                 tooltip. The category-type flags fall back to False for row types that do not
                 carry them. -->
            <Grid Width="18" Height="18" Background="Transparent">
                <Grid.ToolTip>
                    <MultiBinding Converter="{StaticResource AchievementStatusToolTipConverter}">
                        <Binding Path="Unlocked"/>
                        <Binding Path="IsCapstone" FallbackValue="False"/>
                        <Binding Path="IsGoal" FallbackValue="False"/>
                        <Binding Path="IsFiltered" FallbackValue="False"/>
                        <Binding Path="IsFilteredFromSummaries" FallbackValue="False"/>
                        <Binding Path="IsMissable" FallbackValue="False"/>
                        <Binding Path="IsUnobtainable" FallbackValue="False"/>                    </MultiBinding>
                </Grid.ToolTip>
                <Path Data="{StaticResource GeoCheck}"
                      StrokeThickness="2.3"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Stroke" Value="{DynamicResource PlayAch.Brush.Glyph}"/>
                            <Style.Triggers>
                                <!-- All Tags colors the check with the first colored tag other
                                     than Missable and Unobtainable, which only color a lock. -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding StatusColor, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}, FallbackValue={x:Static settings:AchievementStatusColorMode.MissableUnobtainable}}"
                                                   Value="{x:Static settings:AchievementStatusColorMode.AllTags}"/>
                                        <Condition Binding="{Binding HasUnlockedStatusTagBrush, FallbackValue=False}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Stroke" Value="{Binding UnlockedStatusTagBrush}"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsFiltered, FallbackValue=False}" Value="False"/>
                                        <Condition Binding="{Binding IsFilteredFromSummaries, FallbackValue=False}" Value="False"/>
                                        <Condition Binding="{Binding Unlocked}" Value="True"/>
                                        <Condition Binding="{Binding IsCapstone}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>

                <Image Source="{DynamicResource BadgeRarityCompleted}"
                       Effect="{StaticResource BadgeShadow}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    <Image.Style>
                        <Style TargetType="Image" BasedOn="{StaticResource RarityIcon}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsFiltered, FallbackValue=False}" Value="False"/>
                                        <Condition Binding="{Binding IsFilteredFromSummaries, FallbackValue=False}" Value="False"/>
                                        <Condition Binding="{Binding Unlocked}" Value="True"/>
                                        <Condition Binding="{Binding IsCapstone}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>

                <Grid Opacity="0.65"
                      UseLayoutRounding="True"
                      SnapsToDevicePixels="True"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <!-- A goal shows its pin instead, so the two never both render. -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsFiltered, FallbackValue=False}" Value="False"/>
                                        <Condition Binding="{Binding IsFilteredFromSummaries, FallbackValue=False}" Value="False"/>
                                        <Condition Binding="{Binding Unlocked}" Value="False"/>
                                        <Condition Binding="{Binding IsCapstone}" Value="True"/>
                                        <Condition Binding="{Binding IsGoal}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <!-- Explicit 18x18 box with Stretch="None": the geometry is already authored
                         centred on (9,9) in that space, so it needs no scaling. Sizing to the box
                         rather than letting the path measure to its own bounds is what centres it,
                         since those bounds include the geometry's leading offset. Uniform would
                         centre it too, but only by scaling 14x16 up to 18x18, which puts the edges
                         on fractional pixels and softens them. -->
                    <Path Stretch="None"
                          Width="18"
                          Height="18"
                          UseLayoutRounding="True"
                          SnapsToDevicePixels="True"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <!-- Fill set in the style, not as an attribute, so the status color
                             triggers can override it. The lock only shows while locked, so the
                             triggers need no Unlocked condition. -->
                        <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource AchievementLockedStatusFillStyle}"/>
                        </Path.Style>
                        <Path.Data>
                            <CombinedGeometry GeometryCombineMode="Exclude">
                                <CombinedGeometry.Geometry1>
                                    <PathGeometry Figures="M 9,1 L 16,5 L 16,13 L 9,17 L 2,13 L 2,5 Z"/>
                                </CombinedGeometry.Geometry1>
                                <CombinedGeometry.Geometry2>
                                    <PathGeometry Figures="M 68.9792,102.7712 H 57.344 L 59.0848,85.568 C 56.9216,84.224 55.488,81.8432 55.488,79.0912 C 55.488,74.8672 58.9184,71.4368 63.1552,71.4368 C 67.3792,71.4368 70.8096,74.8672 70.8096,79.0912 C 70.8096,81.8304 69.376,84.2368 67.1872,85.568 L 68.9792,102.7712 Z">
                                        <PathGeometry.Transform>
                                            <MatrixTransform Matrix="0.22,0,0,0.22,-4.893,-10.163"/>
                                        </PathGeometry.Transform>
                                    </PathGeometry>
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </Path.Data>
                    </Path>
                </Grid>

                <Path Data="{StaticResource GeoLock}"
                      Stretch="Uniform"
                      Width="18"
                      Height="18"
                      Opacity="0.65"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Path.Style>
                        <Style TargetType="Path" BasedOn="{StaticResource AchievementLockedStatusFillStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsFiltered, FallbackValue=False}" Value="False"/>
                                        <Condition Binding="{Binding IsFilteredFromSummaries, FallbackValue=False}" Value="False"/>
                                        <Condition Binding="{Binding Unlocked}" Value="False"/>
                                        <Condition Binding="{Binding IsCapstone}" Value="False"/>
                                        <Condition Binding="{Binding IsGoal}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>

                <!-- A goal replaces the padlock with a tack pin, and takes priority over the
                     capstone hexagon. Goals are always locked, so this never competes with the
                     unlocked check or the completed badge. -->
                <TextBlock Text="&#xf003;"
                           FontFamily="{DynamicResource PlayAch.FontFamily.Icon}"
                           FontSize="16"
                           Foreground="{DynamicResource PlayAch.Brush.Glyph}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsFiltered, FallbackValue=False}" Value="False"/>
                                        <Condition Binding="{Binding IsFilteredFromSummaries, FallbackValue=False}" Value="False"/>
                                        <Condition Binding="{Binding Unlocked}" Value="False"/>
                                        <Condition Binding="{Binding IsGoal}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- A filtered achievement is excluded from views and counts, so it reads as an X
                     rather than as its unlock state. Every glyph above yields to this, so the cell
                     shows one thing. Other grids project filtered rows out, so this surfaces where
                     they are still listed: the editor. -->
                <!-- Sized and placed like the padlock: an explicit 18x18 box with Stretch None, so
                     the geometry's own coordinates position it. Centring on alignment instead would
                     centre the ink bounds, which is not the same thing once a stroke widens them.
                     Spans 3..15 with the check's stroke, so the two carry the same weight. No
                     pixel snapping: that suits the padlock's filled edges, but it thins a stroked
                     diagonal, which is why the check does not ask for it either. -->
                <Path Data="M 3,3 L 15,15 M 15,3 L 3,15"
                      Stretch="None"
                      Width="18"
                      Height="18"
                      Stroke="{DynamicResource PlayAch.Brush.Glyph}"
                      StrokeThickness="2.3"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFiltered}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFilteredFromSummaries}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Grid>
        </Viewbox>
    </DataTemplate>

    <!-- Achievement Rarity Template -->
    <DataTemplate x:Key="AchievementRarityTemplate">
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellVerticalAlignment)}"
                    HorizontalAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellHorizontalAlignment)}">
            <Image Width="16" Height="16" Margin="0,0,4,0"
                   Effect="{StaticResource BadgeShadow}"
                   VerticalAlignment="Center">
                <Image.Style>
                    <Style TargetType="Image" BasedOn="{StaticResource RarityIcon}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Rarity}" Value="{x:Static models:RarityTier.UltraRare}">
                                <Setter Property="Source" Value="{DynamicResource BadgeRarityUltraRare}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Rarity}" Value="{x:Static models:RarityTier.Rare}">
                                <Setter Property="Source" Value="{DynamicResource BadgeRarityRare}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Rarity}" Value="{x:Static models:RarityTier.Uncommon}">
                                <Setter Property="Source" Value="{DynamicResource BadgeRarityUncommon}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Rarity}" Value="{x:Static models:RarityTier.Common}">
                                <Setter Property="Source" Value="{DynamicResource BadgeRarityCommon}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
            <TextBlock Text="{Binding GlobalPercentText}"
                       FontWeight="SemiBold"
                       Opacity="{StaticResource PlayAch.Opacity.Secondary}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PlayAch.TextBlock.BaseStyle}">
                        <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ColorRarityColumnsByRarity, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}}" Value="True">
                                <Setter Property="Foreground" Value="{Binding RarityBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="AchievementRarityTierTemplate">
        <Image HorizontalAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellHorizontalAlignment)}"
               VerticalAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellVerticalAlignment)}"
               Effect="{StaticResource BadgeShadow}">
            <Image.Width>
                <MultiBinding Converter="{StaticResource ImageFitDimension}" ConverterParameter="platform,width,24,18,20">
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}" Path="ActualHeight"/>
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGridCell}" Path="ActualWidth"/>
                </MultiBinding>
            </Image.Width>
            <Image.Height>
                <MultiBinding Converter="{StaticResource ImageFitDimension}" ConverterParameter="platform,height,24,18,20">
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}" Path="ActualHeight"/>
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGridCell}" Path="ActualWidth"/>
                </MultiBinding>
            </Image.Height>
            <Image.Style>
                <Style TargetType="Image" BasedOn="{StaticResource RarityIcon}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Rarity}" Value="{x:Static models:RarityTier.UltraRare}">
                            <Setter Property="Source" Value="{DynamicResource BadgeRarityUltraRare}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Rarity}" Value="{x:Static models:RarityTier.Rare}">
                            <Setter Property="Source" Value="{DynamicResource BadgeRarityRare}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Rarity}" Value="{x:Static models:RarityTier.Uncommon}">
                            <Setter Property="Source" Value="{DynamicResource BadgeRarityUncommon}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Rarity}" Value="{x:Static models:RarityTier.Common}">
                            <Setter Property="Source" Value="{DynamicResource BadgeRarityCommon}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>
    </DataTemplate>

    <!-- Achievement Trophy Template. While the trophy mask applies the grade badge is swapped for
         the TrophyUnknown badge, so the row still shows that a trophy exists without giving away
         which grade it is. It is the same Image with a different Source, so the masked badge is
         sized, shadowed and aligned exactly like a real grade. -->
    <DataTemplate x:Key="AchievementTrophyTemplate">
        <Grid VerticalAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellVerticalAlignment)}"
              HorizontalAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellHorizontalAlignment)}">
            <Image Effect="{StaticResource BadgeShadow}">
                <Image.Width>
                    <MultiBinding Converter="{StaticResource ImageFitDimension}" ConverterParameter="platform,width,24,18,20">
                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}" Path="ActualHeight"/>
                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridCell}" Path="ActualWidth"/>
                    </MultiBinding>
                </Image.Width>
                <Image.Height>
                    <MultiBinding Converter="{StaticResource ImageFitDimension}" ConverterParameter="platform,height,24,18,20">
                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}" Path="ActualHeight"/>
                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridCell}" Path="ActualWidth"/>
                    </MultiBinding>
                </Image.Height>
                <Image.Style>
                    <Style TargetType="Image" BasedOn="{StaticResource RarityIcon}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasTrophyType}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <!-- All five switch on TrophyTypeResolved, which already returns the
                                 masked sentinel, so exactly one of them can match and no trigger
                                 has to outrank another to keep a grade from showing through. -->
                            <DataTrigger Binding="{Binding TrophyTypeResolved}" Value="platinum">
                                <Setter Property="Source" Value="{DynamicResource TrophyPlatinum}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TrophyTypeResolved}" Value="gold">
                                <Setter Property="Source" Value="{DynamicResource TrophyGold}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TrophyTypeResolved}" Value="silver">
                                <Setter Property="Source" Value="{DynamicResource TrophySilver}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TrophyTypeResolved}" Value="bronze">
                                <Setter Property="Source" Value="{DynamicResource TrophyBronze}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TrophyTypeResolved}" Value="unknown">
                                <Setter Property="Source" Value="{DynamicResource TrophyUnknown}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="ToolTip" Value="{DynamicResource LOCPlayAch_Achievements_ClickToReveal}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
        </Grid>
    </DataTemplate>

    <!-- Achievement Points Template. PointsTextResolved swaps in the placeholder while the points
         mask applies; the italic matches how a masked description reads. -->
    <DataTemplate x:Key="AchievementPointsTemplate">
        <TextBlock Text="{Binding PointsTextResolved}"
                   HorizontalAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellHorizontalAlignment)}"
                   VerticalAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellVerticalAlignment)}"
                   TextAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellTextAlignment)}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PlayAch.Brush.Text}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource PlayAch.TextBlock.BaseStyle}">
                    <Setter Property="Opacity" Value="{StaticResource PlayAch.Opacity.Secondary}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPointsHidden}" Value="True">
                            <Setter Property="FontStyle" Value="Italic"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="ToolTip" Value="{DynamicResource LOCPlayAch_Achievements_ClickToReveal}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </DataTemplate>

    <!-- Achievement Game Column Template - Icon or Cover with toggle support.
         Sizing is width-driven: the Uniform image fills the column width, so
         resizing the column grows the art and auto rows grow to match. When a
         fixed row height is configured it bounds the layout, and Uniform
         stretch fits the art inside both cell dimensions without clipping. -->
    <DataTemplate x:Key="AchievementGameColumnTemplate">
        <Border CornerRadius="{StaticResource PlayAch.Radius.Card}"
                ClipToBounds="True"
                Margin="2"
                HorizontalAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellHorizontalAlignment)}"
                VerticalAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellVerticalAlignment)}"
                RenderOptions.BitmapScalingMode="HighQuality"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True">
            <Image Stretch="Uniform">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="helpers:AsyncImage.CapAtOwnSize" Value="{DynamicResource PlayAch.Image.CapAtOwnSize}"/>
                        <Setter Property="helpers:AsyncImage.Uri" Value="{Binding GameIconPath, Converter={StaticResource DefaultGameImage}, ConverterParameter=icon}"/>
                        <Setter Property="helpers:AsyncImage.DecodePixel" Value="96"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UseCoverImages, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}}"
                                         Value="True">
                                <Setter Property="helpers:AsyncImage.Uri" Value="{Binding GameCoverPath, Converter={StaticResource DefaultGameImage}, ConverterParameter=cover}"/>
                                <Setter Property="helpers:AsyncImage.DecodePixel" Value="128"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
        </Border>
    </DataTemplate>

    <!-- Achievement Category Column Template - category art, falling back to the game icon
         or cover per the grid's UseCoverImages setting. Bounded like the game column so
         banner-shaped art fills the constraining cell dimension without being clipped. -->
    <DataTemplate x:Key="AchievementCategoryColumnTemplate">
        <Border CornerRadius="{StaticResource PlayAch.Radius.Card}"
                ClipToBounds="True"
                Margin="2"
                HorizontalAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellHorizontalAlignment)}"
                VerticalAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellVerticalAlignment)}"
                RenderOptions.BitmapScalingMode="HighQuality"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True">
            <Image Stretch="Uniform">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="helpers:AsyncImage.CapAtOwnSize" Value="{DynamicResource PlayAch.Image.CapAtOwnSize}"/>
                        <Setter Property="helpers:AsyncImage.Uri" Value="{Binding CategoryIconDisplayPath, Converter={StaticResource DefaultGameImage}, ConverterParameter=icon}"/>
                        <Setter Property="helpers:AsyncImage.DecodePixel" Value="-1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UseCoverImages, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}}"
                                         Value="True">
                                <Setter Property="helpers:AsyncImage.Uri" Value="{Binding CategoryCoverDisplayPath, Converter={StaticResource DefaultGameImage}, ConverterParameter=cover}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
        </Border>
    </DataTemplate>

    <!-- Achievement Icon Template - glow is isolated behind an unaffected front icon -->
    <DataTemplate x:Key="AchievementIconTemplate">
        <Grid HorizontalAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellHorizontalAlignment)}"
              VerticalAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellVerticalAlignment)}"
              ClipToBounds="False"
              UseLayoutRounding="True"
              SnapsToDevicePixels="True">

            <!-- Rays glow style: a rotating sunburst behind the soft halo, which keeps rendering
                 under both styles. First child, so it sits under the glow layer and the icon. Its
                 arrows reach past this cell, which is why the Grid sets ClipToBounds="False", and
                 they are traced from the same icon SubjectUri names. Hardcore keeps its crisp shine
                 border instead. The icon carries Margin="2", so the track is inset to match. -->
            <controls:RarityRayBurst Rarity="{Binding Rarity}"
                                     HasRarityData="{Binding HasRarityPercent}"
                                     SubjectUri="{Binding DisplayIcon}"
                                     SubjectInset="2">
                <controls:RarityRayBurst.Style>
                    <Style TargetType="controls:RarityRayBurst">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Unlocked}" Value="True"/>
                                    <Condition Binding="{Binding ShowRarityGlow, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                            <!-- Turn only while the global animation toggle is on; otherwise the
                                 burst still shows, just held still. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Unlocked}" Value="True"/>
                                    <Condition Binding="{Binding ShowRarityGlow, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}}" Value="True"/>
                                    <Condition Binding="{Binding AnimateRarityGlows, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsActive" Value="True"/>
                            </MultiDataTrigger>
            <!-- Hardcore achievements use a solid border instead of any glow, unless the user has
                                 turned that border off — then they glow like anything else. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsHardcore}" Value="True"/>
                                    <Condition Binding="{Binding ShowHardcoreBorder, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="IsActive" Value="False"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:RarityRayBurst.Style>
            </controls:RarityRayBurst>

            <!-- BitmapCache stores the blurred glow output so scrolling composites a
                 cached texture instead of re-rasterizing the DropShadowEffect per frame. -->
            <Border IsHitTestVisible="False">
                <Border.CacheMode>
                    <BitmapCache/>
                </Border.CacheMode>
                <!-- Fade in/out pulse on the cached glow layer when AnimateRarityGlows is on. -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Unlocked}" Value="True"/>
                                    <Condition Binding="{Binding ShowRarityGlow, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}}" Value="True"/>
                                    <Condition Binding="{Binding AnimateRarityGlows, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="helpers:RarityGlowPulse.IsActive" Value="True"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Image Stretch="Uniform"
                       Margin="2"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       IsHitTestVisible="False"
                       helpers:AsyncImage.Uri="{Binding DisplayIcon}"
                       helpers:AsyncImage.DecodePixel="128"
                       helpers:AsyncImage.CapAtOwnSize="{DynamicResource PlayAch.Image.CapAtOwnSize}">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Effect" Value="{x:Null}"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Unlocked}" Value="True"/>
                                        <Condition Binding="{Binding ShowRarityGlow, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <!-- Multi-bound so the glow follows the per-tier selection and
                                         re-evaluates when that selection changes. -->
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource RarityGlowForTiers}" ConverterParameter="20">
                                                <Binding Path="Rarity"/>
                                                <Binding Path="SoftGlowTiers" RelativeSource="{RelativeSource AncestorType=controls:AchievementDataGridControl}"/>
                                                <Binding Path="HasRarityPercent"/>
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                </MultiDataTrigger>
                                <!-- Hardcore achievements use a solid border instead of the soft glow. -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Unlocked}" Value="True"/>
                                        <Condition Binding="{Binding ShowRarityGlow, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}}" Value="True"/>
                                        <Condition Binding="{Binding IsHardcore}" Value="True"/>
                                        <Condition Binding="{Binding ShowHardcoreBorder, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Effect" Value="{x:Null}"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Border>

            <!-- Edge that comes with the rays: the same layer as the soft halo above, at a blur small
                 enough to read as a line rather than a glow. Drawn this way rather than as geometry
                 because it is a blur of the artwork itself, so it hugs the alpha exactly — on cut-out
                 and non-square art alike, which no rectangle or convex hull can do. Cached for the same
                 reason the halo is: it never moves, so it rasterizes once. -->
            <Border IsHitTestVisible="False">
                <Border.CacheMode>
                    <BitmapCache/>
                </Border.CacheMode>
                <Image Stretch="Uniform"
                       Margin="2"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       IsHitTestVisible="False"
                       helpers:AsyncImage.Uri="{Binding DisplayIcon}"
                       helpers:AsyncImage.DecodePixel="128"
                       helpers:AsyncImage.CapAtOwnSize="{DynamicResource PlayAch.Image.CapAtOwnSize}">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Effect" Value="{x:Null}"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Unlocked}" Value="True"/>
                                        <Condition Binding="{Binding ShowRarityGlow, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource RarityGlowForTiers}" ConverterParameter="4">
                                                <Binding Path="Rarity"/>
                                                <Binding Path="RayGlowTiers" RelativeSource="{RelativeSource AncestorType=controls:AchievementDataGridControl}"/>
                                                <Binding Path="HasRarityPercent"/>
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                </MultiDataTrigger>
                                <!-- Hardcore keeps its solid shine border instead. -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Unlocked}" Value="True"/>
                                        <Condition Binding="{Binding ShowRarityGlow, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}}" Value="True"/>
                                        <Condition Binding="{Binding IsHardcore}" Value="True"/>
                                        <Condition Binding="{Binding ShowHardcoreBorder, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Effect" Value="{x:Null}"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Border>

            <!-- Front icon. While the row is masked this is the user's locked or hidden cover, so it
                 advertises the click-to-reveal that the surrounding row already handles. ToolTip is
                 set only by the triggers; an unmasked icon shows none. -->
            <Image Stretch="Uniform"
                   Margin="2"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   helpers:AsyncImage.Uri="{Binding DisplayIcon}"
                   helpers:AsyncImage.DecodePixel="128"
                   helpers:AsyncImage.CapAtOwnSize="{DynamicResource PlayAch.Image.CapAtOwnSize}">
                <Image.Style>
                    <Style TargetType="Image">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIconHidden}" Value="True">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="ToolTip" Value="{DynamicResource LOCPlayAch_Achievements_ClickToReveal}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLockedIconHidden}" Value="True">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="ToolTip" Value="{DynamicResource LOCPlayAch_Achievements_ClickToReveal}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>

            <!-- Solid rarity border for Hardcore achievements (replaces the glow).
                 Negative margin draws the border just OUTSIDE the icon (icon margin 2 - thickness 3)
                 so it never covers or shrinks the icon, matching how the glow extended outward. -->
            <Border Margin="-1"
                    BorderThickness="3"
                    Background="Transparent"
                    IsHitTestVisible="False"
                    SnapsToDevicePixels="True"
                    BorderBrush="{Binding Rarity, Converter={StaticResource RarityToShineBrush}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Unlocked}" Value="True"/>
                                    <Condition Binding="{Binding ShowRarityGlow, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}}" Value="True"/>
                                    <Condition Binding="{Binding IsHardcore}" Value="True"/>
                                    <Condition Binding="{Binding ShowHardcoreBorder, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- The achievement name text of the Achievement and Title columns. Its color follows the
         grid's NameColor source; a row the source gives no color keeps the text color. Trophy
         switches on TrophyTypeResolved, so a masked trophy stays uncolored. -->
    <Style x:Key="AchievementNameTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource PlayAch.FontFamily.Body}"/>
        <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
        <Setter Property="Opacity" Value="0.7"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Unlocked}" Value="True">
                <Setter Property="Opacity" Value="1"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsTitleHidden}" Value="True">
                <Setter Property="FontStyle" Value="Italic"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding NameColor, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}}"
                         Value="{x:Static settings:AchievementNameColorSource.Rarity}">
                <Setter Property="Foreground" Value="{Binding RarityNameBrush}"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding NameColor, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}}"
                               Value="{x:Static settings:AchievementNameColorSource.Trophy}"/>
                    <Condition Binding="{Binding TrophyTypeResolved}" Value="platinum"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Trophy.Platinum}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding NameColor, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}}"
                               Value="{x:Static settings:AchievementNameColorSource.Trophy}"/>
                    <Condition Binding="{Binding TrophyTypeResolved}" Value="gold"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Trophy.Gold}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding NameColor, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}}"
                               Value="{x:Static settings:AchievementNameColorSource.Trophy}"/>
                    <Condition Binding="{Binding TrophyTypeResolved}" Value="silver"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Trophy.Silver}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding NameColor, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}}"
                               Value="{x:Static settings:AchievementNameColorSource.Trophy}"/>
                    <Condition Binding="{Binding TrophyTypeResolved}" Value="bronze"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Trophy.Bronze}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding NameColor, RelativeSource={RelativeSource AncestorType=controls:AchievementDataGridControl}}"
                               Value="{x:Static settings:AchievementNameColorSource.Tag}"/>
                    <Condition Binding="{Binding HasTagBrush, FallbackValue=False}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{Binding TagBrush}"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Achievement Info Template with Hidden Styling -->
    <DataTemplate x:Key="AchievementInfoTemplate">
        <StackPanel VerticalAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellVerticalAlignment)}"
                    HorizontalAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellHorizontalAlignment)}"
                    Background="Transparent">
            <TextBlock FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Style="{StaticResource AchievementNameTextStyle}"
                       TextAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellTextAlignment)}">
                <Run Text="{Binding DisplayNameResolved, Mode=OneWay}"/>
                <Run Text="{Binding HiddenTitleSuffix, Mode=OneWay}"
                     FontStyle="Italic"
                     Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"/>
                <Run Text="{Binding AchievementNoteInlineMarker, Mode=OneWay}"
                     FontFamily="{DynamicResource PlayAch.FontFamily.Icon}"
                     Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"/>
            </TextBlock>
            <TextBlock Text="{Binding DescriptionResolved}"
                       FontFamily="{DynamicResource PlayAch.FontFamily.Body}"
                       FontSize="{DynamicResource PlayAch.FontSize.Body}"
                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                       Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       TextAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellTextAlignment)}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Margin" Value="0,3,0,0"/>
                        <Setter Property="MaxHeight" Value="44"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDescriptionHidden}" Value="True">
                                <Setter Property="FontStyle" Value="Italic"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </DataTemplate>

    <!-- Unlock Date / Progress Template -->
    <DataTemplate x:Key="AchievementUnlockDateTemplate">
        <!-- The tooltip names both sides of the comparison, so it covers the whole cell rather
             than only the friend's row. It resolves to null outside compare mode.

             Outside compare mode the grid stretches and the date aligns itself inside the star
             column, as it always has. In compare mode the grid instead sizes to its content and
             takes the column's alignment itself, so the avatar+date block moves as one unit:
             centered centers the whole pair, right pushes the whole pair right. Aligning each row
             on its own instead would leave the two avatars at different offsets, since the rows
             hold different text. -->
        <Grid Background="Transparent"
              ToolTip="{Binding ComparisonToolTip, Mode=OneWay}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasComparison}" Value="True">
                            <Setter Property="HorizontalAlignment" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellHorizontalAlignment)}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Column 0 carries the row owner's avatar in compare mode and collapses to zero
                 width otherwise, so the non-compare layout is unchanged. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="16"
                    Height="16"
                    CornerRadius="8"
                    Margin="0,0,5,0"
                    ClipToBounds="True"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}}">
                <Image Stretch="Uniform"
                       helpers:AsyncImage.Uri="{Binding ComparisonOwnerAvatarPath}"
                       helpers:AsyncImage.DecodePixel="32"/>
            </Border>

            <!-- Inside the block the text sits hard against its avatar; the block as a whole is
                 what carries the column's alignment (see the grid style above). Letting the text
                 align itself here as well would slide it away from the avatar and stagger the two
                 rows. Outside compare mode there is no block to align, so the column's configured
                 alignment applies to the text directly, as it always has. -->
            <Grid Grid.Column="1"
                  Visibility="{Binding ShowUnlockDate, Converter={StaticResource BoolToVis}}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="HorizontalAlignment" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellHorizontalAlignment)}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasComparison}" Value="True">
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <TextBlock VerticalAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellVerticalAlignment)}"
                        Style="{DynamicResource PlayAch.TextBlock.BaseStyle}"
                        Foreground="{DynamicResource PlayAch.Brush.Text}"
                        Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                        TextWrapping="Wrap"
                        TextAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellTextAlignment)}">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource DateDisplayMode}">
                            <Binding Path="UnlockTimeLocal"/>
                            <Binding Path="UnlockDateMode" RelativeSource="{RelativeSource AncestorType=controls:AchievementDataGridControl}"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>

            <Grid Grid.Column="1"
                Visibility="{Binding ShowLockedProgress, Converter={StaticResource BoolToVis}}"
                Margin="4,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellVerticalAlignment)}">
                <!-- The column stops stretching once the cell sizes to its content in compare
                     mode, so the bar needs a floor there or it shrinks to the width of whatever
                     text the friend row happens to carry. Left unconstrained otherwise, where the
                     star column still drives its width. -->
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasComparison}" Value="True">
                                <Setter Property="MinWidth" Value="80"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ProgressBar Style="{StaticResource GameProgressBar}"
                            Value="{Binding ProgressPercent, Mode=OneWay}"
                            Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Text="{Binding ProgressText, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{DynamicResource PlayAch.TextBlock.BaseStyle}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PlayAch.Brush.Text}"
                        Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <!-- Owner's Locked label, compare mode only. ShowLockedProgress is just !Unlocked, and
                 the progress bar inside it only renders when HasProgress, so a locked achievement
                 with no progress data leaves this row empty. Beside an avatar that reads as a
                 stray image, so the friend row's Locked label is mirrored here. -->
            <Grid Grid.Column="1" HorizontalAlignment="Left">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasComparison}" Value="True"/>
                                    <Condition Binding="{Binding Unlocked}" Value="False"/>
                                    <Condition Binding="{Binding HasProgress}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <TextBlock Text="{DynamicResource LOCPlayAch_Common_Locked}"
                        VerticalAlignment="Center"
                        Style="{DynamicResource PlayAch.TextBlock.BaseStyle}"
                        Foreground="{DynamicResource PlayAch.Brush.Text}"
                        Opacity="{StaticResource PlayAch.Opacity.Placeholder}"/>
            </Grid>

            <!-- Comparison row: the compare friend's avatar + unlock date (or Locked). The avatar
                 sits in the same Auto column as the owner's above it, so the two line up by
                 construction instead of each row aligning itself independently. -->
            <Border Grid.Row="1"
                    Grid.Column="0"
                    Width="16"
                    Height="16"
                    CornerRadius="8"
                    Margin="0,2,5,0"
                    ClipToBounds="True"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}}">
                <Image Stretch="Uniform"
                       helpers:AsyncImage.Uri="{Binding ComparisonFriendAvatarPath}"
                       helpers:AsyncImage.DecodePixel="32"/>
            </Border>

            <!-- Left, matching the owner's text above: this row only exists in compare mode, where
                 both sides are pinned left against their shared avatar column. -->
            <StackPanel Grid.Row="1"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="0,2,0,0"
                        HorizontalAlignment="Left"
                        Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}}">
                <TextBlock VerticalAlignment="Center"
                        Style="{DynamicResource PlayAch.TextBlock.BaseStyle}"
                        Foreground="{DynamicResource PlayAch.Brush.Text}"
                        Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{Binding ComparisonUnlocked, Converter={StaticResource BoolToVis}}">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource DateDisplayMode}">
                            <Binding Path="ComparisonUnlockTimeLocal"/>
                            <Binding Path="UnlockDateMode" RelativeSource="{RelativeSource AncestorType=controls:AchievementDataGridControl}"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Text="{DynamicResource LOCPlayAch_Common_Locked}"
                        VerticalAlignment="Center"
                        Style="{DynamicResource PlayAch.TextBlock.BaseStyle}"
                        Foreground="{DynamicResource PlayAch.Brush.Text}"
                        Opacity="{StaticResource PlayAch.Opacity.Placeholder}">
                    <TextBlock.Visibility>
                        <Binding Path="ComparisonUnlocked" Converter="{StaticResource InverseBoolToVis}"/>
                    </TextBlock.Visibility>
                </TextBlock>
            </StackPanel>
        </Grid>
    </DataTemplate>


</ResourceDictionary>
