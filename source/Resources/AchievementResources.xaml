<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
                    xmlns:vm="clr-namespace:PlayniteAchievements.ViewModels">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/RarityBadges.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/TrophyBadges.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/AchievementGridStyles.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/AchievementCellTemplates.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/AchievementControlStyles.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/LogoResources.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
        Toast animations. These are theme-overridable: a theme may redefine any of these keys in
        its PlayniteAchievements/AchievementToast.xaml to change the easing, timing, or add extra
        child animations. Values the plugin must supply at runtime are left unset here and patched
        in code before the storyboard runs:
          - Slide in/out: From/To (the window's off-screen and resting Top, which depend on the
            live game-window position and toast corner) are set in code; easing and duration below
            are honored as authored.
          - Countdown: Duration is set in code to the toast's display time; the animated target
            (each toast's PART_ToastCountdown bar) is also assigned in code. The animation must
            drive the bar's ScaleX (contract) so it reads as a depleting auto-dismiss timer.
    -->
    <Storyboard x:Key="PlayAch.Storyboard.ToastSlideIn">
        <DoubleAnimation Storyboard.TargetProperty="(Window.Top)"
                         Duration="0:0:0.24"
                         FillBehavior="HoldEnd">
            <DoubleAnimation.EasingFunction>
                <BackEase EasingMode="EaseOut"
                          Amplitude="0.35"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <Storyboard x:Key="PlayAch.Storyboard.ToastSlideOut">
        <DoubleAnimation Storyboard.TargetProperty="(Window.Top)"
                         Duration="0:0:0.2"
                         FillBehavior="HoldEnd">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseIn"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <Storyboard x:Key="PlayAch.Storyboard.ToastCountdown">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         From="1"
                         To="0"
                         FillBehavior="HoldEnd"/>
    </Storyboard>

    <!--
        Subtle shadow that lifts text, badges, and logos off the card surface or a user background
        image so they stay legible. Shared and frozen, so a single tweak here restyles every text
        line and badge on both the toast and frame surfaces. Applied on the shared line-template
        roots (below) and on the badge/provider images in each surface template.
    -->
    <DropShadowEffect x:Key="PlayAch.Effect.ContentShadow"
                      BlurRadius="4"
                      ShadowDepth="1"
                      Direction="315"
                      Opacity="0.6"
                      Color="#FF000000"/>

    <!-- Stronger variant for the muted secondary-color text lines (header, description,
         game/category), which are the hardest to read over busy background images. -->
    <DropShadowEffect x:Key="PlayAch.Effect.ContentShadowStrong"
                      BlurRadius="5"
                      ShadowDepth="1"
                      Direction="315"
                      Opacity="0.95"
                      Color="#FF000000"/>

    <!--
        Shared text-line templates for the toast and frame surfaces. Both templates render an
        ItemsControl over the view model's ToastLines/FrameLines, so the user's line order is
        pure data; WPF picks these implicitly by descriptor type. Surface-specific values
        (font size/family, visibility, title brush, friend avatar) are pre-resolved onto the
        descriptors; everything else binds through Parent. Completion restyling stays in the
        templates via triggers on Parent.IsGameCompleted / Parent.IsFriendUnlock. Frame
        descriptors never show the friend avatar, keeping these templates free of async image
        loads for the offscreen frame render.
    -->
    <DataTemplate DataType="{x:Type vm:ToastHeaderLine}">
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Effect="{StaticResource PlayAch.Effect.ContentShadowStrong}">
            <Border Width="16"
                    Height="16"
                    CornerRadius="8"
                    Margin="0,0,5,0"
                    ClipToBounds="True"
                    Visibility="{Binding ShowFriendAvatar, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Image Stretch="Uniform"
                       helpers:AsyncImage.Uri="{Binding Parent.FriendAvatar}"
                       helpers:AsyncImage.DecodePixel="64"/>
            </Border>
            <TextBlock Text="{Binding Parent.HeaderText}"
                       Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                       FontSize="{Binding FontSize}"
                       FontFamily="{Binding FontFamily}"
                       TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PlayAch.TextBlock.BaseStyle}">
                        <Setter Property="Visibility" Value="{Binding ShowHeader, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Parent.IsGameCompleted}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <!-- Completion headers replace the unlock header: "Congratulations!" for your own
                 completion, "<friend> completed the game!" for a friend's. Both texts honor
                 the user's header edits via the view model. -->
            <TextBlock Text="{Binding Parent.CompletionHeaderText}"
                       Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                       FontSize="{Binding FontSize}"
                       FontFamily="{Binding FontFamily}"
                       TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PlayAch.TextBlock.BaseStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Parent.IsGameCompleted}" Value="True"/>
                                    <Condition Binding="{Binding Parent.IsFriendUnlock}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Parent.FriendCompletionHeaderText}"
                       Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                       FontSize="{Binding FontSize}"
                       FontFamily="{Binding FontFamily}"
                       TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PlayAch.TextBlock.BaseStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Parent.IsGameCompleted}" Value="True"/>
                                    <Condition Binding="{Binding Parent.IsFriendUnlock}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <!-- Optional unlock datetime -->
            <TextBlock Text="  &#8226;  "
                       Style="{DynamicResource PlayAch.TextBlock.BaseStyle}"
                       Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                       FontSize="{Binding FontSize}"
                       FontFamily="{Binding FontFamily}"
                       Visibility="{Binding ShowDateSeparator, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Text="{Binding Parent.UnlockDateTimeText}"
                       Style="{DynamicResource PlayAch.TextBlock.BaseStyle}"
                       Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                       FontSize="{Binding FontSize}"
                       FontFamily="{Binding FontFamily}"
                       Visibility="{Binding ShowUnlockTime, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ToastTitleLine}">
        <!-- Optional inline rarity badge sits immediately before the name; completion
             notifications force the title, swap it for "Game Complete!", and color it with the
             completed brush. -->
        <DockPanel LastChildFill="True"
                   Margin="0,1,0,0"
                   Effect="{StaticResource PlayAch.Effect.ContentShadow}">
            <Image DockPanel.Dock="Left"
                   helpers:AsyncImage.Uri="{Binding InlineBadgeSource}"
                   helpers:AsyncImage.DecodePixel="64"
                   Width="{Binding InlineBadgeSize}"
                   Height="{Binding InlineBadgeSize}"
                   VerticalAlignment="Center"
                   Margin="0,0,5,0"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="{Binding ShowInlineBadge, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock FontSize="{Binding FontSize}"
                       FontFamily="{Binding FontFamily}"
                       FontWeight="SemiBold"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PlayAch.TextBlock.BaseStyle}">
                        <Setter Property="Text" Value="{Binding Parent.TitleText}"/>
                        <Setter Property="Foreground" Value="{Binding TitleBrush}"/>
                        <Setter Property="Visibility" Value="{Binding ShowName, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Parent.IsGameCompleted}" Value="True">
                                <Setter Property="Text" Value="{DynamicResource LOCPlayAch_Toast_GameComplete}"/>
                                <!-- CompletedTitleBrush honors the surface's rarity-colored-name
                                     toggle: completed color when on, plain text when off. -->
                                <Setter Property="Foreground" Value="{Binding CompletedTitleBrush}"/>
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ToastDescriptionLine}">
        <!-- MaxTextHeight clamps to one or two wrapped lines at the row's font size (two when no
             game/category line follows, one when it does); the trailing ellipsis marks overflow. -->
        <TextBlock Text="{Binding Parent.Description}"
                   Style="{DynamicResource PlayAch.TextBlock.BaseStyle}"
                   Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                   FontSize="{Binding FontSize}"
                   FontFamily="{Binding FontFamily}"
                   TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis"
                   MaxHeight="{Binding MaxTextHeight}"
                   Margin="0,2,0,0"
                   Effect="{StaticResource PlayAch.Effect.ContentShadowStrong}"
                   Visibility="{Binding ShowDescription, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ToastGameCategoryLine}">
        <!-- "game name • category" as one bounded, left-aligned string: the category stays
             adjacent to the game name and the pair trims together with a trailing ellipsis
             rather than overflowing into the provider-icon column. -->
        <TextBlock Text="{Binding GameCategoryText}"
                   Style="{DynamicResource PlayAch.TextBlock.BaseStyle}"
                   Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                   FontSize="{Binding FontSize}"
                   FontFamily="{Binding FontFamily}"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,2,0,0"
                   Effect="{StaticResource PlayAch.Effect.ContentShadowStrong}"
                   Visibility="{Binding HasGameCategoryContent, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    </DataTemplate>

    <DataTemplate x:Key="PlayAch.Template.AchievementToast"
                  DataType="{x:Type vm:AchievementToastViewModel}">
        <Border Width="{Binding ToastCardWidth}"
                Height="{Binding ToastCardHeight}"
                MinHeight="64"
                Margin="14"
                CornerRadius="8"
                BorderBrush="{DynamicResource PlayAch.Brush.PopupBorder}"
                helpers:RarityGlowPulse.Target="Effect">
            <!-- Default is a neutral drop shadow; the border-glow option swaps it for a
                 rarity-colored glow. Effect is set via Style (not a local value) so the
                 trigger can override it. Background and BorderThickness also live in the Style
                 (not as local values) so the HasToastBackground trigger can drop the opaque card
                 surface: with a user background image the surface goes transparent and the image's
                 own (possibly rounded/transparent) alpha defines the shape, so the drop shadow /
                 border glow wraps the image instead of a solid card rectangle. -->
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.PopupSurface}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="12"
                                              ShadowDepth="3"
                                              Direction="300"
                                              Opacity="0.5"
                                              Color="#000000"/>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <!-- A user background image defines the card shape: drop the opaque
                             surface + border so the image's alpha shows and the glow wraps it. -->
                        <DataTrigger Binding="{Binding HasToastBackground}" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasBorderGlow}" Value="True">
                            <Setter Property="Effect" Value="{Binding BorderGlowEffect}"/>
                        </DataTrigger>
                        <!-- Fade the outer border glow in and out when AnimateRarityGlows is on. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasBorderGlow}" Value="True"/>
                                <Condition Binding="{Binding AnimateRarityGlows}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="helpers:RarityGlowPulse.IsActive" Value="True"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <!-- Optional user background image behind the whole card. The corner radius is a
                     max-rounding upper bound: an opaque rectangular image gets the card's rounded
                     corners, while an image with its own more-rounded/transparent corners passes
                     through unchanged (its alpha is more restrictive than the clip). With the card
                     surface transparent (see the outer Border trigger), the outer drop shadow /
                     glow then renders from this image's alpha, wrapping its real shape. The
                     explicit DecodePixel matters because ImageBrush is a Freezable with no size
                     AsyncImage could infer. Animated GIF backgrounds play (GifAnimationHelper
                     animates ImageBrush.ImageSource). -->
                <Border CornerRadius="8"
                        Visibility="{Binding HasToastBackground, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Background>
                        <ImageBrush Stretch="UniformToFill"
                                    helpers:AsyncImage.Uri="{Binding ToastBackgroundImagePath}"
                                    helpers:AsyncImage.DecodePixel="512"/>
                    </Border.Background>
                </Border>

                <!-- User left/right card padding insets the content; the background image above
                     stays full-bleed (it is a sibling outside this Border). -->
                <Border Padding="{Binding ToastContentPadding}">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Row 1 hosts the countdown bar, spanning all three columns so it runs the full
                     card width (including under the provider-icon column) instead of being clipped
                     to the content column. -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Rarity accent strip (capstone color takes precedence over rarity). Completion
                     notifications restyle here, in the template: base values live in Setters so
                     the IsGameCompleted trigger can override them. -->
                <Border Grid.Column="0"
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Width="4"
                        CornerRadius="8,0,0,8"
                        Visibility="{Binding ShowAccentStrip, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{Binding AccentBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGameCompleted}" Value="True">
                                    <Setter Property="Background" Value="{Binding CompletedBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- Right column: the provider icon, or (when the rarity badge is placed on the
                     right) a larger badge with an optional percent under it that stands in for the
                     provider icon. The two are mutually exclusive by their visibility gates; the
                     shared content shadow sits on the container. -->
                <Grid Grid.Column="2"
                      Grid.Row="0"
                      Margin="2,0,10,0"
                      VerticalAlignment="Center"
                      Effect="{StaticResource PlayAch.Effect.ContentShadow}">
                    <Image Width="{Binding ToastProviderIconSize}"
                           Height="{Binding ToastProviderIconSize}"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding ShowProviderIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Image.Source>
                            <MultiBinding Converter="{StaticResource ProviderIconConverter}">
                                <Binding Path="ProviderIconKey"/>
                                <Binding Path="ProviderColorHex"/>
                            </MultiBinding>
                        </Image.Source>
                    </Image>
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding ShowRightBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <!-- Center the badge (not the badge+percent group): top spacer = the
                             percent's height balances the percent hanging below. -->
                        <Border Height="{Binding ActualHeight, ElementName=ToastRightPercent}"
                                IsHitTestVisible="False"/>
                        <!-- Reuses the shared badge source, so animated GIF badges animate. -->
                        <Image helpers:AsyncImage.Uri="{Binding ToastBadgeSource}"
                               helpers:AsyncImage.DecodePixel="96"
                               Width="{Binding ToastRightBadgeSize}"
                               Height="{Binding ToastRightBadgeSize}"
                               HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="ToastRightPercent"
                                   Text="{Binding PercentText}"
                                   Style="{DynamicResource PlayAch.TextBlock.BaseStyle}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                   FontSize="{Binding ToastHeaderFontSize}"
                                   FontFamily="{Binding ToastFontFamily}"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding ShowRightPercent, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>

                <!-- Symmetric top/bottom inset so the icon and text center truly on the row
                     (an asymmetric inset biased the content downward). -->
                <Grid Grid.Column="1" Grid.Row="0" Margin="14,8,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                <!-- Left: centered icon (no box) with rarity glow, badge + percent centered below -->
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="0,0,13,0">
                    <!-- Center the icon (not the icon+extras group) on the row: a top spacer equal
                         to the extras' height balances the badge/percent hanging below, so the icon
                         itself lands on the row's vertical center alongside the text. -->
                    <Border Height="{Binding ActualHeight, ElementName=ToastIconExtras}"
                            IsHitTestVisible="False"/>
                    <Grid Width="{Binding ToastIconSize}"
                          Height="{Binding ToastIconSize}"
                          HorizontalAlignment="Center">
                        <!-- Completion notifications swap the achievement icon for the
                             completed-game badge and the completed glow. Glow lives on a cached
                             backing layer so the front icon stays sharp and only the glow pulses. -->
                        <Image Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               helpers:AsyncImage.DecodePixel="160"
                               IsHitTestVisible="False"
                               CacheMode="BitmapCache">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="helpers:AsyncImage.Uri" Value="{Binding IconPath}"/>
                                    <Setter Property="Effect" Value="{Binding RarityGlowEffect}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGameCompleted}" Value="True">
                                            <Setter Property="helpers:AsyncImage.Uri" Value="{Binding ToastCompletedBadgeSource}"/>
                                            <Setter Property="Effect" Value="{Binding CompletedGlowEffect}"/>
                                        </DataTrigger>
                                        <!-- Fade in/out pulse when AnimateRarityGlows is on. -->
                                        <DataTrigger Binding="{Binding AnimateRarityGlows}" Value="True">
                                            <Setter Property="helpers:RarityGlowPulse.IsActive" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <!-- Front icon: crisp, no glow. -->
                        <Image Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               helpers:AsyncImage.DecodePixel="160">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="helpers:AsyncImage.Uri" Value="{Binding IconPath}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGameCompleted}" Value="True">
                                            <Setter Property="helpers:AsyncImage.Uri" Value="{Binding ToastCompletedBadgeSource}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <!-- Hardcore RetroAchievements unlocks: crisp rarity border instead of glow. -->
                        <Border Margin="-2"
                                BorderThickness="2"
                                Background="Transparent"
                                BorderBrush="{Binding IconBorderBrush}"
                                Visibility="{Binding ShowShineBorder, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>

                    <StackPanel x:Name="ToastIconExtras"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,4,0,0"
                                Effect="{StaticResource PlayAch.Effect.ContentShadow}">
                        <!-- User badge images replace the drawn badge; a string source keeps
                             animated GIF badges animating. -->
                        <Image helpers:AsyncImage.Uri="{Binding ToastBadgeSource}"
                               helpers:AsyncImage.DecodePixel="64"
                               Width="{Binding ToastBadgeSize}"
                               Height="{Binding ToastBadgeSize}"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding ShowBadge, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding PercentText}"
                                   Style="{DynamicResource PlayAch.TextBlock.BaseStyle}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                   FontSize="{Binding ToastHeaderFontSize}"
                                   FontFamily="{Binding ToastFontFamily}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"
                                   Visibility="{Binding ShowPercent, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: the reorderable text lines (header, name, description,
                     game/category), rendered via the shared line templates in the user's
                     order. -->
                <ItemsControl Grid.Column="1"
                              VerticalAlignment="Center"
                              IsTabStop="False"
                              ClipToBounds="True"
                              ItemsSource="{Binding ToastLines}">
                    <ItemsControl.ItemContainerStyle>
                        <!-- Per-line left indent for the name-line offset (see LeftIndent). -->
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="{Binding LeftIndentMargin}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
                </Grid>

                <!-- Countdown bar: depletes over the toast's display duration. Spans all three
                     columns (Grid.ColumnSpan=3) so it runs the full card width, across the
                     provider-icon column, instead of being clipped to the content column. The
                     service runs PlayAch.Storyboard.ToastCountdown against this ScaleX; the
                     transform is reassigned in code before animating (a frozen template transform
                     can't be animated), so this inline transform is a design-time/no-op placeholder. -->
                <Border Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        x:Name="PART_ToastCountdown"
                        Height="3"
                        Margin="8,8,8,8"
                        CornerRadius="2"
                        HorizontalAlignment="Stretch"
                        Background="{Binding CountdownBarBrush}"
                        Visibility="{Binding ShowCountdownBar, Converter={StaticResource BooleanToVisibilityConverter}}"
                        RenderTransformOrigin="0,0">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1"
                                        ScaleY="1"/>
                    </Border.RenderTransform>
                </Border>
                </Grid>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>

    <!--
        Default screenshot frame. Composited onto framed unlock screenshots by
        ScreenshotFrameCompositor; never shown on screen. Themes override this by defining
        PlayAch.Template.ScreenshotFrame in a merged dictionary or in
        PlayniteAchievements/ScreenshotFrame.xaml inside the theme directory.

        Sizing contract: the template is laid out on a virtual canvas 1080 DIPs tall (width =
        1080 x screenshot aspect ratio) and rendered at the screenshot's exact pixel size, so
        fixed margins/font sizes look identical at 1080p and 4K.

        Images must load synchronously: use plain Image Source bindings, NOT
        helpers:AsyncImage.Uri (async-loaded images render blank in the offscreen
        RenderTargetBitmap pass). Text is drawn over a fixed dark bar, so light literal
        foregrounds are used deliberately instead of theme text brushes.
    -->
    <DataTemplate x:Key="PlayAch.Template.ScreenshotFrame"
                  DataType="{x:Type vm:AchievementToastViewModel}">
        <Grid>
            <!-- Frame chrome: a circular black vignette around the whole shot; no border lines
                 and no banner card. Relative radial gradients stretch to the bounds, so the radii
                 undo the 16:9 aspect (radius = half-diagonal: 0.57 of width, 1.02 of height) and
                 the fade stays a circle through the corners instead of an edge-hugging ellipse. -->
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.5"
                                         GradientOrigin="0.5,0.5"
                                         RadiusX="0.57"
                                         RadiusY="1.02">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="0.38"/>
                        <GradientStop Color="#73000000" Offset="0.72"/>
                        <GradientStop Color="#F2000000" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Bottom contrast wash so the floating content reads over any game footage; the
                 circular vignette is lightest at the bottom-center, so this carries the text. -->
            <Rectangle VerticalAlignment="Bottom"
                       Height="280"
                       IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#D0000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Bottom content floats directly over the vignette; the wash above supplies the
                 contrast behind it. Binds the FrameShow*/Frame* properties (its own settings),
                 not the toast's Show* toggles. -->
            <Grid VerticalAlignment="Bottom"
                  Margin="36,0,36,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon column: icon with rarity glow, badge + percent centered below -->
                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">
                        <Grid Width="{Binding FrameIconSize}"
                              Height="{Binding FrameIconSize}"
                              HorizontalAlignment="Center">
                            <!-- Completion notifications swap the achievement icon for the
                                 completed-game badge and the completed glow (all sync-loaded, as
                                 offscreen rendering requires). -->
                            <Image Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Source" Value="{Binding IconPath}"/>
                                        <Setter Property="Effect" Value="{Binding FrameRarityGlowEffect}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGameCompleted}" Value="True">
                                                <Setter Property="Source" Value="{Binding FrameCompletedBadgeImage}"/>
                                                <Setter Property="Effect" Value="{Binding FrameCompletedGlowEffect}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <Border Margin="-3"
                                    BorderThickness="3"
                                    Background="Transparent"
                                    BorderBrush="{Binding IconBorderBrush}"
                                    Visibility="{Binding FrameShowShineBorder, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,6,0,0"
                                    Effect="{StaticResource PlayAch.Effect.ContentShadow}">
                            <!-- Sync-loaded custom badge image (offscreen render contract);
                                 animated GIF badges contribute their first frame here. -->
                            <Image Source="{Binding FrameBadgeImage}"
                                   Width="{Binding FrameBadgeSize}"
                                   Height="{Binding FrameBadgeSize}"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding FrameShowBadge, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding PercentText}"
                                       Style="{DynamicResource PlayAch.TextBlock.BaseStyle}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                       FontSize="{Binding FrameHeaderFontSize}"
                                       FontFamily="{Binding FrameFontFamily}"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0"
                                       Visibility="{Binding FrameShowPercent, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Text column: the reorderable text lines (header, name, description,
                         game/category), rendered via the shared line templates in the user's
                         order. Frame line descriptors are avatar-free and their images
                         sync-load, honoring the offscreen render contract. -->
                    <ItemsControl Grid.Column="1"
                                  VerticalAlignment="Center"
                                  IsTabStop="False"
                                  ClipToBounds="True"
                                  Margin="26,0,22,0"
                                  ItemsSource="{Binding FrameLines}">
                        <ItemsControl.ItemContainerStyle>
                            <!-- Per-line left indent for the name-line offset (see LeftIndent). -->
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="{Binding LeftIndentMargin}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>

                    <!-- Provider icon column, or (when the rarity badge is placed on the right) a
                         larger badge with an optional percent standing in for the provider icon.
                         The converter and FrameBadgeImage render synchronously offscreen. -->
                    <Grid Grid.Column="2"
                          Margin="0,0,22,0"
                          VerticalAlignment="Center"
                          Effect="{StaticResource PlayAch.Effect.ContentShadow}">
                        <Image Width="{Binding FrameProviderIconSize}"
                               Height="{Binding FrameProviderIconSize}"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding FrameShowProviderIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Image.Source>
                                <MultiBinding Converter="{StaticResource ProviderIconConverter}">
                                    <Binding Path="ProviderIconKey"/>
                                    <Binding Path="ProviderColorHex"/>
                                </MultiBinding>
                            </Image.Source>
                        </Image>
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding FrameShowRightBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Image Source="{Binding FrameBadgeImage}"
                                   Width="{Binding FrameRightBadgeSize}"
                                   Height="{Binding FrameRightBadgeSize}"
                                   HorizontalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding PercentText}"
                                       Style="{DynamicResource PlayAch.TextBlock.BaseStyle}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                       FontSize="{Binding FrameHeaderFontSize}"
                                       FontFamily="{Binding FrameFontFamily}"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0"
                                       Visibility="{Binding FrameShowRightPercent, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Branding: shared screenshots identify the plugin. Product name stays a
                         literal (not localized). The logo is a DrawingImage (LogoResources.xaml),
                         which loads synchronously as offscreen rendering requires. -->
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Effect="{StaticResource PlayAch.Effect.ContentShadow}">
                        <Border Width="1"
                                Margin="0,10,20,10"
                                Background="{DynamicResource PlayAch.Brush.PopupBorder}"/>
                        <Image Source="{StaticResource PlayAch.Image.Logo}"
                               Width="65"
                               Height="65"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Opacity="0.95"/>
                        <StackPanel VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                            <TextBlock Text="Playnite"
                                       Style="{DynamicResource PlayAch.TextBlock.BaseStyle}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Achievements"
                                       Style="{DynamicResource PlayAch.TextBlock.BaseStyle}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
