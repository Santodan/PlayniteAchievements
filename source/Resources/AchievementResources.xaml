<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Plugin umbrella dictionary, merged app-wide by AchievementResourceService and by the
        plugin's views/controls. It aggregates the shared plugin resources; it defines nothing
        itself. Notification resources (toast animations, content shadow, text-line templates) and
        the badges/logo they need live in NotificationResources.xaml; the two notification surface
        DataTemplates live in Resources/DefaultTemplates and merge NotificationResources.xaml so
        the built-in default and the "Export default template" output share one source.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/NotificationResources.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/AchievementGridStyles.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/AchievementCellTemplates.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/AchievementControlStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>