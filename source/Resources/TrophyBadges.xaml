  <!-- Enhanced platinum fill - brighter, more prestigious gradient -->
  <LinearGradientBrush x:Key="FillTrophyPlatinum" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0.00" Color="#0D1B2A"/>
    <GradientStop Offset="0.20" Color="#4CC9F0"/>
    <GradientStop Offset="0.40" Color="#FFFFFF"/>
    <GradientStop Offset="0.50" Color="#E0F7FF"/>
    <GradientStop Offset="0.70" Color="#4361EE"/>
    <GradientStop Offset="1.00" Color="#1B263B"/>
  </LinearGradientBrush>

  <!-- Platinum rim with subtle glow -->
  <SolidColorBrush x:Key="RimTrophyPlatinum" Color="#CCFFFFFF"/>

  <!-- Extra shine overlay for platinum - more intense -->
  <LinearGradientBrush x:Key="PlatinumShineOverlay" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0.00" Color="#00FFFFFF"/>
    <GradientStop Offset="0.30" Color="#33FFFFFF"/>
    <GradientStop Offset="0.45" Color="#88FFFFFF"/>
    <GradientStop Offset="0.50" Color="#AAFFFFFF"/>
    <GradientStop Offset="0.55" Color="#88FFFFFF"/>
    <GradientStop Offset="0.70" Color="#33FFFFFF"/>
    <GradientStop Offset="1.00" Color="#00FFFFFF"/>
  </LinearGradientBrush>

  <!-- Inner glow gradient for platinum prestige effect -->
  <RadialGradientBrush x:Key="PlatinumInnerGlow" Center="0.4,0.35" RadiusX="0.5" RadiusY="0.5">
    <GradientStop Offset="0.0" Color="#55FFFFFF"/>
    <GradientStop Offset="0.5" Color="#22CCFFFF"/>
    <GradientStop Offset="1.0" Color="#00FFFFFF"/>
  </RadialGradientBrush>

  <!-- Unknown-grade trophy, shown in place of a grade badge while the trophy spoiler mask applies.
       Built like the graded trophies (opaque fill, bright rim, shine) rather than as a flat
       silhouette, because a low-contrast placeholder turns to mush at the ~20px the column renders
       at. Neutral slate plus a diagonal hatch and a question mark keep it clearly distinct from
       silver, which is the grade it would otherwise be confused with. -->
  <LinearGradientBrush x:Key="FillTrophyUnknown" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0.00" Color="#2A2F38"/>
    <GradientStop Offset="0.35" Color="#767F8C"/>
    <GradientStop Offset="0.55" Color="#98A2AF"/>
    <GradientStop Offset="1.00" Color="#39404A"/>
  </LinearGradientBrush>

  <SolidColorBrush x:Key="RimTrophyUnknown" Color="#B3E8EDF5"/>

  <!-- The tile carries three parallel lines so the diagonal runs unbroken across tile seams. -->
  <DrawingBrush x:Key="HatchTrophyUnknown"
                TileMode="Tile"
                Viewport="0,0,18,18"
                ViewportUnits="Absolute"
                Stretch="None">
    <DrawingBrush.Drawing>
      <GeometryDrawing>
        <GeometryDrawing.Pen>
          <Pen Brush="#40121620" Thickness="5"/>
        </GeometryDrawing.Pen>
        <GeometryDrawing.Geometry>
          <GeometryGroup>
            <LineGeometry StartPoint="-18,18" EndPoint="18,-18"/>
            <LineGeometry StartPoint="0,18" EndPoint="18,0"/>
            <LineGeometry StartPoint="0,36" EndPoint="36,0"/>
          </GeometryGroup>
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <DrawingImage x:Key="TrophyUnknown">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Geometry="{StaticResource GeoTrophy}" Brush="{StaticResource FillTrophyUnknown}">
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource RimTrophyUnknown}" Thickness="3" LineJoin="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="{StaticResource GeoTrophy}" Brush="{StaticResource HatchTrophyUnknown}"/>
        <GeometryDrawing Geometry="{StaticResource GeoTrophy}" Brush="{StaticResource ShineOverlay}"/>
        <!-- Question mark last, so the shine does not wash it out. The outline is the real Segoe UI
             Bold glyph converted to a path, so the mark has a typographic question mark's shape
             rather than a hand-drawn arc. The dark pass behind it widens the glyph slightly, which
             keeps it legible over the hatch. -->
        <GeometryDrawing Geometry="{StaticResource GeoQuestionMark}" Brush="#B3141922">
          <GeometryDrawing.Pen>
            <Pen Brush="#B3141922" Thickness="5" LineJoin="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="{StaticResource GeoQuestionMark}" Brush="#FAFCFFFF"/>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Bronze Trophy -->
  <DrawingImage x:Key="TrophyBronze">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Geometry="{StaticResource GeoTrophy}" Brush="{StaticResource FillBronze}">
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource RimBronze}" Thickness="3" LineJoin="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <!-- Shine overlay -->
        <GeometryDrawing Geometry="{StaticResource GeoTrophy}" Brush="{StaticResource ShineOverlay}"/>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Silver Trophy -->
  <DrawingImage x:Key="TrophySilver">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Geometry="{StaticResource GeoTrophy}" Brush="{StaticResource FillSilver}">
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource RimSilver}" Thickness="3" LineJoin="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="{StaticResource GeoTrophy}" Brush="{StaticResource ShineOverlay}"/>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Gold Trophy -->
  <DrawingImage x:Key="TrophyGold">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Geometry="{StaticResource GeoTrophy}" Brush="{StaticResource FillGold}">
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource RimGold}" Thickness="3" LineJoin="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="{StaticResource GeoTrophy}" Brush="{StaticResource ShineOverlay}"/>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Platinum Trophy - Enhanced PSN-inspired design with sparkles -->
  <DrawingImage x:Key="TrophyPlatinum">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <!-- Base trophy shape with enhanced platinum fill -->
        <GeometryDrawing Geometry="{StaticResource GeoTrophy}" Brush="{StaticResource FillTrophyPlatinum}">
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource RimTrophyPlatinum}" Thickness="3" LineJoin="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>

        <!-- Inner glow for depth -->
        <GeometryDrawing Geometry="{StaticResource GeoTrophy}" Brush="{StaticResource PlatinumInnerGlow}"/>

        <!-- Intense shine overlay -->
        <GeometryDrawing Geometry="{StaticResource GeoTrophy}" Brush="{StaticResource PlatinumShineOverlay}"/>

        <!-- Sparkle effects for prestige -->
        <GeometryDrawing Geometry="{StaticResource GeoTrophySparkle1}" Brush="#DDFFFFFF"/>
        <GeometryDrawing Geometry="{StaticResource GeoTrophySparkle2}" Brush="#BBFFFFFF"/>
        <GeometryDrawing Geometry="{StaticResource GeoTrophySparkle3}" Brush="#AAFFFFFF"/>
        <GeometryDrawing Geometry="{StaticResource GeoTrophySparkle4}" Brush="#99FFFFFF"/>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

</ResourceDictionary>
