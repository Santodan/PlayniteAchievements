<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:PlayniteAchievements.Models.Achievements"
                    xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
                    xmlns:converters="clr-namespace:PlayniteAchievements.Views.Converters"
                    xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- =======================
         CONTROL STYLES
         ======================= -->

    <!-- Search TextBox Style -->
    <Style x:Key="SearchTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource PlayAch.TextBox.BaseStyle}">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.Input.Background}"/>
    </Style>

    <Style x:Key="ClearableSearchTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource SearchTextBoxStyle}">
        <Setter Property="Padding" Value="7,2,30,2"/>
    </Style>

    <!-- Progress bar style -->
    <Style x:Key="GameProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="18"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.Progress.Track}"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Progress.Fill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.Progress.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <Grid Margin="1">
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="1"/>
                            <!-- The fill paints at full track width inside a clipped indicator so
                                 gradient fills (tier shine, completed gradient) keep a fixed
                                 position on the track instead of compressing with the bar value. -->
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    CornerRadius="1"
                                    ClipToBounds="True">
                                <Border Background="{TemplateBinding Foreground}"
                                        Width="{Binding ActualWidth, ElementName=PART_Track}"
                                        HorizontalAlignment="Left"
                                        CornerRadius="1"/>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Time range button style: the chip chrome now lives in CommonResources as
         PlayAch.TimeRangeChip.Style (shared with the TimeWindowPicker); this key is kept for hosts
         that still declare their own range strip. -->
    <Style x:Key="TimeRangeButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource PlayAch.TimeRangeChip.Style}"/>

    <!-- Inline clear button for search boxes -->
    <Style x:Key="ClearSearchButtonStyle" TargetType="Button">
        <Setter Property="Content" Value="✕"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Panel.ZIndex" Value="2"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.Button.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Opacity" Value="0.72"/>
        <Setter Property="ToolTip" Value="{DynamicResource LOCPlayAch_Common_Clear}"/>
        <Setter Property="Visibility" Value="Visible"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PlayAch.Brush.Button.Background.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Accent}"/>
                            <Setter Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PlayAch.Brush.Button.Background.Pressed}"/>
                            <Setter Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PlayAch.Brush.Button.Background.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
                            <Setter Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The clear button pinned to a thumbnail's corner. It sits over arbitrary art, so unlike
         the search box's it is opaque and outlined at rest; hover and focus keep the shared
         cues. The Tag rule that hides it is inherited, but slots set Visibility themselves. -->
    <Style x:Key="PlayAch.ThumbnailClearButton.Style" TargetType="Button" BasedOn="{StaticResource ClearSearchButtonStyle}">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True"/>
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PlayAch.Brush.Button.Background.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Accent}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PlayAch.Brush.Button.Background.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PlayAch.Brush.Button.Background.Hover}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A file slot's preview with helpers:FilePickTarget.IsEnabled: a click focuses it
         for Ctrl+V, so focus shows on the border. Slot styles add size and
         background with BasedOn; the triggers here still win over their setters. -->
    <Style x:Key="PlayAch.FilePickTarget.Style" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- =======================
         COMPACT ACHIEVEMENT TILE
         ======================= -->

    <!-- AchievementCompactItemControl's styles and tooltip. Declared inside the control, every
         tile parsed its own copy of each; here one copy serves every tile. The tooltip body is a
         template, built only when a tooltip opens. -->
    <converters:WholePercentToTextConverter x:Key="PlayAch.CompactItem.WholePercentToText"/>

    <DataTemplate x:Key="PlayAch.CompactItem.ToolTipTemplate">
        <StackPanel>
            <!-- Title with hidden indicator -->
            <TextBlock FontWeight="SemiBold"
                       TextWrapping="Wrap">
                <Run Text="{Binding DisplayNameResolved, Mode=OneWay}"/>
                <Run Text="{Binding HiddenTitleSuffix, Mode=OneWay}"
                     FontStyle="Italic"
                     FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                     Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"/>
            </TextBlock>

            <!-- Description -->
            <TextBlock Text="{Binding DescriptionResolved, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Margin="{StaticResource PlayAch.Thickness.Top.Xs}"
                       Opacity="{StaticResource PlayAch.Opacity.Secondary}"/>

            <!-- Game name (if available) -->
            <TextBlock Text="{Binding GameName, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Margin="{StaticResource PlayAch.Thickness.Top.Xs}"
                       FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                       Opacity="{StaticResource PlayAch.Opacity.Muted}"/>

            <!-- Unlock date -->
            <TextBlock Text="{Binding UnlockTimeText, Mode=OneWay}"
                       Margin="{StaticResource PlayAch.Thickness.Top.Xs}"
                       FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                       Opacity="{StaticResource PlayAch.Opacity.Muted}"
                       Visibility="{Binding Unlocked, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Rarity info (only when percentage data is available) -->
            <StackPanel Orientation="Horizontal" Margin="{StaticResource PlayAch.Thickness.Top.Xs}"
                        Visibility="{Binding HasRarityPercent, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding RarityDetailText, Mode=OneWay}"
                           FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                           Opacity="{StaticResource PlayAch.Opacity.Subtle}"/>
            </StackPanel>

            <!-- Progress info (for partial progress achievements) -->
            <StackPanel Orientation="Horizontal" Margin="{StaticResource PlayAch.Thickness.Top.Xs}"
                        Visibility="{Binding HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ProgressText, Mode=OneWay}"
                           FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                           Opacity="{StaticResource PlayAch.Opacity.Subtle}"/>
                <TextBlock Text=" ("
                           FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                           Opacity="{StaticResource PlayAch.Opacity.Placeholder}"/>
                <TextBlock Text="{Binding ProgressPercent, Mode=OneWay, Converter={StaticResource PlayAch.CompactItem.WholePercentToText}}"
                           FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                           Opacity="{StaticResource PlayAch.Opacity.Subtle}"/>
                <TextBlock Text=")"
                           FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                           Opacity="{StaticResource PlayAch.Opacity.Placeholder}"/>
            </StackPanel>

            <!-- Click to reveal hint for hidden achievements -->
            <TextBlock Text="{DynamicResource LOCPlayAch_Achievements_ClickToReveal}"
                       Margin="{StaticResource PlayAch.Thickness.Top.Xs}"
                       FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                       FontStyle="Italic"
                       Opacity="{StaticResource PlayAch.Opacity.Placeholder}"
                       Visibility="{Binding CanReveal, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
    </DataTemplate>

    <!-- Rays glow style: arrows riding the icon's own silhouette, replacing the soft halo. -->
    <Style x:Key="PlayAch.CompactItem.RayBurst" TargetType="controls:RarityRayBurst">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RarityGlowEligible, RelativeSource={RelativeSource AncestorType=controls:AchievementCompactItemControl}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RarityGlowEligible, RelativeSource={RelativeSource AncestorType=controls:AchievementCompactItemControl}}" Value="True"/>
                    <Condition Binding="{Binding AnimateRarityGlows, RelativeSource={RelativeSource AncestorType=controls:AchievementCompactItemControl}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="IsActive" Value="True"/>
            </MultiDataTrigger>
            <!-- Hardcore achievements use a solid border instead of any glow, unless
                 the user has turned that border off. -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsHardcore}" Value="True"/>
                    <Condition Binding="{Binding ShowHardcoreBorder, RelativeSource={RelativeSource AncestorType=controls:AchievementCompactItemControl}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="IsActive" Value="False"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The soft halo: a blurred copy of the icon on a cached layer, so the front icon stays sharp. -->
    <Style x:Key="PlayAch.CompactItem.SoftGlow" TargetType="Border">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Effect" Value="{x:Null}"/>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RarityGlowEligible, RelativeSource={RelativeSource AncestorType=controls:AchievementCompactItemControl}}" Value="True"/>
                    <Condition Binding="{Binding UseLargeRarityGlow, RelativeSource={RelativeSource AncestorType=controls:AchievementCompactItemControl}}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible"/>
                <!-- Multi-bound so the glow follows the per-tier selection and
                     re-evaluates when that selection changes. -->
                <Setter Property="Effect">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource RarityGlowForTiers}" ConverterParameter="8">
                            <Binding Path="Rarity"/>
                            <Binding Path="SoftGlowTiers" RelativeSource="{RelativeSource AncestorType=controls:AchievementCompactItemControl}"/>
                            <Binding Path="HasRarityPercent"/>
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RarityGlowEligible, RelativeSource={RelativeSource AncestorType=controls:AchievementCompactItemControl}}" Value="True"/>
                    <Condition Binding="{Binding UseLargeRarityGlow, RelativeSource={RelativeSource AncestorType=controls:AchievementCompactItemControl}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource RarityGlowForTiers}" ConverterParameter="20">
                            <Binding Path="Rarity"/>
                            <Binding Path="SoftGlowTiers" RelativeSource="{RelativeSource AncestorType=controls:AchievementCompactItemControl}"/>
                            <Binding Path="HasRarityPercent"/>
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </MultiDataTrigger>
            <!-- Hardcore achievements use a solid border instead of the soft glow. -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RarityGlowEligible, RelativeSource={RelativeSource AncestorType=controls:AchievementCompactItemControl}}" Value="True"/>
                    <Condition Binding="{Binding IsHardcore}" Value="True"/>
                    <Condition Binding="{Binding ShowHardcoreBorder, RelativeSource={RelativeSource AncestorType=controls:AchievementCompactItemControl}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="Effect" Value="{x:Null}"/>
            </MultiDataTrigger>
            <!-- Fade in/out pulse on the cached glow layer when AnimateRarityGlows is on. -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RarityGlowEligible, RelativeSource={RelativeSource AncestorType=controls:AchievementCompactItemControl}}" Value="True"/>
                    <Condition Binding="{Binding AnimateRarityGlows, RelativeSource={RelativeSource AncestorType=controls:AchievementCompactItemControl}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="helpers:RarityGlowPulse.IsActive" Value="True"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Edge that comes with the rays: the same layer as the halo above at a blur small enough
         to read as a line. A blur of the artwork, so it hugs the alpha on any shape. -->
    <Style x:Key="PlayAch.CompactItem.RayEdge" TargetType="Border">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Effect" Value="{x:Null}"/>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RarityGlowEligible, RelativeSource={RelativeSource AncestorType=controls:AchievementCompactItemControl}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource RarityGlowForTiers}" ConverterParameter="3">
                            <Binding Path="Rarity"/>
                            <Binding Path="RayGlowTiers" RelativeSource="{RelativeSource AncestorType=controls:AchievementCompactItemControl}"/>
                            <Binding Path="HasRarityPercent"/>
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </MultiDataTrigger>
            <!-- Hardcore keeps its solid border instead. -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RarityGlowEligible, RelativeSource={RelativeSource AncestorType=controls:AchievementCompactItemControl}}" Value="True"/>
                    <Condition Binding="{Binding IsHardcore}" Value="True"/>
                    <Condition Binding="{Binding ShowHardcoreBorder, RelativeSource={RelativeSource AncestorType=controls:AchievementCompactItemControl}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="Effect" Value="{x:Null}"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Solid rarity border for Hardcore achievements (replaces the glow). -->
    <Style x:Key="PlayAch.CompactItem.HardcoreBorder" TargetType="Border">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RarityGlowEligible, RelativeSource={RelativeSource AncestorType=controls:AchievementCompactItemControl}}" Value="True"/>
                    <Condition Binding="{Binding IsHardcore}" Value="True"/>
                    <Condition Binding="{Binding ShowHardcoreBorder, RelativeSource={RelativeSource AncestorType=controls:AchievementCompactItemControl}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Rarity bar overlay at the bottom: the global unlock percentage. -->
    <Style x:Key="PlayAch.CompactItem.RarityBarHost" TargetType="Grid">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HasRarityPercent}" Value="True"/>
                    <Condition Binding="{Binding RarityBarVisible, RelativeSource={RelativeSource AncestorType=controls:AchievementCompactItemControl}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
