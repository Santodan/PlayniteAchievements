<settings:ProviderSettingsViewBase x:Class="PlayniteAchievements.Providers.BattleNet.BattleNetSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:settings="clr-namespace:PlayniteAchievements.Providers.Settings"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             xmlns:converters="clr-namespace:PlayniteAchievements.Views.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="700">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Providers/ProviderSettingsScopedControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:EnumToBoolConverter x:Key="WowSourceToBool"/>

            <Style x:Key="BattleNetFieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,12,8"/>
            </Style>

            <Style x:Key="BattleNetStatusIconStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource PlayAch.FontFamily.Icon}"/>
                <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Body}"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Text" Value="&#xEF19;"/>
                <Setter Property="Foreground" Value="{StaticResource PlayAch.Brush.AuthError}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">

            <DockPanel Style="{StaticResource ProviderHeaderRowStyle}">
                <StackPanel Style="{StaticResource ProviderEnableTogglePanelStyle}">
                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_ProviderEnabled}" Style="{StaticResource ProviderEnableLabelStyle}"/>
                    <CheckBox IsChecked="{Binding Settings.IsEnabled, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="{DynamicResource LOCPlayAch_Settings_ProviderEnabled}"/>
                </StackPanel>
                <StackPanel Style="{StaticResource ProviderHeaderPanelStyle}">
                    <Viewbox Style="{StaticResource ProviderHeaderIconStyle}">
                        <Path Data="{StaticResource GeoBattleNet}" Fill="{StaticResource PlayAch.Brush.ProviderBattleNet}"/>
                    </Viewbox>
                    <TextBlock Text="{DynamicResource LOCPlayAch_Provider_BattleNet}" Style="{StaticResource ProviderTitleTextStyle}"/>
                </StackPanel>
            </DockPanel>

            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_ProviderDisabledMessage}" Style="{StaticResource ProviderDisabledMessageStyle}"/>

            <Border Style="{StaticResource SectionBorderStyle}" IsEnabled="{Binding Settings.IsEnabled}">
                <StackPanel>
                    <TextBlock x:Name="ConnectionLabel"
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource SectionAccentRuleStyle}"/>

                    <!-- The account's region: sign-in and every WoW lookup use it. -->
                    <StackPanel Margin="{StaticResource PlayAch.Thickness.Bottom.Md}">
                        <TextBlock Text="{DynamicResource LOCPlayAch_Common_Region}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}"/>
                        <ComboBox
                                  x:Name="WowRegionCombo"
                                  SelectionChanged="WowRegion_SelectionChanged"
                                  FontSize="{DynamicResource PlayAch.FontSize.Body}"
                                  Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}"/>
                    </StackPanel>

                    <StackPanel Margin="{StaticResource PlayAch.Thickness.Bottom.Lg}">
                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_BattleNet_OAuthHelp}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}"/>
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   Margin="{StaticResource PlayAch.Thickness.Bottom.Xs}"
                                   helpers:HyperlinkFormatText.Format="{DynamicResource LOCPlayAch_Settings_BattleNet_SetupStep1}"
                                   helpers:HyperlinkFormatText.LinkText="Battle.net Developer Portal"
                                   helpers:HyperlinkFormatText.NavigateUri="https://develop.battle.net/access/clients"/>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_BattleNet_SetupStep2}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   Margin="{StaticResource PlayAch.Thickness.Bottom.Xs}"/>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_BattleNet_SetupStep3}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   Margin="{StaticResource PlayAch.Thickness.Bottom.Xs}"/>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_BattleNet_SetupStep4}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   Margin="{StaticResource PlayAch.Thickness.Bottom.Xs}"/>
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   helpers:HyperlinkFormatText.Format="{DynamicResource LOCPlayAch_Settings_BattleNet_SetupSample}"
                                   helpers:HyperlinkFormatText.LinkText="Blizzard OAuth client sample"
                                   helpers:HyperlinkFormatText.NavigateUri="https://github.com/Blizzard/oauth-client-sample"/>
                    </StackPanel>

                    <Border
                            Style="{StaticResource AuthStatusBorderStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource AuthStatusIconStyle}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding AuthStatus, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="{DynamicResource LOCPlayAch_Button_Login}"
                                        Click="LoginWeb_Click"
                                        Style="{StaticResource AuthActionButtonStyle}"
                                        Margin="{StaticResource PlayAch.Thickness.Right.Sm}"/>
                                <Button Content="{DynamicResource LOCPlayAch_Common_Check}"
                                        Click="Auth_Check_Click"
                                        Style="{StaticResource AuthActionButtonStyle}"
                                        Margin="{StaticResource PlayAch.Thickness.Right.Sm}"/>
                                <Button Content="{DynamicResource LOCPlayAch_Button_SignOut}"
                                        Click="Logout_Click"
                                        Style="{StaticResource AuthActionButtonStyle}"/>
                            </StackPanel>

                            <Border BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                    BorderThickness="0,1,0,0"
                                    Padding="0,12,0,0"
                                    Margin="{StaticResource PlayAch.Thickness.Top.Md}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_BattleNet_ClientId}"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               Margin="{StaticResource PlayAch.Thickness.Bottom.Xs}"/>
                                    <TextBox Text="{Binding Settings.BattleNetClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="{DynamicResource PlayAch.FontSize.Body}"
                                             Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}"/>

                                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_BattleNet_ClientSecret}"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               Margin="{StaticResource PlayAch.Thickness.Bottom.Xs}"/>
                                    <PasswordBox x:Name="WowClientSecretBox"
                                                 PasswordChanged="WowClientSecret_Changed"
                                                 FontSize="{DynamicResource PlayAch.FontSize.Body}"
                                                 Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}"/>

                                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_BattleNet_RedirectUri}"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               Margin="{StaticResource PlayAch.Thickness.Bottom.Xs}"/>
                                    <TextBox Text="{Binding Settings.BattleNetRedirectUri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="{DynamicResource PlayAch.FontSize.Body}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionBorderStyle}" IsEnabled="{Binding Settings.IsEnabled}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_BattleNet_WowSection}"
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource SectionAccentRuleStyle}"/>

                    <Border>

                        <StackPanel>
                            <Grid Margin="{StaticResource PlayAch.Thickness.Bottom.Md}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                                    </TextBlock.RenderTransform>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BattleNetStatusIconStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WowConfigured, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             Value="True">
                                                    <Setter Property="Text" Value="&#xF00E;"/>
                                                    <Setter Property="Foreground" Value="{StaticResource PlayAch.Brush.AuthSuccess}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding WowStatus, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </Grid>

                            <!-- Where WoW achievements come from: every character on the signed-in account, or one typed character per version. -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="{StaticResource PlayAch.Thickness.Bottom.Md}">
                                <RadioButton GroupName="WowCharacterSource"
                                             Content="{DynamicResource LOCPlayAch_Settings_BattleNet_WowSourceAccount}"
                                             IsChecked="{Binding Settings.WowCharacterSource, Mode=TwoWay, Converter={StaticResource WowSourceToBool}, ConverterParameter=Account}"
                                             FontSize="{DynamicResource PlayAch.FontSize.Body}"
                                             Margin="{StaticResource PlayAch.Thickness.Right.Md}"/>
                                <RadioButton GroupName="WowCharacterSource"
                                             Content="{DynamicResource LOCPlayAch_Settings_BattleNet_WowSourceCharacter}"
                                             IsChecked="{Binding Settings.WowCharacterSource, Mode=TwoWay, Converter={StaticResource WowSourceToBool}, ConverterParameter=Character}"
                                             FontSize="{DynamicResource PlayAch.FontSize.Body}"/>
                            </StackPanel>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.WowCharacterSource}" Value="Account">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{DynamicResource LOCPlayAch_Settings_BattleNet_WowAccountCharactersHint}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.WowCharacterSource}" Value="Character">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="{DynamicResource LOCPlayAch_Settings_BattleNet_WowRealm}"
                                               Style="{StaticResource BattleNetFieldLabelStyle}"/>
                                    <ComboBox Grid.Row="0"
                                              Grid.Column="1"
                                              x:Name="WowRealmCombo"
                                              DisplayMemberPath="Name"
                                              SelectionChanged="WowRealm_SelectionChanged"
                                              FontSize="{DynamicResource PlayAch.FontSize.Body}"
                                              Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}"/>

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Text="{DynamicResource LOCPlayAch_Settings_BattleNet_WowCharacter}"
                                               Style="{StaticResource BattleNetFieldLabelStyle}"
                                               Margin="{StaticResource PlayAch.Thickness.Right.Md}"/>
                                    <TextBox Grid.Row="1"
                                             Grid.Column="1"
                                             Text="{Binding Settings.WowCharacter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="{DynamicResource PlayAch.FontSize.Body}"
                                             Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}"/>

                                </Grid>

                                <Grid Margin="{StaticResource PlayAch.Thickness.Top.Md}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.ColumnSpan="2"
                                               Text="{DynamicResource LOCPlayAch_Settings_BattleNet_WowClassicSection}"
                                               FontWeight="SemiBold"
                                               Style="{StaticResource BattleNetFieldLabelStyle}"/>

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Text="{DynamicResource LOCPlayAch_Settings_BattleNet_WowRealm}"
                                               Style="{StaticResource BattleNetFieldLabelStyle}"/>
                                    <ComboBox Grid.Row="1"
                                              Grid.Column="1"
                                              x:Name="WowClassicRealmCombo"
                                              DisplayMemberPath="Name"
                                              SelectionChanged="WowClassicRealm_SelectionChanged"
                                              FontSize="{DynamicResource PlayAch.FontSize.Body}"
                                              Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}"/>

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Text="{DynamicResource LOCPlayAch_Settings_BattleNet_WowCharacter}"
                                               Style="{StaticResource BattleNetFieldLabelStyle}"/>
                                    <TextBox Grid.Row="2"
                                             Grid.Column="1"
                                             Text="{Binding Settings.WowClassicCharacter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="{DynamicResource PlayAch.FontSize.Body}"
                                             Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="{StaticResource PlayAch.Thickness.Top.Md}"
                                Grid.IsSharedSizeScope="True">
                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_BattleNet_UseDataForAzerothForWowRarity}"
                                             Hint="{DynamicResource LOCPlayAch_Settings_BattleNet_UseDataForAzerothForWowRarity_Help}"
                                             FontWeight="SemiBold"
                                             Margin="0">
                            <CheckBox IsChecked="{Binding Settings.UseDataForAzerothForWowRarity, Mode=TwoWay}"/>
                        </controls:SettingRow>
                    </StackPanel>

                    <controls:AuthStatusCard Margin="0,12,0,0"
                                             IsEnabled="{Binding Settings.UseDataForAzerothForWowRarity}"
                                             AuthStatus="{Binding DataForAzerothStatus, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             IsAuthStatusPending="{Binding DataForAzerothPending, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             IsAuthStatusSuccess="{Binding DataForAzerothChecked, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             IsAuthStatusChecking="{Binding DataForAzerothChecking, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             AuthBusy="{Binding AuthBusy, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource LOCPlayAch_Button_Login}"
                                    Click="DataForAzeroth_Login_Click"
                                    Style="{StaticResource AuthActionButtonStyle}"
                                    Margin="{StaticResource PlayAch.Thickness.Right.Sm}"/>
                            <Button Content="{DynamicResource LOCPlayAch_Common_Check}"
                                    Click="DataForAzeroth_Check_Click"
                                    Style="{StaticResource AuthActionButtonStyle}"
                                    Margin="{StaticResource PlayAch.Thickness.Right.Sm}"/>
                            <Button Content="{DynamicResource LOCPlayAch_Button_SignOut}"
                                    Click="DataForAzeroth_Clear_Click"
                                    Style="{StaticResource AuthActionButtonStyle}"/>
                        </StackPanel>
                    </controls:AuthStatusCard>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</settings:ProviderSettingsViewBase>
