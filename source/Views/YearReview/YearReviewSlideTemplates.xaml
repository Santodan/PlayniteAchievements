<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
                    xmlns:settings="clr-namespace:PlayniteAchievements.Models.Settings"
                    xmlns:local="clr-namespace:PlayniteAchievements.Views.YearReview"
                    xmlns:vm="clr-namespace:PlayniteAchievements.ViewModels.YearReview">

    <!-- Every slide is a 1280 x 770 canvas the window scales to fit. Elements are placed by hand
         and tilted, and each enters on its own delay (YearReviewMotion). Text is always added
         after the art it sits near, so it draws on top. Big numbers are Title-size text scaled
         by a Viewbox to a fixed height, in the bundled display face. -->

    <ResourceDictionary.MergedDictionaries>
        <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
        <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/RarityBadges.xaml"/>
        <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/LogoResources.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <FontFamily x:Key="YearReview.DisplayFont">pack://application:,,,/PlayniteAchievements;component/Resources/Fonts/#Big Shoulders Display Black</FontFamily>

    <DropShadowEffect x:Key="YearReview.CardShadow" po:Freeze="True" BlurRadius="28" ShadowDepth="10" Direction="270" Opacity="0.4" Color="#000000"/>

    <Style x:Key="YearReview.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource YearReview.DisplayFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Title}"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <Style x:Key="YearReview.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource PlayAch.FontFamily.Body}"/>
        <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Title}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1.25" ScaleY="1.25"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="YearReview.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource PlayAch.FontFamily.Body}"/>
        <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text.Secondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1.15" ScaleY="1.15"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="YearReview.Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.Panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="20,14"/>
        <Setter Property="Effect" Value="{StaticResource YearReview.CardShadow}"/>
    </Style>

    <!-- The slide's view picker: the current view's name and a chevron, opening the list of views. -->
    <Style x:Key="YearReview.ViewPickerButton" TargetType="Button" BasedOn="{StaticResource PlayAch.Button.BaseStyle}">
        <Setter Property="Margin" Value="24,0,0,0"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Visibility" Value="{Binding HasViews, Converter={StaticResource BoolToVis}}"/>
        <Setter Property="Command" Value="{x:Static local:YearReviewControl.OpenViewPickerCommand}"/>
        <Setter Property="CommandParameter" Value="{Binding RelativeSource={RelativeSource Self}}"/>
        <Setter Property="ToolTip" Value="{DynamicResource LOCPlayAch_Showcase_Variant}"/>
        <Setter Property="AutomationProperties.Name" Value="{DynamicResource LOCPlayAch_Showcase_Variant}"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding CurrentView.Label}"
                                   FontSize="{DynamicResource PlayAch.FontSize.Body}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="&#xEAB2;"
                                   FontFamily="{DynamicResource PlayAch.FontFamily.Icon}"
                                   Foreground="{DynamicResource PlayAch.Brush.Glyph}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Content" Value="{Binding}"/>
    </Style>

    <!-- The list of a slide's views, in the unlock list's popup chrome. -->
    <Style x:Key="YearReview.ViewRowStyle" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <!-- The picked view sits on a faint wash of the theme accent; the hover tint
                         sits over it. -->
                    <Grid>
                        <Border x:Name="Picked"
                                Background="{DynamicResource PlayAch.Brush.Accent}"
                                CornerRadius="{DynamicResource PlayAch.Radius.Layout}"
                                Opacity="0"/>
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="{DynamicResource PlayAch.Radius.Layout}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PlayAch.Brush.Overlay.Tint.08}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Picked" Property="Opacity" Value="0.22"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="YearReview.ViewPickerPopupTemplate">
        <Border Background="{DynamicResource PlayAch.Brush.PopupSurface}"
                BorderBrush="{DynamicResource PlayAch.Brush.PopupBorder}"
                BorderThickness="1"
                CornerRadius="{DynamicResource PlayAch.Radius.Layout}"
                Padding="6"
                MinWidth="200"
                MaxWidth="320">
            <ListBox ItemsSource="{Binding Views}"
                     SelectedItem="{Binding CurrentView, Mode=TwoWay}"
                     FocusVisualStyle="{x:Null}"
                     ItemContainerStyle="{StaticResource YearReview.ViewRowStyle}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     MaxHeight="360"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="{DynamicResource PlayAch.FontSize.Body}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DataTemplate>

    <!-- Places each item of a canvas ItemsControl from its X, Y, Angle and Delay. -->
    <Style x:Key="YearReview.PlacedItem" TargetType="ContentPresenter">
        <Setter Property="Canvas.Left" Value="{Binding X}"/>
        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
        <Setter Property="local:YearReviewMotion.Angle" Value="{Binding Angle}"/>
        <Setter Property="local:YearReviewMotion.Delay" Value="{Binding Delay}"/>
    </Style>

    <ItemsPanelTemplate x:Key="YearReview.CanvasPanel">
        <Canvas/>
    </ItemsPanelTemplate>

    <!-- A game cover card: the art, its name and unlock count on a strip below it, and the rank
         or completion badge pinned to a corner. -->
    <DataTemplate x:Key="YearReview.CoverCard" DataType="{x:Type vm:YearReviewCoverCard}">
        <Grid Width="{Binding Width}" ToolTip="{Binding Name}" local:YearReviewUnlockPopover.Group="{Binding Group}">
            <Border CornerRadius="6"
                    Background="{DynamicResource PlayAch.Brush.PopupSurface}"
                    BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                    BorderThickness="1"
                    Effect="{StaticResource YearReview.CardShadow}">
                <StackPanel>
                    <Grid Height="{Binding Height}" ClipToBounds="True" helpers:RoundedClip.Radius="5">
                        <Image Stretch="UniformToFill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               helpers:AsyncImage.Uri="{Binding CoverPath, Converter={StaticResource DefaultGameImage}, ConverterParameter=cover}"
                               helpers:AsyncImage.DecodePixel="600"/>
                    </Grid>
                    <StackPanel Margin="10,8,10,10"
                                Visibility="{Binding ShowCaption, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   FontSize="{DynamicResource PlayAch.FontSize.Body}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   TextWrapping="Wrap"
                                   MaxHeight="40"
                                   TextTrimming="CharacterEllipsis"/>
                        <Viewbox Height="30"
                                 HorizontalAlignment="Left"
                                 Margin="0,4,0,0"
                                 Visibility="{Binding HasRank, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ValueText}" Style="{StaticResource YearReview.Display}"/>
                        </Viewbox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="-14,-18,0,0"
                    MinWidth="48"
                    Height="56"
                    Padding="10,0"
                    CornerRadius="6"
                    Background="{DynamicResource PlayAch.Brush.Accent}"
                    Visibility="{Binding HasRank, Converter={StaticResource BoolToVis}}">
                <Viewbox Height="44">
                    <TextBlock Text="{Binding Rank}" Style="{StaticResource YearReview.Display}" Foreground="{DynamicResource PlayAch.Brush.PopupSurface}"/>
                </Viewbox>
            </Border>

            <Image Width="46"
                   Height="52"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,-16,-14,0"
                   Effect="{StaticResource BadgeShadow}"
                   local:YearReviewMotion.Reveal="Pop"
                   local:YearReviewMotion.Delay="{Binding BadgeDelay}"
                   Visibility="{Binding ShowBadge, Converter={StaticResource BoolToVis}}">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Source" Value="{DynamicResource BadgeRarityCompleted}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Badge}" Value="{x:Static settings:CompletionBadgeKind.Platinum}">
                                <Setter Property="Source" Value="{DynamicResource TrophyPlatinum}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Badge}" Value="{x:Static settings:CompletionBadgeKind.Mythic}">
                                <Setter Property="Source" Value="{DynamicResource BadgeRarityMythic}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
        </Grid>
    </DataTemplate>

    <!-- The unlocks of a clicked month or day: a header over a capped, virtualized list,
         with the chrome and rows of the Showcase calendar's day popup. -->
    <Style x:Key="YearReview.UnlockRowStyle" TargetType="ListBoxItem">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="{DynamicResource PlayAch.Radius.Layout}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PlayAch.Brush.Overlay.Tint.08}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="YearReview.UnlockListPopupTemplate" DataType="{x:Type vm:YearReviewUnlockGroup}">
        <Border Background="{DynamicResource PlayAch.Brush.PopupSurface}"
                BorderBrush="{DynamicResource PlayAch.Brush.PopupBorder}"
                BorderThickness="1"
                CornerRadius="{DynamicResource PlayAch.Radius.Layout}"
                Padding="8"
                MinWidth="260"
                MaxWidth="380">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding Header, Mode=OneWay}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                           TextWrapping="Wrap"
                           Margin="6,0,6,6"/>
                <ListBox ItemsSource="{Binding Rows, Mode=OneWay}"
                         ItemContainerStyle="{StaticResource YearReview.UnlockRowStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         MaxHeight="320"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:YearReviewUnlockRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Width="28"
                                       Height="28"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center"
                                       SnapsToDevicePixels="True"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       helpers:AsyncImage.Uri="{Binding IconPath, Mode=OneWay}"
                                       helpers:AsyncImage.DecodePixel="64"
                                       helpers:RoundedClip.Radius="{DynamicResource PlayAch.Radius.AchievementIcon}"/>
                                <StackPanel Grid.Column="1"
                                            Margin="8,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"/>
                                    <TextBlock Text="{Binding GameName, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               Opacity="{StaticResource PlayAch.Opacity.Subtle}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding TimeText, Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           Opacity="{StaticResource PlayAch.Opacity.Subtle}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </DataTemplate>

    <!-- Cards that drop in at their spot. -->
    <Style x:Key="YearReview.DroppedCard" TargetType="ContentPresenter" BasedOn="{StaticResource YearReview.PlacedItem}">
        <Setter Property="local:YearReviewMotion.Reveal" Value="Drop"/>
        <Setter Property="local:YearReviewMotion.Hover" Value="True"/>
    </Style>

    <!-- 1. Intro: the year, huge, running off the bottom-left corner over the rays. -->
    <DataTemplate DataType="{x:Type vm:YearReviewIntroSlide}">
        <Canvas Width="1280" Height="770">
            <local:YearReviewSunburst Width="1280" Height="770"
                                      Origin="0.26,0.83"
                                      IsActive="True"
                                      Color="{DynamicResource PlayAch.Brush.Accent}"/>
            <Viewbox Canvas.Left="-18" Canvas.Top="300" Height="560"
                     local:YearReviewMotion.Reveal="Zoom" local:YearReviewMotion.Delay="100">
                <TextBlock Text="{Binding YearText}" Style="{StaticResource YearReview.Display}"/>
            </Viewbox>
            <StackPanel Canvas.Right="80" Canvas.Top="96"
                        local:YearReviewMotion.Reveal="Rise" local:YearReviewMotion.Delay="600">
                <TextBlock Text="{DynamicResource LOCPlayAch_YearReview_Title}" Style="{StaticResource YearReview.Title}" HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding RangeText}" Style="{StaticResource YearReview.Label}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock Canvas.Right="80" Canvas.Top="180"
                       Text="{DynamicResource LOCPlayAch_YearReview_ClickToStart}"
                       Style="{StaticResource YearReview.Label}"
                       local:YearReviewMotion.Reveal="Rise" local:YearReviewMotion.Delay="1100"/>
        </Canvas>
    </DataTemplate>

    <!-- 2. Achievements unlocked: one tilted figure, with three cards dropped beside it. -->
    <DataTemplate DataType="{x:Type vm:YearReviewNumbersSlide}">
        <Canvas Width="1280" Height="770">
            <TextBlock Canvas.Left="84" Canvas.Top="88"
                       Text="{DynamicResource LOCPlayAch_YearReview_AchievementsUnlocked}"
                       Style="{StaticResource YearReview.Label}"
                       local:YearReviewMotion.Reveal="Rise"/>
            <Viewbox Canvas.Left="56" Canvas.Top="150" Height="300"
                     local:YearReviewUnlockPopover.Group="{Binding AllGroup}"
                     local:YearReviewMotion.Reveal="Rise" local:YearReviewMotion.Delay="80" local:YearReviewMotion.Angle="-4">
                <local:CountUpText Value="{Binding Unlocked}" Style="{StaticResource YearReview.Display}" local:YearReviewMotion.Delay="230"/>
            </Viewbox>

            <ItemsControl Width="1280" Height="770" ItemsSource="{Binding Icons}"
                          ItemsPanel="{StaticResource YearReview.CanvasPanel}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter" BasedOn="{StaticResource YearReview.PlacedItem}">
                        <Setter Property="local:YearReviewMotion.Reveal" Value="Pop"/>
                        <Setter Property="local:YearReviewMotion.Hover" Value="True"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:YearReviewIcon}">
                        <Image Width="{Binding Size}" Height="{Binding Size}" Stretch="Uniform"
                               ToolTip="{Binding ToolTip}"
                               local:YearReviewUnlockPopover.Group="{Binding Group}"
                               helpers:RoundedClip.Radius="{DynamicResource PlayAch.Radius.AchievementIcon}"
                               helpers:AsyncImage.Uri="{Binding IconPath}"
                               helpers:AsyncImage.DecodePixel="256"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Canvas.Right="96" Canvas.Top="70" Style="{StaticResource YearReview.Chip}"
                    local:YearReviewMotion.Reveal="Drop" local:YearReviewMotion.Delay="850" local:YearReviewMotion.Angle="4">
                <StackPanel>
                    <Viewbox Height="60" HorizontalAlignment="Left">
                        <local:CountUpText Value="{Binding CollectionGained}" Prefix="+" Style="{StaticResource YearReview.Display}" local:YearReviewMotion.Delay="1000"/>
                    </Viewbox>
                    <TextBlock Text="{DynamicResource LOCPlayAch_Score_Collection}" Style="{StaticResource YearReview.Label}"/>
                </StackPanel>
            </Border>

            <Border Canvas.Right="330" Canvas.Top="200" Style="{StaticResource YearReview.Chip}"
                    local:YearReviewMotion.Reveal="Drop" local:YearReviewMotion.Delay="1000" local:YearReviewMotion.Angle="-3">
                <StackPanel>
                    <Viewbox Height="60" HorizontalAlignment="Left">
                        <local:CountUpText Value="{Binding PrestigeGained}" Prefix="+" Style="{StaticResource YearReview.Display}" local:YearReviewMotion.Delay="1150"/>
                    </Viewbox>
                    <TextBlock Text="{DynamicResource LOCPlayAch_Score_Prestige}" Style="{StaticResource YearReview.Label}"/>
                </StackPanel>
            </Border>

            <Border Canvas.Right="110" Canvas.Top="330" Style="{StaticResource YearReview.Chip}"
                    Background="{DynamicResource PlayAch.Brush.Accent}" BorderBrush="{DynamicResource PlayAch.Brush.Accent}"
                    local:YearReviewMotion.Reveal="Drop" local:YearReviewMotion.Delay="1150" local:YearReviewMotion.Angle="-2">
                <StackPanel>
                    <Viewbox Height="60" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding LevelText}" Style="{StaticResource YearReview.Display}" Foreground="{DynamicResource PlayAch.Brush.PopupSurface}"/>
                    </Viewbox>
                    <TextBlock Text="{DynamicResource LOCPlayAch_Column_CollectionLevel}" Style="{StaticResource YearReview.Label}" Foreground="{DynamicResource PlayAch.Brush.PopupSurface}"/>
                </StackPanel>
            </Border>

            <Border Canvas.Right="380" Canvas.Top="455" Style="{StaticResource YearReview.Chip}"
                    Background="{DynamicResource PlayAch.Brush.Accent}" BorderBrush="{DynamicResource PlayAch.Brush.Accent}"
                    local:YearReviewMotion.Reveal="Drop" local:YearReviewMotion.Delay="1250" local:YearReviewMotion.Angle="3">
                <StackPanel>
                    <Viewbox Height="60" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding PrestigeLevelText}" Style="{StaticResource YearReview.Display}" Foreground="{DynamicResource PlayAch.Brush.PopupSurface}"/>
                    </Viewbox>
                    <TextBlock Text="{DynamicResource LOCPlayAch_Column_PrestigeLevel}" Style="{StaticResource YearReview.Label}" Foreground="{DynamicResource PlayAch.Brush.PopupSurface}"/>
                </StackPanel>
            </Border>

            <Border Canvas.Right="110" Canvas.Top="590" Style="{StaticResource YearReview.Chip}"
                    local:YearReviewMotion.Reveal="Drop" local:YearReviewMotion.Delay="1400" local:YearReviewMotion.Angle="6">
                <StackPanel>
                    <Viewbox Height="60" HorizontalAlignment="Left">
                        <local:CountUpText Value="{Binding Games}" Style="{StaticResource YearReview.Display}" local:YearReviewMotion.Delay="1450"/>
                    </Viewbox>
                    <TextBlock Text="{DynamicResource LOCPlayAch_YearReview_GamesWithUnlocks}" Style="{StaticResource YearReview.Label}"/>
                </StackPanel>
            </Border>
        </Canvas>
    </DataTemplate>

    <!-- 3. Unlocks by month: bars along the bottom edge, the year as a tilted strip, the streak as a stamp. -->
    <DataTemplate DataType="{x:Type vm:YearReviewMonthsSlide}">
        <Canvas Width="1280" Height="770">
            <ItemsControl Canvas.Left="0" Canvas.Bottom="0" Width="1280" Height="560" ItemsSource="{Binding CurrentView.Months}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:YearReviewMonthBar}">
                        <StackPanel VerticalAlignment="Bottom" Margin="2,0">
                            <Viewbox Height="70" Margin="0,0,0,8"
                                     local:YearReviewMotion.Reveal="Pop" local:YearReviewMotion.Delay="1000"
                                     Visibility="{Binding IsPeak, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Unlocks, StringFormat={}{0:N0}}" Style="{StaticResource YearReview.Display}"/>
                            </Viewbox>
                            <Border Height="{Binding Height}"
                                    ToolTip="{Binding ToolTip}"
                                    local:YearReviewUnlockPopover.Group="{Binding Group}"
                                    local:YearReviewBarHighlight.IsBar="True"
                                    local:YearReviewMotion.Reveal="Grow"
                                    local:YearReviewMotion.Delay="{Binding Delay}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.Border}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPeak}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="{Binding Label}"
                                       Style="{StaticResource YearReview.Label}"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,4"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Canvas.Right="80" Canvas.Top="84"
                        local:YearReviewMotion.Reveal="Rise" local:YearReviewMotion.Delay="1200" local:YearReviewMotion.Angle="-3">
                <TextBlock Text="{DynamicResource LOCPlayAch_YearReview_EveryDay}" Style="{StaticResource YearReview.Label}" Margin="0,0,0,8"/>
                <ItemsControl Width="530" Height="70" ItemsSource="{Binding Heat}"
                              ItemsPanel="{StaticResource YearReview.CanvasPanel}"
                              ItemContainerStyle="{StaticResource YearReview.PlacedItem}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:YearReviewHeatCell}">
                            <Border Width="8" Height="8" CornerRadius="2"
                                    ToolTip="{Binding ToolTip}"
                                    local:YearReviewUnlockPopover.Group="{Binding Group}"
                                    local:YearReviewMotion.Reveal="Fade"
                                    local:YearReviewMotion.Delay="{Binding Delay}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.Accent}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="0">
                                                <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.Border}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="1">
                                                <Setter Property="Opacity" Value="0.3"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="2">
                                                <Setter Property="Opacity" Value="0.52"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="3">
                                                <Setter Property="Opacity" Value="0.75"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Canvas.Left="72" Canvas.Top="72" local:YearReviewMotion.Reveal="Rise">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource LOCPlayAch_YearReview_ByMonth}" Style="{StaticResource YearReview.Title}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource YearReview.ViewPickerButton}"/>
                </StackPanel>
                <TextBlock Text="{Binding CurrentView.BusiestDayText}" Style="{StaticResource YearReview.Label}" Margin="0,4,0,0" MaxWidth="560" HorizontalAlignment="Left"/>
            </StackPanel>

            <Border Canvas.Left="120" Canvas.Top="170" Width="210" Height="210" CornerRadius="105"
                    local:YearReviewUnlockPopover.Group="{Binding StreakGroup}"
                    BorderThickness="4"
                    BorderBrush="{DynamicResource PlayAch.Brush.Accent}"
                    Background="{DynamicResource PlayAch.Brush.PopupSurface}"
                    local:YearReviewMotion.Reveal="Slam" local:YearReviewMotion.Delay="1500" local:YearReviewMotion.Angle="-12">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Viewbox Height="96" HorizontalAlignment="Center">
                        <local:CountUpText Value="{Binding StreakDays}" Style="{StaticResource YearReview.Display}"
                                           Foreground="{DynamicResource PlayAch.Brush.Accent}" local:YearReviewMotion.Delay="1500"/>
                    </Viewbox>
                    <TextBlock Text="{DynamicResource LOCPlayAch_YearReview_DayStreak}" FontWeight="SemiBold" HorizontalAlignment="Center"
                               FontSize="{DynamicResource PlayAch.FontSize.Body}" Foreground="{DynamicResource PlayAch.Brush.Accent}"/>
                    <TextBlock Text="{Binding StreakRangeText}" HorizontalAlignment="Center" Margin="0,2,0,0"
                               FontSize="{DynamicResource PlayAch.FontSize.Caption}" Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"/>
                </StackPanel>
            </Border>
        </Canvas>
    </DataTemplate>

    <!-- 4. Top games: the leader larger, the runners-up in a loose row, ranked by the picked measure. -->
    <DataTemplate DataType="{x:Type vm:YearReviewTopGamesSlide}">
        <Canvas Width="1280" Height="770">
            <ItemsControl Width="1280" Height="770" ItemsSource="{Binding CurrentView.Cards}"
                          ItemsPanel="{StaticResource YearReview.CanvasPanel}"
                          ItemContainerStyle="{StaticResource YearReview.DroppedCard}"
                          ItemTemplate="{StaticResource YearReview.CoverCard}"/>

            <StackPanel Canvas.Left="72" Canvas.Top="72" local:YearReviewMotion.Reveal="Rise">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource LOCPlayAch_YearReview_TopGames}" Style="{StaticResource YearReview.Title}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource YearReview.ViewPickerButton}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Canvas.Left="72" Canvas.Top="150" MaxWidth="250"
                        local:YearReviewMotion.Reveal="Rise" local:YearReviewMotion.Delay="1300">
                <Viewbox Height="140" HorizontalAlignment="Left">
                    <local:CountUpText Value="{Binding CurrentView.LeadValue}" local:YearReviewMotion.Delay="1400">
                        <local:CountUpText.Style>
                            <Style TargetType="local:CountUpText" BasedOn="{StaticResource YearReview.Display}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView.LeadIsPercent}" Value="True">
                                        <Setter Property="Format" Value="Percent"/>
                                        <Setter Property="Decimals" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:CountUpText.Style>
                    </local:CountUpText>
                </Viewbox>
                <TextBlock Text="{Binding CurrentView.LeadCaption}" Style="{StaticResource YearReview.Label}" MaxWidth="215" HorizontalAlignment="Left"/>
            </StackPanel>
        </Canvas>
    </DataTemplate>

    <!-- 5. Games completed: a huge count beside a pile of tossed covers wearing their badges. -->
    <DataTemplate DataType="{x:Type vm:YearReviewCompletionsSlide}">
        <Canvas Width="1280" Height="770">
            <ItemsControl Width="1280" Height="770" ItemsSource="{Binding Cards}"
                          ItemsPanel="{StaticResource YearReview.CanvasPanel}"
                          ItemContainerStyle="{StaticResource YearReview.DroppedCard}"
                          ItemTemplate="{StaticResource YearReview.CoverCard}"/>

            <TextBlock Canvas.Left="72" Canvas.Top="72"
                       Text="{DynamicResource LOCPlayAch_YearReview_GamesCompleted}"
                       Style="{StaticResource YearReview.Title}"
                       local:YearReviewMotion.Reveal="Rise"/>
            <Viewbox Canvas.Left="60" Canvas.Top="130" Height="330"
                     local:YearReviewUnlockPopover.Group="{Binding AllGroup}"
                     local:YearReviewMotion.Reveal="Zoom" local:YearReviewMotion.Delay="150">
                <local:CountUpText Value="{Binding Count}" Style="{StaticResource YearReview.Display}" local:YearReviewMotion.Delay="300"/>
            </Viewbox>
            <TextBlock Canvas.Left="76" Canvas.Top="560" LineHeight="26"
                       Text="{Binding BreakdownText}"
                       Style="{StaticResource YearReview.Label}"
                       local:YearReviewMotion.Reveal="Rise" local:YearReviewMotion.Delay="1600"/>
        </Canvas>
    </DataTemplate>

    <!-- 6. Rarest unlock: the icon in its tier's rays with the percent counting down, or a row of
         the five rarest, or of each platform's rarest. -->
    <DataTemplate DataType="{x:Type vm:YearReviewRarestSlide}">
        <Canvas Width="1280" Height="770">
            <Canvas Width="1280" Height="770" Visibility="{Binding CurrentView.IsSingle, Converter={StaticResource BoolToVis}}">
                <local:YearReviewSunburst Width="1280" Height="770"
                                          Origin="0.258,0.52"
                                          IsActive="True"
                                          Color="{Binding CurrentView.TierBrush}"/>
                <Image Canvas.Left="200" Canvas.Top="270" Width="260" Height="260" Stretch="Uniform"
                       local:YearReviewUnlockPopover.Group="{Binding CurrentView.Group}"
                       local:YearReviewMotion.Hover="True"
                       helpers:RoundedClip.Radius="{DynamicResource PlayAch.Radius.AchievementIcon}"
                       helpers:AsyncImage.Uri="{Binding CurrentView.IconPath}"
                       helpers:AsyncImage.DecodePixel="512"
                       local:YearReviewMotion.Reveal="Zoom" local:YearReviewMotion.Delay="200" local:YearReviewMotion.Angle="-6"/>
                <Viewbox Canvas.Left="620" Canvas.Top="150" Height="240"
                         local:YearReviewMotion.Reveal="Rise" local:YearReviewMotion.Delay="350">
                    <local:CountUpText Value="{Binding CurrentView.Percent}" From="100" Format="Percent" Decimals="1"
                                       Style="{StaticResource YearReview.Display}" Foreground="{Binding CurrentView.TierBrush}"
                                       local:YearReviewMotion.Delay="500"/>
                </Viewbox>
                <StackPanel Canvas.Left="640" Canvas.Top="440" Width="520"
                            local:YearReviewMotion.Reveal="Rise" local:YearReviewMotion.Delay="1500">
                    <TextBlock Text="{Binding CurrentView.Name}" Style="{StaticResource YearReview.Title}">
                        <TextBlock.LayoutTransform>
                            <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                    <TextBlock Text="{Binding CurrentView.DetailText}" Style="{StaticResource YearReview.Label}" Margin="0,6,0,0"/>
                </StackPanel>
                <Viewbox Canvas.Right="4" Canvas.Top="110" Width="64"
                         local:YearReviewMotion.Reveal="Rise" local:YearReviewMotion.Delay="1700">
                    <TextBlock Text="{Binding CurrentView.TierText}" Style="{StaticResource YearReview.Display}" Foreground="{Binding CurrentView.TierBrush}">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="90"/>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Viewbox>
            </Canvas>

            <ItemsControl Width="1280" Height="770" ItemsSource="{Binding CurrentView.Entries}"
                          ItemsPanel="{StaticResource YearReview.CanvasPanel}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter" BasedOn="{StaticResource YearReview.PlacedItem}">
                        <Setter Property="local:YearReviewMotion.Reveal" Value="Pop"/>
                        <Setter Property="local:YearReviewMotion.Hover" Value="True"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:YearReviewRareEntry}">
                        <StackPanel Width="200" Background="Transparent" local:YearReviewUnlockPopover.Group="{Binding Group}">
                            <Image Width="150" Height="150" Stretch="Uniform" HorizontalAlignment="Center"
                                   helpers:RoundedClip.Radius="{DynamicResource PlayAch.Radius.AchievementIcon}"
                                   helpers:AsyncImage.Uri="{Binding IconPath}"
                                   helpers:AsyncImage.DecodePixel="300"/>
                            <Viewbox Height="64" HorizontalAlignment="Center" Margin="0,12,0,0">
                                <TextBlock Text="{Binding PercentText}" Style="{StaticResource YearReview.Display}" Foreground="{Binding TierBrush}"/>
                            </Viewbox>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="44"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{DynamicResource PlayAch.FontSize.Body}" Foreground="{DynamicResource PlayAch.Brush.Text}"/>
                            <TextBlock Text="{Binding Caption}" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                       FontSize="{DynamicResource PlayAch.FontSize.Caption}" Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Canvas.Left="640" Canvas.Top="72" local:YearReviewMotion.Reveal="Rise">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource LOCPlayAch_YearReview_RarestUnlock}" Style="{StaticResource YearReview.Title}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource YearReview.ViewPickerButton}"/>
                </StackPanel>
            </StackPanel>
        </Canvas>
    </DataTemplate>

    <!-- 7. Unlocks by rarity: one bubble per tier, sized by its count. -->
    <DataTemplate DataType="{x:Type vm:YearReviewRaritySlide}">
        <Canvas Width="1280" Height="770">
            <ItemsControl Width="1280" Height="770" ItemsSource="{Binding CurrentView.Bubbles}"
                          ItemsPanel="{StaticResource YearReview.CanvasPanel}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter" BasedOn="{StaticResource YearReview.PlacedItem}">
                        <Setter Property="local:YearReviewMotion.Reveal" Value="Pop"/>
                        <Setter Property="local:YearReviewMotion.Hover" Value="True"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:YearReviewBubble}">
                        <Grid Width="{Binding Diameter}" Height="{Binding Diameter}" local:YearReviewUnlockPopover.Group="{Binding Group}">
                            <Ellipse Fill="{Binding Fill}"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Viewbox Height="{Binding NumberHeight}" HorizontalAlignment="Center">
                                    <local:CountUpText Value="{Binding Unlocks}" Style="{StaticResource YearReview.Display}"
                                                       Foreground="{Binding TextBrush}"
                                                       local:YearReviewMotion.Delay="{Binding Delay}"/>
                                </Viewbox>
                                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontWeight="SemiBold"
                                           FontSize="{DynamicResource PlayAch.FontSize.Body}"
                                           Foreground="{Binding TextBrush}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Canvas.Left="72" Canvas.Top="72" local:YearReviewMotion.Reveal="Rise">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource LOCPlayAch_YearReview_UnlocksByRarity}" Style="{StaticResource YearReview.Title}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource YearReview.ViewPickerButton}"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Canvas.Left="72" Canvas.Top="660"
                       Text="{Binding CurrentView.TotalText}"
                       Style="{StaticResource YearReview.Label}"
                       local:YearReviewMotion.Reveal="Rise" local:YearReviewMotion.Delay="1300"/>
        </Canvas>
    </DataTemplate>

    <!-- 8. Unlocks by platform: one row per platform down the left (count, share and its top
         covers), the whole donut on the right with the year's total in its hole. A row and its
         slice light up together. -->
    <DataTemplate DataType="{x:Type vm:YearReviewPlatformsSlide}">
        <Canvas Width="1280" Height="770">
            <Grid Canvas.Left="690" Canvas.Top="150" Width="560" Height="560"
                  local:YearReviewMotion.Reveal="Spin">
                <ItemsControl ItemsSource="{Binding Segments}" ItemsPanel="{StaticResource YearReview.CanvasPanel}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:YearReviewDonutSegment}">
                            <local:YearReviewDonutSlice Width="560" Height="560"
                                                        StartAngle="{Binding StartAngle}"
                                                        Sweep="{Binding Sweep}"
                                                        Fill="{Binding Fill}"
                                                        ToolTip="{Binding ToolTip}"
                                                        IsLifted="{Binding Entry.IsHighlighted}"
                                                        local:YearReviewHoverSync.IsEnabled="True"
                                                        local:YearReviewHoverSync.IsHovered="{Binding Entry.IsHighlighted}"
                                                        local:YearReviewUnlockPopover.Group="{Binding Group}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent"
                            local:YearReviewUnlockPopover.Group="{Binding AllGroup}">
                    <Viewbox Height="96" HorizontalAlignment="Center">
                        <local:CountUpText Value="{Binding Total}" Style="{StaticResource YearReview.Display}" local:YearReviewMotion.Delay="600"/>
                    </Viewbox>
                    <TextBlock Text="{DynamicResource LOCPlayAch_Column_Unlocks}" Style="{StaticResource YearReview.Label}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <ItemsControl Width="1280" Height="770" ItemsSource="{Binding Entries}"
                          ItemsPanel="{StaticResource YearReview.CanvasPanel}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter" BasedOn="{StaticResource YearReview.PlacedItem}">
                        <Setter Property="local:YearReviewMotion.Reveal" Value="SlideIn"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:YearReviewPlatformEntry}">
                        <Grid Width="580" Height="{Binding RowHeight}"
                              local:YearReviewHoverSync.IsEnabled="True"
                              local:YearReviewHoverSync.IsHovered="{Binding IsHighlighted}"
                              local:YearReviewUnlockPopover.Group="{Binding Group}">
                            <!-- The highlight: a faint wash of the platform's own color. -->
                            <Border CornerRadius="{DynamicResource PlayAch.Radius.Layout}" Background="{Binding Fill}" Margin="-12,4,0,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                <Setter Property="Opacity" Value="0.16"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Grid Background="Transparent" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Height="{Binding NumberHeight}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <local:CountUpText Value="{Binding Unlocks}" Style="{StaticResource YearReview.Display}" local:YearReviewMotion.Delay="{Binding Delay}"/>
                                </Viewbox>
                                <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="{Binding Fill}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource YearReview.Title}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ShareText}" Style="{StaticResource YearReview.Label}" Margin="20,2,0,0"/>
                                </StackPanel>
                                <ItemsControl Grid.Column="2" ItemsSource="{Binding Covers}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="{Binding DataContext.CoverWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  Height="{Binding DataContext.CoverHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  Margin="6,0,0,0" ClipToBounds="True" helpers:RoundedClip.Radius="5">
                                                <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       helpers:AsyncImage.Uri="{Binding}"
                                                       helpers:AsyncImage.DecodePixel="300"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Canvas.Left="72" Canvas.Top="72"
                       Text="{DynamicResource LOCPlayAch_YearReview_UnlocksByPlatform}"
                       Style="{StaticResource YearReview.Title}"
                       local:YearReviewMotion.Reveal="Rise"/>
        </Canvas>
    </DataTemplate>

    <!-- 9. First and latest unlock: a trail drawing itself from one to the other. -->
    <DataTemplate DataType="{x:Type vm:YearReviewFirstAndLatestSlide}">
        <Canvas Width="1280" Height="770">
            <Path Data="M260,250 C520,200 520,560 760,470 S1000,420 1040,560"
                  Stroke="{DynamicResource PlayAch.Brush.Border}" StrokeThickness="2" StrokeDashArray="3 4"/>
            <Path Data="M260,250 C520,200 520,560 760,470 S1000,420 1040,560"
                  Stroke="{DynamicResource PlayAch.Brush.Accent}" StrokeThickness="3"
                  local:YearReviewMotion.Reveal="Draw" local:YearReviewMotion.Delay="400" local:YearReviewMotion.DrawLength="1200"/>

            <Image Canvas.Left="150" Canvas.Top="190" Width="120" Height="120"
                   local:YearReviewUnlockPopover.Group="{Binding FirstGroup}"
                   helpers:RoundedClip.Radius="{DynamicResource PlayAch.Radius.AchievementIcon}"
                   helpers:AsyncImage.Uri="{Binding FirstIconPath}" helpers:AsyncImage.DecodePixel="256"
                   local:YearReviewMotion.Reveal="Zoom" local:YearReviewMotion.Delay="200" local:YearReviewMotion.Angle="-5"/>
            <Image Canvas.Left="1000" Canvas.Top="500" Width="120" Height="120"
                   local:YearReviewUnlockPopover.Group="{Binding LatestGroup}"
                   helpers:RoundedClip.Radius="{DynamicResource PlayAch.Radius.AchievementIcon}"
                   helpers:AsyncImage.Uri="{Binding LatestIconPath}" helpers:AsyncImage.DecodePixel="256"
                   local:YearReviewMotion.Reveal="Zoom" local:YearReviewMotion.Delay="1600" local:YearReviewMotion.Angle="6"/>

            <TextBlock Canvas.Left="72" Canvas.Top="72"
                       Text="{DynamicResource LOCPlayAch_YearReview_FirstAndLatest}"
                       Style="{StaticResource YearReview.Title}"
                       local:YearReviewMotion.Reveal="Rise"/>
            <StackPanel Canvas.Left="150" Canvas.Top="330" Width="320"
                        local:YearReviewMotion.Reveal="Rise" local:YearReviewMotion.Delay="350">
                <TextBlock Text="{Binding FirstLabel}" Style="{StaticResource YearReview.Label}"/>
                <TextBlock Text="{Binding FirstName}" Style="{StaticResource YearReview.Title}" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding FirstDetail}" Style="{StaticResource YearReview.Label}"/>
            </StackPanel>
            <StackPanel Canvas.Left="660" Canvas.Top="560" Width="320"
                        local:YearReviewMotion.Reveal="Rise" local:YearReviewMotion.Delay="1750">
                <TextBlock Text="{DynamicResource LOCPlayAch_YearReview_LatestUnlock}" Style="{StaticResource YearReview.Label}" HorizontalAlignment="Right" TextAlignment="Right"/>
                <TextBlock Text="{Binding LatestName}" Style="{StaticResource YearReview.Title}" HorizontalAlignment="Right" TextAlignment="Right" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding LatestDetail}" Style="{StaticResource YearReview.Label}" HorizontalAlignment="Right" TextAlignment="Right"/>
            </StackPanel>
            <StackPanel Canvas.Left="560" Canvas.Top="230"
                        local:YearReviewMotion.Reveal="Rise" local:YearReviewMotion.Delay="1100" local:YearReviewMotion.Angle="-6">
                <Viewbox Height="110" HorizontalAlignment="Left">
                    <local:CountUpText Value="{Binding DaysApart}" Style="{StaticResource YearReview.Display}" local:YearReviewMotion.Delay="1200"/>
                </Viewbox>
                <TextBlock Text="{DynamicResource LOCPlayAch_YearReview_DaysApart}" Style="{StaticResource YearReview.Label}"/>
            </StackPanel>
        </Canvas>
    </DataTemplate>

    <!-- 10. Friends: how often the user got there first, and a friend's games in common; with one
         friend picked, both sides of the race. -->
    <DataTemplate DataType="{x:Type vm:YearReviewFriendsSlide}">
        <Canvas Width="1280" Height="770">
            <ItemsControl Width="1280" Height="770" ItemsSource="{Binding CurrentView.SharedCards}"
                          ItemsPanel="{StaticResource YearReview.CanvasPanel}"
                          ItemContainerStyle="{StaticResource YearReview.DroppedCard}"
                          ItemTemplate="{StaticResource YearReview.CoverCard}"/>

            <Grid Canvas.Left="640" Canvas.Top="360" Width="200" Height="200"
                  local:YearReviewUnlockPopover.Group="{Binding CurrentView.SharedGroup}"
                  Visibility="{Binding CurrentView.HasFriend, Converter={StaticResource BoolToVis}}"
                  local:YearReviewMotion.Reveal="Pop" local:YearReviewMotion.Delay="1200">
                <Border CornerRadius="100" Background="{DynamicResource PlayAch.Brush.Panel}"
                        BorderBrush="{DynamicResource PlayAch.Brush.PopupSurface}" BorderThickness="6"
                        Effect="{StaticResource YearReview.CardShadow}">
                    <Viewbox Height="96">
                        <TextBlock Text="{Binding CurrentView.FriendInitial}" Style="{StaticResource YearReview.Display}"/>
                    </Viewbox>
                </Border>
                <Grid Margin="6" ClipToBounds="True" helpers:RoundedClip.Radius="94">
                    <Image Stretch="UniformToFill"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           helpers:AsyncImage.Uri="{Binding CurrentView.AvatarPath}"
                           helpers:AsyncImage.DecodePixel="400"/>
                </Grid>
            </Grid>

            <StackPanel Canvas.Left="72" Canvas.Top="72" local:YearReviewMotion.Reveal="Rise">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Friends}" Style="{StaticResource YearReview.Title}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource YearReview.ViewPickerButton}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Canvas.Left="60" Canvas.Top="140" Width="540">
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding CurrentView.BigNumber}" Value="0"/>
                                        <Condition Binding="{Binding CurrentView.HasSecond}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Viewbox Height="220" HorizontalAlignment="Left"
                             local:YearReviewUnlockPopover.Group="{Binding CurrentView.BigGroup}"
                             local:YearReviewMotion.Reveal="Rise" local:YearReviewMotion.Delay="100" local:YearReviewMotion.Angle="-3">
                        <local:CountUpText Value="{Binding CurrentView.BigNumber}" Style="{StaticResource YearReview.Display}" local:YearReviewMotion.Delay="250"/>
                    </Viewbox>
                    <TextBlock Text="{Binding CurrentView.BigLabel}" Style="{StaticResource YearReview.Label}"
                               MaxWidth="320" HorizontalAlignment="Left" Margin="16,8,0,0"
                               local:YearReviewMotion.Reveal="Rise" local:YearReviewMotion.Delay="500"/>
                </StackPanel>
                <StackPanel Margin="0,30,0,0"
                            Visibility="{Binding CurrentView.HasSecond, Converter={StaticResource BoolToVis}}"
                            local:YearReviewMotion.Reveal="Rise" local:YearReviewMotion.Delay="800" local:YearReviewMotion.Angle="2">
                    <Viewbox Height="120" HorizontalAlignment="Left"
                             local:YearReviewUnlockPopover.Group="{Binding CurrentView.SecondGroup}">
                        <local:CountUpText Value="{Binding CurrentView.SecondNumber}" Style="{StaticResource YearReview.Display}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}" local:YearReviewMotion.Delay="900"/>
                    </Viewbox>
                    <TextBlock Text="{Binding CurrentView.SecondLabel}" Style="{StaticResource YearReview.Label}"
                               MaxWidth="320" HorizontalAlignment="Left" Margin="8,6,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Canvas.Left="860" Canvas.Top="500" Width="360" Background="Transparent"
                        local:YearReviewUnlockPopover.Group="{Binding CurrentView.SharedGroup}"
                        Visibility="{Binding CurrentView.HasFriend, Converter={StaticResource BoolToVis}}"
                        local:YearReviewMotion.Reveal="Rise" local:YearReviewMotion.Delay="1400">
                <TextBlock Text="{Binding CurrentView.FriendName}" Style="{StaticResource YearReview.Title}">
                    <TextBlock.LayoutTransform>
                        <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                    </TextBlock.LayoutTransform>
                </TextBlock>
                <TextBlock Text="{Binding CurrentView.InCommonText}" Style="{StaticResource YearReview.Label}"/>
            </StackPanel>
        </Canvas>
    </DataTemplate>

    <!-- A text box that reads as plain text until hovered or focused, for editing in place. -->
    <Style x:Key="YearReview.InlineTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource PlayAch.Brush.Text}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,1"/>
        <Setter Property="FontFamily" Value="{DynamicResource PlayAch.FontFamily.Body}"/>
        <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Title}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.Border}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- Pieces every card style shares: the editable picture and name, the figures, the
         plugin's signature, and a soft shadow plate. The card itself carries Tag="ShareCard",
         which Save card and Copy capture. Cards stay upright and free of effects so their text
         stays crisp. -->
    <DataTemplate x:Key="YearReview.CardAvatar">
        <!-- Fills the width its card gives it, and stays square. -->
        <Button Cursor="Hand" Focusable="False"
                Command="{x:Static local:YearReviewControl.ChooseAvatarCommand}"
                ToolTip="{DynamicResource LOCPlayAch_Column_Avatar}"
                AutomationProperties.Name="{DynamicResource LOCPlayAch_Column_Avatar}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Height="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                        <Border CornerRadius="14" Background="{DynamicResource PlayAch.Brush.Panel}">
                            <Viewbox Height="32">
                                <TextBlock Text="{Binding CardInitial}" Style="{StaticResource YearReview.Display}"/>
                            </Viewbox>
                        </Border>
                        <Grid ClipToBounds="True" helpers:RoundedClip.Radius="14">
                            <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   helpers:AsyncImage.Uri="{Binding CardAvatarPath}"
                                   helpers:AsyncImage.DecodePixel="200"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="YearReview.CardName">
        <TextBox Text="{Binding CardName}" Style="{StaticResource YearReview.InlineTextBox}" MaxLength="40"
                 ToolTip="{DynamicResource LOCPlayAch_Showcase_ProfileName}"
                 AutomationProperties.Name="{DynamicResource LOCPlayAch_Showcase_ProfileName}">
            <TextBox.LayoutTransform>
                <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
            </TextBox.LayoutTransform>
        </TextBox>
    </DataTemplate>

    <DataTemplate x:Key="YearReview.CardFigure">
        <StackPanel Margin="0,0,20,14">
            <Viewbox Height="38" MaxWidth="230" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Key}" Style="{StaticResource YearReview.Display}"/>
            </Viewbox>
            <TextBlock Text="{Binding Value}" FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                       Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="YearReview.CardSignature">
        <StackPanel Orientation="Horizontal">
            <Image Source="{StaticResource PlayAch.Image.Logo}" Width="24" Height="24" VerticalAlignment="Center"/>
            <TextBlock Text="{DynamicResource LOCPlayAch_Title_PluginName}" Margin="10,0,0,0" VerticalAlignment="Center"
                       FontWeight="SemiBold" FontSize="{DynamicResource PlayAch.FontSize.Body}"
                       Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"/>
        </StackPanel>
    </DataTemplate>

    <Style x:Key="YearReview.CardShadowPlate" TargetType="Border">
        <Setter Property="Margin" Value="6,14,-6,-14"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="Black"/>
        <Setter Property="Opacity" Value="0.35"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Effect">
            <Setter.Value>
                <BlurEffect Radius="24"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="YearReview.CardSurface" TargetType="Border">
        <Setter Property="Tag" Value="ShareCard"/>
        <Setter Property="CornerRadius" Value="12"/>
        <!-- Clips art to the rounded corners; ClipToBounds alone would cut them square. -->
        <Setter Property="helpers:RoundedClip.Radius" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.PopupSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Classic: picture, name and year over the top game's cover and the figures. -->
    <DataTemplate DataType="{x:Type vm:YearReviewClassicCard}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Style="{StaticResource YearReview.CardShadowPlate}"/>
            <Border Style="{StaticResource YearReview.CardSurface}" Width="820" Padding="26,24" DataContext="{Binding Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource YearReview.CardAvatar}" Width="72"/>
                        <StackPanel Grid.Column="1" Margin="18,0,16,0" VerticalAlignment="Center">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource YearReview.CardName}"/>
                        </StackPanel>
                        <Viewbox Grid.Column="2" Height="76" VerticalAlignment="Center">
                            <TextBlock Text="{Binding YearText}" Style="{StaticResource YearReview.Display}" Foreground="{DynamicResource PlayAch.Brush.Accent}"/>
                        </Viewbox>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- The top three covers fanned, the leader in front. -->
                        <Grid Width="200" Height="300" VerticalAlignment="Top">
                            <ItemsControl ItemsSource="{Binding FanCovers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="170" Height="255" ClipToBounds="True" helpers:RoundedClip.Radius="8"
                                              HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Grid.RenderTransform>
                                                <TransformGroup>
                                                    <RotateTransform Angle="{Binding Angle}"/>
                                                    <TranslateTransform X="{Binding X}" Y="{Binding Y}"/>
                                                </TransformGroup>
                                            </Grid.RenderTransform>
                                            <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   helpers:AsyncImage.Uri="{Binding Path}"
                                                   helpers:AsyncImage.DecodePixel="500"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <ItemsControl Grid.Column="1" Margin="28,4,0,0" ItemsSource="{Binding Figures}" ItemTemplate="{StaticResource YearReview.CardFigure}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                    <Border Grid.Row="2" Margin="0,20,0,0" Padding="0,14,0,0"
                            BorderBrush="{DynamicResource PlayAch.Brush.Border}" BorderThickness="0,1,0,0">
                        <ContentPresenter ContentTemplate="{StaticResource YearReview.CardSignature}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- Poster: tall, the top game's art fading down behind a huge year. -->
    <DataTemplate DataType="{x:Type vm:YearReviewPosterCard}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Style="{StaticResource YearReview.CardShadowPlate}"/>
            <Border Style="{StaticResource YearReview.CardSurface}" Width="470" Height="660" DataContext="{Binding Card}">
                <Grid>
                    <Grid Height="380" VerticalAlignment="Top" ClipToBounds="True">
                        <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"
                               helpers:AsyncImage.Uri="{Binding BackdropPath}"
                               helpers:AsyncImage.DecodePixel="800">
                            <Image.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#FF000000"/>
                                    <GradientStop Offset="1" Color="#00000000"/>
                                </LinearGradientBrush>
                            </Image.OpacityMask>
                        </Image>
                    </Grid>
                    <DockPanel Margin="28,26">
                        <ContentPresenter DockPanel.Dock="Top" ContentTemplate="{StaticResource YearReview.CardSignature}" HorizontalAlignment="Left"/>
                        <ContentPresenter DockPanel.Dock="Bottom" Content="{Binding}" Margin="0,8,0,0">
                            <ContentPresenter.ContentTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding TopFigures}" ItemTemplate="{StaticResource YearReview.CardFigure}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </DataTemplate>
                            </ContentPresenter.ContentTemplate>
                        </ContentPresenter>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource YearReview.CardAvatar}" Width="56"/>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" Width="320">
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource YearReview.CardName}"/>
                            </StackPanel>
                        </StackPanel>
                        <Viewbox VerticalAlignment="Bottom" HorizontalAlignment="Left" Height="180">
                            <TextBlock Text="{Binding YearText}" Style="{StaticResource YearReview.Display}"/>
                        </Viewbox>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- Banner: the top game's art across the left with the year set over a dark wash at its
         foot; on the right the picture and name, the main figures, a row of top covers and the
         plugin's signature. The year over the art is white on the wash, the one place a card
         sets text on art. -->
    <DataTemplate DataType="{x:Type vm:YearReviewBannerCard}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Style="{StaticResource YearReview.CardShadowPlate}"/>
            <Border Style="{StaticResource YearReview.CardSurface}" Width="880" Height="360" DataContext="{Binding Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid ClipToBounds="True">
                        <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                               helpers:AsyncImage.Uri="{Binding BackdropPath}"
                               helpers:AsyncImage.DecodePixel="800"/>
                        <Border VerticalAlignment="Bottom" Height="170">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#00000000"/>
                                    <GradientStop Offset="1" Color="#C0000000"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Viewbox Height="96" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,20">
                            <TextBlock Text="{Binding YearText}" Style="{StaticResource YearReview.Display}" Foreground="White"/>
                        </Viewbox>
                    </Grid>
                    <DockPanel Grid.Column="1" Margin="26,22,26,20">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource YearReview.CardAvatar}" Width="52"/>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource YearReview.CardName}"
                                              Margin="14,0,0,0" Width="400" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ContentPresenter DockPanel.Dock="Bottom" ContentTemplate="{StaticResource YearReview.CardSignature}" HorizontalAlignment="Left"/>
                        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Covers}" Margin="0,0,0,14" HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="56" Height="84" Margin="0,0,8,0" ClipToBounds="True" helpers:RoundedClip.Radius="5">
                                        <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               helpers:AsyncImage.Uri="{Binding}"
                                               helpers:AsyncImage.DecodePixel="200"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding TopFigures}" ItemTemplate="{StaticResource YearReview.CardFigure}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- Mosaic: the year's top covers as a header band over the name, year and figures. -->
    <DataTemplate DataType="{x:Type vm:YearReviewMosaicCard}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Style="{StaticResource YearReview.CardShadowPlate}"/>
            <Border Style="{StaticResource YearReview.CardSurface}" Width="820" DataContext="{Binding Card}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Covers}" Height="210">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ClipToBounds="True">
                                    <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           helpers:AsyncImage.Uri="{Binding}"
                                           helpers:AsyncImage.DecodePixel="300"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="26,20,26,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource YearReview.CardAvatar}" Width="64"/>
                        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource YearReview.CardName}"/>
                        </StackPanel>
                        <Viewbox Grid.Column="2" Height="70" VerticalAlignment="Center">
                            <TextBlock Text="{Binding YearText}" Style="{StaticResource YearReview.Display}" Foreground="{DynamicResource PlayAch.Brush.Accent}"/>
                        </Viewbox>
                    </Grid>
                    <ItemsControl Margin="26,18,26,0" ItemsSource="{Binding Figures}" ItemTemplate="{StaticResource YearReview.CardFigure}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Border Margin="26,4,26,20" Padding="0,12,0,0"
                            BorderBrush="{DynamicResource PlayAch.Brush.Border}" BorderThickness="0,1,0,0">
                        <ContentPresenter ContentTemplate="{StaticResource YearReview.CardSignature}"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- 11. Summary: the shareable card, in the picked style, with its own save and copy. -->
    <DataTemplate DataType="{x:Type vm:YearReviewSummarySlide}">
        <Canvas Width="1280" Height="770">
            <!-- The card keeps its own size, centred in the space left of the buttons. -->
            <Grid Canvas.Left="40" Canvas.Top="70" Width="900" Height="680">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Content="{Binding CurrentView}"
                                  local:YearReviewMotion.Reveal="Rise" local:YearReviewMotion.Delay="100"/>
            </Grid>

            <StackPanel Canvas.Left="72" Canvas.Top="20" Orientation="Horizontal" local:YearReviewMotion.Reveal="Rise">
                <Button Style="{StaticResource YearReview.ViewPickerButton}" Margin="0"/>
            </StackPanel>

            <StackPanel Canvas.Left="980" Canvas.Top="560" local:YearReviewMotion.Reveal="Rise" local:YearReviewMotion.Delay="700">
                <StackPanel Orientation="Horizontal">
                    <Button Content="&#xEF08;"
                            Width="40" Height="40" Padding="0"
                            Style="{StaticResource PlayAch.Button.ToolbarIconStyle}"
                            ContentTemplate="{StaticResource PlayAch.ButtonContent.Glyph}"
                            Command="{x:Static local:YearReviewControl.SaveCardCommand}"
                            ToolTip="{DynamicResource LOCPlayAch_YearReview_SaveCard}"
                            AutomationProperties.Name="{DynamicResource LOCPlayAch_YearReview_SaveCard}"/>
                    <TextBlock Text="{DynamicResource LOCPlayAch_YearReview_SaveCard}" Style="{StaticResource YearReview.Label}"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="&#xEDEA;"
                            Width="40" Height="40" Padding="0"
                            Style="{StaticResource PlayAch.Button.ToolbarIconStyle}"
                            ContentTemplate="{StaticResource PlayAch.ButtonContent.Glyph}"
                            Command="{x:Static local:YearReviewControl.CopyImageCommand}"
                            CommandParameter="ShareCard"
                            ToolTip="{DynamicResource LOCPlayAch_Common_Copy}"
                            AutomationProperties.Name="{DynamicResource LOCPlayAch_Common_Copy}"/>
                    <TextBlock Text="{DynamicResource LOCPlayAch_Common_Copy}" Style="{StaticResource YearReview.Label}"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Canvas>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:YearReviewEmptySlide}">
        <Canvas Width="1280" Height="770">
            <TextBlock Canvas.Left="72" Canvas.Top="300" Text="{Binding Text}" Style="{StaticResource YearReview.Title}"
                       local:YearReviewMotion.Reveal="Rise">
                <TextBlock.LayoutTransform>
                    <ScaleTransform ScaleX="1.8" ScaleY="1.8"/>
                </TextBlock.LayoutTransform>
            </TextBlock>
        </Canvas>
    </DataTemplate>
</ResourceDictionary>
