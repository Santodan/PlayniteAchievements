<UserControl x:Class="PlayniteAchievements.Views.GameOptionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:PlayniteAchievements.Views"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             xmlns:converters="clr-namespace:PlayniteAchievements.Views.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1050">

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:EnumToBoolConverter x:Key="EnumToBool" />
            <converters:BooleanConverter x:Key="BoolToVis" Mode="ToVisibility" />
            <converters:BooleanConverter x:Key="InverseBoolToVis" Mode="InvertedToVisibility" />
            <converters:DefaultGameImageConverter x:Key="DefaultGameImage" />

            <Style x:Key="NavTabRadioStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="BorderRoot"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="BorderRoot" Property="Background" Value="#1FFFFFFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BorderRoot" Property="Background" Value="#14FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource NormalBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="2"
                        Height="190"
                        CornerRadius="6"
                        ClipToBounds="False"
                        Background="Transparent">
                    <Image Stretch="Uniform"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           helpers:AsyncImage.Uri="{Binding GameImagePath, Converter={StaticResource DefaultGameImage}, ConverterParameter=cover}"
                           helpers:AsyncImage.DecodePixel="480" />
                </Border>

                <TextBlock Grid.Row="4"
                           Text="{DynamicResource LOCPlayAch_Menu_GameOptions}"
                           Foreground="{DynamicResource TextBrush}"
                           Opacity="0.65"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <StackPanel Grid.Row="5">
                    <RadioButton Content="{DynamicResource LOCPlayAch_GameOptions_Tab_Overview}"
                                 Style="{StaticResource NavTabRadioStyle}"
                                 IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Overview}" />
                    <RadioButton Content="{DynamicResource LOCPlayAch_GameOptions_Tab_ManualTracking}"
                                 Style="{StaticResource NavTabRadioStyle}"
                                 Visibility="{Binding ShowManualTrackingTab, Converter={StaticResource BoolToVis}}"
                                 IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=ManualTracking}" />
                    <RadioButton Content="{DynamicResource LOCPlayAch_GameOptions_Tab_CustomSchema}"
                                 Style="{StaticResource NavTabRadioStyle}"
                                 Visibility="{Binding HasLocalCustomSchemaOverride, Converter={StaticResource BoolToVis}}"
                                 IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=CustomSchema}" />
                    <RadioButton Content="{DynamicResource LOCPlayAch_GameOptions_Tab_Overrides}"
                                 Style="{StaticResource NavTabRadioStyle}"
                                 IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Overrides}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource NormalBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <Grid>
                <views:GameOptionsOverviewTab>
                    <views:GameOptionsOverviewTab.Style>
                        <Style TargetType="{x:Type views:GameOptionsOverviewTab}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Overview">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:GameOptionsOverviewTab.Style>
                </views:GameOptionsOverviewTab>

                <views:GameOptionsOverridesTab>
                    <views:GameOptionsOverridesTab.Style>
                        <Style TargetType="{x:Type views:GameOptionsOverridesTab}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Overrides">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:GameOptionsOverridesTab.Style>
                </views:GameOptionsOverridesTab>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="ManualTracking">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ContentControl x:Name="ManualHost" />
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="CustomSchema">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource NormalBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{DynamicResource LOCPlayAch_GameOptions_Tab_Schema}"
                                         Style="{StaticResource NavTabRadioStyle}"
                                         Margin="0"
                                         IsChecked="{Binding SelectedCustomSchemaTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=SchemaJson}" />
                            <RadioButton Content="{DynamicResource LOCPlayAch_GameOptions_Tab_Capstones}"
                                         Style="{StaticResource NavTabRadioStyle}"
                                         Margin="8,0,0,0"
                                         IsChecked="{Binding SelectedCustomSchemaTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Capstones}" />
                            <RadioButton Content="{DynamicResource LOCPlayAch_GameOptions_Tab_Category}"
                                         Style="{StaticResource NavTabRadioStyle}"
                                         Margin="8,0,0,0"
                                         IsChecked="{Binding SelectedCustomSchemaTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Category}" />
                            <RadioButton Content="{DynamicResource LOCPlayAch_GameOptions_Tab_AchievementOrder}"
                                         Style="{StaticResource NavTabRadioStyle}"
                                         Margin="8,0,0,0"
                                         IsChecked="{Binding SelectedCustomSchemaTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=AchievementOrder}" />
                            <RadioButton Content="{DynamicResource LOCPlayAch_GameOptions_Tab_CustomIcons}"
                                         Style="{StaticResource NavTabRadioStyle}"
                                         Margin="8,0,0,0"
                                         IsChecked="{Binding SelectedCustomSchemaTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=CustomIcons}" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCustomSchemaTab}" Value="SchemaJson">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Button Content="{DynamicResource LOCPlayAch_Button_Reload}"
                                        Command="{Binding ReloadCustomSchemaEditorCommand}"
                                        Padding="12,6"
                                        Margin="0,0,8,0" />
                                <Button Content="{DynamicResource LOCPlayAch_Button_Save}"
                                        Command="{Binding SaveCustomSchemaEditorCommand}"
                                        Padding="12,6" />
                            </StackPanel>

                            <TextBox Grid.Row="2"
                                     Text="{Binding CustomSchemaEditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Padding="8" />

                            <TextBlock Grid.Row="3"
                                       Text="{Binding CustomSchemaEditorStatus}"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Opacity="0.82">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CustomSchemaEditorStatusIsError}" Value="True">
                                                <Setter Property="Foreground" Value="#FFE07070" />
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid>
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCustomSchemaTab}" Value="Capstones">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <TextBlock Text="{Binding CapstoneEmptyMessage}"
                                       Foreground="{DynamicResource TextBrush}"
                                       Opacity="0.78"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Top"
                                       Margin="4"
                                       Visibility="{Binding HasCapstoneData, Converter={StaticResource InverseBoolToVis}}" />

                            <ContentControl x:Name="CapstoneHost"
                                            Visibility="{Binding HasCapstoneData, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <Grid>
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCustomSchemaTab}" Value="AchievementOrder">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <ContentControl x:Name="AchievementOrderHost" />
                        </Grid>

                        <Grid>
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCustomSchemaTab}" Value="Category">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <ContentControl x:Name="CategoryHost" />
                        </Grid>

                        <Grid>
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCustomSchemaTab}" Value="CustomIcons">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <ContentControl x:Name="AchievementIconsHost" />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
