<UserControl x:Class="PlayniteAchievements.Views.GameOptionsOverridesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:PlayniteAchievements.Views"
             xmlns:converters="clr-namespace:PlayniteAchievements.Views.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:EnumToBoolConverter x:Key="EnumToBool" />
            <converters:BooleanConverter x:Key="BoolToVis" Mode="ToVisibility" />
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12" />
            </Style>
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
            </Style>
            <Style x:Key="SubTabRadioStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="BorderRoot"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="BorderRoot" Property="Background" Value="#1FFFFFFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BorderRoot" Property="Background" Value="#14FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton Content="{DynamicResource LOCPlayAch_GameOptions_Overrides_Tab_Main}"
                             GroupName="OverrideRootTabs"
                             Style="{StaticResource SubTabRadioStyle}"
                             IsChecked="{Binding SelectedOverridesTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Main}" />
                <RadioButton Content="{DynamicResource LOCPlayAch_GameOptions_Overrides_Tab_Local}"
                             GroupName="OverrideRootTabs"
                             Style="{StaticResource SubTabRadioStyle}"
                             IsChecked="{Binding SelectedOverridesTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Local}" />
            </StackPanel>

            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedOverridesTab}" Value="Main">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LOCPlayAch_GameOptions_Overrides_ExclusionHeader}"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="{DynamicResource LOCPlayAch_GameOptions_Overrides_ExclusionHint}"
                                       Foreground="{DynamicResource TextBrush}"
                                       Opacity="0.75"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="{Binding ExclusionStatusText}"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,8,0,0" />
                            <Button Content="{Binding ExclusionActionText}"
                                    Command="{Binding ToggleExclusionCommand}"
                                    Padding="12,6"
                                    MinWidth="190"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LOCPlayAch_GameOptions_Overrides_SummaryExclusionHeader}"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="{DynamicResource LOCPlayAch_GameOptions_Overrides_SummaryExclusionHint}"
                                       Foreground="{DynamicResource TextBrush}"
                                       Opacity="0.75"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="{Binding SummaryExclusionStatusText}"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,8,0,0" />
                            <Button Content="{Binding SummaryExclusionActionText}"
                                    Command="{Binding ToggleSummaryExclusionCommand}"
                                    Padding="12,6"
                                    MinWidth="190"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LOCPlayAch_GameOptions_Overrides_LockedIconsHeader}"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="{DynamicResource LOCPlayAch_GameOptions_Overrides_LockedIconsHint}"
                                       Foreground="{DynamicResource TextBrush}"
                                       Opacity="0.75"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="{Binding SeparateLockedIconsStatusText}"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap" />
                            <CheckBox Content="{DynamicResource LOCPlayAch_GameOptions_Overrides_LockedIconsCheckbox}"
                                      IsChecked="{Binding UseSeparateLockedIconsOverride}"
                                      FontWeight="SemiBold"
                                      Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}"
                            Margin="0,0,0,12"
                            Visibility="{Binding IsRaCapable, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LOCPlayAch_GameOptions_Overrides_RaHeader}"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="{DynamicResource LOCPlayAch_GameOptions_Overrides_RaHint}"
                                       Foreground="{DynamicResource TextBrush}"
                                       Opacity="0.75"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="{Binding RaStatusText}"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,10,0,0"
                                  Visibility="{Binding IsRaCapable, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding RaOverrideInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" />
                                <Button Grid.Column="1"
                                        Content="{DynamicResource LOCPlayAch_Button_Apply}"
                                        Command="{Binding ApplyRaOverrideCommand}"
                                        Padding="12,6"
                                        Margin="8,0,0,0" />
                                <Button Grid.Column="2"
                                        Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                        Command="{Binding ClearRaOverrideCommand}"
                                        Padding="12,6"
                                        Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}"
                            Margin="0,0,0,12"
                            Visibility="{Binding ShowXeniaTitleIdOverride, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LOCPlayAch_GameOptions_Overrides_XeniaHeader}"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="{DynamicResource LOCPlayAch_GameOptions_Overrides_XeniaHint}"
                                       Foreground="{DynamicResource TextBrush}"
                                       Opacity="0.75"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="{Binding XeniaTitleIdStatusText}"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,10,0,0"
                                  Visibility="{Binding ShowXeniaTitleIdOverride, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding XeniaTitleIdOverrideInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" />
                                <Button Grid.Column="1"
                                        Content="{DynamicResource LOCPlayAch_Button_Apply}"
                                        Command="{Binding ApplyXeniaTitleIdOverrideCommand}"
                                        Padding="12,6"
                                        Margin="8,0,0,0" />
                                <Button Grid.Column="2"
                                        Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                        Command="{Binding ClearXeniaTitleIdOverrideCommand}"
                                        Padding="12,6"
                                        Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}"
                            Margin="0,0,0,12"
                            Visibility="{Binding ShowShadPS4MatchIdOverride, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LOCPlayAch_GameOptions_Overrides_ShadPS4Header}"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="{DynamicResource LOCPlayAch_GameOptions_Overrides_ShadPS4Hint}"
                                       Foreground="{DynamicResource TextBrush}"
                                       Opacity="0.75"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="{Binding ShadPS4MatchIdStatusText}"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,10,0,0"
                                  Visibility="{Binding ShowShadPS4MatchIdOverride, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding ShadPS4MatchIdOverrideInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" />
                                <Button Grid.Column="1"
                                        Content="{DynamicResource LOCPlayAch_Button_Apply}"
                                        Command="{Binding ApplyShadPS4MatchIdOverrideCommand}"
                                        Padding="12,6"
                                        Margin="8,0,0,0" />
                                <Button Grid.Column="2"
                                        Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                        Command="{Binding ClearShadPS4MatchIdOverrideCommand}"
                                        Padding="12,6"
                                        Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}"
                            Visibility="{Binding ShowExophaseToggle, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LOCPlayAch_Provider_Exophase}"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="{DynamicResource LOCPlayAch_GameOptions_ExophaseHint}"
                                       Foreground="{DynamicResource TextBrush}"
                                       Opacity="0.75"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <CheckBox Content="{DynamicResource LOCPlayAch_GameOptions_UseExophase}"
                                      IsChecked="{Binding UseExophaseForGame}"
                                      FontWeight="SemiBold"
                                      Margin="0,10,0,0" />

                            <TextBlock Text="{DynamicResource LOCPlayAch_GameOptions_ExophaseSlugLabel}"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,12,0,0" />
                            <TextBlock Text="{DynamicResource LOCPlayAch_GameOptions_ExophaseSlugHint}"
                                       Foreground="{DynamicResource TextBrush}"
                                       Opacity="0.6"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="300" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding ExophaseSlugInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6"
                                         ToolTip="{Binding ExophaseAutoSlug}">
                                    <TextBox.Resources>
                                        <VisualBrush x:Key="PlaceholderBrush"
                                                     AlignmentX="Left"
                                                     AlignmentY="Center"
                                                     Stretch="None">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="{Binding ExophaseAutoSlug}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           Opacity="0.4"
                                                           Padding="8,0,0,0" />
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </TextBox.Resources>
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ExophaseSlugInput}" Value="">
                                                    <Setter Property="Background" Value="{StaticResource PlaceholderBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <Button Grid.Column="1"
                                        Content="{DynamicResource LOCPlayAch_Button_Apply}"
                                        Command="{Binding ApplyExophaseSlugOverrideCommand}"
                                        Padding="12,6"
                                        Margin="8,0,0,0" />
                                <Button Grid.Column="2"
                                        Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                        Command="{Binding ClearExophaseSlugOverrideCommand}"
                                        Padding="12,6"
                                        Margin="8,0,0,0" />
                            </Grid>

                            <TextBlock Text="{Binding ExophaseSlugOverrideValue, StringFormat='Current override: {0}'}"
                                       Visibility="{Binding HasExophaseSlugOverride, Converter={StaticResource BoolToVis}}"
                                       Foreground="{DynamicResource TextBrush}"
                                       Opacity="0.75"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedOverridesTab}" Value="Local">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <RadioButton Content="{DynamicResource LOCPlayAch_GameOptions_Overrides_LocalSubTab_LocalSavesSchema}"
                                 GroupName="OverrideLocalTabs"
                                 Style="{StaticResource SubTabRadioStyle}"
                                 IsChecked="{Binding SelectedLocalOverrideTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=LocalSavesSchema}" />
                    <RadioButton Content="{DynamicResource LOCPlayAch_GameOptions_Overrides_LocalSubTab_Steam}"
                                 GroupName="OverrideLocalTabs"
                                 Style="{StaticResource SubTabRadioStyle}"
                                 IsChecked="{Binding SelectedLocalOverrideTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Steam}" />
                    <RadioButton Content="{DynamicResource LOCPlayAch_GameOptions_Overrides_LocalSubTab_LumaPlay}"
                                 GroupName="OverrideLocalTabs"
                                 Style="{StaticResource SubTabRadioStyle}"
                                 IsChecked="{Binding SelectedLocalOverrideTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=LumaPlay}" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedLocalOverrideTab}" Value="LocalSavesSchema">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:GameOptionsLocalOverridesSection />
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedLocalOverrideTab}" Value="Steam">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <StackPanel>
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LOCPlayAch_GameOptions_Overrides_SteamAccountHeader}"
                                               Style="{StaticResource SectionHeaderStyle}" />
                                    <TextBlock Text="{DynamicResource LOCPlayAch_GameOptions_Overrides_SteamAccountHint}"
                                               Foreground="{DynamicResource TextBrush}"
                                               Opacity="0.75"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding SteamAccountStatusText}"
                                               Foreground="{DynamicResource TextBrush}"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="320" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding AvailableSteamAccounts}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="AccountId"
                                                  SelectedValue="{Binding SteamAccountOverrideInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  MinHeight="30" />
                                        <Button Grid.Column="1"
                                                Content="{DynamicResource LOCPlayAch_Button_Apply}"
                                                Command="{Binding ApplySteamAccountOverrideCommand}"
                                                Padding="12,6"
                                                Margin="8,0,0,0" />
                                        <Button Grid.Column="2"
                                                Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                                Command="{Binding ClearSteamAccountOverrideCommand}"
                                                Padding="12,6"
                                                Margin="8,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LOCPlayAch_GameOptions_Overrides_LocalSteamAppIdHeader}"
                                               Style="{StaticResource SectionHeaderStyle}" />
                                    <TextBlock Text="{DynamicResource LOCPlayAch_GameOptions_Overrides_LocalSteamAppIdHint}"
                                               Foreground="{DynamicResource TextBrush}"
                                               Opacity="0.75"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding LocalSteamAppIdStatusText}"
                                               Foreground="{DynamicResource TextBrush}"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                 Text="{Binding LocalSteamAppIdOverrideInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="8,6" />
                                        <Button Grid.Column="1"
                                                Content="{DynamicResource LOCPlayAch_Button_Apply}"
                                                Command="{Binding ApplyLocalSteamAppIdOverrideCommand}"
                                                Padding="12,6"
                                                Margin="8,0,0,0" />
                                        <Button Grid.Column="2"
                                                Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                                Command="{Binding ClearLocalSteamAppIdOverrideCommand}"
                                                Padding="12,6"
                                                Margin="8,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LOCPlayAch_GameOptions_Overrides_LocalSteamUserHeader}"
                                               Style="{StaticResource SectionHeaderStyle}" />
                                    <TextBlock Text="{DynamicResource LOCPlayAch_GameOptions_Overrides_LocalSteamUserHint}"
                                               Foreground="{DynamicResource TextBrush}"
                                               Opacity="0.75"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding LocalSteamAppCacheUserStatusText}"
                                               Foreground="{DynamicResource TextBrush}"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="320" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding AvailableLocalSteamAppCacheUsers}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="UserId"
                                                  SelectedValue="{Binding LocalSteamAppCacheUserOverrideInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  MinHeight="30" />
                                        <Button Grid.Column="1"
                                                Content="{DynamicResource LOCPlayAch_Button_Apply}"
                                                Command="{Binding ApplyLocalSteamAppCacheUserOverrideCommand}"
                                                Padding="12,6"
                                                Margin="8,0,0,0" />
                                        <Button Grid.Column="2"
                                                Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                                Command="{Binding ClearLocalSteamAppCacheUserOverrideCommand}"
                                                Padding="12,6"
                                                Margin="8,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedLocalOverrideTab}" Value="LumaPlay">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <StackPanel>
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LOCPlayAch_GameOptions_Overrides_LocalLumaPlayAppIdHeader}"
                                               Style="{StaticResource SectionHeaderStyle}" />
                                    <TextBlock Text="{DynamicResource LOCPlayAch_GameOptions_Overrides_LocalLumaPlayAppIdHint}"
                                               Foreground="{DynamicResource TextBrush}"
                                               Opacity="0.75"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding LocalLumaPlayAppIdStatusText}"
                                               Foreground="{DynamicResource TextBrush}"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                 Text="{Binding LocalLumaPlayAppIdOverrideInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="8,6" />
                                        <Button Grid.Column="1"
                                                Content="{DynamicResource LOCPlayAch_Button_Apply}"
                                                Command="{Binding ApplyLocalLumaPlayAppIdOverrideCommand}"
                                                Padding="12,6"
                                                Margin="8,0,0,0" />
                                        <Button Grid.Column="2"
                                                Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                                Command="{Binding ClearLocalLumaPlayAppIdOverrideCommand}"
                                                Padding="12,6"
                                                Margin="8,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LOCPlayAch_GameOptions_Overrides_LocalLumaPlayIniPathHeader}"
                                               Style="{StaticResource SectionHeaderStyle}" />
                                    <TextBlock Text="{DynamicResource LOCPlayAch_GameOptions_Overrides_LocalLumaPlayIniPathHint}"
                                               Foreground="{DynamicResource TextBrush}"
                                               Opacity="0.75"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding LocalLumaPlayIniPathStatusText}"
                                               Foreground="{DynamicResource TextBrush}"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MaxWidth="420" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                 Text="{Binding LocalLumaPlayIniPathOverrideInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="8,6" />
                                        <Button Grid.Column="1"
                                                Content="{DynamicResource LOCPlayAch_Button_Browse}"
                                                Command="{Binding BrowseLocalLumaPlayIniPathOverrideCommand}"
                                                Padding="12,6"
                                                Margin="8,0,0,0" />
                                        <Button Grid.Column="2"
                                                Content="{DynamicResource LOCPlayAch_Button_Apply}"
                                                Command="{Binding ApplyLocalLumaPlayIniPathOverrideCommand}"
                                                Padding="12,6"
                                                Margin="8,0,0,0" />
                                        <Button Grid.Column="3"
                                                Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                                Command="{Binding ClearLocalLumaPlayIniPathOverrideCommand}"
                                                Padding="12,6"
                                                Margin="8,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
