<!-- SettingsControl.xaml -->
<UserControl x:Class="PlayniteAchievements.Views.SettingsControl"
             x:Name="SettingsControlRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:nav="clr-namespace:PlayniteAchievements.Views.Settings.Navigation"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="700"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- UseLayoutRounding/SnapsToDevicePixels are declared on this root rather than left to the
         host window, because the usual host is Playnite's own Settings dialog, which the plugin does
         not create and cannot configure. The popout path already gets them from
         PlayniteUiProvider.CreateExtensionWindow, which carries the full rationale. -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/SettingsScopedControlStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/RarityBadges.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24,20,24,24">
        <TabControl x:Name="SettingsTabControl" SelectionChanged="TabControl_SelectionChanged" BorderThickness="0">
            <TabItem x:Name="SantodanForkTab" AutomationProperties.Name="Santodan-Fork">
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderWithIconStyle}">
                        <controls:GlyphIcon Style="{StaticResource HeaderGlyphStyle}" Glyph="&#xEF3A;"/>
                        <TextBlock Text="Santodan-Fork" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <TabControl x:Name="ForkSettingsTabControl" SelectionChanged="TabControl_SelectionChanged" BorderThickness="0">
                    <TabItem x:Name="ForkGeneralTab" AutomationProperties.Name="{DynamicResource LOCGeneralLabel}">
                        <TabItem.Header>
                            <StackPanel Style="{StaticResource TabHeaderWithIconStyle}">
                                <controls:GlyphIcon Style="{StaticResource HeaderGlyphStyle}" Glyph="&#xEF3A;"/>
                                <TextBlock Text="{DynamicResource LOCGeneralLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ContentControl x:Name="ForkGeneralSettingsContent"/>
                    </TabItem>
                    <TabItem x:Name="ForkPlatformsTab" AutomationProperties.Name="{DynamicResource LOCPlatformsTitle}">
                        <TabItem.Header>
                            <StackPanel Style="{StaticResource TabHeaderWithIconStyle}">
                                <controls:GlyphIcon Style="{StaticResource HeaderGlyphStyle}" Glyph="&#xEA30;"/>
                                <TextBlock Text="{DynamicResource LOCPlatformsTitle}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <nav:SettingsMasterDetailControl
                            ItemsSource="{Binding ForkProviderNavigationItems, ElementName=SettingsControlRoot}"
                            SelectedItem="{Binding SelectedForkProviderNavigationItem, ElementName=SettingsControlRoot, Mode=TwoWay}"
                            ShowSearch="True"
                            EnableGrouping="True"/>
                    </TabItem>
                    <!-- Fork notification editor retained alongside the v3 settings pages. -->
                    <TabItem x:Name="AchievementNotificationsTab" AutomationProperties.Name="Achievement Notification">
                        <TabItem.Header>
                            <StackPanel Style="{StaticResource TabHeaderWithIconStyle}">
                                <controls:GlyphIcon Style="{StaticResource HeaderGlyphStyle}" Glyph="&#xECA7;"/>
                                <TextBlock Text="Achievement Notification" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ContentControl x:Name="AchievementNotificationsContent"/>
                    </TabItem>

                    <TabItem x:Name="ForkPerformanceTab" AutomationProperties.Name="Performance (Experimental)">
                        <TabItem.Header>
                            <StackPanel Style="{StaticResource TabHeaderWithIconStyle}">
                                <controls:GlyphIcon Style="{StaticResource HeaderGlyphStyle}" Glyph="&#xEF3A;"/>
                                <TextBlock Text="Performance" VerticalAlignment="Center"/>
                                <Border Background="#80551A" CornerRadius="3" Padding="5,2" Margin="6,0,0,0">
                                    <TextBlock Text="Experimental" Foreground="White" FontSize="10"/>
                                </Border>
                            </StackPanel>
                        </TabItem.Header>
                        <ContentControl x:Name="ForkPerformanceSettingsContent"/>
                    </TabItem>

                    <!-- Fork migration workflow retained as a separate page alongside v3 migration. -->
                    <TabItem x:Name="ForkThemeMigrationTab"
                             AutomationProperties.Name="{DynamicResource LOCPlayAch_ThemeMigration_Title}">
                        <TabItem.Header>
                            <StackPanel Style="{StaticResource TabHeaderWithIconStyle}">
                                <controls:GlyphIcon Style="{StaticResource HeaderGlyphStyle}" Glyph="&#xEFD2;"/>
                                <TextBlock Text="{DynamicResource LOCPlayAch_ThemeMigration_Title}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ContentControl x:Name="ForkThemeMigrationContent"/>
                    </TabItem>
                </TabControl>
            </TabItem>

            <!-- ================== TAB: GENERAL SETTINGS ================== -->
            <TabItem x:Name="GeneralTab" AutomationProperties.Name="{DynamicResource LOCPlayAch_Common_General}">
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderWithIconStyle}">
                        <controls:GlyphIcon Style="{StaticResource HeaderGlyphStyle}" Glyph="&#xEF3A;"/>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Common_General}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ContentControl x:Name="GeneralSettingsContent"/>
            </TabItem>

            <!-- ================== TAB: PROVIDERS ================== -->
            <TabItem x:Name="ProvidersTab" AutomationProperties.Name="{DynamicResource LOCPlayAch_Common_Platforms}">
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderWithIconStyle}">
                        <controls:GlyphIcon Style="{StaticResource HeaderGlyphStyle}" Glyph="&#xEA30;"/>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Common_Platforms}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <nav:SettingsMasterDetailControl
                    ItemsSource="{Binding ProviderNavigationItems, ElementName=SettingsControlRoot}"
                    SelectedItem="{Binding SelectedProviderNavigationItem, ElementName=SettingsControlRoot, Mode=TwoWay}"
                    ShowSearch="True"
                    EnableGrouping="True"/>
            </TabItem>

            <!-- ================== TAB: METADATA ================== -->
            <TabItem x:Name="MetadataTab" AutomationProperties.Name="{DynamicResource LOCPlayAch_Common_Metadata}">
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderWithIconStyle}">
                        <controls:GlyphIcon Style="{StaticResource HeaderGlyphStyle}" Glyph="&#xF005;"/>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Common_Metadata}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ContentControl x:Name="MetadataSettingsContent"/>
            </TabItem>

            <!-- ================== TAB: FRIENDS ================== -->
            <TabItem x:Name="FriendsTab" AutomationProperties.Name="{DynamicResource LOCPlayAch_Settings_Friends}"
                     Visibility="{Binding Persisted.EnableFriendsFeatures, Converter={StaticResource BoolToVis}}">
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderWithIconStyle}">
                        <controls:GlyphIcon Style="{StaticResource HeaderGlyphStyle}" Glyph="&#xED09;"/>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Friends}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ContentControl x:Name="FriendsSettingsContent"/>
            </TabItem>

            <!-- ================== TAB: DISPLAY ================== -->
            <TabItem x:Name="DisplayTab" AutomationProperties.Name="{DynamicResource LOCPlayAch_Settings_TabDisplay}">
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderWithIconStyle}">
                        <controls:GlyphIcon Style="{StaticResource HeaderGlyphStyle}" Glyph="&#xEA48;"/>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_TabDisplay}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ContentControl x:Name="DisplaySettingsContent"/>
            </TabItem>

            <!-- ================== TAB: THEMES ================== -->
            <TabItem x:Name="ThemesTab" AutomationProperties.Name="{DynamicResource LOCPlayAch_Common_Themes}">
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderWithIconStyle}">
                        <controls:GlyphIcon Style="{StaticResource HeaderGlyphStyle}" Glyph="&#xEDE4;"/>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Common_Themes}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ContentControl x:Name="ThemesSettingsContent"/>
            </TabItem>

            <!-- ================== TAB: NOTIFICATIONS ================== -->
            <TabItem x:Name="NotificationsTab" AutomationProperties.Name="{DynamicResource LOCPlayAch_Common_Notifications}">
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderWithIconStyle}">
                        <controls:GlyphIcon Style="{StaticResource HeaderGlyphStyle}" Glyph="&#xEEA3;"/>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Common_Notifications}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ContentControl x:Name="NotificationsSettingsContent"/>
            </TabItem>
            <!-- ================== TAB: WORKSHOP ================== -->
            <TabItem x:Name="WorkshopTab" AutomationProperties.Name="{DynamicResource LOCPlayAch_Workshop_Title}">
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderWithIconStyle}">
                        <controls:GlyphIcon Style="{StaticResource HeaderGlyphStyle}" Glyph="&#xEFE7;"/>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Workshop_Title}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ContentControl x:Name="WorkshopSettingsContent"/>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
