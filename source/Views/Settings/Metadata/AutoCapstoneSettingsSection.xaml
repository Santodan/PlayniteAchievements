<UserControl x:Class="PlayniteAchievements.Views.Settings.General.EditorSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/SettingsScopedControlStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- One row per template: the text box, its reset, and a note when it does not format. -->
            <DataTemplate x:Key="TemplateRowTemplate">
                <controls:SettingRow Label="{Binding Label}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="320"
                                     LostFocus="TemplateTextBox_LostFocus"
                                     PreviewKeyDown="TemplateTextBox_PreviewKeyDown"/>
                            <Button Content="{DynamicResource LOCPlayAch_Settings_Style_ResetToDefault}"
                                    Command="{Binding ResetCommand}"
                                    Margin="{StaticResource PlayAch.Thickness.Left.Sm}"
                                    Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_AutoCapstoneText_TemplateInvalid}"
                                   Foreground="{DynamicResource PlayAch.Brush.ErrorText}"
                                   TextWrapping="Wrap"
                                   MaxWidth="400"
                                   HorizontalAlignment="Left"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding IsInvalid, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </controls:SettingRow>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">

            <!-- ================== AUTO CAPSTONE ================== -->
            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel Grid.IsSharedSizeScope="True">
                    <TextBlock Text="{DynamicResource LOCPlayAch_ManageAchievements_Custom_AutoCapstone}"
                               Style="{StaticResource SectionHeaderStyle}"/>

                    <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_EnableAutoCapstoneGeneration}"
                                         Hint="{DynamicResource LOCPlayAch_Settings_EnableAutoCapstoneGeneration_Description}">
                        <CheckBox IsChecked="{Binding Persisted.EnableAutoCapstoneGeneration}"/>
                    </controls:SettingRow>

                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_AutoCapstoneText_Hint}"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"
                               TextWrapping="Wrap"/>

                    <!-- Whole-game templates, then category ones, each a name and a description. -->
                    <TextBlock Text="{DynamicResource LOCPlayAch_Column_Game}"
                               Style="{StaticResource SubSectionHeaderStyle}"
                               Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}"/>
                    <ItemsControl x:Name="GameTemplateItems"
                                  Focusable="False"
                                  ItemTemplate="{StaticResource TemplateRowTemplate}"
                                  Margin="{StaticResource PlayAch.Thickness.SettingRow.Indent}"/>

                    <TextBlock Text="{DynamicResource LOCCategoryLabel}"
                               Style="{StaticResource SubSectionHeaderStyle}"
                               Margin="{StaticResource PlayAch.Thickness.SubSectionHeading}"/>
                    <ItemsControl x:Name="CategoryTemplateItems"
                                  Focusable="False"
                                  ItemTemplate="{StaticResource TemplateRowTemplate}"
                                  Margin="{StaticResource PlayAch.Thickness.SettingRow.Indent}"/>

                    <!-- Section-level action, not one setting's control. -->
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource PlayAch.Thickness.Top.Md}">
                        <Button Content="{DynamicResource LOCPlayAch_Button_Apply}"
                                Click="Apply_Click"
                                Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
