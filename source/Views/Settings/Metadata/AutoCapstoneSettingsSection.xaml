<UserControl x:Class="PlayniteAchievements.Views.Settings.Metadata.AutoCapstoneSettingsSection"
             x:Name="AutoCapstoneSettingsSectionRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/SettingsScopedControlStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- One row per template: the text box, its reset, and a note when it does not format. -->
            <DataTemplate x:Key="TemplateRowTemplate">
                <controls:SettingRow Label="{Binding Label}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="320"
                                     LostFocus="TemplateTextBox_LostFocus"
                                     PreviewKeyDown="TemplateTextBox_PreviewKeyDown"/>
                            <Button Content="{DynamicResource LOCPlayAch_Settings_Style_ResetToDefault}"
                                    Command="{Binding ResetCommand}"
                                    Margin="{StaticResource PlayAch.Thickness.Left.Sm}"
                                    Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_AutoCapstoneText_TemplateInvalid}"
                                   Foreground="{DynamicResource PlayAch.Brush.ErrorText}"
                                   TextWrapping="Wrap"
                                   MaxWidth="400"
                                   HorizontalAlignment="Left"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding IsInvalid, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </controls:SettingRow>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Scrolled by the Metadata tab, which shows it as its own page. -->
        <StackPanel>

            <!-- ================== AUTO CAPSTONE ================== -->
            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel Grid.IsSharedSizeScope="True">
                    <TextBlock Text="{DynamicResource LOCPlayAch_ManageAchievements_Custom_AutoCapstone}"
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource SectionAccentRuleStyle}"/>

                    <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_EnableAutoCapstoneGeneration}"
                                         Hint="{DynamicResource LOCPlayAch_Settings_EnableAutoCapstoneGeneration_Description}">
                        <CheckBox IsChecked="{Binding Persisted.EnableAutoCapstoneGeneration}"/>
                    </controls:SettingRow>

                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_AutoCapstoneText_Hint}"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_AutoCapstoneTags_Hint}"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"
                               TextWrapping="Wrap"/>

                    <!-- Whole-game templates and tags, then category ones: a name, a description and a tag picker each. -->
                    <TextBlock Text="{DynamicResource LOCPlayAch_Column_Game}"
                               Style="{StaticResource SubSectionHeaderStyle}"
                               Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}"/>
                    <ItemsControl x:Name="GameTemplateItems"
                                  Focusable="False"
                                  ItemTemplate="{StaticResource TemplateRowTemplate}"
                                  Margin="{StaticResource PlayAch.Thickness.SettingRow.Indent}"/>
                    <controls:SettingRow Label="{DynamicResource LOCPlayAch_Common_Tags}"
                                         Margin="{StaticResource PlayAch.Thickness.SettingRow.Indent}">
                        <Button x:Name="GameTagsButton"
                                Style="{StaticResource AchievementSelectorButtonStyle}"
                                Content="{Binding GameTagsText, ElementName=AutoCapstoneSettingsSectionRoot}"
                                Click="GameTagsButton_Click"
                                MinWidth="180"
                                Height="{StaticResource PlayAch.Size.Control.Height}">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource AchievementSelectorContextMenuStyle}"
                                             ItemContainerStyle="{StaticResource AchievementMultiSelectMenuItemStyle}"/>
                            </Button.ContextMenu>
                        </Button>
                    </controls:SettingRow>

                    <TextBlock Text="{DynamicResource LOCPlayAch_Common_Category}"
                               Style="{StaticResource SubSectionHeaderStyle}"
                               Margin="{StaticResource PlayAch.Thickness.SubSectionHeading}"/>
                    <ItemsControl x:Name="CategoryTemplateItems"
                                  Focusable="False"
                                  ItemTemplate="{StaticResource TemplateRowTemplate}"
                                  Margin="{StaticResource PlayAch.Thickness.SettingRow.Indent}"/>
                    <controls:SettingRow Label="{DynamicResource LOCPlayAch_Common_Tags}"
                                         Margin="{StaticResource PlayAch.Thickness.SettingRow.Indent}">
                        <Button x:Name="CategoryTagsButton"
                                Style="{StaticResource AchievementSelectorButtonStyle}"
                                Content="{Binding CategoryTagsText, ElementName=AutoCapstoneSettingsSectionRoot}"
                                Click="CategoryTagsButton_Click"
                                MinWidth="180"
                                Height="{StaticResource PlayAch.Size.Control.Height}">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource AchievementSelectorContextMenuStyle}"
                                             ItemContainerStyle="{StaticResource AchievementMultiSelectMenuItemStyle}"/>
                            </Button.ContextMenu>
                        </Button>
                    </controls:SettingRow>
                </StackPanel>
            </Border>
        </StackPanel>
</UserControl>
