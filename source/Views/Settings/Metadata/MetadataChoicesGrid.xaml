<UserControl x:Class="PlayniteAchievements.Views.Settings.Metadata.MetadataChoicesGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The metadata source choices grid, one row per scope: the Metadata tab shows the defaults
         and every platform, Manage Achievements one game. DataContext is the rows. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/SettingsScopedControlStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Compact settings-row height, no hand cursor; the defaults row reads as the header row. -->
            <Style x:Key="MetadataSourcesRowStyle"
                   TargetType="DataGridRow"
                   BasedOn="{StaticResource AchievementRowStyle}">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Cursor" Value="Arrow"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDefaults}" Value="True">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MetadataChoiceComboStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <!-- Tag holds what "Default" stands for, which the closed box shows muted. -->
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <ContentPresenter x:Name="Option" Content="{Binding Label}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsInherited}" Value="True">
                                    <Setter TargetName="Option" Property="ContentTemplate" Value="{StaticResource PlayAch.ComboBox.InheritedOptionTemplate}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="SelectedValuePath" Value="Key"/>
                <Setter Property="MinWidth" Value="120"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="4,2"/>
                <Setter Property="FontWeight" Value="Normal"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- As wide as its columns, not the window. -->
    <DataGrid x:Name="ChoicesGrid"
              Style="{StaticResource PlayAch.DataGrid.BaseStyle}"
              HorizontalAlignment="Left"
              ItemsSource="{Binding}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserSortColumns="False"
              HeadersVisibility="Column"
              IsReadOnly="False"
              GridLinesVisibility="None"
              BorderThickness="0"
              Background="{DynamicResource PlayAch.Brush.Grid.Background}"
              RowBackground="{DynamicResource PlayAch.Brush.Grid.RowBackground}"
              Foreground="{DynamicResource PlayAch.Brush.Text}"
              ColumnHeaderStyle="{StaticResource AchievementColumnHeaderStyle}"
              CellStyle="{StaticResource AchievementCellStyle}"
              RowStyle="{StaticResource MetadataSourcesRowStyle}"
              MaxHeight="520"
              VirtualizingPanel.ScrollUnit="Pixel"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              ScrollViewer.HorizontalScrollBarVisibility="Auto">
        <DataGrid.Columns>
            <DataGridTemplateColumn x:Name="PlatformColumn"
                                    Header="{DynamicResource LOCPlayAch_Common_Platform}"
                                    Width="Auto"
                                    MinWidth="140">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="4,2">
                            <Image Width="16"
                                   Height="16"
                                   Margin="{StaticResource PlayAch.Thickness.Right.Sm}"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasProviderIcon, Converter={StaticResource BoolToVis}}">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource ProviderIconConverter}">
                                        <Binding Path="ProviderIconKey"/>
                                        <Binding Path="ProviderColorHex"/>
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                            <TextBlock Text="{Binding DisplayName}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Read-only columns keep the grid out of row edit mode: a ComboBox never
                 commits that edit, so closing the view would cancel it and write the
                 original values back over the choices. The ComboBoxes stay editable.
                 A platform no source has shows a dash in every column. -->
            <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_ManageAchievements_Tab_CustomIcons}" Width="Auto" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Grid>
                            <ComboBox Style="{StaticResource MetadataChoiceComboStyle}"
                                      ItemsSource="{Binding IconOptions}"
                                      Tag="{Binding InheritedIcons}"
                                      SelectedValue="{Binding Icons, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Visibility="{Binding SupportsSources, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="—"
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="12,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding SupportsSources, Converter={StaticResource InverseBoolToVis}}"/>
                        </Grid>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_ManageAchievements_Tab_Category}" Width="Auto" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Grid>
                            <ComboBox Style="{StaticResource MetadataChoiceComboStyle}"
                                      ItemsSource="{Binding CategoryOptions}"
                                      Tag="{Binding InheritedCategories}"
                                      SelectedValue="{Binding Categories, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Visibility="{Binding SupportsSources, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="—"
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="12,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding SupportsSources, Converter={StaticResource InverseBoolToVis}}"/>
                        </Grid>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_Common_Tags}" Width="Auto" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Grid>
                            <ComboBox Style="{StaticResource MetadataChoiceComboStyle}"
                                      ItemsSource="{Binding TagOptions}"
                                      Tag="{Binding InheritedTags}"
                                      SelectedValue="{Binding Tags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Visibility="{Binding SupportsSources, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="—"
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="12,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding SupportsSources, Converter={StaticResource InverseBoolToVis}}"/>
                        </Grid>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Only platforms whose scanners read Exophase rarity get a choice. -->
            <DataGridTemplateColumn x:Name="RarityColumn" Header="{DynamicResource LOCPlayAch_Column_Rarity}" Width="Auto" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Grid>
                            <ComboBox Style="{StaticResource MetadataChoiceComboStyle}"
                                      ItemsSource="{Binding RarityOptions}"
                                      Tag="{Binding InheritedRarity}"
                                      SelectedValue="{Binding Rarity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Visibility="{Binding SupportsRarity, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="—"
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="12,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding SupportsRarity, Converter={StaticResource InverseBoolToVis}}"/>
                        </Grid>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_ManageAchievements_Custom_AutoCapstone}" Width="Auto" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Grid>
                            <ComboBox Style="{StaticResource MetadataChoiceComboStyle}"
                                      ItemsSource="{Binding CapstoneArtOptions}"
                                      Tag="{Binding InheritedCapstoneArt}"
                                      SelectedValue="{Binding CapstoneArt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Visibility="{Binding SupportsSources, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="—"
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="12,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding SupportsSources, Converter={StaticResource InverseBoolToVis}}"/>
                        </Grid>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Platforms with trophy types or points of their own get no choice for them. -->
            <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_Column_Trophy}" Width="Auto" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Grid>
                            <ComboBox Style="{StaticResource MetadataChoiceComboStyle}"
                                      ItemsSource="{Binding TrophyTypeOptions}"
                                      Tag="{Binding InheritedTrophyTypes}"
                                      SelectedValue="{Binding TrophyTypes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Visibility="{Binding SupportsTrophyTypes, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="—"
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="12,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding SupportsTrophyTypes, Converter={StaticResource InverseBoolToVis}}"/>
                        </Grid>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_Column_Points}" Width="Auto" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Grid>
                            <ComboBox Style="{StaticResource MetadataChoiceComboStyle}"
                                      ItemsSource="{Binding PointsOptions}"
                                      Tag="{Binding InheritedPoints}"
                                      SelectedValue="{Binding Points, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Visibility="{Binding SupportsPoints, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="—"
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="12,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding SupportsPoints, Converter={StaticResource InverseBoolToVis}}"/>
                        </Grid>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_Tagging_Area_Text}" Width="Auto" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Grid>
                            <ComboBox Style="{StaticResource MetadataChoiceComboStyle}"
                                      ItemsSource="{Binding TextOptions}"
                                      Tag="{Binding InheritedText}"
                                      SelectedValue="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Visibility="{Binding SupportsSources, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="—"
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="12,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding SupportsSources, Converter={StaticResource InverseBoolToVis}}"/>
                        </Grid>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
