<UserControl x:Class="PlayniteAchievements.Views.Settings.Metadata.MetadataSourcesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/SettingsScopedControlStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Compact settings-row height, no hand cursor; the defaults row reads as the header row. -->
            <Style x:Key="MetadataSourcesRowStyle"
                   TargetType="DataGridRow"
                   BasedOn="{StaticResource AchievementRowStyle}">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Cursor" Value="Arrow"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDefaults}" Value="True">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MetadataChoiceComboStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="DisplayMemberPath" Value="Label"/>
                <Setter Property="SelectedValuePath" Value="Key"/>
                <Setter Property="MinWidth" Value="120"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="4,2"/>
                <Setter Property="FontWeight" Value="Normal"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource PlayAch.Brush.Panel}">
        <!-- Scrolled by the Metadata tab, which stacks this above the auto capstone section. -->
                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Metadata_Sources}"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>
                        <Border Style="{StaticResource SectionAccentRuleStyle}"/>

                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Metadata_SourcesHint}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <DataGrid Style="{StaticResource PlayAch.DataGrid.BaseStyle}"
                                  ItemsSource="{Binding Rows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserSortColumns="False"
                                  HeadersVisibility="Column"
                                  IsReadOnly="False"
                                  GridLinesVisibility="None"
                                  BorderThickness="0"
                                  Background="{DynamicResource PlayAch.Brush.Grid.Background}"
                                  RowBackground="{DynamicResource PlayAch.Brush.Grid.RowBackground}"
                                  Foreground="{DynamicResource PlayAch.Brush.Text}"
                                  ColumnHeaderStyle="{StaticResource AchievementColumnHeaderStyle}"
                                  CellStyle="{StaticResource AchievementCellStyle}"
                                  RowStyle="{StaticResource MetadataSourcesRowStyle}"
                                  MaxHeight="520"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{DynamicResource LOCPlatformTitle}"
                                                        Width="*"
                                                        MinWidth="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="4,2">
                                                <Image Width="16"
                                                       Height="16"
                                                       Margin="{StaticResource PlayAch.Thickness.Right.Sm}"
                                                       VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding HasProviderIcon, Converter={StaticResource BoolToVis}}">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource ProviderIconConverter}">
                                                            <Binding Path="ProviderIconKey"/>
                                                            <Binding Path="ProviderColorHex"/>
                                                        </MultiBinding>
                                                    </Image.Source>
                                                </Image>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Read-only columns keep the grid out of row edit mode: a ComboBox never
                                     commits that edit, so closing the view would cancel it and write the
                                     original values back over the choices. The ComboBoxes stay editable. -->
                                <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_ManageAchievements_Tab_CustomIcons}" Width="Auto" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource MetadataChoiceComboStyle}"
                                                      ItemsSource="{Binding IconOptions}"
                                                      SelectedValue="{Binding Icons, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_ManageAchievements_Tab_Category}" Width="Auto" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource MetadataChoiceComboStyle}"
                                                      MinWidth="170"
                                                      ItemsSource="{Binding CategoryOptions}"
                                                      SelectedValue="{Binding Categories, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Only platforms whose scanners read Exophase rarity get a choice. -->
                                <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_Column_Rarity}" Width="Auto" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <ComboBox Style="{StaticResource MetadataChoiceComboStyle}"
                                                          ItemsSource="{Binding RarityOptions}"
                                                          SelectedValue="{Binding Rarity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Visibility="{Binding SupportsRarity, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="—"
                                                           Style="{StaticResource MutedTextStyle}"
                                                           Margin="12,0"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding SupportsRarity, Converter={StaticResource InverseBoolToVis}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_ManageAchievements_Custom_AutoCapstone}" Width="Auto" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource MetadataChoiceComboStyle}"
                                                      ItemsSource="{Binding CapstoneArtOptions}"
                                                      SelectedValue="{Binding CapstoneArt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
    </Grid>
</UserControl>
