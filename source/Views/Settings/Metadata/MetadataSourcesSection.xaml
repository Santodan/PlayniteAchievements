<UserControl x:Class="PlayniteAchievements.Views.Settings.Metadata.MetadataSourcesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PlayniteAchievements.Views.Settings.Metadata"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             xmlns:settings="clr-namespace:PlayniteAchievements.Models.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/SettingsScopedControlStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource PlayAch.Brush.Panel}">
        <!-- The Metadata tab's Sources page: the grid fills the page and scrolls itself. -->
                <Border Style="{StaticResource SectionBorderStyle}">
                    <DockPanel LastChildFill="True">
                        <controls:SettingRow DockPanel.Dock="Top"
                                             Label="{DynamicResource LOCPlayAch_Settings_Metadata_ConsoleVersion}"
                                             Hint="{DynamicResource LOCPlayAch_Settings_Metadata_ConsoleVersionHint}"
                                             Margin="{StaticResource PlayAch.Thickness.Bottom.Md}">
                            <ComboBox SelectedValue="{Binding Settings.Persisted.MetadataConsoleVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Tag"
                                      MinWidth="140">
                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Workshop_SortNewest}" Tag="{x:Static settings:MetadataConsoleVersion.Newest}"/>
                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Common_Oldest}" Tag="{x:Static settings:MetadataConsoleVersion.Oldest}"/>
                            </ComboBox>
                        </controls:SettingRow>

                        <TextBlock DockPanel.Dock="Top"
                                   Text="{DynamicResource LOCPlayAch_Settings_Metadata_Sources}"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>
                        <Border DockPanel.Dock="Top" Style="{StaticResource SectionAccentRuleStyle}"/>

                        <TextBlock DockPanel.Dock="Top"
                                   Text="{DynamicResource LOCPlayAch_Settings_Metadata_SourcesHint}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <!-- Where the official sources' data comes from, under the grid. -->
                        <TextBlock DockPanel.Dock="Bottom"
                                   Text="{DynamicResource LOCPlayAch_Settings_Metadata_OfficialSources}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>

                        <local:MetadataChoicesGrid DataContext="{Binding Rows}" FillsHeight="True"/>
                    </DockPanel>
                </Border>
    </Grid>
</UserControl>
