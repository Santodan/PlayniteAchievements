<UserControl x:Class="PlayniteAchievements.Views.Settings.Notifications.NotificationCapturesSection"
             x:Name="NotificationCapturesSectionRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="clr-namespace:PlayniteAchievements.Models.Settings"
             xmlns:converters="clr-namespace:PlayniteAchievements.Views.Converters"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/SettingsScopedControlStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BooleanAggregateConverter x:Key="AnyTrue" Mode="Any"/>

            <!-- One card per capture variant (clean, notification, framed), headed by its own
                 switch, so the variants read as separate groups. -->
            <Style x:Key="CaptureVariantCardStyle" TargetType="Border" BasedOn="{StaticResource SettingGroupCardStyle}">
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Margin" Value="{StaticResource PlayAch.Thickness.Bottom.Sm}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource PlayAch.Brush.Panel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">
                <!-- Capture timing. Deliberately not gated on the notifications master switch:
                     ProviderNotificationPolicy ANDs screenshots and recordings against their own
                     masters only, so captures work with notifications off. -->
                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <TextBlock Text="{DynamicResource LOCPlayAch_Column_Captures}"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>
                        <Border Style="{StaticResource SectionAccentRuleStyle}"/>

                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_CaptureDelaySeconds}"
                                             Margin="0">
                            <controls:SettingRow.IsEnabled>
                                <MultiBinding Converter="{StaticResource AnyTrue}">
                                    <Binding Path="Persisted.EnableUnlockScreenshots"/>
                                    <Binding Path="Persisted.EnableUnlockRecordings"/>
                                </MultiBinding>
                            </controls:SettingRow.IsEnabled>
                            <TextBox Text="{Binding Persisted.CaptureDelaySeconds, UpdateSourceTrigger=LostFocus}"
                                     Width="{StaticResource PlayAch.Size.Input.NarrowWidth}"
                                     TextAlignment="Right"/>
                        </controls:SettingRow>
                    </StackPanel>
                </Border>

                <!-- Screenshots -->
                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_ScreenshotsHeader}"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>
                        <Border Style="{StaticResource SectionAccentRuleStyle}"/>

                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_EnableUnlockScreenshots}">
                            <CheckBox IsChecked="{Binding Persisted.EnableUnlockScreenshots}"/>
                        </controls:SettingRow>

                        <StackPanel Margin="{StaticResource PlayAch.Thickness.SettingRow.Indent}"
                                    IsEnabled="{Binding Persisted.EnableUnlockScreenshots}"
                                    Grid.IsSharedSizeScope="True">
                            <!-- Clean variant: independent rarity threshold + completion bypass -->
                            <Border Style="{StaticResource CaptureVariantCardStyle}">
                                <StackPanel Grid.IsSharedSizeScope="True">
                                    <CheckBox IsChecked="{Binding Persisted.UnlockScreenshotClean}"
                                              Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}">
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_ScreenshotVariantClean}"
                                                   Style="{StaticResource SubSectionHeaderStyle}"/>
                                    </CheckBox>
                                    <StackPanel Margin="{StaticResource PlayAch.Thickness.SettingRow.Indent}"
                                                IsEnabled="{Binding Persisted.UnlockScreenshotClean}"
                                                Grid.IsSharedSizeScope="True">
                                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_CaptureMinimumRarity}">
                                            <Button x:Name="CleanRaritiesButton"
                                                    Style="{StaticResource AchievementSelectorButtonStyle}"
                                                    Content="{Binding CleanRaritiesText, ElementName=NotificationCapturesSectionRoot}"
                                                    Click="CleanRaritiesButton_Click"
                                                    MinWidth="140"
                                                    Height="{StaticResource PlayAch.Size.Control.Height}">
                                                <Button.ContextMenu>
                                                    <ContextMenu Style="{StaticResource AchievementSelectorContextMenuStyle}"
                                                                 ItemContainerStyle="{StaticResource AchievementMultiSelectMenuItemStyle}"/>
                                                </Button.ContextMenu>
                                            </Button>
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_AlwaysCaptureCompletion}">
                                            <CheckBox IsChecked="{Binding Persisted.UnlockScreenshotCleanAlwaysCaptureCompletion}"/>
                                        </controls:SettingRow>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- With-notification variant: independent rarity threshold + completion bypass -->
                            <Border Style="{StaticResource CaptureVariantCardStyle}">
                                <StackPanel Grid.IsSharedSizeScope="True">
                                    <CheckBox IsChecked="{Binding Persisted.UnlockScreenshotWithToast}"
                                              Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}">
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_ScreenshotVariantWithToast}"
                                                   Style="{StaticResource SubSectionHeaderStyle}"/>
                                    </CheckBox>
                                    <StackPanel Margin="{StaticResource PlayAch.Thickness.SettingRow.Indent}"
                                                IsEnabled="{Binding Persisted.UnlockScreenshotWithToast}"
                                                Grid.IsSharedSizeScope="True">
                                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_CaptureMinimumRarity}">
                                            <Button x:Name="WithToastRaritiesButton"
                                                    Style="{StaticResource AchievementSelectorButtonStyle}"
                                                    Content="{Binding WithToastRaritiesText, ElementName=NotificationCapturesSectionRoot}"
                                                    Click="WithToastRaritiesButton_Click"
                                                    MinWidth="140"
                                                    Height="{StaticResource PlayAch.Size.Control.Height}">
                                                <Button.ContextMenu>
                                                    <ContextMenu Style="{StaticResource AchievementSelectorContextMenuStyle}"
                                                                 ItemContainerStyle="{StaticResource AchievementMultiSelectMenuItemStyle}"/>
                                                </Button.ContextMenu>
                                            </Button>
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_AlwaysCaptureCompletion}">
                                            <CheckBox IsChecked="{Binding Persisted.UnlockScreenshotWithToastAlwaysCaptureCompletion}"/>
                                        </controls:SettingRow>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Framed variant: independent rarity threshold + completion bypass -->
                            <Border Style="{StaticResource CaptureVariantCardStyle}">
                                <StackPanel Grid.IsSharedSizeScope="True">
                                    <CheckBox IsChecked="{Binding Persisted.UnlockScreenshotFramed}"
                                              Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}">
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_ScreenshotVariantFramed}"
                                                   Style="{StaticResource SubSectionHeaderStyle}"/>
                                    </CheckBox>
                                    <StackPanel Margin="{StaticResource PlayAch.Thickness.SettingRow.Indent}"
                                                IsEnabled="{Binding Persisted.UnlockScreenshotFramed}"
                                                Grid.IsSharedSizeScope="True">
                                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_CaptureMinimumRarity}">
                                            <Button x:Name="FramedRaritiesButton"
                                                    Style="{StaticResource AchievementSelectorButtonStyle}"
                                                    Content="{Binding FramedRaritiesText, ElementName=NotificationCapturesSectionRoot}"
                                                    Click="FramedRaritiesButton_Click"
                                                    MinWidth="140"
                                                    Height="{StaticResource PlayAch.Size.Control.Height}">
                                                <Button.ContextMenu>
                                                    <ContextMenu Style="{StaticResource AchievementSelectorContextMenuStyle}"
                                                                 ItemContainerStyle="{StaticResource AchievementMultiSelectMenuItemStyle}"/>
                                                </Button.ContextMenu>
                                            </Button>
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_AlwaysCaptureCompletion}">
                                            <CheckBox IsChecked="{Binding Persisted.UnlockScreenshotFramedAlwaysCaptureCompletion}"/>
                                        </controls:SettingRow>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_ScreenshotSuffixes}"
                                       Style="{StaticResource SubSectionHeaderStyle}"
                                       Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}"/>
                            <StackPanel Margin="{StaticResource PlayAch.Thickness.SettingRow.Indent}" Grid.IsSharedSizeScope="True">
                                <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_ScreenshotVariantClean}">
                                    <TextBox Text="{Binding Persisted.UnlockScreenshotSuffixClean, UpdateSourceTrigger=PropertyChanged}"
                                             Width="160"/>
                                </controls:SettingRow>
                                <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_ScreenshotVariantWithToast}">
                                    <TextBox Text="{Binding Persisted.UnlockScreenshotSuffixWithToast, UpdateSourceTrigger=PropertyChanged}"
                                             Width="160"/>
                                </controls:SettingRow>
                                <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_ScreenshotVariantFramed}">
                                    <TextBox Text="{Binding Persisted.UnlockScreenshotSuffixFramed, UpdateSourceTrigger=PropertyChanged}"
                                             Width="160"/>
                                </controls:SettingRow>
                            </StackPanel>

                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_RecordingResolution}">
                                <ComboBox SelectedValue="{Binding Persisted.ScreenshotResolution, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Tag"
                                          MinWidth="140">
                                    <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_RecordingResolutionNative}" Tag="{x:Static settings:ScreenshotResolution.Native}"/>
                                    <ComboBoxItem Content="1080p" Tag="{x:Static settings:ScreenshotResolution.P1080}"/>
                                    <ComboBoxItem Content="720p" Tag="{x:Static settings:ScreenshotResolution.P720}"/>
                                </ComboBox>
                            </controls:SettingRow>

                            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_ScreenshotDirectory}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       Margin="{StaticResource PlayAch.Thickness.Bottom.Xs}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding Persisted.UnlockScreenshotDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="{DynamicResource LOCPlayAch_Button_Browse}"
                                        Click="ScreenshotDirectory_Browse_Click"
                                        Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Unlock recordings: in-process Windows.Graphics.Capture + Media Foundation
                     rolling capture and per-unlock clip export. No external tools. -->
                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_RecordingsHeader}"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>
                        <Border Style="{StaticResource SectionAccentRuleStyle}"/>

                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_EnableUnlockRecordings}">
                            <CheckBox IsChecked="{Binding Persisted.EnableUnlockRecordings}"/>
                        </controls:SettingRow>

                        <StackPanel Margin="{StaticResource PlayAch.Thickness.SettingRow.Indent}"
                                    IsEnabled="{Binding Persisted.EnableUnlockRecordings}"
                                    Grid.IsSharedSizeScope="True">
                            <!-- Clip variants mirror the screenshot variants: each has its own rarity
                                 threshold and completion bypass, and shares the screenshot suffixes. -->
                            <Border Style="{StaticResource CaptureVariantCardStyle}">
                                <StackPanel Grid.IsSharedSizeScope="True">
                                    <CheckBox IsChecked="{Binding Persisted.UnlockRecordingClean}"
                                              Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}">
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_ScreenshotVariantClean}"
                                                   Style="{StaticResource SubSectionHeaderStyle}"/>
                                    </CheckBox>
                                    <StackPanel Margin="{StaticResource PlayAch.Thickness.SettingRow.Indent}"
                                                IsEnabled="{Binding Persisted.UnlockRecordingClean}"
                                                Grid.IsSharedSizeScope="True">
                                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_CaptureMinimumRarity}">
                                            <Button x:Name="RecordingCleanRaritiesButton"
                                                    Style="{StaticResource AchievementSelectorButtonStyle}"
                                                    Content="{Binding RecordingCleanRaritiesText, ElementName=NotificationCapturesSectionRoot}"
                                                    Click="RecordingCleanRaritiesButton_Click"
                                                    MinWidth="140"
                                                    Height="{StaticResource PlayAch.Size.Control.Height}">
                                                <Button.ContextMenu>
                                                    <ContextMenu Style="{StaticResource AchievementSelectorContextMenuStyle}"
                                                                 ItemContainerStyle="{StaticResource AchievementMultiSelectMenuItemStyle}"/>
                                                </Button.ContextMenu>
                                            </Button>
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_AlwaysCaptureCompletion}">
                                            <CheckBox IsChecked="{Binding Persisted.UnlockRecordingCleanAlwaysCaptureCompletion}"/>
                                        </controls:SettingRow>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CaptureVariantCardStyle}">
                                <StackPanel Grid.IsSharedSizeScope="True">
                                    <CheckBox IsChecked="{Binding Persisted.UnlockRecordingWithToast}"
                                              Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}">
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_ScreenshotVariantWithToast}"
                                                   Style="{StaticResource SubSectionHeaderStyle}"/>
                                    </CheckBox>
                                    <StackPanel Margin="{StaticResource PlayAch.Thickness.SettingRow.Indent}"
                                                IsEnabled="{Binding Persisted.UnlockRecordingWithToast}"
                                                Grid.IsSharedSizeScope="True">
                                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_CaptureMinimumRarity}">
                                            <Button x:Name="RecordingRaritiesButton"
                                                    Style="{StaticResource AchievementSelectorButtonStyle}"
                                                    Content="{Binding RecordingRaritiesText, ElementName=NotificationCapturesSectionRoot}"
                                                    Click="RecordingRaritiesButton_Click"
                                                    MinWidth="140"
                                                    Height="{StaticResource PlayAch.Size.Control.Height}">
                                                <Button.ContextMenu>
                                                    <ContextMenu Style="{StaticResource AchievementSelectorContextMenuStyle}"
                                                                 ItemContainerStyle="{StaticResource AchievementMultiSelectMenuItemStyle}"/>
                                                </Button.ContextMenu>
                                            </Button>
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_AlwaysCaptureCompletion}">
                                            <CheckBox IsChecked="{Binding Persisted.UnlockRecordingAlwaysCaptureCompletion}"/>
                                        </controls:SettingRow>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CaptureVariantCardStyle}">
                                <StackPanel Grid.IsSharedSizeScope="True">
                                    <CheckBox IsChecked="{Binding Persisted.UnlockRecordingFramed}"
                                              Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}">
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_ScreenshotVariantFramed}"
                                                   Style="{StaticResource SubSectionHeaderStyle}"/>
                                    </CheckBox>
                                    <StackPanel Margin="{StaticResource PlayAch.Thickness.SettingRow.Indent}"
                                                IsEnabled="{Binding Persisted.UnlockRecordingFramed}"
                                                Grid.IsSharedSizeScope="True">
                                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_CaptureMinimumRarity}">
                                            <Button x:Name="RecordingFramedRaritiesButton"
                                                    Style="{StaticResource AchievementSelectorButtonStyle}"
                                                    Content="{Binding RecordingFramedRaritiesText, ElementName=NotificationCapturesSectionRoot}"
                                                    Click="RecordingFramedRaritiesButton_Click"
                                                    MinWidth="140"
                                                    Height="{StaticResource PlayAch.Size.Control.Height}">
                                                <Button.ContextMenu>
                                                    <ContextMenu Style="{StaticResource AchievementSelectorContextMenuStyle}"
                                                                 ItemContainerStyle="{StaticResource AchievementMultiSelectMenuItemStyle}"/>
                                                </Button.ContextMenu>
                                            </Button>
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_AlwaysCaptureCompletion}">
                                            <CheckBox IsChecked="{Binding Persisted.UnlockRecordingFramedAlwaysCaptureCompletion}"/>
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_ToastDurationSeconds}">
                                            <TextBox Text="{Binding Persisted.UnlockRecordingFramedSeconds, UpdateSourceTrigger=LostFocus, Converter={StaticResource NullableIntTextConverter}, ConverterParameter=1}"
                                                     Width="{StaticResource PlayAch.Size.Input.NarrowWidth}"
                                                     TextAlignment="Right"/>
                                        </controls:SettingRow>
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_RecordingFramedSecondsHint}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="{StaticResource PlayAch.Thickness.Bottom.SettingRow}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_RecordingDirectory}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       Margin="{StaticResource PlayAch.Thickness.Bottom.Xs}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding Persisted.UnlockRecordingDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="{DynamicResource LOCPlayAch_Button_Browse}"
                                        Click="RecordingDirectory_Browse_Click"
                                        Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_RecordingDirectoryHint}"
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="{StaticResource PlayAch.Thickness.Bottom.SettingRow}"/>

                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_RecordingClipSeconds}">
                                <TextBox Text="{Binding Persisted.RecordingClipSeconds, UpdateSourceTrigger=LostFocus}"
                                         Width="{StaticResource PlayAch.Size.Input.NarrowWidth}"
                                         TextAlignment="Right"/>
                            </controls:SettingRow>
                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_RecordingFps}">
                                <TextBox Text="{Binding Persisted.RecordingFps, UpdateSourceTrigger=LostFocus}"
                                         Width="{StaticResource PlayAch.Size.Input.NarrowWidth}"
                                         TextAlignment="Right"/>
                            </controls:SettingRow>
                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_RecordingResolution}">
                                <ComboBox SelectedValue="{Binding Persisted.RecordingResolution, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Tag"
                                          MinWidth="140">
                                    <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_RecordingResolutionNative}" Tag="{x:Static settings:RecordingResolution.Native}"/>
                                    <ComboBoxItem Content="1080p" Tag="{x:Static settings:RecordingResolution.P1080}"/>
                                    <ComboBoxItem Content="720p" Tag="{x:Static settings:RecordingResolution.P720}"/>
                                </ComboBox>
                            </controls:SettingRow>
                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_RecordingQuality}">
                                <ComboBox SelectedValue="{Binding Persisted.RecordingQuality, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Tag"
                                          MinWidth="140">
                                    <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_RecordingResolutionNative}" Tag="{x:Static settings:RecordingQuality.Native}"/>
                                    <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_RecordingQualityHigh}" Tag="{x:Static settings:RecordingQuality.High}"/>
                                    <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_RecordingQualityMedium}" Tag="{x:Static settings:RecordingQuality.Medium}"/>
                                    <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_RecordingQualityLow}" Tag="{x:Static settings:RecordingQuality.Low}"/>
                                </ComboBox>
                            </controls:SettingRow>

                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_RecordingIncludeAudio}"
                                                 Margin="{StaticResource PlayAch.Thickness.Bottom.SettingRow}">
                                <CheckBox IsChecked="{Binding Persisted.RecordingIncludeAudio}"/>
                            </controls:SettingRow>
                            <StackPanel Margin="{StaticResource PlayAch.Thickness.SettingRow.Indent}"
                                        IsEnabled="{Binding Persisted.RecordingIncludeAudio}"
                                        Grid.IsSharedSizeScope="True">
                                <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_RecordingAudioSource}">
                                    <ComboBox SelectedValue="{Binding Persisted.RecordingAudioSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Tag"
                                              MinWidth="160">
                                        <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_RecordingAudioSourceFull}" Tag="{x:Static settings:RecordingAudioSource.FullSystem}"/>
                                        <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_RecordingAudioSourceGame}" Tag="{x:Static settings:RecordingAudioSource.GameOnly}"/>
                                    </ComboBox>
                                </controls:SettingRow>
                                <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_RecordingIncludeMicrophone}"
                                                     Margin="0">
                                    <CheckBox IsChecked="{Binding Persisted.RecordingIncludeMicrophone}"/>
                                </controls:SettingRow>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
