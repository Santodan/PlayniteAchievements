<UserControl x:Class="PlayniteAchievements.Views.Settings.Notifications.NotificationBehaviorSection"
             x:Name="NotificationBehaviorSectionRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="clr-namespace:PlayniteAchievements.Models.Settings"
             xmlns:vm="clr-namespace:PlayniteAchievements.ViewModels"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/SettingsScopedControlStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource PlayAch.Brush.Panel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">
                <!-- What fires -->
                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <TextBlock Text="{DynamicResource LOCPlayAch_Section_Notifications}"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>
                        <Border Style="{StaticResource SectionAccentRuleStyle}"/>

                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_EnableNotifications}">
                            <CheckBox IsChecked="{Binding Persisted.EnableNotifications}"/>
                        </controls:SettingRow>
                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_EnableUnlockToasts}"
                                             Margin="18,0,0,14"
                                             IsEnabled="{Binding Persisted.EnableNotifications}">
                            <CheckBox IsChecked="{Binding Persisted.EnableUnlockToasts}"/>
                        </controls:SettingRow>
                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_EnableFriendUnlockToasts}"
                                             Margin="18,0,0,14"
                                             IsEnabled="{Binding Persisted.EnableNotifications}"
                                             Visibility="{Binding Persisted.EnableFriendsFeatures, Converter={StaticResource BoolToVis}}">
                            <CheckBox IsChecked="{Binding Persisted.EnableFriendUnlockToasts}"/>
                        </controls:SettingRow>
                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_EnableProgressToasts}"
                                             Margin="18,0,0,0"
                                             IsEnabled="{Binding Persisted.EnableNotifications}">
                            <CheckBox IsChecked="{Binding Persisted.EnableProgressToasts}"/>
                        </controls:SettingRow>
                    </StackPanel>
                </Border>

                <!-- How it fires -->
                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel IsEnabled="{Binding Persisted.EnableNotifications}"
                                Grid.IsSharedSizeScope="True">
                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_ToastBehavior}"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>
                        <Border Style="{StaticResource SectionAccentRuleStyle}"/>

                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_ToastDurationSeconds}">
                            <TextBox Text="{Binding Persisted.ToastDurationSeconds, UpdateSourceTrigger=LostFocus}"
                                     Width="{StaticResource PlayAch.Size.Input.NarrowWidth}"
                                     TextAlignment="Right"/>
                        </controls:SettingRow>
                        <!-- LostFocus keeps the delay un-normalized while it is being typed, so any
                             number can be entered without the setter rewriting it mid-keystroke. -->
                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_NotificationDelaySeconds}">
                            <TextBox Text="{Binding Persisted.NotificationDelaySeconds, UpdateSourceTrigger=LostFocus}"
                                     Width="{StaticResource PlayAch.Size.Input.NarrowWidth}"
                                     TextAlignment="Right"/>
                        </controls:SettingRow>
                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_MaxConcurrentToasts}">
                            <TextBox Text="{Binding Persisted.MaxConcurrentToasts, UpdateSourceTrigger=LostFocus}"
                                     Width="{StaticResource PlayAch.Size.Input.NarrowWidth}"
                                     TextAlignment="Right"/>
                        </controls:SettingRow>
                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_ToastPosition}">
                            <ComboBox SelectedValue="{Binding Persisted.ToastPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Tag"
                                      MinWidth="140">
                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_ToastPosition_BottomRight}" Tag="{x:Static settings:ToastScreenCorner.BottomRight}"/>
                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_ToastPosition_BottomLeft}" Tag="{x:Static settings:ToastScreenCorner.BottomLeft}"/>
                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_ToastPosition_TopRight}" Tag="{x:Static settings:ToastScreenCorner.TopRight}"/>
                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_ToastPosition_TopLeft}" Tag="{x:Static settings:ToastScreenCorner.TopLeft}"/>
                            </ComboBox>
                        </controls:SettingRow>

                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_EnableControllerVibration}"
                                             Margin="0,10,0,14">
                            <CheckBox IsChecked="{Binding Persisted.EnableControllerVibration}"/>
                        </controls:SettingRow>
                        <StackPanel Margin="18,0,0,0"
                                    IsEnabled="{Binding Persisted.EnableControllerVibration}"
                                    Grid.IsSharedSizeScope="True">
                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_ControllerVibrationStrength}">
                                <StackPanel Orientation="Horizontal">
                                    <Slider Style="{StaticResource SettingsSliderStyle}"
                                            Minimum="0" Maximum="100"
                                            SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding Persisted.ControllerVibrationStrengthPercent, Mode=TwoWay}"
                                            Width="160"
                                            VerticalAlignment="Center"
                                            Margin="{StaticResource PlayAch.Thickness.Right.Sm}"/>
                                    <TextBox Text="{Binding Persisted.ControllerVibrationStrengthPercent, UpdateSourceTrigger=LostFocus}"
                                             Width="{StaticResource PlayAch.Size.Input.NarrowWidth}"
                                             TextAlignment="Right"/>
                                </StackPanel>
                            </controls:SettingRow>
                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_ControllerVibrationDuration}">
                                <StackPanel Orientation="Horizontal">
                                    <Slider Style="{StaticResource SettingsSliderStyle}"
                                            Minimum="100" Maximum="2000"
                                            SmallChange="50" LargeChange="250" TickFrequency="50" IsSnapToTickEnabled="True"
                                            Value="{Binding Persisted.ControllerVibrationDurationMs, Mode=TwoWay}"
                                            Width="160"
                                            VerticalAlignment="Center"
                                            Margin="{StaticResource PlayAch.Thickness.Right.Sm}"/>
                                    <TextBox Text="{Binding Persisted.ControllerVibrationDurationMs, UpdateSourceTrigger=LostFocus}"
                                             Width="{StaticResource PlayAch.Size.Input.NarrowWidth}"
                                             TextAlignment="Right"/>
                                </StackPanel>
                            </controls:SettingRow>
                            <!-- Pulses at the current settings without firing a whole notification
                                 wave, and logs which controllers were reached. -->
                            <Button Click="TestVibration_Click"
                                    Content="{DynamicResource LOCPlayAch_Button_Test}"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,0"/>
                        </StackPanel>

                        <!-- Unlock sounds: played by the plugin's own sound host. Per tier, the
                             user's file wins, then the active theme's, then the bundled default. -->
                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_EnableUnlockSounds}"
                                             Margin="0,14,0,14">
                            <CheckBox IsChecked="{Binding Persisted.EnableUnlockSounds}"/>
                        </controls:SettingRow>
                        <StackPanel Margin="18,0,0,0"
                                    IsEnabled="{Binding Persisted.EnableUnlockSounds}"
                                    Grid.IsSharedSizeScope="True">
                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_UnlockSoundVolume}">
                                <StackPanel Orientation="Horizontal">
                                    <Slider Style="{StaticResource SettingsSliderStyle}"
                                            Minimum="0" Maximum="100"
                                            SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding Persisted.UnlockSoundVolumePercent, Mode=TwoWay}"
                                            Width="160"
                                            VerticalAlignment="Center"
                                            Margin="{StaticResource PlayAch.Thickness.Right.Sm}"/>
                                    <TextBox Text="{Binding Persisted.UnlockSoundVolumePercent, UpdateSourceTrigger=LostFocus}"
                                             Width="{StaticResource PlayAch.Size.Input.NarrowWidth}"
                                             TextAlignment="Right"/>
                                </StackPanel>
                            </controls:SettingRow>
                            <!-- Drops the theme step out of the per-tier chain, leaving the user's
                                 own file and the bundled default. On by default so a theme that
                                 ships sounds is heard without configuring anything. -->
                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_UseThemeUnlockSounds}">
                                <CheckBox IsChecked="{Binding Persisted.AllowThemeUnlockSounds}"/>
                            </controls:SettingRow>
                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_UseHiddenUnlockSound}">
                                <CheckBox IsChecked="{Binding Persisted.UseHiddenUnlockSound}"/>
                            </controls:SettingRow>
                            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_UnlockSoundFilesHint}"
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"/>
                            <!-- DataContext island (see UnlockSoundSettingsViewModel); one row per tier.
                                 Button handlers read the row from the sender's DataContext. -->
                            <ItemsControl x:Name="UnlockSoundRows"
                                          ItemsSource="{Binding Rows}"
                                          Grid.IsSharedSizeScope="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:UnlockSoundRowItem}">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="UnlockSoundTier"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="UnlockSoundSource"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- The tier's own badge, drawn from the user's rarity
                                                 appearance, so the table reads as the notifications
                                                 it configures. -->
                                            <Image Grid.Column="0"
                                                   Source="{Binding BadgeImage}"
                                                   Width="20"
                                                   Height="20"
                                                   Stretch="Uniform"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding TierLabel}"
                                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SourceLabel}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{Binding ResolvedPath}"
                                                       Margin="0,0,10,0"/>
                                            <TextBox Grid.Column="3"
                                                     Text="{Binding CustomPath, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="{Binding ResolvedPath}"
                                                     VerticalAlignment="Center"/>
                                            <!-- Drawn over the empty box, not behind it, so the
                                                 theme's TextBox background cannot hide it; clicks
                                                 pass through to the box underneath. Names the file
                                                 a blank tier will actually play, so an
                                                 unconfigured row reads as its source rather than
                                                 as nothing. -->
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding ResolvedFileName}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsHitTestVisible="False"
                                                       Margin="5,0,4,0"
                                                       Visibility="{Binding ShowResolvedFileName, Converter={StaticResource BoolToVis}}"/>
                                            <Button Grid.Column="4"
                                                    Click="UnlockSoundBrowse_Click"
                                                    Content="{DynamicResource LOCPlayAch_Button_Browse}"
                                                    Margin="6,0,0,0"/>
                                            <Button Grid.Column="5"
                                                    Click="UnlockSoundClear_Click"
                                                    Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                                    IsEnabled="{Binding HasCustomPath}"
                                                    Margin="6,0,0,0"/>
                                            <Button Grid.Column="6"
                                                    Click="UnlockSoundTest_Click"
                                                    Content="{DynamicResource LOCPlayAch_Button_Test}"
                                                    Margin="6,0,0,0"/>
                                            <!-- Plays what a theme ships for this tier, in either
                                                 Playnite mode, whatever the chain currently
                                                 resolves to. Disabled when neither theme provides
                                                 the tier. -->
                                            <Button Grid.Column="7"
                                                    Click="UnlockSoundTheme_Click"
                                                    Content="{DynamicResource LOCPlayAch_Settings_Style_FireTheme}"
                                                    ToolTip="{DynamicResource LOCPlayAch_Settings_UnlockSoundTheme_Tooltip}"
                                                    IsEnabled="{Binding HasThemeCandidates}"
                                                    Margin="6,0,0,0">
                                                <Button.ContextMenu>
                                                    <!-- Plain action items, not the checkable ones
                                                         the rarity selectors use: each entry plays
                                                         a sound rather than toggling a value. -->
                                                    <ContextMenu Style="{StaticResource AchievementSelectorContextMenuStyle}"
                                                                 ItemContainerStyle="{StaticResource AchievementContextMenuItemStyle}"/>
                                                </Button.ContextMenu>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
