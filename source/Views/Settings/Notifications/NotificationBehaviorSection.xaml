<UserControl x:Class="PlayniteAchievements.Views.Settings.Notifications.NotificationBehaviorSection"
             x:Name="NotificationBehaviorSectionRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="clr-namespace:PlayniteAchievements.Models.Settings"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/SettingsScopedControlStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource PlayAch.Brush.Panel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContentPanel" Margin="20">
                <!-- Game mode only: whether this game has its own behavior. Without it the
                     settings below show the inherited values, read-only. -->
                <CheckBox x:Name="GameCustomizeCheckBox"
                          Content="{DynamicResource LOCPlayAch_ManageAchievements_Notifications_CustomizeBehavior}"
                          Click="GameCustomizeCheckBox_Click"
                          Visibility="Collapsed"
                          Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>

                <StackPanel x:Name="SettingsBody">
                <!-- What fires -->
                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <TextBlock Text="{DynamicResource LOCPlayAch_Common_Notifications}"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>
                        <Border Style="{StaticResource SectionAccentRuleStyle}"/>

                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_EnableNotifications}">
                            <CheckBox IsChecked="{Binding Persisted.EnableNotifications}"/>
                        </controls:SettingRow>
                        <StackPanel Margin="{StaticResource PlayAch.Thickness.SettingRow.Indent}"
                                    IsEnabled="{Binding Persisted.EnableNotifications}"
                                    Grid.IsSharedSizeScope="True">
                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_EnableUnlockToasts}">
                                <CheckBox IsChecked="{Binding Persisted.EnableUnlockToasts}"/>
                            </controls:SettingRow>
                            <!-- App-wide; collapses in game mode with the other *GlobalRow rows. -->
                            <controls:SettingRow x:Name="SkipCompletionGlobalRow"
                                                 Label="{DynamicResource LOCPlayAch_Settings_SkipCompletionAfterCapstone}">
                                <CheckBox IsChecked="{Binding Persisted.SkipCompletionNotificationAfterCapstone}"/>
                            </controls:SettingRow>
                            <controls:SettingRow x:Name="FriendUnlockToastsRow"
                                                 Label="{DynamicResource LOCPlayAch_Settings_EnableFriendUnlockToasts}"
                                                 Visibility="{Binding Persisted.EnableFriendsFeatures, Converter={StaticResource BoolToVis}}">
                                <CheckBox IsChecked="{Binding Persisted.EnableFriendUnlockToasts}"/>
                            </controls:SettingRow>
                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_EnableProgressToasts}">
                                <CheckBox IsChecked="{Binding Persisted.EnableProgressToasts}"/>
                            </controls:SettingRow>
                            <StackPanel Margin="{StaticResource PlayAch.Thickness.SettingRow.Indent}"
                                        IsEnabled="{Binding Persisted.EnableProgressToasts}"
                                        Grid.IsSharedSizeScope="True">
                                <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_ProgressToastIntervalPercent}"
                                                     Hint="{DynamicResource LOCPlayAch_Settings_ProgressToastIntervalPercent_Hint}"
                                                     Margin="0">
                                    <TextBox Text="{Binding Persisted.ProgressToastIntervalPercent, UpdateSourceTrigger=LostFocus}"
                                             Width="{StaticResource PlayAch.Size.Input.NarrowWidth}"
                                             TextAlignment="Right"/>
                                </controls:SettingRow>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- How it fires -->
                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel IsEnabled="{Binding Persisted.EnableNotifications}"
                                Grid.IsSharedSizeScope="True">
                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_ToastBehavior}"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>
                        <Border Style="{StaticResource SectionAccentRuleStyle}"/>

                        <!-- Rows named *GlobalRow stay app-wide and collapse in game mode. -->
                        <controls:SettingRow x:Name="DurationGlobalRow"
                                             Label="{DynamicResource LOCPlayAch_Settings_ToastDurationSeconds}">
                            <TextBox Text="{Binding Persisted.ToastDurationSeconds, UpdateSourceTrigger=LostFocus}"
                                     Width="{StaticResource PlayAch.Size.Input.NarrowWidth}"
                                     TextAlignment="Right"/>
                        </controls:SettingRow>
                        <!-- LostFocus keeps the delay un-normalized while it is being typed, so any
                             number can be entered without the setter rewriting it mid-keystroke. -->
                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_NotificationDelaySeconds}">
                            <TextBox Text="{Binding Persisted.NotificationDelaySeconds, UpdateSourceTrigger=LostFocus}"
                                     Width="{StaticResource PlayAch.Size.Input.NarrowWidth}"
                                     TextAlignment="Right"/>
                        </controls:SettingRow>
                        <controls:SettingRow x:Name="MaxConcurrentGlobalRow"
                                             Label="{DynamicResource LOCPlayAch_Settings_MaxConcurrentToasts}">
                            <TextBox Text="{Binding Persisted.MaxConcurrentToasts, UpdateSourceTrigger=LostFocus}"
                                     Width="{StaticResource PlayAch.Size.Input.NarrowWidth}"
                                     TextAlignment="Right"/>
                        </controls:SettingRow>
                        <controls:SettingRow x:Name="PositionGlobalRow"
                                             Label="{DynamicResource LOCPlayAch_Settings_Style_Position}">
                            <ComboBox SelectedValue="{Binding Persisted.ToastPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Tag"
                                      MinWidth="140">
                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_ToastPosition_BottomRight}" Tag="{x:Static settings:ToastScreenCorner.BottomRight}"/>
                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_ToastPosition_BottomLeft}" Tag="{x:Static settings:ToastScreenCorner.BottomLeft}"/>
                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_ToastPosition_BottomCenter}" Tag="{x:Static settings:ToastScreenCorner.BottomCenter}"/>
                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_ToastPosition_TopRight}" Tag="{x:Static settings:ToastScreenCorner.TopRight}"/>
                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_ToastPosition_TopLeft}" Tag="{x:Static settings:ToastScreenCorner.TopLeft}"/>
                            </ComboBox>
                        </controls:SettingRow>
                        <controls:SettingRow x:Name="RenderModeGlobalRow"
                                             Label="{DynamicResource LOCPlayAch_Settings_NotificationRenderMode}"
                                             Hint="{DynamicResource LOCPlayAch_Settings_NotificationRenderMode_Hint}">
                            <ComboBox SelectedValue="{Binding Persisted.NotificationRenderMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Tag"
                                      MinWidth="140">
                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_NotificationRenderMode_Performance}" Tag="{x:Static settings:NotificationRenderMode.Performance}"/>
                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_RecordingQuality}" Tag="{x:Static settings:NotificationRenderMode.Quality}"/>
                            </ComboBox>
                        </controls:SettingRow>

                        <controls:SettingRow x:Name="VibrationGlobalRow"
                                             Label="{DynamicResource LOCPlayAch_Settings_EnableControllerVibration}">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding Persisted.EnableControllerVibration}"
                                          VerticalAlignment="Center"
                                          Margin="{StaticResource PlayAch.Thickness.Right.Sm}"/>
                                <!-- Pulses at the current settings without firing a whole notification
                                     wave, and logs which controllers were reached. -->
                                <Button Click="TestVibration_Click"
                                        Content="{DynamicResource LOCPlayAch_Button_Test}"
                                        IsEnabled="{Binding Persisted.EnableControllerVibration}"/>
                            </StackPanel>
                        </controls:SettingRow>
                        <StackPanel x:Name="VibrationGlobalPanel"
                                    Margin="{StaticResource PlayAch.Thickness.SettingRow.Indent}"
                                    IsEnabled="{Binding Persisted.EnableControllerVibration}"
                                    Grid.IsSharedSizeScope="True">
                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_ControllerVibrationStrength}">
                                <StackPanel Orientation="Horizontal">
                                    <Slider Style="{StaticResource SettingsSliderStyle}"
                                            Minimum="0" Maximum="100"
                                            SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding Persisted.ControllerVibrationStrengthPercent, Mode=TwoWay}"
                                            Width="160"
                                            VerticalAlignment="Center"
                                            Margin="{StaticResource PlayAch.Thickness.Right.Sm}"/>
                                    <TextBox Text="{Binding Persisted.ControllerVibrationStrengthPercent, UpdateSourceTrigger=LostFocus}"
                                             Width="{StaticResource PlayAch.Size.Input.NarrowWidth}"
                                             TextAlignment="Right"/>
                                </StackPanel>
                            </controls:SettingRow>
                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_ControllerVibrationDuration}">
                                <StackPanel Orientation="Horizontal">
                                    <Slider Style="{StaticResource SettingsSliderStyle}"
                                            Minimum="100" Maximum="2000"
                                            SmallChange="50" LargeChange="250" TickFrequency="50" IsSnapToTickEnabled="True"
                                            Value="{Binding Persisted.ControllerVibrationDurationMs, Mode=TwoWay}"
                                            Width="160"
                                            VerticalAlignment="Center"
                                            Margin="{StaticResource PlayAch.Thickness.Right.Sm}"/>
                                    <TextBox Text="{Binding Persisted.ControllerVibrationDurationMs, UpdateSourceTrigger=LostFocus}"
                                             Width="{StaticResource PlayAch.Size.Input.NarrowWidth}"
                                             TextAlignment="Right"/>
                                </StackPanel>
                            </controls:SettingRow>
                        </StackPanel>
                    </StackPanel>
                </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
