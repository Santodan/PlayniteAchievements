<UserControl x:Class="PlayniteAchievements.Views.Settings.Workshop.WorkshopBundlesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/SettingsScopedControlStyles.xaml"/>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">
                <!-- The whole global look as one .pabundle bundle: colors, unlock sounds,
                     notification and frame styles, any subset, each a checkbox on export and on
                     import. Import adds each chosen part to its preset list; nothing applies here. -->
                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Workshop_Kind_Bundle}"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>
                        <Border Style="{StaticResource SectionAccentRuleStyle}"/>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Workshop_BundlesHint}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Button Content="{DynamicResource LOCPlayAch_Workshop_ExportBundle}" ContentTemplate="{DynamicResource PlayAch.ButtonContent.Export}"
                                    Click="ExportBundle_Click"
                                    Margin="0,0,8,0"/>
                            <Button Content="{DynamicResource LOCPlayAch_Workshop_ImportBundle}" ContentTemplate="{DynamicResource PlayAch.ButtonContent.Import}"
                                    Click="ImportBundle_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
