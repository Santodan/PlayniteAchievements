<UserControl x:Class="PlayniteAchievements.Views.Settings.Workshop.WorkshopAccountSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/SettingsScopedControlStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource PlayAch.Brush.Panel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">
                <!-- Who this install is on the Workshop: the name shown on submissions and the
                     random key whose hash owns them. No account exists anywhere else, so the key
                     is the only thing that lets another install update the same items. -->
                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <TextBlock Text="{DynamicResource LOCPlayAch_Workshop_Account}"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>
                        <Border Style="{StaticResource SectionAccentRuleStyle}"/>

                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Workshop_Share_AuthorName}">
                            <TextBox x:Name="NameBox"
                                     MinWidth="280"
                                     MaxLength="40"
                                     LostFocus="NameBox_LostFocus"/>
                        </controls:SettingRow>

                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Workshop_SubmitterKey}"
                                             Hint="{DynamicResource LOCPlayAch_Workshop_SubmitterKeyHint}"
                                             Margin="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="KeyBox"
                                         MinWidth="420"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"/>
                                <Button Content="{DynamicResource LOCPlayAch_Common_Copy}"
                                        Click="CopyKey_Click"
                                        Margin="8,0,0,0"/>
                                <Button Content="{DynamicResource LOCPlayAch_Button_Paste}"
                                        Click="PasteKey_Click"
                                        Margin="8,0,0,0"/>
                            </StackPanel>
                        </controls:SettingRow>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
