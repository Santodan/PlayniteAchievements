<UserControl x:Class="PlayniteAchievements.Views.Settings.General.GeneralOverviewSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/SettingsScopedControlStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/LogoResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <!-- MinHeight fills the viewport so the links row sits at the bottom when the page is
             shorter than the window, and scrolls with the content when it is taller. The grid
             itself has no margin so the MinHeight never forces a scrollbar. -->
        <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,20,20,0">

                <!-- Settings Header -->
                <Border Style="{StaticResource SectionBorderStyle}"
                        Background="{DynamicResource PlayAch.Brush.Panel}"
                        BorderBrush="{DynamicResource PlayAch.Brush.Border}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource PlayAch.Image.Logo}"
                               Width="32"
                               Height="32"
                               VerticalAlignment="Center"
                               Margin="{StaticResource PlayAch.Thickness.Right.Compact}"/>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Description}"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0"/>
                    </StackPanel>
                </Border>

                <!-- Prominent quick links to other settings tabs -->
                <Grid Margin="0,12,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource ProminentLinkButtonStyle}"
                            Click="JumpToTab_Click"
                            CommandParameter="Display"
                            ToolTip="{DynamicResource LOCPlayAch_Settings_TabDisplay}"
                            AutomationProperties.Name="{DynamicResource LOCPlayAch_Settings_TabDisplay}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="20" Margin="0,0,10,0" Text="&#xE7F4;" Foreground="{DynamicResource PlayAch.Brush.Accent}"/>
                            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_TabDisplay}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Style="{StaticResource ProminentLinkButtonStyle}"
                            Click="JumpToTab_Click"
                            CommandParameter="Providers"
                            ToolTip="{DynamicResource LOCPlayAch_CustomRefresh_ProvidersHeader}"
                            AutomationProperties.Name="{DynamicResource LOCPlayAch_CustomRefresh_ProvidersHeader}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="20" Margin="0,0,10,0" Text="&#xE753;" Foreground="{DynamicResource PlayAch.Brush.Accent}"/>
                            <TextBlock Text="{DynamicResource LOCPlayAch_CustomRefresh_ProvidersHeader}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource ProminentLinkButtonStyle}"
                            Click="JumpToTab_Click"
                            CommandParameter="ThemeMigration"
                            ToolTip="{DynamicResource LOCPlayAch_ThemeMigration_Title}"
                            AutomationProperties.Name="{DynamicResource LOCPlayAch_ThemeMigration_Title}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="20" Margin="0,0,10,0" Text="&#xE8AB;" Foreground="{DynamicResource PlayAch.Brush.Accent}"/>
                            <TextBlock Text="{DynamicResource LOCPlayAch_ThemeMigration_Title}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ================== FRIENDS ================== -->
                <Border Style="{StaticResource SectionBorderStyle}" Grid.IsSharedSizeScope="True">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Friends}"
                                   Style="{StaticResource SectionHeaderStyle}"/>

                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_EnableFriendsFeatures}"
                                             Hint="{DynamicResource LOCPlayAch_Settings_EnableFriendsFeatures_Description}"
                                             Margin="0">
                            <CheckBox IsChecked="{Binding Persisted.EnableFriendsFeatures}"/>
                        </controls:SettingRow>
                    </StackPanel>
                </Border>

                <!-- ================== LANGUAGE ================== -->
                <Border Style="{StaticResource SectionBorderStyle}" Grid.IsSharedSizeScope="True">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Language}"
                                   Style="{StaticResource SectionHeaderStyle}"/>

                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_Language}"
                                             Hint="{DynamicResource LOCPlayAch_Settings_LanguageHint}"
                                             Margin="0">
                            <ComboBox Width="200"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding Persisted.GlobalLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="English" Tag="english"/>
                                <ComboBoxItem Content="German (Deutsch)" Tag="german"/>
                                <ComboBoxItem Content="French (Français)" Tag="french"/>
                                <ComboBoxItem Content="Spanish (Español)" Tag="spanish"/>
                                <ComboBoxItem Content="Italian (Italiano)" Tag="italian"/>
                                <ComboBoxItem Content="Portuguese (Português)" Tag="portuguese"/>
                                <ComboBoxItem Content="Brazilian Portuguese (Português brasileiro)" Tag="brazilian"/>
                                <ComboBoxItem Content="Russian (Русский)" Tag="russian"/>
                                <ComboBoxItem Content="Polish (Polski)" Tag="polish"/>
                                <ComboBoxItem Content="Dutch (Nederlands)" Tag="dutch"/>
                                <ComboBoxItem Content="Swedish (Svenska)" Tag="swedish"/>
                                <ComboBoxItem Content="Finnish (Suomi)" Tag="finnish"/>
                                <ComboBoxItem Content="Danish (Dansk)" Tag="danish"/>
                                <ComboBoxItem Content="Norwegian (Norsk)" Tag="norwegian"/>
                                <ComboBoxItem Content="Hungarian (Magyar)" Tag="hungarian"/>
                                <ComboBoxItem Content="Czech (Čeština)" Tag="czech"/>
                                <ComboBoxItem Content="Romanian (Română)" Tag="romanian"/>
                                <ComboBoxItem Content="Turkish (Türkçe)" Tag="turkish"/>
                                <ComboBoxItem Content="Greek (Ελληνικά)" Tag="greek"/>
                                <ComboBoxItem Content="Bulgarian (Български)" Tag="bulgarian"/>
                                <ComboBoxItem Content="Ukrainian (Українська)" Tag="ukrainian"/>
                                <ComboBoxItem Content="Thai (ไทย)" Tag="thai"/>
                                <ComboBoxItem Content="Vietnamese (Tiếng Việt)" Tag="vietnamese"/>
                                <ComboBoxItem Content="Japanese (日本語)" Tag="japanese"/>
                                <ComboBoxItem Content="Korean (한국어)" Tag="koreana"/>
                                <ComboBoxItem Content="Simplified Chinese (简体中文)" Tag="schinese"/>
                                <ComboBoxItem Content="Traditional Chinese (繁體中文)" Tag="tchinese"/>
                                <ComboBoxItem Content="Arabic (العربية)" Tag="arabic"/>
                            </ComboBox>
                        </controls:SettingRow>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ================== LINKS ================== -->
            <Border Grid.Row="2"
                    Style="{StaticResource SectionBorderStyle}"
                    Margin="20,0,20,20">
                <Grid Margin="-4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style x:Key="LinkIconBoxStyle" TargetType="Viewbox">
                            <Setter Property="Width" Value="20"/>
                            <Setter Property="Height" Value="20"/>
                            <Setter Property="Stretch" Value="Uniform"/>
                            <Setter Property="Margin" Value="0,0,10,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <Style x:Key="LinkTitleStyle" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                        <Style x:Key="LinkCaptionStyle" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
                            <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Caption}"/>
                            <Setter Property="Opacity" Value="{StaticResource PlayAch.Opacity.Muted}"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </Grid.Resources>

                    <Button Grid.Column="0" Style="{StaticResource CompactLinkButtonStyle}"
                            Click="OpenLink_Click"
                            Tag="https://github.com/justin-delano/PlayniteAchievements"
                            ToolTip="https://github.com/justin-delano/PlayniteAchievements"
                            AutomationProperties.Name="GitHub">
                        <DockPanel>
                            <Viewbox Style="{StaticResource LinkIconBoxStyle}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource PlayAch.Geometry.Brand.GitHub}"
                                          Fill="{DynamicResource PlayAch.Brush.Text}"/>
                                </Canvas>
                            </Viewbox>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="GitHub" Style="{StaticResource LinkTitleStyle}"/>
                                <TextBlock Text="justin-delano/PlayniteAchievements" Style="{StaticResource LinkCaptionStyle}"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>

                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource CompactLinkButtonStyle}"
                            Click="OpenLink_Click"
                            Tag="https://github.com/justin-delano/PlayniteAchievements/wiki"
                            ToolTip="https://github.com/justin-delano/PlayniteAchievements/wiki"
                            AutomationProperties.Name="GitHub Wiki">
                        <DockPanel>
                            <Viewbox Style="{StaticResource LinkIconBoxStyle}">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE736;"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"/>
                            </Viewbox>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="GitHub Wiki" Style="{StaticResource LinkTitleStyle}"/>
                                <TextBlock Text="justin-delano/PlayniteAchievements/wiki" Style="{StaticResource LinkCaptionStyle}"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>

                    <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource CompactLinkButtonStyle}"
                            Click="OpenLink_Click"
                            Tag="https://discord.gg/hSFvmN6"
                            ToolTip="https://discord.gg/hSFvmN6"
                            AutomationProperties.Name="Playnite Discord">
                        <DockPanel>
                            <Viewbox Style="{StaticResource LinkIconBoxStyle}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource PlayAch.Geometry.Brand.Discord}"
                                          Fill="{StaticResource PlayAch.Brush.Brand.Discord}"/>
                                </Canvas>
                            </Viewbox>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Playnite Discord" Style="{StaticResource LinkTitleStyle}"/>
                                <TextBlock Text="#extensions-forum › PlayniteAchievements" Style="{StaticResource LinkCaptionStyle}"/>
                                <TextBlock Text="#extensions-devel › PlayniteAchievements Dev" Style="{StaticResource LinkCaptionStyle}"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>

                    <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource CompactLinkButtonStyle}"
                            Click="OpenLink_Click"
                            Tag="https://ko-fi.com/justindelano"
                            ToolTip="https://ko-fi.com/justindelano"
                            AutomationProperties.Name="Ko-fi">
                        <DockPanel>
                            <Viewbox Style="{StaticResource LinkIconBoxStyle}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource PlayAch.Geometry.Brand.Kofi}"
                                          Fill="{StaticResource PlayAch.Brush.Brand.Kofi}"/>
                                </Canvas>
                            </Viewbox>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ko-fi" Style="{StaticResource LinkTitleStyle}"/>
                                <TextBlock Text="ko-fi.com/justindelano" Style="{StaticResource LinkCaptionStyle}"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
