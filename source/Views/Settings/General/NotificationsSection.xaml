<UserControl x:Class="PlayniteAchievements.Views.Settings.General.NotificationsSection"
             x:Name="NotificationsSectionRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="clr-namespace:PlayniteAchievements.Models.Settings"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             xmlns:vm="clr-namespace:PlayniteAchievements.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/SettingsScopedControlStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Captures this section's DataContext (the settings view model) so DataGrid columns
                 inside the provider-overrides grid (a DataContext island, and columns are not in
                 the visual tree) can bind back to persisted settings. -->
            <helpers:BindingProxy x:Key="NotificationsSectionContext" Data="{Binding}"/>

            <!-- Themed like the achievement grids, but with a compact settings-row height and no
                 achievement-style hand cursor (mirrors FriendsSettingsGridRowStyle). -->
            <Style x:Key="ProviderOverridesGridRowStyle"
                   TargetType="DataGridRow"
                   BasedOn="{StaticResource AchievementRowStyle}">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource PlayAch.Brush.Panel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">
                <!-- General notifications -->
                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Section_Notifications}"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>
                        <Border Style="{StaticResource SectionAccentRuleStyle}"/>
                        <CheckBox Content="{DynamicResource LOCPlayAch_Settings_EnableNotifications}"
                                  IsChecked="{Binding Persisted.EnableNotifications}"
                                  Margin="0,0,0,10"/>
                        <CheckBox Content="{DynamicResource LOCPlayAch_Settings_EnableUnlockToasts}"
                                  IsChecked="{Binding Persisted.EnableUnlockToasts}"
                                  Margin="18,0,0,10"
                                  IsEnabled="{Binding Persisted.EnableNotifications}"/>
                        <CheckBox Content="{DynamicResource LOCPlayAch_Settings_EnableFriendUnlockToasts}"
                                  IsChecked="{Binding Persisted.EnableFriendUnlockToasts}"
                                  Margin="18,0,0,0"
                                  IsEnabled="{Binding Persisted.EnableNotifications}"
                                  Visibility="{Binding Persisted.EnableFriendsFeatures, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- Behavior -->
                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel IsEnabled="{Binding Persisted.EnableNotifications}">
                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_ToastBehavior}"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>
                        <Border Style="{StaticResource SectionAccentRuleStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="{DynamicResource LOCPlayAch_Settings_ToastDurationSeconds}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,8"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding Persisted.ToastDurationSeconds, UpdateSourceTrigger=LostFocus}"
                                     Width="{StaticResource PlayAch.Size.Input.NarrowWidth}"
                                     TextAlignment="Right"
                                     Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="{DynamicResource LOCPlayAch_Settings_MaxConcurrentToasts}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,8"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding Persisted.MaxConcurrentToasts, UpdateSourceTrigger=LostFocus}"
                                     Width="{StaticResource PlayAch.Size.Input.NarrowWidth}"
                                     TextAlignment="Right"
                                     Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="{DynamicResource LOCPlayAch_Settings_ToastPosition}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <ComboBox Grid.Row="2" Grid.Column="1"
                                      SelectedValue="{Binding Persisted.ToastPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Tag"
                                      MinWidth="140">
                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_ToastPosition_BottomRight}" Tag="{x:Static settings:ToastScreenCorner.BottomRight}"/>
                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_ToastPosition_BottomLeft}" Tag="{x:Static settings:ToastScreenCorner.BottomLeft}"/>
                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_ToastPosition_TopRight}" Tag="{x:Static settings:ToastScreenCorner.TopRight}"/>
                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_ToastPosition_TopLeft}" Tag="{x:Static settings:ToastScreenCorner.TopLeft}"/>
                            </ComboBox>
                        </Grid>

                        <CheckBox Content="{DynamicResource LOCPlayAch_Settings_EnableControllerVibration}"
                                  IsChecked="{Binding Persisted.EnableControllerVibration}"
                                  Margin="0,10,0,10"/>
                        <Grid Margin="18,0,0,0"
                              IsEnabled="{Binding Persisted.EnableControllerVibration}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="{DynamicResource LOCPlayAch_Settings_ControllerVibrationStrength}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,8"/>
                            <Slider Grid.Row="0" Grid.Column="1"
                                    Style="{StaticResource SettingsSliderStyle}"
                                    Minimum="0" Maximum="100"
                                    SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding Persisted.ControllerVibrationStrengthPercent, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,8"/>
                            <TextBox Grid.Row="0" Grid.Column="2"
                                     Text="{Binding Persisted.ControllerVibrationStrengthPercent, UpdateSourceTrigger=LostFocus}"
                                     Width="{StaticResource PlayAch.Size.Input.NarrowWidth}"
                                     TextAlignment="Right"
                                     Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="{DynamicResource LOCPlayAch_Settings_ControllerVibrationDuration}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <Slider Grid.Row="1" Grid.Column="1"
                                    Style="{StaticResource SettingsSliderStyle}"
                                    Minimum="100" Maximum="2000"
                                    SmallChange="50" LargeChange="250" TickFrequency="50" IsSnapToTickEnabled="True"
                                    Value="{Binding Persisted.ControllerVibrationDurationMs, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"/>
                            <TextBox Grid.Row="1" Grid.Column="2"
                                     Text="{Binding Persisted.ControllerVibrationDurationMs, UpdateSourceTrigger=LostFocus}"
                                     Width="{StaticResource PlayAch.Size.Input.NarrowWidth}"
                                     TextAlignment="Right"/>

                            <!-- Pulses at the current settings without firing a whole notification
                                 wave, and logs which controllers were reached. -->
                            <Button Grid.Row="2" Grid.Column="1"
                                    Click="TestVibration_Click"
                                    Content="{DynamicResource LOCPlayAch_Button_Test}"
                                    HorizontalAlignment="Right"
                                    Margin="0,8,8,0"/>
                        </Grid>

                        <!-- Unlock sounds are fired as a URI that UniPlaySong handles; this plugin
                             plays no audio itself and cannot tell whether a sound was heard. -->
                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_UnlockSoundHint}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,14,0,6"/>
                        <CheckBox Content="{DynamicResource LOCPlayAch_Settings_UseHiddenUnlockSound}"
                                  IsChecked="{Binding Persisted.UseHiddenUnlockSound}"
                                  Margin="0,0,0,4"/>
                    </StackPanel>
                </Border>

                <!-- Screenshots -->
                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_ScreenshotsHeader}"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>
                        <Border Style="{StaticResource SectionAccentRuleStyle}"/>

                        <CheckBox Content="{DynamicResource LOCPlayAch_Settings_EnableUnlockScreenshots}"
                                  IsChecked="{Binding Persisted.EnableUnlockScreenshots}"
                                  Margin="0,0,0,10"/>

                        <StackPanel Margin="18,0,0,0"
                                    IsEnabled="{Binding Persisted.EnableUnlockScreenshots}">
                            <!-- Clean variant: independent rarity threshold + completion bypass -->
                            <CheckBox Content="{DynamicResource LOCPlayAch_Settings_ScreenshotVariantClean}"
                                      IsChecked="{Binding Persisted.UnlockScreenshotClean}"
                                      Margin="0,0,0,4"/>
                            <StackPanel Margin="18,0,0,10"
                                        IsEnabled="{Binding Persisted.UnlockScreenshotClean}">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{DynamicResource LOCPlayAch_Settings_CaptureMinimumRarity}"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Button Grid.Column="1"
                                            x:Name="CleanRaritiesButton"
                                            Style="{StaticResource AchievementSelectorButtonStyle}"
                                            Content="{Binding CleanRaritiesText, ElementName=NotificationsSectionRoot}"
                                            Click="CleanRaritiesButton_Click"
                                            MinWidth="140"
                                            Height="{StaticResource PlayAch.Size.Control.Height}"
                                            HorizontalAlignment="Left">
                                        <Button.ContextMenu>
                                            <ContextMenu Style="{StaticResource AchievementSelectorContextMenuStyle}"
                                                         ItemContainerStyle="{StaticResource AchievementMultiSelectMenuItemStyle}"/>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>
                                <CheckBox Content="{DynamicResource LOCPlayAch_Settings_AlwaysCaptureCompletion}"
                                          IsChecked="{Binding Persisted.UnlockScreenshotCleanAlwaysCaptureCompletion}"/>
                            </StackPanel>

                            <!-- With-notification variant: independent rarity threshold + completion bypass -->
                            <CheckBox Content="{DynamicResource LOCPlayAch_Settings_ScreenshotVariantWithToast}"
                                      IsChecked="{Binding Persisted.UnlockScreenshotWithToast}"
                                      Margin="0,0,0,4"/>
                            <StackPanel Margin="18,0,0,10"
                                        IsEnabled="{Binding Persisted.UnlockScreenshotWithToast}">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{DynamicResource LOCPlayAch_Settings_CaptureMinimumRarity}"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Button Grid.Column="1"
                                            x:Name="WithToastRaritiesButton"
                                            Style="{StaticResource AchievementSelectorButtonStyle}"
                                            Content="{Binding WithToastRaritiesText, ElementName=NotificationsSectionRoot}"
                                            Click="WithToastRaritiesButton_Click"
                                            MinWidth="140"
                                            Height="{StaticResource PlayAch.Size.Control.Height}"
                                            HorizontalAlignment="Left">
                                        <Button.ContextMenu>
                                            <ContextMenu Style="{StaticResource AchievementSelectorContextMenuStyle}"
                                                         ItemContainerStyle="{StaticResource AchievementMultiSelectMenuItemStyle}"/>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>
                                <CheckBox Content="{DynamicResource LOCPlayAch_Settings_AlwaysCaptureCompletion}"
                                          IsChecked="{Binding Persisted.UnlockScreenshotWithToastAlwaysCaptureCompletion}"/>
                            </StackPanel>

                            <!-- Framed variant: independent rarity threshold + completion bypass -->
                            <CheckBox Content="{DynamicResource LOCPlayAch_Settings_ScreenshotVariantFramed}"
                                      IsChecked="{Binding Persisted.UnlockScreenshotFramed}"
                                      Margin="0,0,0,4"/>
                            <StackPanel Margin="18,0,0,10"
                                        IsEnabled="{Binding Persisted.UnlockScreenshotFramed}">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{DynamicResource LOCPlayAch_Settings_CaptureMinimumRarity}"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Button Grid.Column="1"
                                            x:Name="FramedRaritiesButton"
                                            Style="{StaticResource AchievementSelectorButtonStyle}"
                                            Content="{Binding FramedRaritiesText, ElementName=NotificationsSectionRoot}"
                                            Click="FramedRaritiesButton_Click"
                                            MinWidth="140"
                                            Height="{StaticResource PlayAch.Size.Control.Height}"
                                            HorizontalAlignment="Left">
                                        <Button.ContextMenu>
                                            <ContextMenu Style="{StaticResource AchievementSelectorContextMenuStyle}"
                                                         ItemContainerStyle="{StaticResource AchievementMultiSelectMenuItemStyle}"/>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>
                                <CheckBox Content="{DynamicResource LOCPlayAch_Settings_AlwaysCaptureCompletion}"
                                          IsChecked="{Binding Persisted.UnlockScreenshotFramedAlwaysCaptureCompletion}"/>
                            </StackPanel>

                            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_ScreenshotSuffixes}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       Margin="0,0,0,4"/>
                            <Grid Margin="18,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{DynamicResource LOCPlayAch_Settings_ScreenshotVariantClean}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,8"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding Persisted.UnlockScreenshotSuffixClean, UpdateSourceTrigger=PropertyChanged}"
                                         Width="160"
                                         Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{DynamicResource LOCPlayAch_Settings_ScreenshotVariantWithToast}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,8"/>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding Persisted.UnlockScreenshotSuffixWithToast, UpdateSourceTrigger=PropertyChanged}"
                                         Width="160"
                                         Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="{DynamicResource LOCPlayAch_Settings_ScreenshotVariantFramed}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,8"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding Persisted.UnlockScreenshotSuffixFramed, UpdateSourceTrigger=PropertyChanged}"
                                         Width="160"
                                         Margin="0,0,0,8"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{DynamicResource LOCPlayAch_Settings_RecordingResolution}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <ComboBox Grid.Column="1"
                                          SelectedValue="{Binding Persisted.ScreenshotResolution, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Tag"
                                          MinWidth="140">
                                    <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_RecordingResolutionNative}" Tag="{x:Static settings:ScreenshotResolution.Native}"/>
                                    <ComboBoxItem Content="1080p" Tag="{x:Static settings:ScreenshotResolution.P1080}"/>
                                    <ComboBoxItem Content="720p" Tag="{x:Static settings:ScreenshotResolution.P720}"/>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_ScreenshotDirectory}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding Persisted.UnlockScreenshotDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="{DynamicResource LOCPlayAch_Button_Browse}"
                                        Click="ScreenshotDirectory_Browse_Click"
                                        Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Unlock recordings: in-process Windows.Graphics.Capture + Media Foundation
                     rolling capture and per-unlock clip export. No external tools. -->
                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_RecordingsHeader}"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>
                        <Border Style="{StaticResource SectionAccentRuleStyle}"/>

                        <CheckBox Content="{DynamicResource LOCPlayAch_Settings_EnableUnlockRecordings}"
                                  IsChecked="{Binding Persisted.EnableUnlockRecordings}"
                                  Margin="0,0,0,10"/>

                        <StackPanel Margin="18,0,0,0"
                                    IsEnabled="{Binding Persisted.EnableUnlockRecordings}">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{DynamicResource LOCPlayAch_Settings_CaptureMinimumRarity}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <Button Grid.Column="1"
                                        x:Name="RecordingRaritiesButton"
                                        Style="{StaticResource AchievementSelectorButtonStyle}"
                                        Content="{Binding RecordingRaritiesText, ElementName=NotificationsSectionRoot}"
                                        Click="RecordingRaritiesButton_Click"
                                        MinWidth="140"
                                        Height="{StaticResource PlayAch.Size.Control.Height}"
                                        HorizontalAlignment="Left">
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{StaticResource AchievementSelectorContextMenuStyle}"
                                                     ItemContainerStyle="{StaticResource AchievementMultiSelectMenuItemStyle}"/>
                                    </Button.ContextMenu>
                                </Button>
                            </Grid>
                            <CheckBox Content="{DynamicResource LOCPlayAch_Settings_AlwaysCaptureCompletion}"
                                      IsChecked="{Binding Persisted.UnlockRecordingAlwaysCaptureCompletion}"
                                      Margin="0,0,0,10"/>

                            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_RecordingDirectory}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       Margin="0,10,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding Persisted.UnlockRecordingDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="{DynamicResource LOCPlayAch_Button_Browse}"
                                        Click="RecordingDirectory_Browse_Click"
                                        Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_RecordingDirectoryHint}"
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{DynamicResource LOCPlayAch_Settings_RecordingClipSeconds}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,8"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding Persisted.RecordingClipSeconds, UpdateSourceTrigger=LostFocus}"
                                         Width="{StaticResource PlayAch.Size.Input.NarrowWidth}"
                                         TextAlignment="Right"
                                         Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{DynamicResource LOCPlayAch_Settings_RecordingFps}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,8"/>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding Persisted.RecordingFps, UpdateSourceTrigger=LostFocus}"
                                         Width="{StaticResource PlayAch.Size.Input.NarrowWidth}"
                                         TextAlignment="Right"
                                         Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="{DynamicResource LOCPlayAch_Settings_RecordingResolution}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,8"/>
                                <ComboBox Grid.Row="2" Grid.Column="1"
                                          SelectedValue="{Binding Persisted.RecordingResolution, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Tag"
                                          MinWidth="140"
                                          Margin="0,0,0,8">
                                    <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_RecordingResolutionNative}" Tag="{x:Static settings:RecordingResolution.Native}"/>
                                    <ComboBoxItem Content="1080p" Tag="{x:Static settings:RecordingResolution.P1080}"/>
                                    <ComboBoxItem Content="720p" Tag="{x:Static settings:RecordingResolution.P720}"/>
                                </ComboBox>

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="{DynamicResource LOCPlayAch_Settings_RecordingQuality}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,8"/>
                                <ComboBox Grid.Row="3" Grid.Column="1"
                                          SelectedValue="{Binding Persisted.RecordingQuality, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Tag"
                                          MinWidth="140"
                                          Margin="0,0,0,8">
                                    <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_RecordingResolutionNative}" Tag="{x:Static settings:RecordingQuality.Native}"/>
                                    <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_RecordingQualityHigh}" Tag="{x:Static settings:RecordingQuality.High}"/>
                                    <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_RecordingQualityMedium}" Tag="{x:Static settings:RecordingQuality.Medium}"/>
                                    <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_RecordingQualityLow}" Tag="{x:Static settings:RecordingQuality.Low}"/>
                                </ComboBox>
                            </Grid>

                            <CheckBox Content="{DynamicResource LOCPlayAch_Settings_RecordingIncludeAudio}"
                                      IsChecked="{Binding Persisted.RecordingIncludeAudio}"
                                      Margin="0,10,0,0"/>
                            <StackPanel Margin="18,6,0,0"
                                        IsEnabled="{Binding Persisted.RecordingIncludeAudio}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{DynamicResource LOCPlayAch_Settings_RecordingAudioSource}"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="1"
                                              SelectedValue="{Binding Persisted.RecordingAudioSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Tag"
                                              MinWidth="160"
                                              HorizontalAlignment="Left">
                                        <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_RecordingAudioSourceFull}" Tag="{x:Static settings:RecordingAudioSource.FullSystem}"/>
                                        <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_RecordingAudioSourceGame}" Tag="{x:Static settings:RecordingAudioSource.GameOnly}"/>
                                    </ComboBox>
                                </Grid>
                                <CheckBox Content="{DynamicResource LOCPlayAch_Settings_RecordingIncludeMicrophone}"
                                          IsChecked="{Binding Persisted.RecordingIncludeMicrophone}"
                                          Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Per-platform overrides: tri-state cells (Default / On / Off) modulating the
                     global toggles above per provider. The grid stays enabled when notifications
                     are off because it edits defaults for when they are on; the master switches
                     always win. DataContext is the provider-overrides view model (set in
                     code-behind), independent of this section's settings DataContext. -->
                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_ProviderNotificationOverrides}"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>
                        <Border Style="{StaticResource SectionAccentRuleStyle}"/>

                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_ProviderNotificationOverridesHint}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <DataGrid x:Name="ProviderOverridesGrid"
                                  Style="{StaticResource PlayAch.DataGrid.BaseStyle}"
                                  ItemsSource="{Binding Rows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  IsReadOnly="False"
                                  GridLinesVisibility="None"
                                  BorderThickness="0"
                                  Background="{DynamicResource PlayAch.Brush.Grid.Background}"
                                  RowBackground="{DynamicResource PlayAch.Brush.Grid.RowBackground}"
                                  Foreground="{DynamicResource PlayAch.Brush.Text}"
                                  ColumnHeaderStyle="{StaticResource AchievementColumnHeaderStyle}"
                                  CellStyle="{StaticResource AchievementCellStyle}"
                                  RowStyle="{StaticResource ProviderOverridesGridRowStyle}"
                                  MaxHeight="420"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_Common_Label_Platform}"
                                                        Width="*"
                                                        MinWidth="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="4,2">
                                                <Image Width="16"
                                                       Height="16"
                                                       Margin="{StaticResource PlayAch.Thickness.Right.Sm}"
                                                       VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding HasProviderIcon, Converter={StaticResource BoolToVis}}">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource ProviderIconConverter}">
                                                            <Binding Path="ProviderIconKey"/>
                                                            <Binding Path="ProviderColorHex"/>
                                                        </MultiBinding>
                                                    </Image.Source>
                                                </Image>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_Column_UnlockToasts}"
                                                        Width="Auto"
                                                        MinWidth="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedValue="{Binding UnlockToasts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Tag"
                                                      MinWidth="86"
                                                      VerticalAlignment="Center"
                                                      Margin="4,2">
                                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Common_Default}" Tag="{x:Static vm:OverrideState.Inherit}"/>
                                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_Override_On}" Tag="{x:Static vm:OverrideState.On}"/>
                                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_Override_Off}" Tag="{x:Static vm:OverrideState.Off}"/>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_Column_FriendToasts}"
                                                        Width="Auto"
                                                        MinWidth="100"
                                                        Visibility="{Binding Data.Persisted.EnableFriendsFeatures, Source={StaticResource NotificationsSectionContext}, Converter={StaticResource BoolToVis}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedValue="{Binding FriendUnlockToasts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Tag"
                                                      MinWidth="86"
                                                      VerticalAlignment="Center"
                                                      Margin="4,2">
                                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Common_Default}" Tag="{x:Static vm:OverrideState.Inherit}"/>
                                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_Override_On}" Tag="{x:Static vm:OverrideState.On}"/>
                                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_Override_Off}" Tag="{x:Static vm:OverrideState.Off}"/>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_Column_Screenshots}"
                                                        Width="Auto"
                                                        MinWidth="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center"
                                                  Margin="4,2">
                                                <ToggleButton x:Name="ScreenshotOverridesButton"
                                                              Content="{Binding ScreenshotsSummaryText}"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Center"
                                                              MinWidth="86"
                                                              Padding="8,3"/>
                                                <Popup PlacementTarget="{Binding ElementName=ScreenshotOverridesButton}"
                                                       Placement="Bottom"
                                                       StaysOpen="False"
                                                       AllowsTransparency="True"
                                                       IsOpen="{Binding IsChecked, ElementName=ScreenshotOverridesButton}">
                                                    <Border Background="{DynamicResource PlayAch.Brush.PopupSurface}"
                                                            BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                                            BorderThickness="1"
                                                            Padding="10"
                                                            MinWidth="220">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                                       Text="{DynamicResource LOCPlayAch_Settings_ScreenshotVariantClean}"
                                                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,10,6"/>
                                                            <ComboBox Grid.Row="0" Grid.Column="1"
                                                                      SelectedValue="{Binding ScreenshotClean, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      SelectedValuePath="Tag"
                                                                      MinWidth="86"
                                                                      Margin="0,0,0,6">
                                                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Common_Default}" Tag="{x:Static vm:OverrideState.Inherit}"/>
                                                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_Override_On}" Tag="{x:Static vm:OverrideState.On}"/>
                                                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_Override_Off}" Tag="{x:Static vm:OverrideState.Off}"/>
                                                            </ComboBox>

                                                            <TextBlock Grid.Row="1" Grid.Column="0"
                                                                       Text="{DynamicResource LOCPlayAch_Settings_ScreenshotVariantWithToast}"
                                                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,10,6"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="1"
                                                                      SelectedValue="{Binding ScreenshotWithToast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      SelectedValuePath="Tag"
                                                                      MinWidth="86"
                                                                      Margin="0,0,0,6">
                                                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Common_Default}" Tag="{x:Static vm:OverrideState.Inherit}"/>
                                                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_Override_On}" Tag="{x:Static vm:OverrideState.On}"/>
                                                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_Override_Off}" Tag="{x:Static vm:OverrideState.Off}"/>
                                                            </ComboBox>

                                                            <TextBlock Grid.Row="2" Grid.Column="0"
                                                                       Text="{DynamicResource LOCPlayAch_Settings_ScreenshotVariantFramed}"
                                                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,10,0"/>
                                                            <ComboBox Grid.Row="2" Grid.Column="1"
                                                                      SelectedValue="{Binding ScreenshotFramed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      SelectedValuePath="Tag"
                                                                      MinWidth="86">
                                                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Common_Default}" Tag="{x:Static vm:OverrideState.Inherit}"/>
                                                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_Override_On}" Tag="{x:Static vm:OverrideState.On}"/>
                                                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_Override_Off}" Tag="{x:Static vm:OverrideState.Off}"/>
                                                            </ComboBox>
                                                        </Grid>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_Column_Recordings}"
                                                        Width="Auto"
                                                        MinWidth="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedValue="{Binding Recordings, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Tag"
                                                      MinWidth="86"
                                                      VerticalAlignment="Center"
                                                      Margin="4,2">
                                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Common_Default}" Tag="{x:Static vm:OverrideState.Inherit}"/>
                                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_Override_On}" Tag="{x:Static vm:OverrideState.On}"/>
                                                <ComboBoxItem Content="{DynamicResource LOCPlayAch_Settings_Override_Off}" Tag="{x:Static vm:OverrideState.Off}"/>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
