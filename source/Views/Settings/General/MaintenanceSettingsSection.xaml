<UserControl x:Class="PlayniteAchievements.Views.Settings.General.MaintenanceSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/SettingsScopedControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="MaintenanceActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="{StaticResource PlayAch.Thickness.ButtonPadding.Wide}"/>
                <Setter Property="MinWidth" Value="130"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20" Grid.IsSharedSizeScope="True">

            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_AchievementData_Title}"
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource SectionAccentRuleStyle}"/>
                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_AchievementData_Description}"
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>

                    <controls:SettingRow Label="{DynamicResource LOCPlayAch_Menu_ClearPlatformData}">
                        <Button Content="{DynamicResource LOCPlayAch_Common_Clear}"
                                Click="ClearLayer_Click"
                                Tag="Platform"
                                Style="{StaticResource MaintenanceActionButtonStyle}"/>
                    </controls:SettingRow>

                    <controls:SettingRow Label="{DynamicResource LOCPlayAch_Menu_ClearMetadata}">
                        <Button Content="{DynamicResource LOCPlayAch_Common_Clear}"
                                Click="ClearLayer_Click"
                                Tag="Metadata"
                                Style="{StaticResource MaintenanceActionButtonStyle}"/>
                    </controls:SettingRow>

                    <controls:SettingRow Label="{DynamicResource LOCPlayAch_Menu_ClearCustomData}">
                        <Button Content="{DynamicResource LOCPlayAch_Common_Clear}"
                                Click="ClearLayer_Click"
                                Tag="Custom"
                                Style="{StaticResource MaintenanceActionButtonStyle}"/>
                    </controls:SettingRow>

                    <controls:SettingRow Label="{DynamicResource LOCPlayAch_Menu_ClearAllData}">
                        <Button Content="{DynamicResource LOCPlayAch_Common_Clear}"
                                Click="ClearLayer_Click"
                                Tag="All"
                                Style="{StaticResource MaintenanceActionButtonStyle}"/>
                    </controls:SettingRow>

                    <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_ClearUnownedFriendData_Title}"
                                         Hint="{DynamicResource LOCPlayAch_Settings_ClearUnownedFriendData_Description}">
                        <Button Content="{DynamicResource LOCPlayAch_Common_Clear}"
                                Click="ClearUnownedFriendGameData_Click"
                                Style="{StaticResource MaintenanceActionButtonStyle}"/>
                    </controls:SettingRow>

                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_AchievementIconCache_Title}"
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource SectionAccentRuleStyle}"/>
                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_IconCache_Description}"
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>

                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_IconCache_Folder}"
                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                               Margin="{StaticResource PlayAch.Thickness.Bottom.Xs}"/>
                    <Grid Margin="{StaticResource PlayAch.Thickness.Bottom.Md}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="IconCacheFolderText"
                                 Grid.Column="0"
                                 IsReadOnly="True"
                                 VerticalAlignment="Center"/>
                        <Button x:Name="IconCacheFolderBrowseButton"
                                Grid.Column="1"
                                Content="..."
                                ToolTip="{DynamicResource LOCPlayAch_Button_Browse}"
                                Click="IconCacheFolder_Browse_Click"
                                Margin="8,0,0,0"/>
                        <Button x:Name="IconCacheFolderResetButton"
                                Grid.Column="2"
                                Content="{DynamicResource LOCPlayAch_Common_Reset}"
                                Click="IconCacheFolder_Reset_Click"
                                Margin="8,0,0,0"/>
                    </Grid>

                    <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_IconCache_ClearAll}">
                        <Button Content="{DynamicResource LOCPlayAch_Common_Clear}"
                                Click="ClearAllIconCache_Click"
                                Style="{StaticResource MaintenanceActionButtonStyle}"/>
                    </controls:SettingRow>

                    <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_IconCache_ClearLocked}"
                                         Hint="{DynamicResource LOCPlayAch_Settings_IconCache_ClearLockedDescription}">
                        <Button Content="{DynamicResource LOCPlayAch_Common_Clear}"
                                Click="ClearLockedIconCache_Click"
                                Style="{StaticResource MaintenanceActionButtonStyle}"/>
                    </controls:SettingRow>

                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_CompressImages_Title}"
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource SectionAccentRuleStyle}"/>
                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_CompressImages_Description}"
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>

                    <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_CompressImages_MaxSize}">
                        <ComboBox x:Name="CompressMaxDimensionCombo"
                                  MinWidth="130"
                                  HorizontalAlignment="Left"/>
                    </controls:SettingRow>

                    <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_CompressImages_AchievementIcons}"
                                         Hint="{DynamicResource LOCPlayAch_Settings_CompressImages_AchievementIconsDescription}">
                        <Button Content="{DynamicResource LOCPlayAch_Button_Compress}"
                                Click="CompressAchievementIcons_Click"
                                Style="{StaticResource MaintenanceActionButtonStyle}"/>
                    </controls:SettingRow>

                    <controls:SettingRow Label="{DynamicResource LOCPlayAch_Column_CategoryArt}"
                                         Hint="{DynamicResource LOCPlayAch_Settings_CompressImages_CategoryArtDescription}">
                        <Button Content="{DynamicResource LOCPlayAch_Button_Compress}"
                                Click="CompressCategoryArt_Click"
                                Style="{StaticResource MaintenanceActionButtonStyle}"/>
                    </controls:SettingRow>

                    <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_CompressImages_FriendImages}"
                                         Hint="{DynamicResource LOCPlayAch_Settings_CompressImages_FriendImagesDescription}">
                        <Button Content="{DynamicResource LOCPlayAch_Button_Compress}"
                                Click="CompressFriendImages_Click"
                                Style="{StaticResource MaintenanceActionButtonStyle}"/>
                    </controls:SettingRow>

                    <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_CompressImages_CustomImages}"
                                         Hint="{DynamicResource LOCPlayAch_Settings_CompressImages_CustomIconsDescription}">
                        <Button Content="{DynamicResource LOCPlayAch_Button_Compress}"
                                Click="CompressCustomIcons_Click"
                                Style="{StaticResource MaintenanceActionButtonStyle}"/>
                    </controls:SettingRow>

                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Utilities_Title}"
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource SectionAccentRuleStyle}"/>

                    <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_ResetFirstTimeSetup_Title}"
                                         Hint="{DynamicResource LOCPlayAch_Settings_ResetFirstTimeSetup}">
                        <Button Content="{DynamicResource LOCPlayAch_Settings_ResetFirstTimeSetupButton}"
                                Click="ResetFirstTimeSetup_Click"
                                Style="{StaticResource MaintenanceActionButtonStyle}"/>
                    </controls:SettingRow>

                    <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_ExportDatabase_Title}"
                                         Hint="{DynamicResource LOCPlayAch_Settings_ExportDatabase}">
                        <Button Content="{DynamicResource LOCPlayAch_Settings_ExportDatabaseButton}"
                                ContentTemplate="{DynamicResource PlayAch.ButtonContent.Export}"
                                Click="ExportDatabase_Click"
                                Style="{StaticResource MaintenanceActionButtonStyle}"/>
                    </controls:SettingRow>

                    <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_OpenDataFolder_Title}"
                                         Hint="{DynamicResource LOCPlayAch_Settings_OpenDataFolder}">
                        <Button Content="{DynamicResource LOCPlayAch_Settings_OpenDataFolderButton}"
                                Click="OpenDataFolder_Click"
                                Style="{StaticResource MaintenanceActionButtonStyle}"/>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
