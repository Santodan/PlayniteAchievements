<UserControl x:Class="PlayniteAchievements.Views.Settings.General.MaintenanceSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/SettingsScopedControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">

            <!-- ================== MAINTENANCE ================== -->
            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Maintenance_Title}"
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Maintenance_Description}"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="{StaticResource PlayAch.Thickness.Bottom.Lg}"/>

                    <Border Style="{StaticResource SettingGroupCardStyle}" Grid.IsSharedSizeScope="True">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_CachedAchievementData_Title}"
                                       Style="{StaticResource SubSectionHeaderStyle}"
                                       Margin="{StaticResource PlayAch.Thickness.Bottom.Xs}"/>
                            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_CachedAchievementData_Description}"
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>

                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_CachedAchievementData_ClearDescription}">
                                <Button Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                        Click="WipeCache_Click"
                                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding.Wide}"
                                        MinWidth="130"/>
                            </controls:SettingRow>

                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_ClearUnownedFriendData_Description}"
                                                 Margin="0">
                                <Button Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                        Click="ClearUnownedFriendGameData_Click"
                                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding.Wide}"
                                        MinWidth="130"/>
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingGroupCardStyle}" Grid.IsSharedSizeScope="True">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_AchievementIconCache_Title}"
                                       Style="{StaticResource SubSectionHeaderStyle}"
                                       Margin="{StaticResource PlayAch.Thickness.Bottom.Xs}"/>
                            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_IconCache_Description}"
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>

                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_IconCache_ClearAllDescription}">
                                <Button Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                        Click="ClearAllIconCache_Click"
                                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding.Wide}"
                                        MinWidth="130"/>
                            </controls:SettingRow>

                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_IconCache_ClearLockedDescription}"
                                                 Margin="0">
                                <Button Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                        Click="ClearLockedIconCache_Click"
                                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding.Wide}"
                                        MinWidth="130"/>
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingGroupCardStyle}" Grid.IsSharedSizeScope="True">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_CompressImages_Title}"
                                       Style="{StaticResource SubSectionHeaderStyle}"
                                       Margin="{StaticResource PlayAch.Thickness.Bottom.Xs}"/>
                            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_CompressImages_Description}"
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>

                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_CompressImages_MaxSize}">
                                <ComboBox x:Name="CompressMaxDimensionCombo"
                                          MinWidth="130"/>
                            </controls:SettingRow>

                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_CompressImages_AchievementIconsDescription}">
                                <Button Content="{DynamicResource LOCPlayAch_Button_Compress}"
                                        Click="CompressAchievementIcons_Click"
                                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding.Wide}"
                                        MinWidth="130"/>
                            </controls:SettingRow>

                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_CompressImages_CategoryArtDescription}">
                                <Button Content="{DynamicResource LOCPlayAch_Button_Compress}"
                                        Click="CompressCategoryArt_Click"
                                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding.Wide}"
                                        MinWidth="130"/>
                            </controls:SettingRow>

                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_CompressImages_FriendImagesDescription}">
                                <Button Content="{DynamicResource LOCPlayAch_Button_Compress}"
                                        Click="CompressFriendImages_Click"
                                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding.Wide}"
                                        MinWidth="130"/>
                            </controls:SettingRow>

                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_CompressImages_CustomIconsDescription}"
                                                 Margin="0">
                                <Button Content="{DynamicResource LOCPlayAch_Button_Compress}"
                                        Click="CompressCustomIcons_Click"
                                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding.Wide}"
                                        MinWidth="130"/>
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingGroupCardStyle}" Grid.IsSharedSizeScope="True">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Utilities_Title}"
                                       Style="{StaticResource SubSectionHeaderStyle}"
                                       Margin="{StaticResource PlayAch.Thickness.Bottom.Xs}"/>
                            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Utilities_Description}"
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>

                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_ResetFirstTimeSetup}">
                                <Button Content="{DynamicResource LOCPlayAch_Settings_ResetFirstTimeSetupButton}"
                                        Click="ResetFirstTimeSetup_Click"
                                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding.Wide}"
                                        MinWidth="130"/>
                            </controls:SettingRow>

                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_ExportDatabase}">
                                <Button Content="{DynamicResource LOCPlayAch_Settings_ExportDatabaseButton}"
                                        Click="ExportDatabase_Click"
                                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding.Wide}"
                                        MinWidth="130"/>
                            </controls:SettingRow>

                            <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_OpenDataFolder}"
                                                 Margin="0">
                                <Button Content="{DynamicResource LOCPlayAch_Settings_OpenDataFolderButton}"
                                        Click="OpenDataFolder_Click"
                                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding.Wide}"
                                        MinWidth="130"/>
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
