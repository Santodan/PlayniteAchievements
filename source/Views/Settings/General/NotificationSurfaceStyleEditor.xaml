<UserControl x:Class="PlayniteAchievements.Views.Settings.General.NotificationSurfaceStyleEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             xmlns:vmSettings="clr-namespace:PlayniteAchievements.ViewModels.Settings"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="640"
             d:DataContext="{d:DesignInstance vmSettings:NotificationAppearanceEditorViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/SettingsScopedControlStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="EditorGroupLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,14,0,4"/>
            </Style>

            <Style x:Key="LineOrderGridRowStyle"
                   TargetType="DataGridRow"
                   BasedOn="{StaticResource AchievementRowStyle}">
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel IsEnabled="{Binding IsEditable}">

        <!-- Shown fields -->
        <WrapPanel Margin="0,0,0,4">
            <CheckBox Content="{DynamicResource LOCPlayAch_Settings_ToastShowHeader}"
                      IsChecked="{Binding Surface.ShowHeader}"
                      Margin="0,0,14,8"/>
            <CheckBox Content="{DynamicResource LOCPlayAch_Settings_ToastShowName}"
                      IsChecked="{Binding Surface.ShowName}"
                      Margin="0,0,14,8"/>
            <CheckBox Content="{DynamicResource LOCPlayAch_Settings_ToastShowDescription}"
                      IsChecked="{Binding Surface.ShowDescription}"
                      Margin="0,0,14,8"/>
            <CheckBox Content="{DynamicResource LOCPlayAch_Settings_ToastShowGameName}"
                      IsChecked="{Binding Surface.ShowGameName}"
                      Margin="0,0,14,8"/>
            <CheckBox Content="{DynamicResource LOCPlayAch_Common_Label_Category}"
                      IsChecked="{Binding Surface.ShowCategory}"
                      Margin="0,0,14,8"/>
            <CheckBox Content="{DynamicResource LOCPlayAch_Common_UnlockTime}"
                      IsChecked="{Binding Surface.ShowUnlockTime}"
                      Margin="0,0,14,8"/>
            <CheckBox Content="{DynamicResource LOCPlayAch_Settings_ToastShowRarityBadge}"
                      IsChecked="{Binding Surface.ShowRarityBadge}"
                      Margin="0,0,14,8"/>
            <CheckBox Content="{DynamicResource LOCPlayAch_Settings_ToastShowRarityPercent}"
                      IsChecked="{Binding Surface.ShowRarityPercent}"
                      Margin="0,0,14,8"/>
            <CheckBox Content="{DynamicResource LOCPlayAch_Settings_ToastShowRarityGlow}"
                      IsChecked="{Binding Surface.ShowRarityGlow}"
                      Margin="0,0,14,8"/>
            <CheckBox Content="{DynamicResource LOCPlayAch_Settings_ToastRarityColoredName}"
                      IsChecked="{Binding Surface.RarityColoredName}"
                      Margin="0,0,14,8"/>
            <CheckBox Content="{DynamicResource LOCPlayAch_Settings_Style_ShowProviderIcon}"
                      IsChecked="{Binding Surface.ShowProviderIcon}"
                      Margin="0,0,14,8"/>
        </WrapPanel>

        <!-- Text lines: drag to reorder, per-line font size -->
        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Style_TextLines}"
                   Style="{StaticResource EditorGroupLabelStyle}"/>
        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Style_TextLinesHint}"
                   Style="{StaticResource MutedTextStyle}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6"/>
        <Grid HorizontalAlignment="Left"
              MinWidth="360">
            <DataGrid x:Name="LineOrderGrid"
                      Style="{StaticResource PlayAch.DataGrid.BaseStyle}"
                      ItemsSource="{Binding LineRows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserResizeColumns="False"
                      CanUserReorderColumns="False"
                      CanUserSortColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="None"
                      IsReadOnly="False"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      Background="{DynamicResource PlayAch.Brush.Grid.Background}"
                      RowBackground="{DynamicResource PlayAch.Brush.Grid.RowBackground}"
                      Foreground="{DynamicResource PlayAch.Brush.Text}"
                      CellStyle="{StaticResource AchievementCellStyle}"
                      RowStyle="{StaticResource LineOrderGridRowStyle}"
                      AllowDrop="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="36" MinWidth="36" MaxWidth="36" CanUserResize="False">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource AchievementCellStyle}">
                                <Setter Property="Cursor" Value="SizeAll"/>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Tag="DragHandle"
                                        Background="Transparent"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Cursor="SizeAll">
                                    <TextBlock Tag="DragHandle"
                                               Text="☰"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               Opacity="0.65"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           VerticalAlignment="Center"
                                           Margin="6,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="70" MinWidth="70" MaxWidth="70" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding SizeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         TextAlignment="Right"
                                         VerticalAlignment="Center"
                                         Margin="4,2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border x:Name="DropInsertLine"
                    Height="2"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource PlayAch.Brush.Accent}"
                    Visibility="Collapsed"
                    Margin="0,0,0,0"
                    IsHitTestVisible="False"
                    Panel.ZIndex="10"/>

            <Popup x:Name="DragCountPopup"
                   Placement="AbsolutePoint"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   IsHitTestVisible="False">
                <Border Background="{StaticResource PlayAch.Brush.DialogBackdrop}"
                        BorderBrush="{DynamicResource PlayAch.Brush.Accent}"
                        BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                        CornerRadius="10"
                        Padding="8,3">
                    <TextBlock x:Name="DragCountText"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="{DynamicResource PlayAch.FontSize.Caption}"/>
                </Border>
            </Popup>
        </Grid>

        <!-- Font family -->
        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Style_FontFamily}"
                   Style="{StaticResource EditorGroupLabelStyle}"/>
        <ComboBox ItemsSource="{Binding FontFamilyOptions}"
                  SelectedItem="{Binding SelectedFontFamilyOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  HorizontalAlignment="Left"
                  MinWidth="260"
                  MaxDropDownHeight="360"
                  VirtualizingPanel.IsVirtualizing="True">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}"
                               FontFamily="{Binding PreviewFamily}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Shared groups (background, badges, header texts) are edited once on the toast
             surface; they apply to both surfaces. -->
        <StackPanel Visibility="{Binding IsToastSurface, Converter={StaticResource BoolToVis}}">

            <!-- Background image (toast only by design: frames never get a background) -->
            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Style_BackgroundImage}"
                       Style="{StaticResource EditorGroupLabelStyle}"/>
            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Style_BackgroundImageHint}"
                       Style="{StaticResource MutedTextStyle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="48"
                        Height="48"
                        Background="{DynamicResource PlayAch.Brush.Surface}"
                        BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                        BorderThickness="1"
                        Margin="0,0,8,0">
                    <Image helpers:AsyncImage.Uri="{Binding Style.ToastBackgroundImagePath}"
                           helpers:AsyncImage.DecodePixel="48"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBox Grid.Column="1"
                         Tag="Background"
                         Text="{Binding Style.ToastBackgroundImagePath, Mode=OneWay}"
                         IsReadOnly="True"
                         VerticalAlignment="Center"
                         AllowDrop="True"
                         PreviewDragOver="ImageTextBox_PreviewDragOver"
                         PreviewDrop="ImageTextBox_PreviewDrop"/>
                <Button Grid.Column="2"
                        Tag="Background"
                        Content="{DynamicResource LOCPlayAch_Button_Clear}"
                        Click="ImageClear_Click"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"/>
                <Button Grid.Column="3"
                        Tag="Background"
                        Content="{DynamicResource LOCPlayAch_Button_Browse}"
                        Click="ImageBrowse_Click"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Style_SharedAcrossSurfacesHint}"
                       Style="{StaticResource MutedTextStyle}"
                       TextWrapping="Wrap"/>

            <!-- Badge images -->
            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Style_BadgeImages}"
                       Style="{StaticResource EditorGroupLabelStyle}"/>
            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Style_BadgeImagesHint}"
                       Style="{StaticResource MutedTextStyle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="110"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Common -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{DynamicResource LOCPlayAch_Rarity_Common}"
                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,6"/>
                <Border Grid.Row="0" Grid.Column="1"
                        Width="48" Height="48"
                        Background="{DynamicResource PlayAch.Brush.Surface}"
                        BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                        BorderThickness="1"
                        Margin="0,0,8,6">
                    <Image helpers:AsyncImage.Uri="{Binding Style.BadgeImages.CommonPath}"
                           helpers:AsyncImage.DecodePixel="48"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBox Grid.Row="0" Grid.Column="2"
                         Tag="BadgeCommon"
                         Text="{Binding Style.BadgeImages.CommonPath, Mode=OneWay}"
                         IsReadOnly="True"
                         VerticalAlignment="Center"
                         Margin="0,0,0,6"
                         AllowDrop="True"
                         PreviewDragOver="ImageTextBox_PreviewDragOver"
                         PreviewDrop="ImageTextBox_PreviewDrop"/>
                <Button Grid.Row="0" Grid.Column="3"
                        Tag="BadgeCommon"
                        Content="{DynamicResource LOCPlayAch_Button_Clear}"
                        Click="ImageClear_Click"
                        Margin="8,0,0,6"
                        VerticalAlignment="Center"/>
                <Button Grid.Row="0" Grid.Column="4"
                        Tag="BadgeCommon"
                        Content="{DynamicResource LOCPlayAch_Button_Browse}"
                        Click="ImageBrowse_Click"
                        Margin="8,0,0,6"
                        VerticalAlignment="Center"/>

                <!-- Uncommon -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{DynamicResource LOCPlayAch_Rarity_Uncommon}"
                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,6"/>
                <Border Grid.Row="1" Grid.Column="1"
                        Width="48" Height="48"
                        Background="{DynamicResource PlayAch.Brush.Surface}"
                        BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                        BorderThickness="1"
                        Margin="0,0,8,6">
                    <Image helpers:AsyncImage.Uri="{Binding Style.BadgeImages.UncommonPath}"
                           helpers:AsyncImage.DecodePixel="48"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBox Grid.Row="1" Grid.Column="2"
                         Tag="BadgeUncommon"
                         Text="{Binding Style.BadgeImages.UncommonPath, Mode=OneWay}"
                         IsReadOnly="True"
                         VerticalAlignment="Center"
                         Margin="0,0,0,6"
                         AllowDrop="True"
                         PreviewDragOver="ImageTextBox_PreviewDragOver"
                         PreviewDrop="ImageTextBox_PreviewDrop"/>
                <Button Grid.Row="1" Grid.Column="3"
                        Tag="BadgeUncommon"
                        Content="{DynamicResource LOCPlayAch_Button_Clear}"
                        Click="ImageClear_Click"
                        Margin="8,0,0,6"
                        VerticalAlignment="Center"/>
                <Button Grid.Row="1" Grid.Column="4"
                        Tag="BadgeUncommon"
                        Content="{DynamicResource LOCPlayAch_Button_Browse}"
                        Click="ImageBrowse_Click"
                        Margin="8,0,0,6"
                        VerticalAlignment="Center"/>

                <!-- Rare -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="{DynamicResource LOCPlayAch_Rarity_Rare}"
                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,6"/>
                <Border Grid.Row="2" Grid.Column="1"
                        Width="48" Height="48"
                        Background="{DynamicResource PlayAch.Brush.Surface}"
                        BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                        BorderThickness="1"
                        Margin="0,0,8,6">
                    <Image helpers:AsyncImage.Uri="{Binding Style.BadgeImages.RarePath}"
                           helpers:AsyncImage.DecodePixel="48"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBox Grid.Row="2" Grid.Column="2"
                         Tag="BadgeRare"
                         Text="{Binding Style.BadgeImages.RarePath, Mode=OneWay}"
                         IsReadOnly="True"
                         VerticalAlignment="Center"
                         Margin="0,0,0,6"
                         AllowDrop="True"
                         PreviewDragOver="ImageTextBox_PreviewDragOver"
                         PreviewDrop="ImageTextBox_PreviewDrop"/>
                <Button Grid.Row="2" Grid.Column="3"
                        Tag="BadgeRare"
                        Content="{DynamicResource LOCPlayAch_Button_Clear}"
                        Click="ImageClear_Click"
                        Margin="8,0,0,6"
                        VerticalAlignment="Center"/>
                <Button Grid.Row="2" Grid.Column="4"
                        Tag="BadgeRare"
                        Content="{DynamicResource LOCPlayAch_Button_Browse}"
                        Click="ImageBrowse_Click"
                        Margin="8,0,0,6"
                        VerticalAlignment="Center"/>

                <!-- Ultra rare -->
                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="{DynamicResource LOCPlayAch_Rarity_UltraRare}"
                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,6"/>
                <Border Grid.Row="3" Grid.Column="1"
                        Width="48" Height="48"
                        Background="{DynamicResource PlayAch.Brush.Surface}"
                        BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                        BorderThickness="1"
                        Margin="0,0,8,6">
                    <Image helpers:AsyncImage.Uri="{Binding Style.BadgeImages.UltraRarePath}"
                           helpers:AsyncImage.DecodePixel="48"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBox Grid.Row="3" Grid.Column="2"
                         Tag="BadgeUltraRare"
                         Text="{Binding Style.BadgeImages.UltraRarePath, Mode=OneWay}"
                         IsReadOnly="True"
                         VerticalAlignment="Center"
                         Margin="0,0,0,6"
                         AllowDrop="True"
                         PreviewDragOver="ImageTextBox_PreviewDragOver"
                         PreviewDrop="ImageTextBox_PreviewDrop"/>
                <Button Grid.Row="3" Grid.Column="3"
                        Tag="BadgeUltraRare"
                        Content="{DynamicResource LOCPlayAch_Button_Clear}"
                        Click="ImageClear_Click"
                        Margin="8,0,0,6"
                        VerticalAlignment="Center"/>
                <Button Grid.Row="3" Grid.Column="4"
                        Tag="BadgeUltraRare"
                        Content="{DynamicResource LOCPlayAch_Button_Browse}"
                        Click="ImageBrowse_Click"
                        Margin="8,0,0,6"
                        VerticalAlignment="Center"/>

                <!-- Completion -->
                <TextBlock Grid.Row="4" Grid.Column="0"
                           Text="{DynamicResource LOCPlayAch_Completed}"
                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <Border Grid.Row="4" Grid.Column="1"
                        Width="48" Height="48"
                        Background="{DynamicResource PlayAch.Brush.Surface}"
                        BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                        BorderThickness="1"
                        Margin="0,0,8,0">
                    <Image helpers:AsyncImage.Uri="{Binding Style.BadgeImages.CompletionPath}"
                           helpers:AsyncImage.DecodePixel="48"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBox Grid.Row="4" Grid.Column="2"
                         Tag="BadgeCompletion"
                         Text="{Binding Style.BadgeImages.CompletionPath, Mode=OneWay}"
                         IsReadOnly="True"
                         VerticalAlignment="Center"
                         AllowDrop="True"
                         PreviewDragOver="ImageTextBox_PreviewDragOver"
                         PreviewDrop="ImageTextBox_PreviewDrop"/>
                <Button Grid.Row="4" Grid.Column="3"
                        Tag="BadgeCompletion"
                        Content="{DynamicResource LOCPlayAch_Button_Clear}"
                        Click="ImageClear_Click"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"/>
                <Button Grid.Row="4" Grid.Column="4"
                        Tag="BadgeCompletion"
                        Content="{DynamicResource LOCPlayAch_Button_Browse}"
                        Click="ImageBrowse_Click"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Style_SharedAcrossSurfacesHint}"
                       Style="{StaticResource MutedTextStyle}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"/>

            <!-- Header texts (Explicit commit + Apply so format strings never persist per
                 keystroke) -->
            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Style_HeaderTexts}"
                       Style="{StaticResource EditorGroupLabelStyle}"/>
            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Style_HeaderTextsHint}"
                       Style="{StaticResource MutedTextStyle}"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Style_SharedAcrossSurfacesHint}"
                       Style="{StaticResource MutedTextStyle}"
                       TextWrapping="Wrap"
                       Margin="0,2,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{DynamicResource LOCPlayAch_Settings_Style_HeaderUnlock}"
                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,6"/>
                <TextBox x:Name="UnlockHeaderTextBox"
                         Grid.Row="0" Grid.Column="1"
                         Text="{Binding UnlockHeaderText, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                         Margin="0,0,0,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{DynamicResource LOCPlayAch_Settings_Style_HeaderFriendUnlock}"
                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,6"/>
                <TextBox x:Name="FriendUnlockHeaderTextBox"
                         Grid.Row="1" Grid.Column="1"
                         Text="{Binding FriendUnlockHeaderText, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                         Margin="0,0,0,6"/>

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="{DynamicResource LOCPlayAch_Settings_Style_HeaderCongratulations}"
                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,6"/>
                <TextBox x:Name="CompletionHeaderTextBox"
                         Grid.Row="2" Grid.Column="1"
                         Text="{Binding CompletionHeaderText, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                         Margin="0,0,0,6"/>

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="{DynamicResource LOCPlayAch_Settings_Style_HeaderFriendCompleted}"
                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBox x:Name="FriendCompletionHeaderTextBox"
                         Grid.Row="3" Grid.Column="1"
                         Text="{Binding FriendCompletionHeaderText, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            </Grid>
            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Style_HeaderFormatInvalid}"
                       Foreground="{DynamicResource PlayAch.Brush.ErrorText}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Visibility="{Binding HasHeaderFormatError, Converter={StaticResource BoolToVis}}"/>
            <Button Content="{DynamicResource LOCPlayAch_Button_Apply}"
                    Click="ApplyHeaderTexts_Click"
                    HorizontalAlignment="Left"
                    Margin="0,8,0,0"
                    Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
