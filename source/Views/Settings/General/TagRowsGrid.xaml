<UserControl x:Class="PlayniteAchievements.Views.Settings.General.TagRowsGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            >
    <!-- A grid of tag rows (TagRow): a label, then up to four tags in fixed columns, each an
         enable toggle plus the name it writes. DataContext is the rows. Edits go straight into the
         live TagConfig objects and are saved with the settings window's OK, as in the Metadata
         sources grid. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/SettingsScopedControlStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TagRowsRowStyle"
                   TargetType="DataGridRow"
                   BasedOn="{StaticResource AchievementRowStyle}">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Style>

            <!-- One tag. IsChecked is one-way and the click sets the value, and the name commits on
                 LostFocus: a two-way toggle inside a grid cell can be reverted by the grid's
                 close-time CancelEdit. -->
            <DataTemplate x:Key="TagCellTemplate">
                <!-- The name box fills whatever width its column has. -->
                <DockPanel VerticalAlignment="Center"
                           Margin="4,2">
                    <CheckBox DockPanel.Dock="Left"
                              IsChecked="{Binding IsEnabled, Mode=OneWay}"
                              Click="TagEnabled_Click"
                              VerticalAlignment="Center"
                              Margin="{StaticResource PlayAch.Thickness.Right.Sm}"/>
                    <TextBox Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             VerticalAlignment="Center"/>
                </DockPanel>
            </DataTemplate>

            <!-- A layer the area cannot have shows a dash, as in the Metadata sources grid. -->
            <DataTemplate x:Key="NoTagCellTemplate">
                <TextBlock Text="—"
                           Style="{StaticResource MutedTextStyle}"
                           Margin="12,0"
                           VerticalAlignment="Center"/>
            </DataTemplate>

            <!-- Chooses the template by the cell's config, so a null one never gets an empty toggle. -->
            <Style x:Key="TagCellStyle" TargetType="ContentControl">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="ContentTemplate" Value="{StaticResource TagCellTemplate}"/>
                <Style.Triggers>
                    <Trigger Property="Content" Value="{x:Null}">
                        <Setter Property="ContentTemplate" Value="{StaticResource NoTagCellTemplate}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Read-only columns keep the grid out of row edit mode; their controls stay editable. The
         grid fills the page width: the tag columns share what the label column leaves, and
         below their minimum width the grid scrolls sideways. -->
    <DataGrid x:Name="RowsGrid"
              Style="{StaticResource PlayAch.DataGrid.BaseStyle}"
              HorizontalAlignment="Stretch"
              ItemsSource="{Binding}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserSortColumns="False"
              CanUserReorderColumns="False"
              HeadersVisibility="Column"
              IsReadOnly="False"
              GridLinesVisibility="None"
              BorderThickness="0"
              Background="{DynamicResource PlayAch.Brush.Grid.Background}"
              RowBackground="{DynamicResource PlayAch.Brush.Grid.RowBackground}"
              Foreground="{DynamicResource PlayAch.Brush.Text}"
              ColumnHeaderStyle="{StaticResource AchievementColumnHeaderStyle}"
              CellStyle="{StaticResource AchievementCellStyle}"
              RowStyle="{StaticResource TagRowsRowStyle}"
              ScrollViewer.VerticalScrollBarVisibility="Disabled"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              PreviewMouseWheel="RowsGrid_PreviewMouseWheel">
        <DataGrid.Columns>
            <DataGridTemplateColumn Width="Auto" MinWidth="140" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label, Mode=OneWay}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   VerticalAlignment="Center"
                                   Margin="4,2"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn x:Name="FirstColumn" Width="*" MinWidth="200" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <ContentControl Style="{StaticResource TagCellStyle}" Content="{Binding First}"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn x:Name="SecondColumn" Width="*" MinWidth="200" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <ContentControl Style="{StaticResource TagCellStyle}" Content="{Binding Second}"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn x:Name="ThirdColumn" Width="*" MinWidth="200" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <ContentControl Style="{StaticResource TagCellStyle}" Content="{Binding Third}"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn x:Name="FourthColumn" Width="*" MinWidth="200" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <ContentControl Style="{StaticResource TagCellStyle}" Content="{Binding Fourth}"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
