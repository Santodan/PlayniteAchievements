<UserControl x:Class="PlayniteAchievements.Views.Settings.General.TagRowsGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            >
    <!-- A grid of tag rows (TagRow): a label, then up to four tags in fixed columns, each an
         enable toggle plus the name it writes. DataContext is the rows. Edits go straight into the
         live TagConfig objects and are saved with the settings window's OK, as in the Metadata
         sources grid. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/SettingsScopedControlStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TagRowsRowStyle"
                   TargetType="DataGridRow"
                   BasedOn="{StaticResource AchievementRowStyle}">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Style>

            <!-- One tag. IsChecked is one-way and the click sets the value, and the name commits on
                 LostFocus: a two-way toggle inside a grid cell can be reverted by the grid's
                 close-time CancelEdit. A null config renders nothing. -->
            <DataTemplate x:Key="TagCellTemplate">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="4,2">
                    <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}"
                              Click="TagEnabled_Click"
                              VerticalAlignment="Center"
                              Margin="{StaticResource PlayAch.Thickness.Right.Sm}"/>
                    <TextBox Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Width="200"
                             VerticalAlignment="Center"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Read-only columns keep the grid out of row edit mode; their controls stay editable. -->
    <DataGrid x:Name="RowsGrid"
              Style="{StaticResource PlayAch.DataGrid.BaseStyle}"
              HorizontalAlignment="Left"
              ItemsSource="{Binding}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserSortColumns="False"
              CanUserReorderColumns="False"
              HeadersVisibility="Column"
              IsReadOnly="False"
              GridLinesVisibility="None"
              BorderThickness="0"
              Background="{DynamicResource PlayAch.Brush.Grid.Background}"
              RowBackground="{DynamicResource PlayAch.Brush.Grid.RowBackground}"
              Foreground="{DynamicResource PlayAch.Brush.Text}"
              ColumnHeaderStyle="{StaticResource AchievementColumnHeaderStyle}"
              CellStyle="{StaticResource AchievementCellStyle}"
              RowStyle="{StaticResource TagRowsRowStyle}"
              ScrollViewer.VerticalScrollBarVisibility="Disabled"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              PreviewMouseWheel="RowsGrid_PreviewMouseWheel">
        <DataGrid.Columns>
            <DataGridTemplateColumn Width="Auto" MinWidth="140" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label, Mode=OneWay}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   VerticalAlignment="Center"
                                   Margin="4,2"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn x:Name="FirstColumn" Width="Auto" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <ContentControl Focusable="False" Content="{Binding First}" ContentTemplate="{StaticResource TagCellTemplate}"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn x:Name="SecondColumn" Width="Auto" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <ContentControl Focusable="False" Content="{Binding Second}" ContentTemplate="{StaticResource TagCellTemplate}"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn x:Name="ThirdColumn" Width="Auto" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <ContentControl Focusable="False" Content="{Binding Third}" ContentTemplate="{StaticResource TagCellTemplate}"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn x:Name="FourthColumn" Width="Auto" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <ContentControl Focusable="False" Content="{Binding Fourth}" ContentTemplate="{StaticResource TagCellTemplate}"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
