<UserControl x:Class="PlayniteAchievements.Views.Settings.General.ProgressDetailPriorityEditor"
             x:Name="ProgressDetailPriorityEditorRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="200"
             d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/SettingsScopedControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- The Achievement styles priority every surface follows. Hosted on the General
         settings page. -->
    <StackPanel>
        <!-- Priority list: drag a row to reorder; each game shows the first enabled
             styles it has data for, up to Display's progress bar details count. Rarity's
             checkbox is locked on. -->
        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_AchievementStyles}"
                             Hint="{DynamicResource LOCPlayAch_Settings_AchievementStyles_Help}">
            <Grid HorizontalAlignment="Left">
                <DataGrid x:Name="ProgressDetailsGrid"
                          Style="{StaticResource PlayAch.DataGrid.BaseStyle}"
                          ItemsSource="{Binding ProgressDetailRows, ElementName=ProgressDetailPriorityEditorRoot}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserResizeColumns="False"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="None"
                          IsReadOnly="False"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          Background="{DynamicResource PlayAch.Brush.Grid.Background}"
                          RowBackground="{DynamicResource PlayAch.Brush.Grid.RowBackground}"
                          Foreground="{DynamicResource PlayAch.Brush.Text}"
                          CellStyle="{StaticResource AchievementCellStyle}"
                          AllowDrop="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource AchievementRowStyle}">
                            <Setter Property="MinHeight" Value="28"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="32" MinWidth="32" MaxWidth="32" CanUserResize="False" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Tag="DragHandle"
                                            Background="Transparent"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Cursor="SizeAll">
                                        <TextBlock Tag="DragHandle"
                                                   Text="☰"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                   Opacity="0.65"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- IsReadOnly keeps the checkbox click out of row edit mode,
                             whose cancel would revert it. -->
                        <DataGridTemplateColumn Width="Auto" MinWidth="120" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                              Content="{Binding DisplayName}"
                                              IsEnabled="{Binding CanToggle}"
                                              Click="ProgressDetailEnabled_Click"
                                              VerticalAlignment="Center"
                                              Margin="4,2,10,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border x:Name="ProgressDetailsDropLine"
                        Height="2"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        Background="{DynamicResource PlayAch.Brush.Accent}"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        Panel.ZIndex="10"/>

                <Popup x:Name="ProgressDetailsDragPopup"
                       Placement="AbsolutePoint"
                       AllowsTransparency="True"
                       StaysOpen="True"
                       IsHitTestVisible="False">
                    <Border Background="{DynamicResource PlayAch.Brush.DialogBackdrop}"
                            BorderBrush="{DynamicResource PlayAch.Brush.Accent}"
                            BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                            CornerRadius="10"
                            Padding="8,3">
                        <TextBlock x:Name="ProgressDetailsDragText"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="{DynamicResource PlayAch.FontSize.Caption}"/>
                    </Border>
                </Popup>
            </Grid>
        </controls:SettingRow>
    </StackPanel>
</UserControl>
