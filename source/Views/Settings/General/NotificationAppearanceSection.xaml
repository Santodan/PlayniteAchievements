<UserControl x:Class="PlayniteAchievements.Views.Settings.General.NotificationAppearanceSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:general="clr-namespace:PlayniteAchievements.Views.Settings.General"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/SettingsScopedControlStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/RarityBadges.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Two-band layout: the preview and tester are pinned at the top (always in view) while the
         scope/import-export controls and the per-surface editor scroll below. The Toast/Frame tabs
         live in the pinned band; the matching editor in the scroll band shows/hides by binding to
         each tab's IsSelected, so switching surface swaps both at once. -->
    <Grid Background="{DynamicResource PlayAch.Brush.Panel}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============================ PINNED: preview + tester ============================ -->
            <Border Grid.Row="0"
                    Style="{StaticResource SectionBorderStyle}"
                    Margin="0,0,0,10">
                <TabControl x:Name="SurfaceTabs"
                            Background="Transparent"
                            BorderThickness="0"
                            SelectionChanged="SurfaceTabs_SelectionChanged">
                    <TabItem x:Name="ToastTabItem"
                             Header="{DynamicResource LOCPlayAch_Settings_Style_ToastTab}">
                        <StackPanel Margin="0,12,0,0">
                            <!-- Prominent, live line naming where the previewed style/look come
                                 from (scope + template source). -->
                            <TextBlock x:Name="ToastSourceSummary"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>

                            <Border Background="{DynamicResource PlayAch.Brush.Surface}"
                                    BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,10">
                                <ContentControl x:Name="ToastMockupHost"
                                                ContentTemplate="{DynamicResource PlayAch.Template.AchievementToast}"/>
                            </Border>

                            <!-- Tester. -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Style_SampleUnlock}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <ComboBox x:Name="NotificationSampleSelector"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="SampleSelector_SelectionChanged"
                                          MinWidth="160">
                                    <ComboBoxItem Tag="common" Content="{DynamicResource LOCPlayAch_Rarity_Common}"/>
                                    <ComboBoxItem Tag="uncommon" Content="{DynamicResource LOCPlayAch_Rarity_Uncommon}"/>
                                    <ComboBoxItem Tag="rare" Content="{DynamicResource LOCPlayAch_Rarity_Rare}" IsSelected="True"/>
                                    <ComboBoxItem Tag="ultrarare" Content="{DynamicResource LOCPlayAch_Rarity_UltraRare}"/>
                                    <ComboBoxItem Tag="capstone" Content="{DynamicResource LOCPlayAch_Completed}"/>
                                    <ComboBoxItem Tag="complete" Content="{DynamicResource LOCPlayAch_Toast_GameComplete}"/>
                                    <ComboBoxItem Tag="friend" Content="{DynamicResource LOCPlayAch_Settings_ToastPreviewFriend}"/>
                                </ComboBox>
                            </StackPanel>
                            <WrapPanel Margin="0,0,0,10">
                                <Button Click="FireNotification_Click"
                                        Tag="PluginStyle"
                                        Content="{DynamicResource LOCPlayAch_Settings_Style_FirePluginStyle}"
                                        Margin="0,0,8,8"/>
                                <Button x:Name="NotificationThemeButton"
                                        Click="FireNotification_Click"
                                        Tag="ActiveTheme"
                                        Content="{DynamicResource LOCPlayAch_Settings_Style_FireTheme}"
                                        Margin="0,0,8,8"/>
                            </WrapPanel>

                            <!-- Theme toggle grouped with the tester: it decides whether the live
                                 notification (and the preview above) use the theme's design or the
                                 plugin's. -->
                            <CheckBox x:Name="ToastThemeStylingCheckBox"
                                      Content="{DynamicResource LOCPlayAch_Settings_Style_UseThemeTemplate}"
                                      Click="ThemeStylingCheckBox_Click"/>
                        </StackPanel>
                    </TabItem>

                    <TabItem x:Name="FrameTabItem"
                             Header="{DynamicResource LOCPlayAch_Settings_FrameHeader}">
                        <StackPanel Margin="0,12,0,0">
                            <!-- Prominent, live line naming where the previewed style/look come
                                 from (scope + template source). -->
                            <TextBlock x:Name="FrameSourceSummary"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>

                            <!-- The 16:9 grid stands in for the screenshot; the frame template lays
                                 out on the same 1080-DIP virtual canvas the compositor uses, scaled
                                 down uniformly. -->
                            <Border Background="{DynamicResource PlayAch.Brush.Surface}"
                                    BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,10">
                                <!-- Fill the tab width; the 16:9 canvas scales up uniformly to it. -->
                                <Viewbox Stretch="Uniform"
                                         HorizontalAlignment="Stretch">
                                    <Grid Width="1920"
                                          Height="1080"
                                          Background="#FF17222D">
                                        <ContentControl x:Name="FrameMockupHost"/>
                                    </Grid>
                                </Viewbox>
                            </Border>

                            <!-- Tester. -->
                            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_FramePreviewButton}"
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Style_SampleUnlock}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <ComboBox x:Name="FrameSampleSelector"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="SampleSelector_SelectionChanged"
                                          MinWidth="160">
                                    <ComboBoxItem Tag="common" Content="{DynamicResource LOCPlayAch_Rarity_Common}"/>
                                    <ComboBoxItem Tag="uncommon" Content="{DynamicResource LOCPlayAch_Rarity_Uncommon}"/>
                                    <ComboBoxItem Tag="rare" Content="{DynamicResource LOCPlayAch_Rarity_Rare}" IsSelected="True"/>
                                    <ComboBoxItem Tag="ultrarare" Content="{DynamicResource LOCPlayAch_Rarity_UltraRare}"/>
                                    <ComboBoxItem Tag="capstone" Content="{DynamicResource LOCPlayAch_Completed}"/>
                                    <ComboBoxItem Tag="complete" Content="{DynamicResource LOCPlayAch_Toast_GameComplete}"/>
                                </ComboBox>
                            </StackPanel>
                            <WrapPanel Margin="0,0,0,10">
                                <Button Click="FireFrame_Click"
                                        Tag="PluginStyle"
                                        Content="{DynamicResource LOCPlayAch_Settings_Style_FirePluginStyle}"
                                        Margin="0,0,8,8"/>
                                <Button x:Name="FrameThemeButton"
                                        Click="FireFrame_Click"
                                        Tag="ActiveTheme"
                                        Content="{DynamicResource LOCPlayAch_Settings_Style_FireTheme}"
                                        Margin="0,0,8,8"/>
                            </WrapPanel>

                            <!-- Theme toggle grouped with the tester: it decides whether the saved
                                 screenshot frame (and the preview above) use the theme's design or
                                 the plugin's. -->
                            <CheckBox x:Name="FrameThemeStylingCheckBox"
                                      Content="{DynamicResource LOCPlayAch_Settings_Style_UseThemeTemplate}"
                                      Click="ThemeStylingCheckBox_Click"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- ======================= SCROLL: scope / share / editor ======================= -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Platform selector: Default edits the global appearance; a platform can be
                         given its own whole-style copy via the Customize checkbox. -->
                    <Border Style="{StaticResource SectionBorderStyle}">
                        <StackPanel>
                            <TextBlock x:Name="PlatformHeader"
                                       Text="{DynamicResource LOCPlayAch_Common_Label_Platform}"
                                       Style="{StaticResource SectionHeaderStyle}"
                                       Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>
                            <Border Style="{StaticResource SectionAccentRuleStyle}"/>

                            <StackPanel x:Name="PlatformSelectorPanel"
                                        Orientation="Horizontal">
                                <ComboBox x:Name="PlatformSelector"
                                          MinWidth="220"
                                          SelectionChanged="PlatformSelector_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Image Width="16"
                                                       Height="16"
                                                       Margin="{StaticResource PlayAch.Thickness.Right.Sm}"
                                                       VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding HasProviderIcon, Converter={StaticResource BoolToVis}}">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource ProviderIconConverter}">
                                                            <Binding Path="ProviderIconKey"/>
                                                            <Binding Path="ProviderColorHex"/>
                                                        </MultiBinding>
                                                    </Image.Source>
                                                </Image>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <CheckBox x:Name="CustomizeCheckBox"
                                          Content="{DynamicResource LOCPlayAch_Settings_Style_CustomizeForPlatform}"
                                          Click="CustomizeCheckBox_Click"
                                          VerticalAlignment="Center"
                                          Margin="14,0,0,0"
                                          Visibility="Collapsed"/>
                            </StackPanel>
                            <TextBlock x:Name="FollowDefaultHint"
                                       Text="{DynamicResource LOCPlayAch_Settings_Style_FollowDefaultHint}"
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"
                                       Margin="0,8,0,0"/>
                            <StackPanel x:Name="GameSelectionPanel"
                                        Visibility="Collapsed">
                                <TextBlock Text="{DynamicResource LOCPlayAch_Section_Notifications}"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                                <CheckBox x:Name="CustomizeGameCheckBox"
                                          Content="{DynamicResource LOCPlayAch_ManageAchievements_Notifications_Customize}"
                                          Click="CustomizeGameCheckBox_Click"
                                          Margin="0,10,0,0"/>
                                <TextBlock x:Name="GameInheritanceHint"
                                           Style="{StaticResource MutedTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                            </StackPanel>

                            <!-- Share the selected style: export to a .pastyle(.zip) file or import
                                 one onto the current platform selection. -->
                            <WrapPanel Margin="0,14,0,0">
                                <Button x:Name="ExportStyleButton"
                                        Click="ExportStyle_Click"
                                        Content="{DynamicResource LOCPlayAch_Settings_Style_ExportButton}"
                                        Margin="0,0,8,0"/>
                                <Button x:Name="ImportStyleButton"
                                        Click="ImportStyle_Click"
                                        Content="{DynamicResource LOCPlayAch_Settings_Style_ImportButton}"/>
                            </WrapPanel>
                            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Style_ShareHint}"
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                            <!-- Named presets for the tab selected above: save the active surface's
                                 appearance (including images and any custom template) under a name,
                                 or apply a saved preset to the current platform/game selection. The
                                 dropdown lists only presets for the active surface. -->
                            <TextBlock Text="{DynamicResource LOCPlayAch_Presets_Header}"
                                       Style="{StaticResource SectionHeaderStyle}"
                                       Margin="0,14,0,0"/>
                            <WrapPanel Margin="0,8,0,0">
                                <ComboBox x:Name="PresetSelector"
                                          MinWidth="220"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0"
                                          SelectionChanged="PresetSelector_SelectionChanged"/>
                                <Button x:Name="ApplyPresetButton"
                                        Click="ApplyPreset_Click"
                                        Content="{DynamicResource LOCPlayAch_Button_Apply}"
                                        IsEnabled="False"
                                        Margin="0,0,8,0"/>
                                <Button x:Name="SavePresetButton"
                                        Click="SavePreset_Click"
                                        Content="{DynamicResource LOCPlayAch_Presets_Save}"
                                        Margin="0,0,8,0"/>
                                <Button x:Name="DeletePresetButton"
                                        Click="DeletePreset_Click"
                                        Content="{DynamicResource LOCPlayAch_Button_Delete}"
                                        IsEnabled="False"/>
                            </WrapPanel>
                            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Style_Presets_Hint}"
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                            <!-- Per-surface actions for the tab selected above: reset the surface to
                                 its built-in default (clears style edits and any custom template),
                                 or export the default template as a loose .xaml starting point to
                                 edit and re-import. Only the active tab's row is shown. -->
                            <WrapPanel Margin="0,10,0,0"
                                       Visibility="{Binding IsSelected, ElementName=ToastTabItem, Converter={StaticResource BoolToVis}}">
                                <Button Click="ResetToastStyle_Click"
                                        Content="{DynamicResource LOCPlayAch_Settings_Style_ResetToDefault}"
                                        Margin="0,0,8,0"/>
                                <Button Click="ExportDefaultToastTemplate_Click"
                                        Content="{DynamicResource LOCPlayAch_Settings_Style_ExportDefaultTemplate}"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,10,0,0"
                                       Visibility="{Binding IsSelected, ElementName=FrameTabItem, Converter={StaticResource BoolToVis}}">
                                <Button Click="ResetFrameStyle_Click"
                                        Content="{DynamicResource LOCPlayAch_Settings_Style_ResetToDefault}"
                                        Margin="0,0,8,0"/>
                                <Button Click="ExportDefaultFrameTemplate_Click"
                                        Content="{DynamicResource LOCPlayAch_Settings_Style_ExportDefaultTemplate}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- The editor for the surface selected in the pinned tabs above. Both exist;
                         each shows only when its tab is active. -->
                    <general:NotificationSurfaceStyleEditor
                        x:Name="ToastEditor"
                        Visibility="{Binding IsSelected, ElementName=ToastTabItem, Converter={StaticResource BoolToVis}}"/>
                    <general:NotificationSurfaceStyleEditor
                        x:Name="FrameEditor"
                        Visibility="{Binding IsSelected, ElementName=FrameTabItem, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
