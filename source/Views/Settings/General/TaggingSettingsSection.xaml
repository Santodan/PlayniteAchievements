<UserControl x:Class="PlayniteAchievements.Views.Settings.General.TaggingSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/SettingsScopedControlStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- One row of related tags (TagPairRow): each tag is an enable toggle plus the name it
                 writes, and the name boxes split the row's width. A one-sided row leaves the
                 second half empty so its box lines up with the first column. -->
            <DataTemplate x:Key="TagPairRowTemplate">
                <controls:SettingRow Label="{Binding Label}"
                                     HorizontalContentAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0"
                                   Margin="{StaticResource PlayAch.Thickness.Right.Md}">
                            <CheckBox DockPanel.Dock="Left"
                                      IsChecked="{Binding First.IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center"
                                      Margin="{StaticResource PlayAch.Thickness.Right.Sm}"/>
                            <TextBox Text="{Binding First.DisplayName, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                     MinWidth="120"/>
                        </DockPanel>
                        <DockPanel Grid.Column="1"
                                   Visibility="{Binding HasSecond, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <CheckBox DockPanel.Dock="Left"
                                      IsChecked="{Binding Second.IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center"
                                      Margin="{StaticResource PlayAch.Thickness.Right.Sm}"/>
                            <TextBox Text="{Binding Second.DisplayName, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                     MinWidth="120"/>
                        </DockPanel>
                    </Grid>
                </controls:SettingRow>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">

            <!-- ================== TAGGING ================== -->
            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel Grid.IsSharedSizeScope="True">
                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_TaggingHeader}"
                               Style="{StaticResource SectionHeaderStyle}"/>

                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_TaggingDescription}"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="{StaticResource PlayAch.Thickness.Bottom.Lg}"
                               TextWrapping="Wrap"/>

                    <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_EnableTagging}">
                        <CheckBox IsChecked="{Binding Persisted.TaggingSettings.EnableTagging, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:SettingRow>

                    <!-- Completion status, actions and the tag list - only visible when tagging is enabled -->
                    <StackPanel Margin="{StaticResource PlayAch.Thickness.SettingRow.Indent}"
                                Visibility="{Binding Persisted.TaggingSettings.EnableTagging, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Grid.IsSharedSizeScope="True">

                        <!-- Completion Status -->
                        <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_SetCompletionStatus}">
                            <CheckBox IsChecked="{Binding Persisted.TaggingSettings.SetCompletionStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </controls:SettingRow>

                        <StackPanel Margin="{StaticResource PlayAch.Thickness.SettingRow.Indent}"
                                    Visibility="{Binding Persisted.TaggingSettings.SetCompletionStatus, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Grid.IsSharedSizeScope="True">
                            <controls:SettingRow Label="{DynamicResource LOCCompletionStatus}">
                                <ComboBox x:Name="CompletionStatusComboBox"
                                          MinWidth="200"
                                          ItemsSource="{Binding CompletionStatuses, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding Persisted.TaggingSettings.CompletionStatusId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue={x:Static sys:Guid.Empty}}"/>
                            </controls:SettingRow>
                        </StackPanel>

                        <!-- Action Buttons: section-level actions, not one setting's control. -->
                        <StackPanel Orientation="Horizontal" Margin="0">
                            <Button Content="{DynamicResource LOCPlayAch_Settings_ApplyAndSync}"
                                    Click="ApplyAndSync_Click"
                                    Margin="{StaticResource PlayAch.Thickness.Right.Sm}"
                                    Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"/>
                            <Button Content="{DynamicResource LOCPlayAch_Settings_RemoveAllTags}"
                                    Click="RemoveAllTags_Click"
                                    Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"/>
                        </StackPanel>

                        <!-- Tags: one scope so status and customization rows share a label column. -->
                        <StackPanel Grid.IsSharedSizeScope="True">
                            <TextBlock Text="{DynamicResource LOCPlayAch_Column_Status}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       Margin="{StaticResource PlayAch.Thickness.SubSectionHeading}"/>
                            <ItemsControl ItemsSource="{Binding Persisted.TaggingSettings.StatusRows}"
                                          ItemTemplate="{StaticResource TagPairRowTemplate}"
                                          Focusable="False"/>

                            <TextBlock Text="{DynamicResource LOCPlayAch_Filter_CustomizationSelectorPlaceholder}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       Margin="{StaticResource PlayAch.Thickness.SubSectionHeading}"/>
                            <ItemsControl ItemsSource="{Binding Persisted.TaggingSettings.CustomizationRows}"
                                          ItemTemplate="{StaticResource TagPairRowTemplate}"
                                          Focusable="False"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
