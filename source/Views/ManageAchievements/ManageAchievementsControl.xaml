<UserControl x:Class="PlayniteAchievements.Views.ManageAchievements.ManageAchievementsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:PlayniteAchievements.Views.ManageAchievements"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             xmlns:converters="clr-namespace:PlayniteAchievements.Views.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1050">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/ManageAchievementsScopedControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="NavTabRadioStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Body}" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="BorderRoot"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="BorderRoot" Property="Background" Value="{StaticResource PlayAch.Brush.Overlay.Tint.1F}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BorderRoot" Property="Background" Value="{StaticResource PlayAch.Brush.Overlay.Tint.14}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="BorderRoot" Property="Background" Value="{StaticResource PlayAch.Brush.Overlay.Tint.20}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NavSectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}" />
                <Setter Property="Opacity" Value="0.65" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Body}" />
                <Setter Property="Margin" Value="0,12,0,4" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource PlayAch.Brush.Window.Background}" Padding="12">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource PlayAch.Brush.Surface}"
                BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                CornerRadius="{StaticResource PlayAch.Radius.Card}"
                Padding="{StaticResource PlayAch.Thickness.CardPadding}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="2"
                        Height="190"
                        CornerRadius="{StaticResource PlayAch.Radius.Card}"
                        ClipToBounds="False"
                        Background="Transparent">
                    <Image Stretch="Uniform"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           helpers:AsyncImage.Uri="{Binding GameImagePath, Converter={StaticResource DefaultGameImage}, ConverterParameter=cover}"
                           helpers:AsyncImage.DecodePixel="480" />
                </Border>

                <ScrollViewer Grid.Row="4"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Common_General}"
                                   Style="{StaticResource NavSectionHeaderStyle}"
                                   Margin="0,0,0,4" />
                        <RadioButton x:Name="OverviewTabButton"
                                     Content="{DynamicResource LOCPlayAch_ManageAchievements_Tab_Overview}"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Overview}" />
                        <RadioButton x:Name="ManualTrackingTabButton"
                                     Content="{DynamicResource LOCPlayAch_ManageAchievements_Tab_ManualTracking}"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     Visibility="{Binding ShowManualTrackingTab, Converter={StaticResource BoolToVis}}"
                                     IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=ManualTracking}" />

                        <RadioButton x:Name="CustomSchemaTabButton"
                                     Content="{DynamicResource LOCPlayAch_GameOptions_Tab_CustomSchema}"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=CustomSchema}" />

                        <TextBlock x:Name="AchievementsSectionHeader"
                                   Text="{DynamicResource LOCPlayAch_Achievements}"
                                   Style="{StaticResource NavSectionHeaderStyle}"
                                   Visibility="{Binding HasAchievementData, Converter={StaticResource BoolToVis}}" />
                        <RadioButton x:Name="CategoryTabButton"
                                     Content="{DynamicResource LOCPlayAch_ManageAchievements_Tab_Category}"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     Visibility="{Binding HasAchievementData, Converter={StaticResource BoolToVis}}"
                                     IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Category}" />
                        <RadioButton x:Name="FiltersTabButton"
                                     Content="{DynamicResource LOCPlayAch_Menu_Filters}"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     Visibility="{Binding HasAchievementData, Converter={StaticResource BoolToVis}}"
                                     IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Filters}" />
                        <RadioButton x:Name="AchievementOrderTabButton"
                                     Content="{DynamicResource LOCPlayAch_ManageAchievements_Tab_AchievementOrder}"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     Visibility="{Binding HasAchievementData, Converter={StaticResource BoolToVis}}"
                                     IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=AchievementOrder}" />
                        <RadioButton x:Name="CapstonesTabButton"
                                     Content="{DynamicResource LOCPlayAch_ManageAchievements_Tab_Capstones}"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     Visibility="{Binding HasAchievementData, Converter={StaticResource BoolToVis}}"
                                     IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Capstones}" />
                        <RadioButton x:Name="GoalsTabButton"
                                     Content="{DynamicResource LOCPlayAch_ManageAchievements_Tab_Goals}"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     Visibility="{Binding HasAchievementData, Converter={StaticResource BoolToVis}}"
                                     IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Goals}" />
                        <RadioButton x:Name="NotesTabButton"
                                     Content="{DynamicResource LOCPlayAch_ManageAchievements_Tab_Notes}"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     Visibility="{Binding HasAchievementData, Converter={StaticResource BoolToVis}}"
                                     IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Notes}" />

                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Appearance}"
                                   Style="{StaticResource NavSectionHeaderStyle}" />
                        <RadioButton x:Name="CustomIconsTabButton"
                                     Content="{DynamicResource LOCPlayAch_ManageAchievements_Tab_CustomIcons}"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     Visibility="{Binding HasAchievementData, Converter={StaticResource BoolToVis}}"
                                     IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=CustomIcons}" />
                        <RadioButton x:Name="NotificationsTabButton"
                                     Content="{DynamicResource LOCPlayAch_Settings_TabNotifications}"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Notifications}" />

                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Maintenance_Title}"
                                   Style="{StaticResource NavSectionHeaderStyle}" />
                        <RadioButton x:Name="OverridesTabButton"
                                     Content="{DynamicResource LOCPlayAch_ManageAchievements_Tab_Overrides}"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Overrides}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border x:Name="ManageAchievementsContentHost"
                Grid.Column="2"
                Background="{DynamicResource PlayAch.Brush.Surface}"
                BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                CornerRadius="{StaticResource PlayAch.Radius.Card}"
                Padding="{StaticResource PlayAch.Thickness.CardPadding}">
            <Grid>
                <views:ManageAchievementsOverviewTab x:Name="OverviewTabControl">
                    <views:ManageAchievementsOverviewTab.Style>
                        <Style TargetType="{x:Type views:ManageAchievementsOverviewTab}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Overview">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:ManageAchievementsOverviewTab.Style>
                </views:ManageAchievementsOverviewTab>

                <Grid x:Name="CustomSchemaControlRoot">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="CustomSchema">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <RadioButton Content="{DynamicResource LOCPlayAch_GameOptions_Tab_Schema}"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     Margin="0"
                                     IsChecked="{Binding SelectedCustomSchemaTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=SchemaJson}" />
                        <RadioButton Content="{DynamicResource LOCPlayAch_GameOptions_Tab_Capstones}"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     Margin="8,0,0,0"
                                     IsChecked="{Binding SelectedCustomSchemaTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Capstones}" />
                        <RadioButton Content="{DynamicResource LOCPlayAch_GameOptions_Tab_Category}"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     Margin="8,0,0,0"
                                     IsChecked="{Binding SelectedCustomSchemaTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Category}" />
                        <RadioButton Content="{DynamicResource LOCPlayAch_GameOptions_Tab_AchievementOrder}"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     Margin="8,0,0,0"
                                     IsChecked="{Binding SelectedCustomSchemaTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=AchievementOrder}" />
                        <RadioButton Content="{DynamicResource LOCPlayAch_GameOptions_Tab_CustomIcons}"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     Margin="8,0,0,0"
                                     IsChecked="{Binding SelectedCustomSchemaTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=CustomIcons}" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCustomSchemaTab}" Value="SchemaJson">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="{Binding LocalCustomSchemaStatusText}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       TextWrapping="Wrap"
                                       Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}" />
                            <CheckBox Grid.Row="1"
                                      Content="{DynamicResource LOCPlayAch_GameOptions_CustomSchemaEnabled}"
                                      IsChecked="{Binding LocalCustomSchemaEnabled, Mode=TwoWay}"
                                      Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}" />
                            <Grid Grid.Row="2" Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding LocalCustomSchemaOverrideInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" />
                                <Button Grid.Column="1"
                                        Content="{DynamicResource LOCPlayAch_Button_Browse}"
                                        Command="{Binding BrowseLocalCustomSchemaOverrideCommand}"
                                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                        Margin="{StaticResource PlayAch.Thickness.Left.Sm}" />
                                <Button Grid.Column="2"
                                        Content="{DynamicResource LOCPlayAch_Button_Apply}"
                                        Command="{Binding ApplyLocalCustomSchemaOverrideCommand}"
                                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                        Margin="{StaticResource PlayAch.Thickness.Left.Sm}" />
                                <Button Grid.Column="3"
                                        Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                        Command="{Binding ClearLocalCustomSchemaOverrideCommand}"
                                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                        Margin="{StaticResource PlayAch.Thickness.Left.Sm}" />
                            </Grid>
                            <StackPanel Grid.Row="3"
                                        Orientation="Horizontal"
                                        Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}">
                                <Button Content="{DynamicResource LOCPlayAch_Button_Reload}"
                                        Command="{Binding ReloadCustomSchemaEditorCommand}"
                                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                        Margin="{StaticResource PlayAch.Thickness.Right.Sm}" />
                                <Button Content="{DynamicResource LOCPlayAch_Button_Save}"
                                        Command="{Binding SaveCustomSchemaEditorCommand}"
                                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding}" />
                            </StackPanel>
                            <TextBox Grid.Row="4"
                                     Text="{Binding CustomSchemaEditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Padding="8" />
                            <TextBlock Grid.Row="5"
                                       Text="{Binding CustomSchemaEditorStatus}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       Margin="{StaticResource PlayAch.Thickness.Top.Sm}"
                                       TextWrapping="Wrap"
                                       Opacity="0.82">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CustomSchemaEditorStatusIsError}" Value="True">
                                                <Setter Property="Foreground" Value="#FFE07070" />
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid>
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCustomSchemaTab}" Value="Capstones">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <ContentControl x:Name="CustomSchemaCapstoneHost" />
                        </Grid>

                        <Grid>
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCustomSchemaTab}" Value="AchievementOrder">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <ContentControl x:Name="CustomSchemaAchievementOrderHost" />
                        </Grid>

                        <Grid>
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCustomSchemaTab}" Value="Category">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <ContentControl x:Name="CustomSchemaCategoryHost" />
                        </Grid>

                        <Grid>
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCustomSchemaTab}" Value="CustomIcons">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <ContentControl x:Name="CustomSchemaAchievementIconsHost" />
                        </Grid>
                    </Grid>
                </Grid>

                <views:ManageAchievementsOverridesTab x:Name="OverridesTabControl">
                    <views:ManageAchievementsOverridesTab.Style>
                        <Style TargetType="{x:Type views:ManageAchievementsOverridesTab}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Overrides">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:ManageAchievementsOverridesTab.Style>
                </views:ManageAchievementsOverridesTab>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Capstones">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <ContentControl x:Name="CapstoneHost" />
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="ManualTracking">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ContentControl x:Name="ManualHost" />
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="AchievementOrder">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ContentControl x:Name="AchievementOrderHost" />
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Goals">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ContentControl x:Name="GoalsHost" />
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Category">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ContentControl x:Name="CategoryHost" />
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Filters">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ContentControl x:Name="FiltersHost" />
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Notes">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ContentControl x:Name="NotesHost" />
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="CustomIcons">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ContentControl x:Name="AchievementIconsHost" />
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Notifications">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ContentControl x:Name="NotificationsHost" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
    </Border>
</UserControl>
