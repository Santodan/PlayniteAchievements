<UserControl x:Class="PlayniteAchievements.Views.ManageAchievements.ManageAchievementsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:PlayniteAchievements.Views.ManageAchievements"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             xmlns:converters="clr-namespace:PlayniteAchievements.Views.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1050">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/ManageAchievementsScopedControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="NavTabRadioStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Body}" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="BorderRoot"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="BorderRoot" Property="Background" Value="{StaticResource PlayAch.Brush.Overlay.Tint.1F}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BorderRoot" Property="Background" Value="{StaticResource PlayAch.Brush.Overlay.Tint.14}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="BorderRoot" Property="Background" Value="{StaticResource PlayAch.Brush.Overlay.Tint.20}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NavSectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}" />
                <Setter Property="Opacity" Value="0.65" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Body}" />
                <Setter Property="Margin" Value="0,12,0,4" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource PlayAch.Brush.Window.Background}" Padding="12">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource PlayAch.Brush.Surface}"
                BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                CornerRadius="{StaticResource PlayAch.Radius.Card}"
                Padding="{StaticResource PlayAch.Thickness.CardPadding}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="2"
                        Height="190"
                        CornerRadius="{StaticResource PlayAch.Radius.Card}"
                        ClipToBounds="False"
                        Background="Transparent">
                    <Image Stretch="Uniform"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           helpers:AsyncImage.Uri="{Binding GameImagePath, Converter={StaticResource DefaultGameImage}, ConverterParameter=cover}"
                           helpers:AsyncImage.DecodePixel="480" />
                </Border>

                <ScrollViewer Grid.Row="4"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Common_General}"
                                   Style="{StaticResource NavSectionHeaderStyle}"
                                   Margin="0,0,0,4" />
                        <RadioButton x:Name="OverviewTabButton"
                                     Content="{DynamicResource LOCPlayAch_ManageAchievements_Tab_Overview}"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Overview}" />
                        <!-- Not gated on HasAchievementData: it is the Custom tab widened to every
                             achievement, so it must stay reachable for a game with no cached
                             achievements, where custom ones are authored. -->
                        <RadioButton x:Name="EditorTabButton"
                                     Content="{DynamicResource LOCPlayAch_ManageAchievements_Tab_Editor}"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Editor}" />

                        <RadioButton x:Name="CategoryTabButton"
                                     Content="{DynamicResource LOCPlayAch_ManageAchievements_Tab_Category}"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     Visibility="{Binding HasAchievementData, Converter={StaticResource BoolToVis}}"
                                     IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Category}" />

                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Appearance}"
                                   Style="{StaticResource NavSectionHeaderStyle}" />
                        <RadioButton x:Name="NotificationsTabButton"
                                     Content="{DynamicResource LOCPlayAch_Settings_TabNotifications}"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Notifications}" />

                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Maintenance_Title}"
                                   Style="{StaticResource NavSectionHeaderStyle}" />
                        <RadioButton x:Name="OverridesTabButton"
                                     Content="{DynamicResource LOCPlayAch_ManageAchievements_Tab_Overrides}"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Overrides}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Always-visible stats: completion and the rarity, trophy, points, goal and
                     categorized counts, pinned under the nav so every tab shows them. -->
                <Border Grid.Row="5"
                        BorderBrush="{DynamicResource PlayAch.Brush.ControlBorder}"
                        BorderThickness="0,1,0,0"
                        Margin="0,10,0,0"
                        Padding="0,10,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Text="{DynamicResource LOCPlayAch_ManageAchievements_Overview_Completion}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CompletionSummary}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar Value="{Binding CompletionPercentValue, Mode=OneWay}"
                                     Maximum="100"
                                     Height="6"
                                     Margin="0,6,0,8" />

                        <WrapPanel Visibility="{Binding HasAchievementData, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource MetaChipStyle}" ToolTip="{DynamicResource LOCPlayAch_Rarity_Common}"
                                    Visibility="{Binding OverviewSummary.RarityCommon.IsVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Style="{StaticResource OverviewBadgeImageStyle}" Source="{DynamicResource BadgeRarityCommon}" />
                                    <TextBlock Style="{StaticResource ChipCountTextStyle}" Text="{Binding OverviewSummary.RarityCommon.Text}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaChipStyle}" ToolTip="{DynamicResource LOCPlayAch_Rarity_Uncommon}"
                                    Visibility="{Binding OverviewSummary.RarityUncommon.IsVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Style="{StaticResource OverviewBadgeImageStyle}" Source="{DynamicResource BadgeRarityUncommon}" />
                                    <TextBlock Style="{StaticResource ChipCountTextStyle}" Text="{Binding OverviewSummary.RarityUncommon.Text}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaChipStyle}" ToolTip="{DynamicResource LOCPlayAch_Rarity_Rare}"
                                    Visibility="{Binding OverviewSummary.RarityRare.IsVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Style="{StaticResource OverviewBadgeImageStyle}" Source="{DynamicResource BadgeRarityRare}" />
                                    <TextBlock Style="{StaticResource ChipCountTextStyle}" Text="{Binding OverviewSummary.RarityRare.Text}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaChipStyle}" ToolTip="{DynamicResource LOCPlayAch_Rarity_UltraRare}"
                                    Visibility="{Binding OverviewSummary.RarityUltraRare.IsVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Style="{StaticResource OverviewBadgeImageStyle}" Source="{DynamicResource BadgeRarityUltraRare}" />
                                    <TextBlock Style="{StaticResource ChipCountTextStyle}" Text="{Binding OverviewSummary.RarityUltraRare.Text}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaChipStyle}" ToolTip="{DynamicResource LOCPlayAch_Trophy_Platinum}"
                                    Visibility="{Binding OverviewSummary.TrophyPlatinum.IsVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Style="{StaticResource OverviewBadgeImageStyle}" Source="{DynamicResource TrophyPlatinum}" />
                                    <TextBlock Style="{StaticResource ChipCountTextStyle}" Text="{Binding OverviewSummary.TrophyPlatinum.Text}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaChipStyle}" ToolTip="{DynamicResource LOCPlayAch_Trophy_Gold}"
                                    Visibility="{Binding OverviewSummary.TrophyGold.IsVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Style="{StaticResource OverviewBadgeImageStyle}" Source="{DynamicResource TrophyGold}" />
                                    <TextBlock Style="{StaticResource ChipCountTextStyle}" Text="{Binding OverviewSummary.TrophyGold.Text}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaChipStyle}" ToolTip="{DynamicResource LOCPlayAch_Trophy_Silver}"
                                    Visibility="{Binding OverviewSummary.TrophySilver.IsVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Style="{StaticResource OverviewBadgeImageStyle}" Source="{DynamicResource TrophySilver}" />
                                    <TextBlock Style="{StaticResource ChipCountTextStyle}" Text="{Binding OverviewSummary.TrophySilver.Text}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaChipStyle}" ToolTip="{DynamicResource LOCPlayAch_Trophy_Bronze}"
                                    Visibility="{Binding OverviewSummary.TrophyBronze.IsVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Style="{StaticResource OverviewBadgeImageStyle}" Source="{DynamicResource TrophyBronze}" />
                                    <TextBlock Style="{StaticResource ChipCountTextStyle}" Text="{Binding OverviewSummary.TrophyBronze.Text}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaChipStyle}"
                                    Visibility="{Binding OverviewSummary.Points.IsVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ChipTextStyle}" Text="{DynamicResource LOCPlayAch_Column_Points}" />
                                    <TextBlock Style="{StaticResource ChipCountTextStyle}" Text="{Binding OverviewSummary.Points.Text}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaChipStyle}"
                                    Visibility="{Binding OverviewSummary.Goals.IsVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ChipTextStyle}" Text="{DynamicResource LOCPlayAch_ManageAchievements_Editor_Goal}" />
                                    <TextBlock Style="{StaticResource ChipCountTextStyle}" Text="{Binding OverviewSummary.Goals.Text}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaChipStyle}"
                                    Visibility="{Binding OverviewSummary.Categorized.IsVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ChipTextStyle}" Text="{DynamicResource LOCPlayAch_ManageAchievements_Overview_Categorized}" />
                                    <TextBlock Style="{StaticResource ChipCountTextStyle}" Text="{Binding OverviewSummary.Categorized.Text}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="ManageAchievementsContentHost"
                Grid.Column="2"
                Background="{DynamicResource PlayAch.Brush.Surface}"
                BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                CornerRadius="{StaticResource PlayAch.Radius.Card}"
                Padding="{StaticResource PlayAch.Thickness.CardPadding}">
            <Grid>
                <!-- Every tab is a host, and every host is Hidden rather than Collapsed when
                     it is not the selected one.

                     Hosted, so the shell does not build all five: overview and overrides used
                     to be inline, which put their construction and first layout inside
                     ShowDialog's synchronous first render.

                     Hidden, so a host that has been filled is still measured and arranged.
                     WPF skips layout for a Collapsed element entirely, which meant a
                     pre-built tab still paid its whole first layout and render on the click
                     that revealed it - measured as a 557ms stall on selecting the editor.
                     Hidden lets the idle prebuild absorb that instead. -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Overview">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ContentControl x:Name="OverviewHost" />
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Overrides">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ContentControl x:Name="OverridesHost" />
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Editor">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ContentControl x:Name="EditorHost" />
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Category">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ContentControl x:Name="CategoryHost" />
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Notifications">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ContentControl x:Name="NotificationsHost" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
    </Border>
</UserControl>
