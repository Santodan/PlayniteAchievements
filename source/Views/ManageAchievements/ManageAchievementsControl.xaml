<UserControl x:Class="PlayniteAchievements.Views.ManageAchievements.ManageAchievementsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:PlayniteAchievements.Views.ManageAchievements"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             xmlns:converters="clr-namespace:PlayniteAchievements.Views.Converters"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1050">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/ManageAchievementsScopedControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="NavTabRadioStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Body}" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="BorderRoot"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="BorderRoot" Property="Background" Value="{StaticResource PlayAch.Brush.Overlay.Tint.1F}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BorderRoot" Property="Background" Value="{StaticResource PlayAch.Brush.Overlay.Tint.14}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="BorderRoot" Property="Background" Value="{StaticResource PlayAch.Brush.Overlay.Tint.20}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Sidebar stats: one full-width chip per row, icon or label left, value right. -->
            <Style x:Key="SidebarStatChipStyle" TargetType="Border" BasedOn="{StaticResource MetaChipStyle}">
                <Setter Property="Margin" Value="0,0,0,3" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="SidebarStatValueStyle" TargetType="TextBlock" BasedOn="{StaticResource ChipCountTextStyle}">
                <Setter Property="Grid.Column" Value="1" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SidebarStatGroupStyle" TargetType="StackPanel">
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
            <!-- Rarity and trophies pair up two per row. Columns are equal and as wide as the widest
                 chip, so long counts widen the sidebar; a hidden chip drops out and the rest close
                 up, and a chip left alone on the last row spans both columns. The panel owns the
                 gaps, so its chips carry no margin; the 9 bottom margin matches a single-column
                 group's last chip gap plus group gap. -->
            <Style x:Key="SidebarStatPairGroupStyle" TargetType="controls:PairedRowsPanel">
                <Setter Property="ColumnGap" Value="3" />
                <Setter Property="RowGap" Value="3" />
                <Setter Property="Margin" Value="0,0,0,9" />
            </Style>
            <Style x:Key="SidebarStatPairChipStyle" TargetType="Border" BasedOn="{StaticResource SidebarStatChipStyle}">
                <Setter Property="Margin" Value="0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource PlayAch.Brush.Window.Background}" Padding="12">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- As wide as the longest tab name or stat row; the cover follows that width. The
                 stats reserve their widest row up front, so the width holds still: a change
                 would resize the content column and re-lay-out every tab host in it. -->
            <ColumnDefinition Width="Auto" MinWidth="150" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource PlayAch.Brush.Surface}"
                BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                CornerRadius="{StaticResource PlayAch.Radius.Card}"
                Padding="{StaticResource PlayAch.Thickness.CardPadding}">
            <DockPanel LastChildFill="True">
                <!-- Always-visible stats, docked at the bottom so every tab shows them. Right-click
                     shows or hides stat groups for every game. Transparent background so the
                     gaps between chips take the right-click too. -->
                <Border x:Name="SidebarStatsHost"
                        DockPanel.Dock="Bottom"
                        Background="Transparent"
                        MouseRightButtonUp="SidebarStatsHost_MouseRightButtonUp"
                        BorderBrush="{DynamicResource PlayAch.Brush.ControlBorder}"
                        BorderThickness="0,1,0,0"
                        Margin="0,10,0,0"
                        Padding="0,10,0,0">
                    <StackPanel>
                        <!-- Width reservation: a zero-height, hidden pair row with five-digit
                             counts, so the sidebar is already wide enough for every chip it may
                             later show. Without it a chip appearing or a count gaining a digit
                             would widen the sidebar, and every tab host beside it would
                             re-lay-out. -->
                        <controls:PairedRowsPanel Height="0"
                                                  Visibility="Hidden"
                                                  Style="{StaticResource SidebarStatPairGroupStyle}"
                                                  Margin="0">
                            <Border Style="{StaticResource SidebarStatPairChipStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Style="{StaticResource OverviewBadgeImageStyle}" />
                                    <TextBlock Style="{StaticResource SidebarStatValueStyle}" Text="00,000 / 00,000" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SidebarStatPairChipStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Style="{StaticResource OverviewBadgeImageStyle}" />
                                    <TextBlock Style="{StaticResource SidebarStatValueStyle}" Text="00,000 / 00,000" />
                                </Grid>
                            </Border>
                        </controls:PairedRowsPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Text="{DynamicResource LOCPlayAch_ManageAchievements_Overview_Completion}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CompletionSummary}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       FontWeight="SemiBold"
                                       Margin="12,0,0,0"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar Value="{Binding CompletionPercentValue, Mode=OneWay}"
                                     Maximum="100"
                                     Height="6"
                                     Margin="0,6,0,10" />

                        <Border BorderBrush="{DynamicResource PlayAch.Brush.ControlBorder}"
                                BorderThickness="0,1,0,0"
                                Margin="0,0,0,10"
                                Visibility="{Binding SidebarAnyStatsVisible, Converter={StaticResource BoolToVis}}" />

                        <!-- Capstones, then rarity and trophies (highest first), then the rest. A group collapses
                             when the game has nothing for it or it is hidden from the right-click menu. -->
                        <StackPanel Visibility="{Binding SidebarAnyStatsVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel Style="{StaticResource SidebarStatGroupStyle}"
                                        Visibility="{Binding SidebarCapstonesVisible, Converter={StaticResource BoolToVis}}">
                                <Border Style="{StaticResource SidebarStatChipStyle}" ToolTip="{Binding OverviewSummary.Capstones.ToolTip}"
                                        Visibility="{Binding SidebarCapstonesVisible, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Style="{StaticResource OverviewBadgeImageStyle}" Source="{DynamicResource BadgeCompletedGame}" />
                                        <TextBlock Style="{StaticResource SidebarStatValueStyle}" Text="{Binding OverviewSummary.Capstones.Text}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <controls:PairedRowsPanel Style="{StaticResource SidebarStatPairGroupStyle}"
                                         Visibility="{Binding SidebarRarityVisible, Converter={StaticResource BoolToVis}}">
                                <Border Style="{StaticResource SidebarStatPairChipStyle}" ToolTip="{DynamicResource LOCPlayAch_Rarity_UltraRare}"
                                        Visibility="{Binding OverviewSummary.RarityUltraRare.IsVisible, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Style="{StaticResource OverviewBadgeImageStyle}" Source="{DynamicResource BadgeRarityUltraRare}" />
                                        <TextBlock Style="{StaticResource SidebarStatValueStyle}" Text="{Binding OverviewSummary.RarityUltraRare.Text}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SidebarStatPairChipStyle}" ToolTip="{DynamicResource LOCPlayAch_Rarity_Rare}"
                                        Visibility="{Binding OverviewSummary.RarityRare.IsVisible, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Style="{StaticResource OverviewBadgeImageStyle}" Source="{DynamicResource BadgeRarityRare}" />
                                        <TextBlock Style="{StaticResource SidebarStatValueStyle}" Text="{Binding OverviewSummary.RarityRare.Text}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SidebarStatPairChipStyle}" ToolTip="{DynamicResource LOCPlayAch_Rarity_Uncommon}"
                                        Visibility="{Binding OverviewSummary.RarityUncommon.IsVisible, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Style="{StaticResource OverviewBadgeImageStyle}" Source="{DynamicResource BadgeRarityUncommon}" />
                                        <TextBlock Style="{StaticResource SidebarStatValueStyle}" Text="{Binding OverviewSummary.RarityUncommon.Text}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SidebarStatPairChipStyle}" ToolTip="{DynamicResource LOCPlayAch_Rarity_Common}"
                                        Visibility="{Binding OverviewSummary.RarityCommon.IsVisible, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Style="{StaticResource OverviewBadgeImageStyle}" Source="{DynamicResource BadgeRarityCommon}" />
                                        <TextBlock Style="{StaticResource SidebarStatValueStyle}" Text="{Binding OverviewSummary.RarityCommon.Text}" />
                                    </Grid>
                                </Border>
                            </controls:PairedRowsPanel>
                            <controls:PairedRowsPanel Style="{StaticResource SidebarStatPairGroupStyle}"
                                         Visibility="{Binding SidebarTrophiesVisible, Converter={StaticResource BoolToVis}}">
                                <Border Style="{StaticResource SidebarStatPairChipStyle}" ToolTip="{DynamicResource LOCPlayAch_Trophy_Platinum}"
                                        Visibility="{Binding OverviewSummary.TrophyPlatinum.IsVisible, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Style="{StaticResource OverviewBadgeImageStyle}" Source="{DynamicResource TrophyPlatinum}" />
                                        <TextBlock Style="{StaticResource SidebarStatValueStyle}" Text="{Binding OverviewSummary.TrophyPlatinum.Text}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SidebarStatPairChipStyle}" ToolTip="{DynamicResource LOCPlayAch_Trophy_Gold}"
                                        Visibility="{Binding OverviewSummary.TrophyGold.IsVisible, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Style="{StaticResource OverviewBadgeImageStyle}" Source="{DynamicResource TrophyGold}" />
                                        <TextBlock Style="{StaticResource SidebarStatValueStyle}" Text="{Binding OverviewSummary.TrophyGold.Text}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SidebarStatPairChipStyle}" ToolTip="{DynamicResource LOCPlayAch_Trophy_Silver}"
                                        Visibility="{Binding OverviewSummary.TrophySilver.IsVisible, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Style="{StaticResource OverviewBadgeImageStyle}" Source="{DynamicResource TrophySilver}" />
                                        <TextBlock Style="{StaticResource SidebarStatValueStyle}" Text="{Binding OverviewSummary.TrophySilver.Text}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SidebarStatPairChipStyle}" ToolTip="{DynamicResource LOCPlayAch_Trophy_Bronze}"
                                        Visibility="{Binding OverviewSummary.TrophyBronze.IsVisible, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Style="{StaticResource OverviewBadgeImageStyle}" Source="{DynamicResource TrophyBronze}" />
                                        <TextBlock Style="{StaticResource SidebarStatValueStyle}" Text="{Binding OverviewSummary.TrophyBronze.Text}" />
                                    </Grid>
                                </Border>
                            </controls:PairedRowsPanel>
                            <StackPanel Style="{StaticResource SidebarStatGroupStyle}"
                                        Visibility="{Binding SidebarOtherStatsVisible, Converter={StaticResource BoolToVis}}">
                                <Border Style="{StaticResource SidebarStatChipStyle}"
                                        Visibility="{Binding SidebarPointsVisible, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource ChipTextStyle}" VerticalAlignment="Center" Text="{DynamicResource LOCPlayAch_Column_Points}" />
                                        <TextBlock Style="{StaticResource SidebarStatValueStyle}" Text="{Binding OverviewSummary.Points.Text}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SidebarStatChipStyle}"
                                        Visibility="{Binding SidebarGoalsVisible, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource ChipTextStyle}" VerticalAlignment="Center" Text="{DynamicResource LOCPlayAch_ManageAchievements_Editor_Goal}" />
                                        <TextBlock Style="{StaticResource SidebarStatValueStyle}" Text="{Binding OverviewSummary.Goals.Text}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SidebarStatChipStyle}"
                                        Visibility="{Binding SidebarCategorizedVisible, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource ChipTextStyle}" VerticalAlignment="Center" Text="{DynamicResource LOCPlayAch_ManageAchievements_Overview_Categorized}" />
                                        <TextBlock Style="{StaticResource SidebarStatValueStyle}" Text="{Binding OverviewSummary.Categorized.Text}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SidebarStatChipStyle}"
                                        Visibility="{Binding SidebarFilteredVisible, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource ChipTextStyle}" VerticalAlignment="Center" Text="{DynamicResource LOCPlayAch_Menu_Filters}" />
                                        <TextBlock Style="{StaticResource SidebarStatValueStyle}" Text="{Binding OverviewSummary.Filtered.Text}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SidebarStatChipStyle}"
                                        Visibility="{Binding SidebarNotesVisible, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource ChipTextStyle}" VerticalAlignment="Center" Text="{DynamicResource LOCPlayAch_ManageAchievements_Tab_Notes}" />
                                        <TextBlock Style="{StaticResource SidebarStatValueStyle}" Text="{Binding OverviewSummary.Notes.Text}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- The tabs never scroll: the cover takes what height is left, up to 190, and
                     shrinks first when the window is short or the stats run long. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" MaxHeight="190" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <controls:WidthFollowingDecorator Grid.Row="2">
                        <Border CornerRadius="{StaticResource PlayAch.Radius.Card}"
                                ClipToBounds="False"
                                Background="Transparent">
                            <Image Stretch="Uniform"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   helpers:AsyncImage.Uri="{Binding GameImagePath, Converter={StaticResource DefaultGameImage}, ConverterParameter=cover}"
                                   helpers:AsyncImage.DecodePixel="480" />
                        </Border>
                    </controls:WidthFollowingDecorator>

                    <StackPanel Grid.Row="4">
                        <RadioButton x:Name="OverviewTabButton"
                                     Content="{DynamicResource LOCPlayAch_ManageAchievements_Tab_Overview}"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Overview}" />
                        <!-- Not gated on HasAchievementData: it is the Custom tab widened to every
                             achievement, so it must stay reachable for a game with no cached
                             achievements, where custom ones are authored. -->
                        <RadioButton x:Name="EditorTabButton"
                                     Content="{DynamicResource LOCPlayAch_ManageAchievements_Tab_Editor}"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Editor}" />

                        <RadioButton x:Name="CategoryTabButton"
                                     Content="{DynamicResource LOCPlayAch_ManageAchievements_Tab_Category}"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     Visibility="{Binding HasAchievementData, Converter={StaticResource BoolToVis}}"
                                     IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Category}" />

                        <RadioButton x:Name="NotificationsTabButton"
                                     Content="{DynamicResource LOCPlayAch_Settings_TabNotifications}"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Notifications}" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <Border x:Name="ManageAchievementsContentHost"
                Grid.Column="2"
                Background="{DynamicResource PlayAch.Brush.Surface}"
                BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                CornerRadius="{StaticResource PlayAch.Radius.Card}"
                Padding="{StaticResource PlayAch.Thickness.CardPadding}">
            <Grid>
                <!-- Every tab is a host, and every host is Hidden rather than Collapsed when
                     it is not the selected one.

                     Hosted, so the shell does not build all five: overview and overrides used
                     to be inline, which put their construction and first layout inside
                     ShowDialog's synchronous first render.

                     Hidden, so a host that has been filled is still measured and arranged.
                     WPF skips layout for a Collapsed element entirely, which meant a
                     pre-built tab still paid its whole first layout and render on the click
                     that revealed it - measured as a 557ms stall on selecting the editor.
                     Hidden lets the idle prebuild absorb that instead. -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Overview">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ContentControl x:Name="OverviewHost" />
                </Grid>


                <Grid>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Editor">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ContentControl x:Name="EditorHost" />
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Category">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ContentControl x:Name="CategoryHost" />
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Notifications">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ContentControl x:Name="NotificationsHost" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
    </Border>
</UserControl>
