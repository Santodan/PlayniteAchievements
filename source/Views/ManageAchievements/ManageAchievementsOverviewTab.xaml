<UserControl x:Class="PlayniteAchievements.Views.ManageAchievements.ManageAchievementsOverviewTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/ManageAchievementsScopedControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ItemsPanelTemplate x:Key="OverviewWrapPanelTemplate">
                <WrapPanel />
            </ItemsPanelTemplate>

            <Style x:Key="OverviewMutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}" />
                <Setter Property="Opacity" Value="{StaticResource PlayAch.Opacity.Subtle}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  KeyboardNavigation.DirectionalNavigation="Continue">
        <StackPanel Margin="0">

            <!-- Game header: identity, source and platform override, and the everyday actions. -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="{StaticResource PlayAch.Thickness.Bottom.Md}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="{Binding GameName, Mode=OneWay}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource PlayAch.FontSize.Title}"
                                       TextWrapping="Wrap" />

                            <WrapPanel Margin="{StaticResource PlayAch.Thickness.Top.Sm}">
                                <Border Style="{StaticResource MetaChipStyle}">
                                    <TextBlock Style="{StaticResource ChipTextStyle}">
                                        <Run Text="{DynamicResource LOCPlayAch_ManageAchievements_Overview_Provider}" /><Run Text=": " /><Run Text="{Binding ProviderName, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                                <Border Style="{StaticResource MetaChipStyle}">
                                    <TextBlock Style="{StaticResource ChipTextStyle}">
                                        <Run Text="{DynamicResource LOCPlayAch_ManageAchievements_Overview_LibrarySource}" /><Run Text=": " /><Run Text="{Binding LibrarySourceName, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                            </WrapPanel>

                            <WrapPanel Margin="0,2,0,0">
                                <TextBlock Style="{StaticResource OverviewMutedTextStyle}">
                                    <Run Text="{DynamicResource LOCPlayAch_ManageAchievements_Overview_LastUpdatedLocal}" /><Run Text=": " /><Run Text="{Binding LastUpdatedLocalText, Mode=OneWay}" />
                                </TextBlock>
                                <Button Command="{Binding OpenAchievementPageCommand}"
                                        Style="{StaticResource InlineLinkButtonStyle}"
                                        Visibility="{Binding HasAchievementPageLink, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{DynamicResource LOCPlayAch_ManageAchievements_Overview_OpenAchievementPage}"
                                               TextDecorations="Underline" />
                                </Button>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource OverviewMutedTextStyle}"
                                       Margin="0,2,0,0"
                                       Visibility="{Binding HasManualTrackingLink, Converter={StaticResource BoolToVis}}">
                                <Run Text="{DynamicResource LOCPlayAch_ManageAchievements_Tab_ManualTracking}" /><Run Text=": " /><Run Text="{Binding ManualTrackingSummary, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top">
                            <Button Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                    Command="{Binding ClearGameDataCommand}"
                                    Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                    MinWidth="100"
                                    Margin="{StaticResource PlayAch.Thickness.Right.Sm}" />
                            <Button Content="{DynamicResource LOCPlayAch_Button_Refresh}"
                                    Command="{Binding RefreshGameCommand}"
                                    Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                    MinWidth="100"
                                    Margin="{StaticResource PlayAch.Thickness.Right.Sm}" />
                            <Button Content="{DynamicResource LOCPlayAch_Menu_ViewAchievements}"
                                    Command="{Binding OpenAchievementsCommand}"
                                    Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                    MinWidth="130" />
                        </StackPanel>
                    </Grid>

                    <!-- Platform override, edited in place beside the platform it replaces. -->
                    <Border BorderBrush="{DynamicResource PlayAch.Brush.ControlBorder}"
                            BorderThickness="0,1,0,0"
                            Margin="0,10,0,0"
                            Padding="0,10,0,0">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_ProviderHeader}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                                <ComboBox ItemsSource="{Binding ProviderOverrideOptions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="ProviderKey"
                                          SelectedValue="{Binding SelectedProviderOverrideKey, Mode=TwoWay}"
                                          Width="200"
                                          Padding="8,4"
                                          VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsProviderOverrideValueVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBox Text="{Binding ProviderOverrideInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding ProviderOverrideInputLabel}"
                                             Visibility="{Binding IsProviderOverrideTextVisible, Converter={StaticResource BoolToVis}}"
                                             Width="220"
                                             Padding="8,4"
                                             Margin="{StaticResource PlayAch.Thickness.Left.Sm}" />
                                    <ComboBox ItemsSource="{Binding ProviderOverrideChoices}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding ProviderOverrideInput, Mode=TwoWay}"
                                              ToolTip="{Binding ProviderOverrideInputLabel}"
                                              Visibility="{Binding IsProviderOverrideChoiceVisible, Converter={StaticResource BoolToVis}}"
                                              Width="220"
                                              Padding="8,4"
                                              Margin="{StaticResource PlayAch.Thickness.Left.Sm}" />
                                </StackPanel>
                                <Button Content="{DynamicResource LOCPlayAch_Button_Apply}"
                                        Command="{Binding ApplyProviderOverrideCommand}"
                                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                        VerticalAlignment="Center"
                                        Margin="{StaticResource PlayAch.Thickness.Left.Sm}" />
                                <Button Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                        Command="{Binding ClearProviderOverrideCommand}"
                                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                        VerticalAlignment="Center"
                                        Margin="{StaticResource PlayAch.Thickness.Left.Sm}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource OverviewMutedTextStyle}"
                                       Text="{Binding ProviderOverrideStatusText}"
                                       Margin="{StaticResource PlayAch.Thickness.Top.Compact}" />

                            <!-- Exophase rarity slug: which Exophase page enriches rarity when another
                                 platform services the game. Separate from the override above, which
                                 picks the servicing platform itself. -->
                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding IsExophaseEnrichmentSlugSectionVisible, Converter={StaticResource BoolToVis}}">
                                <WrapPanel>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_ExophaseEnrichmentHeader}"
                                               ToolTip="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_ExophaseEnrichmentHint}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                                    <Grid Width="200" VerticalAlignment="Center">
                                        <TextBox x:Name="ExophaseEnrichmentSlugTextBox"
                                                 Text="{Binding ExophaseEnrichmentSlugInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="8,4" />
                                        <TextBlock Text="{Binding ExophaseEnrichmentSlugPlaceholder}"
                                                   Tag="{Binding Text, ElementName=ExophaseEnrichmentSlugTextBox}"
                                                   Style="{StaticResource ManageAchievementsSearchPlaceholderTextStyle}" />
                                    </Grid>
                                    <Button Content="{DynamicResource LOCPlayAch_Button_Apply}"
                                            Command="{Binding ApplyExophaseEnrichmentSlugCommand}"
                                            Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                            VerticalAlignment="Center"
                                            Margin="{StaticResource PlayAch.Thickness.Left.Sm}" />
                                    <Button Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                            Command="{Binding ClearExophaseEnrichmentSlugCommand}"
                                            Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                            VerticalAlignment="Center"
                                            Margin="{StaticResource PlayAch.Thickness.Left.Sm}" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource OverviewMutedTextStyle}"
                                           Text="{Binding ExophaseEnrichmentSlugStatusText}"
                                           Margin="{StaticResource PlayAch.Thickness.Top.Compact}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Per-game overrides, one row each: name (hint on hover), current state, action. -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="{StaticResource PlayAch.Thickness.Bottom.Md}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <Style x:Key="OverrideRowLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="0,4,16,4" />
                            </Style>
                            <Style x:Key="OverrideRowStatusStyle" TargetType="TextBlock" BasedOn="{StaticResource OverviewMutedTextStyle}">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="0,4,12,4" />
                            </Style>
                        </Grid.Resources>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource OverrideRowLabelStyle}"
                                   Text="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_ExclusionHeader}"
                                   ToolTip="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_ExclusionHint}" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Style="{StaticResource OverrideRowStatusStyle}"
                                   Text="{Binding ExclusionStatusText}" />
                        <Button Grid.Row="0" Grid.Column="2"
                                Content="{Binding ExclusionActionText}"
                                Command="{Binding ToggleExclusionCommand}"
                                Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                MinWidth="160"
                                Margin="0,2" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Style="{StaticResource OverrideRowLabelStyle}"
                                   Text="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_SummaryExclusionHeader}"
                                   ToolTip="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_SummaryExclusionHint}" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Style="{StaticResource OverrideRowStatusStyle}"
                                   Text="{Binding SummaryExclusionStatusText}" />
                        <Button Grid.Row="1" Grid.Column="2"
                                Content="{Binding SummaryExclusionActionText}"
                                Command="{Binding ToggleSummaryExclusionCommand}"
                                Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                MinWidth="160"
                                Margin="0,2" />

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Style="{StaticResource OverrideRowLabelStyle}"
                                   Text="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_LockedIconsHeader}"
                                   ToolTip="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_LockedIconsHint}" />
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Style="{StaticResource OverrideRowStatusStyle}"
                                   Text="{Binding SeparateLockedIconsStatusText}" />
                        <CheckBox Grid.Row="2" Grid.Column="2"
                                  IsChecked="{Binding UseSeparateLockedIconsOverride}"
                                  ToolTip="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_LockedIconsCheckbox}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Margin="0,4" />

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Style="{StaticResource OverrideRowLabelStyle}"
                                   Text="{DynamicResource LOCPlayAch_ManageAchievements_Overview_GameId}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                 Text="{Binding GameIdText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource PlayAch.Brush.Text}"
                                 Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                                 Padding="0"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Left"
                                 Margin="0,4" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- What this game's stored custom data holds, and moving it in and out. -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Text="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_CustomDataHeader}"
                                   ToolTip="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_CustomDataHint}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_ExportButton}"
                                    Command="{Binding ExportCustomCommand}"
                                    Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                    Margin="{StaticResource PlayAch.Thickness.Right.Sm}" />
                            <Button Content="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_ImportButton}"
                                    Command="{Binding ImportCustomJsonCommand}"
                                    Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                    Margin="{StaticResource PlayAch.Thickness.Right.Sm}" />
                            <Button Content="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_ClearCustomDataButton}"
                                    Command="{Binding ClearCustomDataCommand}"
                                    Padding="{StaticResource PlayAch.Thickness.ButtonPadding}" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding OverviewSummary.Customizations}"
                                  ItemsPanel="{StaticResource OverviewWrapPanelTemplate}"
                                  Focusable="False"
                                  Margin="0,8,0,0"
                                  Visibility="{Binding OverviewSummary.HasCustomizations, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource MetaChipStyle}" ToolTip="{Binding ToolTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource ChipTextStyle}" Text="{Binding Label}" />
                                        <TextBlock Style="{StaticResource ChipCountTextStyle}"
                                                   Text="{Binding CountText}"
                                                   Visibility="{Binding HasCount, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource OverviewMutedTextStyle}"
                               Text="{DynamicResource LOCPlayAch_Tagging_NotCustomized}"
                               Margin="0,8,0,0"
                               Visibility="{Binding OverviewSummary.HasCustomizations, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
