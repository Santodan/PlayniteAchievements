<UserControl x:Class="PlayniteAchievements.Views.ManageAchievements.ManageAchievementsOverviewTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             xmlns:metadata="clr-namespace:PlayniteAchievements.Views.Settings.Metadata"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/ManageAchievementsScopedControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ItemsPanelTemplate x:Key="OverviewWrapPanelTemplate">
                <WrapPanel />
            </ItemsPanelTemplate>

            <Style x:Key="OverviewMutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}" />
                <Setter Property="Opacity" Value="{StaticResource PlayAch.Opacity.Subtle}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- The Workshop source line's icon buttons: the glyph (the button's string Content)
                 drawn as vector geometry, as on the Library page. -->
            <DataTemplate x:Key="OverviewGlyphContentTemplate">
                <controls:GlyphIcon Glyph="{Binding}"
                                    Size="16"
                                    FontFamily="{DynamicResource PlayAch.FontFamily.Icon}"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True" />
            </DataTemplate>
            <Style x:Key="OverviewIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayAch.Button.ToolbarIconStyle}">
                <Setter Property="Margin" Value="4,0,0,0" />
                <Setter Property="ContentTemplate" Value="{StaticResource OverviewGlyphContentTemplate}" />
            </Style>

            <!-- A small rounded state tag (Edited, Update available), as on the Library page. -->
            <Style x:Key="OverviewTagStyle" TargetType="Border">
                <Setter Property="BorderThickness" Value="{StaticResource PlayAch.Thickness.Border}" />
                <Setter Property="CornerRadius" Value="{StaticResource PlayAch.Radius.PillSmall}" />
                <Setter Property="Padding" Value="8,1" />
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="OverviewTagTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Caption}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  KeyboardNavigation.DirectionalNavigation="Continue">
        <StackPanel Margin="0">

            <!-- Game header: identity, source and platform override, and the everyday actions. -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="{StaticResource PlayAch.Thickness.Bottom.Md}">
                <StackPanel>
                    <!-- Shared by the per-game settings rows and the metadata link rows. -->
                    <StackPanel.Resources>
                        <Style x:Key="SettingLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,4,16,4" />
                        </Style>
                        <Style x:Key="SettingStatusStyle" TargetType="TextBlock" BasedOn="{StaticResource OverviewMutedTextStyle}">
                            <Setter Property="Margin" Value="0,0,0,4" />
                        </Style>
                    </StackPanel.Resources>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="{Binding GameName, Mode=OneWay}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource PlayAch.FontSize.Title}"
                                       TextWrapping="Wrap" />

                            <WrapPanel Margin="{StaticResource PlayAch.Thickness.Top.Sm}">
                                <Border Style="{StaticResource MetaChipStyle}">
                                    <TextBlock Style="{StaticResource ChipTextStyle}">
                                        <Run Text="{DynamicResource LOCPlayAch_Common_Platform}" /><Run Text=": " /><Run Text="{Binding ProviderName, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                                <Border Style="{StaticResource MetaChipStyle}">
                                    <TextBlock Style="{StaticResource ChipTextStyle}">
                                        <Run Text="{DynamicResource LOCPlayAch_ManageAchievements_Overview_LibrarySource}" /><Run Text=": " /><Run Text="{Binding LibrarySourceName, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                            </WrapPanel>

                            <WrapPanel Margin="0,2,0,0">
                                <TextBlock Style="{StaticResource OverviewMutedTextStyle}">
                                    <Run Text="{DynamicResource LOCPlayAch_ManageAchievements_Overview_LastUpdatedLocal}" /><Run Text=": " /><Run Text="{Binding LastUpdatedLocalText, Mode=OneWay}" />
                                </TextBlock>
                                <Button Command="{Binding OpenAchievementPageCommand}"
                                        Style="{StaticResource InlineLinkButtonStyle}"
                                        Visibility="{Binding HasAchievementPageLink, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{DynamicResource LOCPlayAch_ManageAchievements_Overview_OpenAchievementPage}"
                                               TextDecorations="Underline" />
                                </Button>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource OverviewMutedTextStyle}"
                                       Margin="0,2,0,0"
                                       Visibility="{Binding HasManualTrackingLink, Converter={StaticResource BoolToVis}}">
                                <Run Text="{DynamicResource LOCPlayAch_ManageAchievements_Tab_ManualTracking}" /><Run Text=": " /><Run Text="{Binding ManualTrackingSummary, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <!-- The game's actions: Clear (achievement data or custom data), Refresh and
                             View on top, moving custom data out and in underneath. -->
                        <Grid Grid.Column="1" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Grid.Column="0"
                                    Content="{DynamicResource LOCPlayAch_Common_Clear}"
                                    Click="ContextMenuButton_Click"
                                    Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                    MinWidth="100"
                                    Margin="{StaticResource PlayAch.Thickness.Right.Sm}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{DynamicResource LOCPlayAch_Menu_ClearData}"
                                                  Command="{Binding ClearGameDataCommand}" />
                                        <MenuItem Header="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_ClearCustomDataButton}"
                                                  Command="{Binding ClearCustomDataCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Grid.Row="0" Grid.Column="1"
                                    Content="{DynamicResource LOCPlayAch_Button_Refresh}"
                                    Command="{Binding RefreshGameCommand}"
                                    Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                    MinWidth="100"
                                    Margin="{StaticResource PlayAch.Thickness.Right.Sm}" />
                            <Button Grid.Row="0" Grid.Column="2"
                                    Content="{DynamicResource LOCPlayAch_Common_View}"
                                    Command="{Binding OpenAchievementsCommand}"
                                    Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                    MinWidth="100" />
                            <Button Grid.Row="1" Grid.Column="0"
                                    Content="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_ExportButton}" ContentTemplate="{DynamicResource PlayAch.ButtonContent.Export}"
                                    Click="ContextMenuButton_Click"
                                    Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                    MinWidth="100"
                                    Margin="0,6,8,0">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{DynamicResource LOCPlayAch_Workshop_Menu_ToFile}"
                                                  Command="{Binding ExportCustomCommand}" />
                                        <MenuItem Header="{DynamicResource LOCPlayAch_Workshop_Share}"
                                                  Command="{Binding ShareToWorkshopCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="1"
                                    Content="{DynamicResource LOCPlayAch_Common_Import}" ContentTemplate="{DynamicResource PlayAch.ButtonContent.Import}"
                                    Click="ContextMenuButton_Click"
                                    Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                    MinWidth="100"
                                    Margin="0,6,8,0">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{DynamicResource LOCPlayAch_Workshop_Menu_FromFile}"
                                                  Command="{Binding ImportCustomJsonCommand}" />
                                        <MenuItem Header="{DynamicResource LOCPlayAch_Workshop_Menu_FromWorkshop}"
                                                  Command="{Binding ImportFromWorkshopCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- Per-game settings, one aligned row each: name on the left (hint on hover), control on the right. -->
                    <Border BorderBrush="{DynamicResource PlayAch.Brush.ControlBorder}"
                            BorderThickness="0,1,0,0"
                            Margin="0,10,0,0"
                            Padding="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Platform override: the platform that services the game. -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Style="{StaticResource SettingLabelStyle}"
                                       Text="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_ProviderHeader}"
                                       ToolTip="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_ProviderHint}" />
                            <WrapPanel Grid.Row="0" Grid.Column="1" Margin="0,2">
                                <ComboBox ItemsSource="{Binding ProviderOverrideOptions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="ProviderKey"
                                          SelectedValue="{Binding SelectedProviderOverrideKey, Mode=TwoWay}"
                                          Width="200"
                                          Padding="8,4"
                                          VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsProviderOverrideValueVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBox Text="{Binding ProviderOverrideInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding ProviderOverrideInputLabel}"
                                             Visibility="{Binding IsProviderOverrideTextVisible, Converter={StaticResource BoolToVis}}"
                                             Width="200"
                                             Padding="8,4"
                                             Margin="{StaticResource PlayAch.Thickness.Left.Sm}" />
                                    <!-- A provider whose games can be searched: the overridden game's name, and Select to pick another. -->
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding IsProviderOverrideSearchVisible, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding ProviderOverrideGameName}"
                                                   ToolTip="{Binding ProviderOverrideIdToolTip}"
                                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="320"
                                                   VerticalAlignment="Center"
                                                   Margin="{StaticResource PlayAch.Thickness.Left.Sm}" />
                                        <Button Content="&#xED1B;"
                                                Style="{StaticResource OverviewIconButtonStyle}"
                                                ToolTip="{DynamicResource LOCPlayAch_Button_Pick}"
                                                AutomationProperties.Name="{DynamicResource LOCPlayAch_Button_Pick}"
                                                Command="{Binding ChooseProviderOverrideGameCommand}"
                                                VerticalAlignment="Center"
                                                Margin="{StaticResource PlayAch.Thickness.Left.Sm}" />
                                    </StackPanel>
                                    <ComboBox ItemsSource="{Binding ProviderOverrideChoices}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding ProviderOverrideInput, Mode=TwoWay}"
                                              ToolTip="{Binding ProviderOverrideInputLabel}"
                                              Visibility="{Binding IsProviderOverrideChoiceVisible, Converter={StaticResource BoolToVis}}"
                                              Width="200"
                                              Padding="8,4"
                                              Margin="{StaticResource PlayAch.Thickness.Left.Sm}" />
                                </StackPanel>
                                <Button Content="{DynamicResource LOCPlayAch_Button_Apply}"
                                        Command="{Binding ApplyProviderOverrideCommand}"
                                        Visibility="{Binding IsProviderOverrideApplyVisible, Converter={StaticResource BoolToVis}}"
                                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                        VerticalAlignment="Center"
                                        Margin="{StaticResource PlayAch.Thickness.Left.Sm}" />
                                <Button Content="{DynamicResource LOCPlayAch_Common_Clear}"
                                        Command="{Binding ClearProviderOverrideCommand}"
                                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                        VerticalAlignment="Center"
                                        Margin="{StaticResource PlayAch.Thickness.Left.Sm}" />
                            </WrapPanel>
                            <!-- Exclusion: one choice between the refresh and summary exclusions. -->
                            <TextBlock Grid.Row="4" Grid.Column="0"
                                       Style="{StaticResource SettingLabelStyle}"
                                       Text="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_ExclusionHeader}" />
                            <WrapPanel Grid.Row="4" Grid.Column="1"
                                       Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding ExclusionModeOptions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Mode"
                                          SelectedValue="{Binding ExclusionMode, Mode=TwoWay}"
                                          Width="200"
                                          Padding="8,4"
                                          HorizontalAlignment="Left"
                                          Margin="0,2" />
                                <!-- Which side owns the choice when saved filters are in play. -->
                                <TextBlock Style="{StaticResource SettingStatusStyle}"
                                           Text="{DynamicResource LOCPlayAch_ManageAchievements_Exclusion_SetByFilter}"
                                           Visibility="{Binding IsExclusionSetByFilter, Converter={StaticResource BoolToVis}}"
                                           VerticalAlignment="Center"
                                           Margin="{StaticResource PlayAch.Thickness.Left.Sm}" />
                                <Button Content="{DynamicResource LOCPlayAch_ManageAchievements_Exclusion_FollowFilters}"
                                        Command="{Binding FollowSavedFiltersCommand}"
                                        Visibility="{Binding IsExclusionOverridingFilter, Converter={StaticResource BoolToVis}}"
                                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                        VerticalAlignment="Center"
                                        Margin="{StaticResource PlayAch.Thickness.Left.Sm}" />
                            </WrapPanel>

                            <!-- Separate locked icons: per-game override of the global setting. -->
                            <TextBlock Grid.Row="5" Grid.Column="0"
                                       Style="{StaticResource SettingLabelStyle}"
                                       Text="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_LockedIconsHeader}"
                                       ToolTip="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_LockedIconsHint}" />
                            <StackPanel Grid.Row="5" Grid.Column="1"
                                        Orientation="Horizontal"
                                        Margin="0,4">
                                <CheckBox IsChecked="{Binding UseSeparateLockedIconsOverride}"
                                          ToolTip="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_LockedIconsCheckbox}"
                                          VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource OverviewMutedTextStyle}"
                                           Text="{Binding SeparateLockedIconsStatusText}"
                                           VerticalAlignment="Center"
                                           Margin="{StaticResource PlayAch.Thickness.Left.Sm}" />
                            </StackPanel>

                            <!-- Playnite's own id for the game, selectable for copying. -->
                            <TextBlock Grid.Row="6" Grid.Column="0"
                                       Style="{StaticResource SettingLabelStyle}"
                                       Text="{DynamicResource LOCPlayAch_ManageAchievements_Overview_GameId}" />
                            <TextBox Grid.Row="6" Grid.Column="1"
                                     Text="{Binding GameIdText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource PlayAch.Brush.Text}"
                                     Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                                     Padding="0"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Left"
                                     Margin="0,4" />
                        </Grid>
                    </Border>

                    <!-- Metadata links: which game each secondary source supplies data from. -->
                    <Border BorderBrush="{DynamicResource PlayAch.Brush.ControlBorder}"
                            BorderThickness="0,1,0,0"
                            Margin="0,10,0,0"
                            Padding="0,6,0,0"
                            DataContext="{Binding MetadataLinks}"
                            Visibility="{Binding HasChoices, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingLabelStyle}"
                                       Text="{DynamicResource LOCPlayAch_ManageAchievements_Overview_MetadataLinks}"
                                       ToolTip="{DynamicResource LOCPlayAch_ManageAchievements_Overview_MetadataLinks_Help}" />
                            <!-- The game's own source per field; "Default" follows its platform. -->
                            <metadata:MetadataChoicesGrid DataContext="{Binding ChoiceRows}"
                                                          ShowsRarity="False"
                                                          ShowsPlatform="False"
                                                          Margin="0,4,0,8" />
                            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" Grid.IsSharedSizeScope="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- One column per part, sized across all rows, so every row's
                                             title, buttons and count line up whichever parts it shows. -->
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="MetadataLinkSource" />
                                                <ColumnDefinition Width="260" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="MetadataLinkSelect" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="MetadataLinkReset" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="MetadataLinkCount" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="MetadataLinkEdit" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="MetadataLinkPage" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Style="{StaticResource SettingLabelStyle}"
                                                       Text="{Binding SourceName}"
                                                       ToolTip="{Binding LinkDetails}"
                                                       VerticalAlignment="Center" />
                                            <!-- The linked game's title, or each game's for a collection; its ids on hover. -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding LinkTitle}"
                                                       ToolTip="{Binding LinkIdsText}"
                                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <!-- Search for the linked game (IcoFont search). -->
                                            <Button Grid.Column="2"
                                                    Content="&#xED1B;"
                                                    Style="{StaticResource OverviewIconButtonStyle}"
                                                    ToolTip="{DynamicResource LOCPlayAch_Button_Pick}"
                                                    AutomationProperties.Name="{DynamicResource LOCPlayAch_Button_Pick}"
                                                    Command="{Binding ChangeCommand}"
                                                    VerticalAlignment="Center"
                                                    Margin="{StaticResource PlayAch.Thickness.Left.Sm}" />
                                            <!-- Back to automatic matching; hidden, keeping its place, while there is no
                                                 stored link to drop, as for a link the game implies (IcoFont undo). -->
                                            <Button Grid.Column="3"
                                                    Content="&#xEE0B;"
                                                    ToolTip="{DynamicResource LOCPlayAch_Common_Reset}"
                                                    AutomationProperties.Name="{DynamicResource LOCPlayAch_Common_Reset}"
                                                    Command="{Binding ClearCommand}"
                                                    VerticalAlignment="Center"
                                                    Margin="{StaticResource PlayAch.Thickness.Left.Sm}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource OverviewIconButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanReset}" Value="False">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <!-- The match count, and the pairings window for the source's match list. -->
                                            <TextBlock Grid.Column="4"
                                                       Style="{StaticResource SettingStatusStyle}"
                                                       Text="{Binding StatusText}"
                                                       ToolTip="{Binding StatusToolTip}"
                                                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0" />
                                            <!-- The achievement pairings window (IcoFont pencil-alt-2: solid, holds its shape at 16px). -->
                                            <Button Grid.Column="5"
                                                    Content="&#xEBF6;"
                                                    Style="{StaticResource OverviewIconButtonStyle}"
                                                    ToolTip="{DynamicResource LOCPlayAch_Common_Edit}"
                                                    AutomationProperties.Name="{DynamicResource LOCPlayAch_Common_Edit}"
                                                    Command="{Binding OpenMatchesCommand}"
                                                    Visibility="{Binding ShowFixMatches, Converter={StaticResource BoolToVis}}"
                                                    VerticalAlignment="Center"
                                                    Margin="{StaticResource PlayAch.Thickness.Left.Sm}" />
                                            <!-- Opens the page the link uses, or a menu of them when there are several (TrueGaming: one per site). -->
                                            <Button Grid.Column="6"
                                                    Content="&#xEF1F;"
                                                    Style="{StaticResource OverviewIconButtonStyle}"
                                                    ToolTip="{Binding PageLinksToolTip}"
                                                    AutomationProperties.Name="{Binding PageLinksToolTip}"
                                                    Visibility="{Binding HasPageLinks, Converter={StaticResource BoolToVis}}"
                                                    Click="PageLinks_Click"
                                                    VerticalAlignment="Center"
                                                    Margin="{StaticResource PlayAch.Thickness.Left.Sm}" />
                                            <!-- What the source adds to this game, under the title; the tooltip names the pages it read. -->
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="1"
                                                       Grid.ColumnSpan="7"
                                                       Style="{StaticResource SettingStatusStyle}"
                                                       Text="{Binding Supplies}"
                                                       ToolTip="{Binding LinkDetails}"
                                                       Visibility="{Binding HasSupplies, Converter={StaticResource BoolToVis}}"
                                                       Margin="0,2,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Where the official sources' data comes from, as under the Sources grid in Settings. -->
                            <TextBlock Style="{StaticResource SettingStatusStyle}"
                                       Text="{DynamicResource LOCPlayAch_Settings_Metadata_OfficialSources}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- What this game's stored custom data holds, and moving it in and out. -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}"
                               Text="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_CustomDataHeader}"
                               ToolTip="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_CustomDataHint}" />

                    <!-- The Workshop item this data came from: its version and state, and Update
                         (download, merge), Reset (as published) and Unlink. -->
                    <Grid Margin="0,8,0,0"
                          Visibility="{Binding HasWorkshopSource, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource PlayAch.Brush.Text}" TextWrapping="Wrap">
                                <Run Text="{DynamicResource LOCPlayAch_Workshop_Title}" /><Run Text=": " /><Run Text="{Binding WorkshopSourceName, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource OverviewMutedTextStyle}"
                                       Text="{Binding WorkshopSourceVersionText}"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0"
                                       Visibility="{Binding HasWorkshopSourceVersion, Converter={StaticResource BoolToVis}}" />
                            <Border Style="{StaticResource OverviewTagStyle}"
                                    BorderBrush="{DynamicResource PlayAch.Brush.AuthPending}"
                                    Visibility="{Binding WorkshopSourceIsEdited, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource LOCPlayAch_Library_Edited}"
                                           Style="{StaticResource OverviewTagTextStyle}"
                                           Foreground="{DynamicResource PlayAch.Brush.AuthPending}" />
                            </Border>
                            <Border Style="{StaticResource OverviewTagStyle}"
                                    BorderBrush="{DynamicResource PlayAch.Brush.Accent}"
                                    Visibility="{Binding WorkshopSourceHasUpdate, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource LOCPlayAch_Workshop_UpdateAvailable}"
                                           Style="{StaticResource OverviewTagTextStyle}"
                                           Foreground="{DynamicResource PlayAch.Brush.Accent}" />
                            </Border>
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="&#xEF08;"
                                    Style="{StaticResource OverviewIconButtonStyle}"
                                    ToolTip="{DynamicResource LOCPlayAch_Workshop_Update}"
                                    AutomationProperties.Name="{DynamicResource LOCPlayAch_Workshop_Update}"
                                    Visibility="{Binding WorkshopSourceHasUpdate, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding UpdateWorkshopDataCommand}" />
                            <Button Content="&#xEE0B;"
                                    Style="{StaticResource OverviewIconButtonStyle}"
                                    ToolTip="{DynamicResource LOCPlayAch_Common_Reset}"
                                    AutomationProperties.Name="{DynamicResource LOCPlayAch_Common_Reset}"
                                    Command="{Binding ResetWorkshopDataCommand}" />
                            <Button Content="&#xEDF8;"
                                    Style="{StaticResource OverviewIconButtonStyle}"
                                    ToolTip="{DynamicResource LOCPlayAch_Library_Unlink}"
                                    AutomationProperties.Name="{DynamicResource LOCPlayAch_Library_Unlink}"
                                    Command="{Binding UnlinkWorkshopDataCommand}" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding OverviewSummary.Customizations}"
                                  ItemsPanel="{StaticResource OverviewWrapPanelTemplate}"
                                  Focusable="False"
                                  Margin="0,8,0,0"
                                  Visibility="{Binding OverviewSummary.HasCustomizations, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource MetaChipStyle}" ToolTip="{Binding ToolTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource ChipTextStyle}" Text="{Binding Label}" />
                                        <TextBlock Style="{StaticResource ChipCountTextStyle}"
                                                   Text="{Binding CountText}"
                                                   Visibility="{Binding HasCount, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource OverviewMutedTextStyle}"
                               Text="{DynamicResource LOCPlayAch_Tagging_NotCustomized}"
                               Margin="0,8,0,0"
                               Visibility="{Binding OverviewSummary.HasCustomizations, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
