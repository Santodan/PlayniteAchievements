<UserControl x:Class="PlayniteAchievements.Views.ManageAchievements.ManageAchievementsOverviewTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/ManageAchievementsScopedControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ItemsPanelTemplate x:Key="OverviewWrapPanelTemplate">
                <WrapPanel />
            </ItemsPanelTemplate>

            <Style x:Key="OverviewBadgeImageStyle" TargetType="Image">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
            </Style>

            <Style x:Key="OverviewMutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}" />
                <Setter Property="Opacity" Value="{StaticResource PlayAch.Opacity.Subtle}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  KeyboardNavigation.DirectionalNavigation="Continue">
        <StackPanel Margin="0">

            <!-- Game header: identity, source and platform override, and the everyday actions. -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="{StaticResource PlayAch.Thickness.Bottom.Md}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="{Binding GameName, Mode=OneWay}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource PlayAch.FontSize.Title}"
                                       TextWrapping="Wrap" />

                            <WrapPanel Margin="{StaticResource PlayAch.Thickness.Top.Sm}">
                                <Border Style="{StaticResource MetaChipStyle}">
                                    <TextBlock Style="{StaticResource ChipTextStyle}">
                                        <Run Text="{DynamicResource LOCPlayAch_ManageAchievements_Overview_Provider}" /><Run Text=": " /><Run Text="{Binding ProviderName, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                                <Border Style="{StaticResource MetaChipStyle}">
                                    <TextBlock Style="{StaticResource ChipTextStyle}">
                                        <Run Text="{DynamicResource LOCPlayAch_ManageAchievements_Overview_LibrarySource}" /><Run Text=": " /><Run Text="{Binding LibrarySourceName, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                            </WrapPanel>

                            <WrapPanel Margin="0,2,0,0">
                                <TextBlock Style="{StaticResource OverviewMutedTextStyle}">
                                    <Run Text="{DynamicResource LOCPlayAch_ManageAchievements_Overview_LastUpdatedLocal}" /><Run Text=": " /><Run Text="{Binding LastUpdatedLocalText, Mode=OneWay}" />
                                </TextBlock>
                                <Button Command="{Binding OpenAchievementPageCommand}"
                                        Style="{StaticResource InlineLinkButtonStyle}"
                                        Visibility="{Binding HasAchievementPageLink, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{DynamicResource LOCPlayAch_ManageAchievements_Overview_OpenAchievementPage}"
                                               TextDecorations="Underline" />
                                </Button>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top">
                            <Button Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                    Command="{Binding ClearGameDataCommand}"
                                    Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                    MinWidth="100"
                                    Margin="{StaticResource PlayAch.Thickness.Right.Sm}" />
                            <Button Content="{DynamicResource LOCPlayAch_Button_Refresh}"
                                    Command="{Binding RefreshGameCommand}"
                                    Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                    MinWidth="100"
                                    Margin="{StaticResource PlayAch.Thickness.Right.Sm}" />
                            <Button Content="{DynamicResource LOCPlayAch_Menu_ViewAchievements}"
                                    Command="{Binding OpenAchievementsCommand}"
                                    Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                    MinWidth="130" />
                        </StackPanel>
                    </Grid>

                    <!-- Platform override, edited in place beside the platform it replaces. -->
                    <Border BorderBrush="{DynamicResource PlayAch.Brush.ControlBorder}"
                            BorderThickness="0,1,0,0"
                            Margin="0,10,0,0"
                            Padding="0,10,0,0">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_ProviderHeader}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                                <ComboBox ItemsSource="{Binding ProviderOverrideOptions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="ProviderKey"
                                          SelectedValue="{Binding SelectedProviderOverrideKey, Mode=TwoWay}"
                                          Width="200"
                                          Padding="8,4"
                                          VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsProviderOverrideValueVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBox Text="{Binding ProviderOverrideInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding ProviderOverrideInputLabel}"
                                             Visibility="{Binding IsProviderOverrideTextVisible, Converter={StaticResource BoolToVis}}"
                                             Width="220"
                                             Padding="8,4"
                                             Margin="{StaticResource PlayAch.Thickness.Left.Sm}" />
                                    <ComboBox ItemsSource="{Binding ProviderOverrideChoices}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding ProviderOverrideInput, Mode=TwoWay}"
                                              ToolTip="{Binding ProviderOverrideInputLabel}"
                                              Visibility="{Binding IsProviderOverrideChoiceVisible, Converter={StaticResource BoolToVis}}"
                                              Width="220"
                                              Padding="8,4"
                                              Margin="{StaticResource PlayAch.Thickness.Left.Sm}" />
                                </StackPanel>
                                <Button Content="{DynamicResource LOCPlayAch_Button_Apply}"
                                        Command="{Binding ApplyProviderOverrideCommand}"
                                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                        VerticalAlignment="Center"
                                        Margin="{StaticResource PlayAch.Thickness.Left.Sm}" />
                                <Button Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                        Command="{Binding ClearProviderOverrideCommand}"
                                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                        VerticalAlignment="Center"
                                        Margin="{StaticResource PlayAch.Thickness.Left.Sm}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource OverviewMutedTextStyle}"
                                       Text="{Binding ProviderOverrideStatusText}"
                                       Margin="{StaticResource PlayAch.Thickness.Top.Compact}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Progress: completion, then rarity and trophy counts as badges. -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="{StaticResource PlayAch.Thickness.Bottom.Md}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Text="{DynamicResource LOCPlayAch_ManageAchievements_Overview_Completion}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CompletionSummary}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar Value="{Binding CompletionPercentValue, Mode=OneWay}"
                                 Maximum="100"
                                 Height="10"
                                 Margin="0,8,0,10" />

                    <WrapPanel Visibility="{Binding HasAchievementData, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource MetaChipStyle}" ToolTip="{DynamicResource LOCPlayAch_Rarity_Common}">
                            <StackPanel Orientation="Horizontal">
                                <Image Style="{StaticResource OverviewBadgeImageStyle}" Source="{DynamicResource BadgeRarityCommon}" />
                                <TextBlock Style="{StaticResource ChipTextStyle}" Text="{Binding OverviewSummary.RarityCommonText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetaChipStyle}" ToolTip="{DynamicResource LOCPlayAch_Rarity_Uncommon}">
                            <StackPanel Orientation="Horizontal">
                                <Image Style="{StaticResource OverviewBadgeImageStyle}" Source="{DynamicResource BadgeRarityUncommon}" />
                                <TextBlock Style="{StaticResource ChipTextStyle}" Text="{Binding OverviewSummary.RarityUncommonText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetaChipStyle}" ToolTip="{DynamicResource LOCPlayAch_Rarity_Rare}">
                            <StackPanel Orientation="Horizontal">
                                <Image Style="{StaticResource OverviewBadgeImageStyle}" Source="{DynamicResource BadgeRarityRare}" />
                                <TextBlock Style="{StaticResource ChipTextStyle}" Text="{Binding OverviewSummary.RarityRareText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetaChipStyle}" ToolTip="{DynamicResource LOCPlayAch_Rarity_UltraRare}">
                            <StackPanel Orientation="Horizontal">
                                <Image Style="{StaticResource OverviewBadgeImageStyle}" Source="{DynamicResource BadgeRarityUltraRare}" />
                                <TextBlock Style="{StaticResource ChipTextStyle}" Text="{Binding OverviewSummary.RarityUltraRareText}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding OverviewSummary.HasTrophies, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource MetaChipStyle}" ToolTip="{DynamicResource LOCPlayAch_Trophy_Platinum}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Style="{StaticResource OverviewBadgeImageStyle}" Source="{DynamicResource TrophyPlatinum}" />
                                    <TextBlock Style="{StaticResource ChipTextStyle}" Text="{Binding OverviewSummary.TrophyPlatinumText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaChipStyle}" ToolTip="{DynamicResource LOCPlayAch_Trophy_Gold}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Style="{StaticResource OverviewBadgeImageStyle}" Source="{DynamicResource TrophyGold}" />
                                    <TextBlock Style="{StaticResource ChipTextStyle}" Text="{Binding OverviewSummary.TrophyGoldText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaChipStyle}" ToolTip="{DynamicResource LOCPlayAch_Trophy_Silver}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Style="{StaticResource OverviewBadgeImageStyle}" Source="{DynamicResource TrophySilver}" />
                                    <TextBlock Style="{StaticResource ChipTextStyle}" Text="{Binding OverviewSummary.TrophySilverText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaChipStyle}" ToolTip="{DynamicResource LOCPlayAch_Trophy_Bronze}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Style="{StaticResource OverviewBadgeImageStyle}" Source="{DynamicResource TrophyBronze}" />
                                    <TextBlock Style="{StaticResource ChipTextStyle}" Text="{Binding OverviewSummary.TrophyBronzeText}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </WrapPanel>

                    <WrapPanel>
                        <Border Style="{StaticResource MetaChipStyle}"
                                Visibility="{Binding OverviewSummary.HasPoints, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ChipTextStyle}" Text="{DynamicResource LOCPlayAch_Column_Points}" />
                                <TextBlock Style="{StaticResource ChipCountTextStyle}" Text="{Binding OverviewSummary.PointsText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetaChipStyle}"
                                Visibility="{Binding OverviewSummary.HasCategorized, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ChipTextStyle}" Text="{DynamicResource LOCPlayAch_ManageAchievements_Tab_Category}" />
                                <TextBlock Style="{StaticResource ChipCountTextStyle}" Text="{Binding OverviewSummary.CategorizedText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetaChipStyle}"
                                Visibility="{Binding HasCapstone, Converter={StaticResource BoolToVis}}"
                                MaxWidth="320">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ChipTextStyle}" Text="{DynamicResource LOCPlayAch_Dynamic_Capstone}" />
                                <TextBlock Style="{StaticResource ChipCountTextStyle}"
                                           Text="{Binding CurrentCapstoneName}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding CurrentCapstoneName}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetaChipStyle}"
                                Visibility="{Binding OverviewSummary.HasLastUnlock, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ChipTextStyle}" Text="{DynamicResource LOCPlayAch_Common_LastUnlock}" />
                                <TextBlock Style="{StaticResource ChipCountTextStyle}" Text="{Binding OverviewSummary.LastUnlockText}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource OverviewMutedTextStyle}"
                               FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                               Margin="{StaticResource PlayAch.Thickness.Top.Compact}"
                               Visibility="{Binding OverviewSummary.HasHidden, Converter={StaticResource BoolToVis}}">
                        <Run Text="{DynamicResource LOCPlayAch_Filter_Hidden}" /><Run Text=": " /><Run Text="{Binding OverviewSummary.HiddenText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource OverviewMutedTextStyle}"
                               Margin="{StaticResource PlayAch.Thickness.Top.Compact}"
                               Visibility="{Binding HasManualTrackingLink, Converter={StaticResource BoolToVis}}">
                        <Run Text="{DynamicResource LOCPlayAch_ManageAchievements_Tab_ManualTracking}" /><Run Text=": " /><Run Text="{Binding ManualTrackingSummary, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- What this game's stored custom data holds, and moving it in and out. -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Text="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_CustomDataHeader}"
                                   ToolTip="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_CustomDataHint}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_ExportButton}"
                                    Command="{Binding ExportCustomCommand}"
                                    Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                    Margin="{StaticResource PlayAch.Thickness.Right.Sm}" />
                            <Button Content="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_ImportButton}"
                                    Command="{Binding ImportCustomJsonCommand}"
                                    Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                    Margin="{StaticResource PlayAch.Thickness.Right.Sm}" />
                            <Button Content="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_ClearCustomDataButton}"
                                    Command="{Binding ClearCustomDataCommand}"
                                    Padding="{StaticResource PlayAch.Thickness.ButtonPadding}" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding OverviewSummary.Customizations}"
                                  ItemsPanel="{StaticResource OverviewWrapPanelTemplate}"
                                  Focusable="False"
                                  Margin="0,8,0,0"
                                  Visibility="{Binding OverviewSummary.HasCustomizations, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource MetaChipStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource ChipTextStyle}" Text="{Binding Label}" />
                                        <TextBlock Style="{StaticResource ChipCountTextStyle}"
                                                   Text="{Binding CountText}"
                                                   Visibility="{Binding HasCount, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource OverviewMutedTextStyle}"
                               Text="{DynamicResource LOCPlayAch_Tagging_NotCustomized}"
                               Margin="0,8,0,0"
                               Visibility="{Binding OverviewSummary.HasCustomizations, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
