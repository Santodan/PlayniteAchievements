<UserControl x:Class="PlayniteAchievements.Views.ManageAchievements.ManageAchievementsOverviewTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/ManageAchievementsScopedControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ItemsPanelTemplate x:Key="OverviewWrapPanelTemplate">
                <WrapPanel />
            </ItemsPanelTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  KeyboardNavigation.DirectionalNavigation="Continue">
        <StackPanel Margin="0">

            <!-- Game header: identity, source, freshness, and the everyday actions. -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="{StaticResource PlayAch.Thickness.Bottom.Md}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="{Binding GameName, Mode=OneWay}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   FontWeight="SemiBold"
                                   FontSize="{DynamicResource PlayAch.FontSize.Title}"
                                   TextWrapping="Wrap" />

                        <WrapPanel Margin="{StaticResource PlayAch.Thickness.Top.Sm}">
                            <Border Style="{StaticResource MetaChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ChipTextStyle}"
                                               Text="{DynamicResource LOCPlayAch_ManageAchievements_Overview_Provider}" />
                                    <TextBlock Style="{StaticResource ChipTextStyle}" Text=": " />
                                    <TextBlock Style="{StaticResource ChipTextStyle}"
                                               Text="{Binding ProviderName, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ChipTextStyle}"
                                               Text="{DynamicResource LOCPlayAch_ManageAchievements_Overview_LibrarySource}" />
                                    <TextBlock Style="{StaticResource ChipTextStyle}" Text=": " />
                                    <TextBlock Style="{StaticResource ChipTextStyle}"
                                               Text="{Binding LibrarySourceName, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <WrapPanel Margin="0,2,0,0">
                            <TextBlock Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       Opacity="{StaticResource PlayAch.Opacity.Subtle}">
                                <Run Text="{DynamicResource LOCPlayAch_ManageAchievements_Overview_LastUpdatedLocal}" /><Run Text=": " /><Run Text="{Binding LastUpdatedLocalText, Mode=OneWay}" />
                            </TextBlock>
                            <Button Command="{Binding OpenAchievementPageCommand}"
                                    Style="{StaticResource InlineLinkButtonStyle}"
                                    Visibility="{Binding HasAchievementPageLink, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource LOCPlayAch_ManageAchievements_Overview_OpenAchievementPage}"
                                           TextDecorations="Underline" />
                            </Button>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Button Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                Command="{Binding ClearGameDataCommand}"
                                Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                MinWidth="100"
                                Margin="{StaticResource PlayAch.Thickness.Right.Sm}" />
                        <Button Content="{DynamicResource LOCPlayAch_Button_Refresh}"
                                Command="{Binding RefreshGameCommand}"
                                Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                MinWidth="100"
                                Margin="{StaticResource PlayAch.Thickness.Right.Sm}" />
                        <Button Content="{DynamicResource LOCPlayAch_Menu_ViewAchievements}"
                                Command="{Binding OpenAchievementsCommand}"
                                Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                MinWidth="130" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Progress: completion plus the few single numbers worth a glance. -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="{StaticResource PlayAch.Thickness.Bottom.Md}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Text="{DynamicResource LOCPlayAch_ManageAchievements_Overview_Completion}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CompletionSummary}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar Value="{Binding CompletionPercentValue, Mode=OneWay}"
                                 Maximum="100"
                                 Height="10"
                                 Margin="0,8,0,12" />

                    <WrapPanel>
                        <Border Style="{StaticResource OverviewStatTileStyle}"
                                Visibility="{Binding OverviewSummary.HasPoints, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource OverviewStatValueStyle}" Text="{Binding OverviewSummary.PointsText}" />
                                <TextBlock Style="{StaticResource OverviewStatLabelStyle}" Text="{DynamicResource LOCPlayAch_Column_Points}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource OverviewStatTileStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource OverviewStatValueStyle}" Text="{Binding OverviewSummary.HiddenText}" />
                                <TextBlock Style="{StaticResource OverviewStatLabelStyle}" Text="{DynamicResource LOCPlayAch_Filter_Hidden}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource OverviewStatTileStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource OverviewStatValueStyle}" Text="{Binding OverviewSummary.LastUnlockText}" />
                                <TextBlock Style="{StaticResource OverviewStatLabelStyle}" Text="{DynamicResource LOCPlayAch_Common_LastUnlock}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource OverviewStatTileStyle}" MaxWidth="280">
                            <StackPanel>
                                <TextBlock Style="{StaticResource OverviewStatValueStyle}"
                                           Text="{Binding CurrentCapstoneName}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding CurrentCapstoneName}" />
                                <TextBlock Style="{StaticResource OverviewStatLabelStyle}" Text="{DynamicResource LOCPlayAch_ManageAchievements_Overview_Capstone}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <TextBlock Visibility="{Binding HasManualTrackingLink, Converter={StaticResource BoolToVis}}"
                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                               Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                               TextWrapping="Wrap">
                        <Run Text="{DynamicResource LOCPlayAch_ManageAchievements_Tab_ManualTracking}" /><Run Text=": " /><Run Text="{Binding ManualTrackingSummary, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Breakdown by rarity, trophy and category. -->
            <Border Style="{StaticResource CardBorderStyle}"
                    Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"
                    Visibility="{Binding HasAchievementData, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}"
                               Text="{DynamicResource LOCPlayAch_Overview_RarityPieChart}"
                               Margin="0,0,0,8" />
                    <WrapPanel>
                        <Border Style="{StaticResource OverviewStatTileStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource OverviewStatValueStyle}"
                                           Foreground="{DynamicResource PlayAch.Brush.Rarity.Common}"
                                           Text="{Binding OverviewSummary.RarityCommonText}" />
                                <TextBlock Style="{StaticResource OverviewStatLabelStyle}" Text="{DynamicResource LOCPlayAch_Rarity_Common}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource OverviewStatTileStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource OverviewStatValueStyle}"
                                           Foreground="{DynamicResource PlayAch.Brush.Rarity.Uncommon}"
                                           Text="{Binding OverviewSummary.RarityUncommonText}" />
                                <TextBlock Style="{StaticResource OverviewStatLabelStyle}" Text="{DynamicResource LOCPlayAch_Rarity_Uncommon}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource OverviewStatTileStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource OverviewStatValueStyle}"
                                           Foreground="{DynamicResource PlayAch.Brush.Rarity.Rare}"
                                           Text="{Binding OverviewSummary.RarityRareText}" />
                                <TextBlock Style="{StaticResource OverviewStatLabelStyle}" Text="{DynamicResource LOCPlayAch_Rarity_Rare}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource OverviewStatTileStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource OverviewStatValueStyle}"
                                           Foreground="{DynamicResource PlayAch.Brush.Rarity.UltraRare}"
                                           Text="{Binding OverviewSummary.RarityUltraRareText}" />
                                <TextBlock Style="{StaticResource OverviewStatLabelStyle}" Text="{DynamicResource LOCPlayAch_Rarity_UltraRare}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <StackPanel Visibility="{Binding OverviewSummary.HasTrophies, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="{DynamicResource LOCPlayAch_Overview_TrophyPieChart}"
                                   Margin="0,4,0,8" />
                        <WrapPanel>
                            <Border Style="{StaticResource OverviewStatTileStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource OverviewStatValueStyle}"
                                               Foreground="{DynamicResource PlayAch.Brush.Trophy.Platinum}"
                                               Text="{Binding OverviewSummary.TrophyPlatinumText}" />
                                    <TextBlock Style="{StaticResource OverviewStatLabelStyle}" Text="{DynamicResource LOCPlayAch_Trophy_Platinum}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource OverviewStatTileStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource OverviewStatValueStyle}"
                                               Foreground="{DynamicResource PlayAch.Brush.Trophy.Gold}"
                                               Text="{Binding OverviewSummary.TrophyGoldText}" />
                                    <TextBlock Style="{StaticResource OverviewStatLabelStyle}" Text="{DynamicResource LOCPlayAch_Trophy_Gold}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource OverviewStatTileStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource OverviewStatValueStyle}"
                                               Foreground="{DynamicResource PlayAch.Brush.Trophy.Silver}"
                                               Text="{Binding OverviewSummary.TrophySilverText}" />
                                    <TextBlock Style="{StaticResource OverviewStatLabelStyle}" Text="{DynamicResource LOCPlayAch_Trophy_Silver}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource OverviewStatTileStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource OverviewStatValueStyle}"
                                               Foreground="{DynamicResource PlayAch.Brush.Trophy.Bronze}"
                                               Text="{Binding OverviewSummary.TrophyBronzeText}" />
                                    <TextBlock Style="{StaticResource OverviewStatLabelStyle}" Text="{DynamicResource LOCPlayAch_Trophy_Bronze}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding OverviewSummary.HasMultipleCategories, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="{DynamicResource LOCPlayAch_ManageAchievements_Tab_Category}"
                                   Margin="0,4,0,8" />
                        <ItemsControl ItemsSource="{Binding OverviewSummary.Categories}"
                                      ItemsPanel="{StaticResource OverviewWrapPanelTemplate}"
                                      Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource OverviewStatTileStyle}" MaxWidth="240">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource OverviewStatValueStyle}" Text="{Binding ProgressText}" />
                                            <TextBlock Style="{StaticResource OverviewStatLabelStyle}"
                                                       Text="{Binding Label}"
                                                       ToolTip="{Binding Label}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- What this game's stored custom data holds, kind by kind. -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}"
                               Text="{DynamicResource LOCPlayAch_Tagging_Customized}"
                               Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding OverviewSummary.Customizations}"
                                  ItemsPanel="{StaticResource OverviewWrapPanelTemplate}"
                                  Focusable="False"
                                  Visibility="{Binding OverviewSummary.HasCustomizations, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource MetaChipStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource ChipTextStyle}" Text="{Binding Label}" />
                                        <TextBlock Style="{StaticResource ChipCountTextStyle}"
                                                   Text="{Binding CountText}"
                                                   Visibility="{Binding HasCount, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{DynamicResource LOCPlayAch_Tagging_NotCustomized}"
                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                               Opacity="{StaticResource PlayAch.Opacity.Hint}"
                               Visibility="{Binding OverviewSummary.HasCustomizations, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
