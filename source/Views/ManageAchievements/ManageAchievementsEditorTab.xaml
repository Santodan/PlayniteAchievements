<UserControl x:Class="PlayniteAchievements.Views.ManageAchievements.ManageAchievementsEditorTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             xmlns:converters="clr-namespace:PlayniteAchievements.Views.Converters"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="1100">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/ManageAchievementsScopedControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BooleanConverter x:Key="BoolToVis" Mode="ToVisibility" />
            <converters:BooleanConverter x:Key="InverseBoolToVis" Mode="InvertedToVisibility" />

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12" />
            </Style>

            <Style x:Key="GridEditorTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource HighlightGlyphBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Opacity" Value="0.72" />
                <Setter Property="Margin" Value="0,8,0,4" />
            </Style>

            <Style x:Key="StatusTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Opacity" Value="0.82" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                        <Setter Property="Foreground" Value="#FFE07070" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,0,0,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: what this page is, and the search that narrows the one shared list. -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource LOCPlayAch_ManageAchievements_Category_Hint}"
                               Style="{StaticResource BaseTextBlockStyle}"
                               Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource StatusTextStyle}"
                               Margin="0,6,0,0"
                               Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox"
                             Width="240"
                             MinHeight="30"
                             VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                             Tag="{DynamicResource LOCPlayAch_Common_FilterAchievementsPlaceholder}"
                             Style="{StaticResource GridEditorTextBoxStyle}" />
                    <Button Content="{DynamicResource LOCPlayAch_Button_Clear}"
                            Command="{Binding ClearSearchCommand}"
                            MinHeight="30"
                            Padding="12,6"
                            Margin="8,0,0,0" />
                    <Button Content="{DynamicResource LOCPlayAch_Button_Reset}"
                            ToolTip="{DynamicResource LOCPlayAch_ManageAchievements_Order_Hint}"
                            Command="{Binding ResetOrderCommand}"
                            MinHeight="30"
                            Padding="12,6"
                            Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Shown instead of the editor when the game has no cached achievements and none authored. -->
        <TextBlock Grid.Row="1"
                   Text="{DynamicResource LOCPlayAch_Common_NoCachedAchievementsForGame}"
                   Style="{StaticResource BaseTextBlockStyle}"
                   Foreground="{DynamicResource TextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Visibility="{Binding HasAchievements, Converter={StaticResource InverseBoolToVis}}" />

        <Grid Grid.Row="2" Visibility="{Binding HasAchievements, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="620" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- The grid owns its scrolling so row virtualization engages: this list is a whole
                 library, not the handful of achievements the custom editor used to hold. -->
            <DataGrid x:Name="AchievementsGrid"
                      Grid.Column="0"
                      ItemsSource="{Binding AchievementRows}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      RowBackground="Transparent"
                      Background="Transparent"
                      BorderThickness="0"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="False"
                      CanUserSortColumns="False"
                      AllowDrop="True"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      VirtualizingStackPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ColumnHeaderStyle="{StaticResource ManageAchievementsColumnHeaderStyle}"
                      helpers:DataGridHoverScrollBarBehavior.IsEnabled="True"
                      helpers:DataGridAlignmentBehavior.IsEnabled="True"
                      KeyboardNavigation.DirectionalNavigation="Continue"
                      Tag="ControllerCellFocus">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource ManageAchievementsDataGridRowStyle}">
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="Row_PreviewMouseRightButtonDown" />
                        <EventSetter Event="PreviewMouseRightButtonUp" Handler="Row_PreviewMouseRightButtonUp" />
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <!-- Drag handle: the row order is the achievement order, custom rows included. -->
                    <DataGridTemplateColumn Header="" Width="28" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="&#x2807;"
                                           FontSize="14"
                                           Opacity="0.55"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_Column_Icon}" Width="48" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding DisplayIcon}"
                                       Width="32"
                                       Height="32"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_Column_Achievement}" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBox Text="{Binding EditDisplayName, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource GridEditorTextBoxStyle}"
                                             KeyDown="EditorTextBox_KeyDown" />
                                    <!-- A custom row is the only kind whose rarity is user input,
                                         so it is worth marking in the shared list. -->
                                    <TextBlock Text="{DynamicResource LOCPlayAch_ManageAchievements_Tab_Custom}"
                                               FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                               Opacity="0.6"
                                               Margin="2,2,0,0"
                                               Foreground="{DynamicResource TextBrush}"
                                               Visibility="{Binding IsCustomRow, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_Common_Label_Category}" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding EditCategory, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource GridEditorTextBoxStyle}"
                                         KeyDown="EditorTextBox_KeyDown" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_Column_Points}" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding EditPointsText, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource GridEditorTextBoxStyle}"
                                         ToolTip="{Binding ValidationMessage}"
                                         KeyDown="EditorTextBox_KeyDown" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_Column_Trophy}" Width="96">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.TrophyTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding EditTrophyType, Mode=TwoWay}"
                                          MinHeight="26"
                                          VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Rarity is read-only for provider achievements: it is derived from the
                         provider's unlock percentages. Only an authored row can set it. -->
                    <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_Column_Rarity}" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding GlobalPercentText}"
                                               VerticalAlignment="Center"
                                               Opacity="0.75"
                                               Foreground="{DynamicResource TextBrush}"
                                               Visibility="{Binding CanEditRarity, Converter={StaticResource InverseBoolToVis}}" />
                                    <TextBox Text="{Binding EditRarity, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource GridEditorTextBoxStyle}"
                                             KeyDown="EditorTextBox_KeyDown"
                                             Visibility="{Binding CanEditRarity, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_ManageAchievements_Tab_Goals}" Width="60" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding EditIsGoal, Mode=TwoWay}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_ManageAchievements_Filters_FilterOut}" Width="70" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding EditIsFiltered, Mode=TwoWay}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_ManageAchievements_Filters_FilterOutOfSummaries}" Width="70" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding EditIsSummaryFiltered, Mode=TwoWay}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_Capstone_Subtitle}" Width="70" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding EditIsCapstone, Mode=TwoWay}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Detail pane: the facets that do not fit a column, for the selected row only. It is
                 bound to one row rather than templated per row, so it is never virtualized. -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedRow}">
                        <TextBlock Text="{Binding DisplayName}"
                                   Style="{StaticResource BaseTextBlockStyle}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}" />

                        <TextBlock Text="{DynamicResource LOCPlayAch_Column_Description}" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource GridEditorTextBoxStyle}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="60" />

                        <TextBlock Text="{DynamicResource LOCPlayAch_Common_Label_Type}" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding EditCategoryType, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource GridEditorTextBoxStyle}" />

                        <!-- Only a correction to an achievement that is already unlocked; unlock
                             status itself is provider-owned and not editable here. -->
                        <StackPanel Visibility="{Binding CanEditUnlockTime, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource LOCPlayAch_Common_UnlockTime}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding EditUnlockTimeText, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource GridEditorTextBoxStyle}"
                                     ToolTip="{Binding ValidationMessage}" />
                        </StackPanel>

                        <TextBlock Text="{DynamicResource LOCPlayAch_ManageAchievements_Notes_Note}" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding EditNote, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource GridEditorTextBoxStyle}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="80" />

                        <TextBlock Text="{Binding ValidationMessage}"
                                   Style="{StaticResource StatusTextStyle}"
                                   Foreground="#FFE07070"
                                   Margin="0,10,0,0"
                                   Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
