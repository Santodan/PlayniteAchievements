<UserControl x:Class="PlayniteAchievements.Views.ManageAchievements.ManageAchievementsCategoryTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:PlayniteAchievements.ViewModels.ManageAchievements"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             xmlns:converters="clr-namespace:PlayniteAchievements.Views.Converters"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="820"
             d:DataContext="{d:DesignInstance vm:ManageAchievementsCategoryViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/ManageAchievementsScopedControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <TabControl x:Name="CategorySubTabs"
                BorderThickness="0"
                Background="Transparent">
        <!-- One tab, so the strip would be a header with nothing to switch to; the template renders
             just the selected content. -->
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <ContentPresenter ContentSource="SelectedContent" />
            </ControlTemplate>
        </TabControl.Template>

        <TabItem Header="{DynamicResource LOCPlayAch_ManageAchievements_Category_Context_ManageCategories}"
                 IsSelected="True">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource ManageAchievementsHeaderCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource LOCPlayAch_ManageAchievements_Category_Context_ManageCategories}"
                                       Style="{StaticResource ManageAchievementsHeaderTitleStyle}" />
                            <TextBlock Text="{DynamicResource LOCPlayAch_ManageAchievements_Category_ManageHint}"
                                       Style="{StaticResource ManageAchievementsHeaderHintStyle}" />
                            <TextBlock Text="{Binding CategoryImageStatusText}"
                                       Style="{StaticResource StatusTextStyle}"
                                       Margin="{StaticResource PlayAch.Thickness.Top.Sm}"
                                       Visibility="{Binding HasCategoryImageStatusText, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="{StaticResource PlayAch.Thickness.Left.Md}">
                            <WrapPanel Orientation="Horizontal"
                                       HorizontalAlignment="Right">
                                <Button x:Name="AddCategoryButton"
                                        Content="{DynamicResource LOCPlayAch_Common_Add}"
                                        Click="AddCategoryButton_Click"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        IsEnabled="{Binding HasAchievements}"
                                        Margin="{StaticResource PlayAch.Thickness.Right.Sm}" />
                                <Button x:Name="ResetCategoryMetadataButton"
                                        Content="{DynamicResource LOCPlayAch_Common_Reset}"
                                        Click="ResetCategoryMetadataButton_Click"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        IsEnabled="{Binding HasCustomCategoryMetadata}" />
                            </WrapPanel>

                            <Button x:Name="OpenCategoryImagesFolderButton"
                                    Content="{DynamicResource LOCPlayAch_ManageAchievements_CustomIcons_OpenFolderButton}"
                                    Command="{Binding OpenCategoryImagesFolderCommand}"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Margin="{StaticResource PlayAch.Thickness.Top.Sm}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2"
                           Text="{DynamicResource LOCPlayAch_Common_NoCachedAchievementsForGame}"
                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                           Opacity="{StaticResource PlayAch.Opacity.Secondary}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top"
                           Visibility="{Binding HasAchievements, Converter={StaticResource InverseBoolToVis}}" />

                <DataGrid x:Name="CategoryManagerDataGrid"
                          Style="{StaticResource PlayAch.DataGrid.BaseStyle}"
                          Grid.Row="2"
                          ItemsSource="{Binding CategoryRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Visibility="{Binding HasAchievements, Converter={StaticResource BoolToVis}}"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowBackground="{DynamicResource PlayAch.Brush.Grid.RowBackground}"
                          BorderThickness="0"
                          Background="{DynamicResource PlayAch.Brush.Grid.Background}"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserResizeColumns="True"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="False"
                          RowHeight="88"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          VirtualizingStackPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ColumnHeaderStyle="{StaticResource ManageAchievementsColumnHeaderStyle}"
                          helpers:DataGridHoverScrollBarBehavior.IsEnabled="True"
                          helpers:DataGridAlignmentBehavior.IsEnabled="True"
                          Tag="ControllerCellFocus"
                          AllowDrop="True">

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource ManageAchievementsControllerCellStyle}" />
                    </DataGrid.CellStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource ManageAchievementsDataGridRowStyle}">
                            <Setter Property="MinHeight" Value="64" />
                            <Setter Property="ClipToBounds" Value="True" />
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="CategoryManagerRow_PreviewMouseRightButtonDown" />
                            <EventSetter Event="PreviewMouseRightButtonUp" Handler="CategoryManagerRow_PreviewMouseRightButtonUp" />
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44" MinWidth="44" MaxWidth="44" CanUserResize="False" CanUserSort="False">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource ManageAchievementsControllerCellStyle}">
                                    <Setter Property="Cursor" Value="SizeAll" />
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Tag="DragHandle"
                                            Background="Transparent"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Cursor="SizeAll">
                                        <TextBlock Tag="DragHandle"
                                                   Text="☰"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                   Opacity="0.65" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Nesting controls. Indent puts the row under the category above it;
                             outdent moves it out one level. -->
                        <!-- Stacked rather than side by side: the rows are tall and the column is
                             narrow, so two buttons in a row ran past the cell edge. -->
                        <DataGridTemplateColumn Width="38" MinWidth="38" MaxWidth="38" CanUserResize="False" CanUserSort="False">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource ManageAchievementsControllerCellStyle}">
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsDefaultCategory, Converter={StaticResource InverseBoolToVis}}">
                                        <!-- IcoFont simple-right / simple-left. The arrow-to-bar
                                             characters render hairline-thin in the body font, and
                                             IcoFont's own indent/outdent are text-editor icons -
                                             stacked rules plus an arrow - which turn to mush in a
                                             26x22 button. A plain chevron survives the size.
                                             Codepoints read from the shipped icofont.ttf glyph
                                             names rather than IcoFont's published CSS, so they
                                             match the build Playnite actually loads. -->
                                        <Button Content="&#xEAB8;"
                                                FontFamily="{DynamicResource PlayAch.FontFamily.Icon}"
                                                FontSize="18"
                                                Width="26"
                                                Height="22"
                                                Padding="0"
                                                ToolTip="{DynamicResource LOCPlayAch_ManageAchievements_Category_Indent}"
                                                IsEnabled="{Binding CanIndent}"
                                                Command="{Binding DataContext.IndentCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="&#xEAB5;"
                                                FontFamily="{DynamicResource PlayAch.FontFamily.Icon}"
                                                FontSize="18"
                                                Width="26"
                                                Height="22"
                                                Padding="0"
                                                Margin="0,3,0,0"
                                                ToolTip="{DynamicResource LOCPlayAch_ManageAchievements_Category_Outdent}"
                                                IsEnabled="{Binding IsNested}"
                                                Command="{Binding DataContext.OutdentCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="3*" MinWidth="260" Header="{DynamicResource LOCPlayAch_Common_Category}"
                                                CellStyle="{StaticResource PlayAch.TreeGuideDataGridCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                  <!-- Depth is shown by the same tree connectors the category-mode
                                       grid draws; the row edits its own name only, and the full
                                       path is on hover. The guide's own width is the indent. -->
                                  <DockPanel LastChildFill="True">
                                    <controls:CategoryTreeGuide DockPanel.Dock="Left"
                                                                VerticalAlignment="Stretch"
                                                                Shape="{Binding TreeShape}"
                                                                LineBrush="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                                                NodeBrush="{DynamicResource PlayAch.Brush.Accent}"/>
                                    <!-- Padding lives here, not on the cell: the guide beside it has
                                         to reach the row edges for its lanes to join up. -->
                                    <!-- Equal star rows above and below the name box keep its centre
                                         on the row centre - where the guide draws its junction -
                                         instead of letting the caption below push the box off it. -->
                                    <Grid Margin="0,6,10,6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="1">
                                            <!-- The tooltip sits on the TextBox, not the panel: the
                                                 box covers the cell, and a panel's tooltip never
                                                 surfaces from under a child that has its own. -->
                                            <!-- The box always holds the name, so editing starts from
                                                 it. While it still reads the provider's name its own
                                                 text is transparent and the dimmed copy above shows
                                                 through; the first edit hides the copy and the box
                                                 draws in full. The caret keeps a real brush. -->
                                            <TextBox x:Name="CategoryRenameTextBox"
                                                     Text="{Binding RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     LostKeyboardFocus="CategoryRenameTextBox_LostKeyboardFocus"
                                                     KeyDown="CategoryRenameTextBox_KeyDown"
                                                     IsEnabled="{Binding IsDefaultCategory, Converter={StaticResource InvertBoolConverter}}"
                                                     ToolTip="{Binding CategoryPathDisplay}"
                                                     ToolTipService.ShowOnDisabled="True"
                                                     CaretBrush="{DynamicResource PlayAch.Brush.Text}"
                                                     Padding="6,4"
                                                     VerticalContentAlignment="Center">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRenameUntouched}" Value="True">
                                                                <Setter Property="Foreground" Value="Transparent" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <TextBlock Text="{Binding RenameText}"
                                                       VerticalAlignment="Center"
                                                       Margin="9,0,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                       Opacity="{StaticResource PlayAch.Opacity.Placeholder}"
                                                       IsHitTestVisible="False"
                                                       Visibility="{Binding IsRenameUntouched, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding ProgressText}"
                                                   VerticalAlignment="Top"
                                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                   Opacity="{StaticResource PlayAch.Opacity.Hint}"
                                                   FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                                   Margin="0,3,0,0" />
                                    </Grid>
                                  </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="Auto" MinWidth="170" Header="{DynamicResource LOCPlayAch_Column_CategoryArt}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- Centered in the cell; Clear sits on the thumbnail's corner,
                                         as in the editor's icon slots, so rows with and without art
                                         line up. -->
                                    <Grid HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Wide box so arbitrary aspect ratios (Steam banner art,
                                             portrait covers, square icons) stay recognizable. It is
                                             the slot's input: drop an image on it, or click it and
                                             paste (or use Paste) a file, URL or image. -->
                                        <Border x:Name="CategoryArtSlot"
                                                Grid.Column="0"
                                                Width="88"
                                                Height="50"
                                                Background="Transparent"
                                                ToolTipService.InitialShowDelay="300"
                                                helpers:FilePickTarget.IsEnabled="True"
                                                helpers:FilePickTarget.Picked="CategoryImage_Picked">
                                            <!-- A larger preview of the art, sized up front so the tooltip does not grow as it loads. -->
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <Image helpers:AsyncImage.Uri="{Binding ArtPreviewPath}"
                                                           helpers:AsyncImage.DecodePixel="320"
                                                           Width="320"
                                                           Height="180"
                                                           Stretch="Uniform" />
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource PreviewBorderStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasArtOverrideValidationError}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource PlayAch.Brush.ErrorText}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Image Stretch="Uniform"
                                                   helpers:AsyncImage.Uri="{Binding ArtPreviewPath}"
                                                   helpers:AsyncImage.DecodePixel="-1" />
                                        </Border>

                                        <Button Grid.Column="0"
                                                Style="{StaticResource PlayAch.ThumbnailClearButton.Style}"
                                                Visibility="{Binding HasArtOverride, Converter={StaticResource BoolToVis}}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,2,2,0"
                                                Focusable="True"
                                                Click="ClearCategoryImageButton_Click" />

                                        <Button Grid.Column="2"
                                                Content="..."
                                                ToolTip="{DynamicResource LOCPlayAch_Button_Browse}"
                                                Style="{StaticResource InlineBrowseButtonStyle}"
                                                Click="BrowseCategoryImageButton_Click" />

                                        <Button Grid.Column="1"
                                                Content="{DynamicResource LOCPlayAch_Button_Paste}"
                                                ContentTemplate="{DynamicResource PlayAch.ButtonContent.Paste}"
                                                ToolTip="{DynamicResource LOCPlayAch_Button_Paste}"
                                                Style="{StaticResource InlineBrowseButtonStyle}"
                                                helpers:FilePickTarget.PasteTarget="{Binding ElementName=CategoryArtSlot}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="Auto"
                                                MinWidth="96"
                                                CanUserResize="False"
                                                CanUserSort="False"
                                                Header="{DynamicResource LOCPlayAch_Column_UseForGameSummaries}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- No GroupName: exclusivity is enforced in the view model because
                                         recycled virtualized rows make WPF radio groups unreliable. The
                                         OneWay binding keeps the view model the single writer; the
                                         Preview/Key handlers toggle, enabling click-again-to-clear. -->
                                    <RadioButton IsChecked="{Binding IsSummarySelected, Mode=OneWay}"
                                                 PreviewMouseLeftButtonDown="SummaryCategoryRadioButton_PreviewMouseLeftButtonDown"
                                                 KeyDown="SummaryCategoryRadioButton_KeyDown"
                                                 ToolTip="{DynamicResource LOCPlayAch_ManageAchievements_Category_SummaryArtTooltip}"
                                                 Focusable="True"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="Auto"
                                                MinWidth="110"
                                                CanUserResize="False"
                                                CanUserSort="False"
                                                Header="{DynamicResource LOCPlayAch_Common_Type}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- Built per click like the Filters cell beside it. A kind the
                                         providers decide reads dimmed; one set here reads in full. -->
                                    <Button Content="{Binding KindDisplayText}"
                                            Click="CategoryKindButton_Click"
                                            MinHeight="22"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            Margin="4,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource AchievementSelectorButtonStyle}">
                                                <Setter Property="Opacity" Value="{StaticResource PlayAch.Opacity.Hint}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsKindStored}" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="Auto"
                                                MinWidth="120"
                                                CanUserResize="False"
                                                CanUserSort="False"
                                                Header="{DynamicResource LOCPlayAch_Menu_Filters}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- A button with a menu built per click, as in the Editor's
                                         Filters column, rather than a ComboBox: a recycled combo
                                         raises SelectionChanged while it rebinds, which wrote one
                                         row's scope onto another during scrolling. A click only
                                         comes from the user. Picking a scope pushes it onto this
                                         category's own achievements, and the face then shows what
                                         they hold, blank when they disagree. -->
                                    <Button Content="{Binding FilterScopeDisplayText}"
                                            Style="{StaticResource AchievementSelectorButtonStyle}"
                                            IsEnabled="{Binding CanEditFilterScope}"
                                            Click="CategoryFilterScopeButton_Click"
                                            ToolTip="{DynamicResource LOCPlayAch_ManageAchievements_Category_FilterScopeTooltip}"
                                            MinHeight="22"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            Margin="4,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <Border x:Name="CategoryDropInsertLine"
                        Grid.Row="2"
                        Height="2"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        Background="{DynamicResource PlayAch.Brush.Accent}"
                        Visibility="Collapsed"
                        Margin="0,0,0,0"
                        IsHitTestVisible="False"
                        Panel.ZIndex="10" />

                <!-- Row outline shown while a drag hovers a row's middle: the drop makes the
                     dragged categories subcategories of that row, as opposed to the insert
                     line's between-rows reorder. -->
                <Border x:Name="CategoryNestHighlight"
                        Grid.Row="2"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        BorderBrush="{DynamicResource PlayAch.Brush.Accent}"
                        BorderThickness="2"
                        Background="Transparent"
                        CornerRadius="4"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        Panel.ZIndex="10" />

                <Popup x:Name="CategoryDragCountPopup"
                       Placement="AbsolutePoint"
                       AllowsTransparency="True"
                       StaysOpen="True"
                       IsHitTestVisible="False">
                    <Border Background="{StaticResource PlayAch.Brush.DialogBackdrop}"
                            BorderBrush="{DynamicResource PlayAch.Brush.Accent}"
                            BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                            CornerRadius="10"
                            Padding="8,3">
                        <TextBlock x:Name="CategoryDragCountText"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="{DynamicResource PlayAch.FontSize.Caption}" />
                    </Border>
                </Popup>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>

