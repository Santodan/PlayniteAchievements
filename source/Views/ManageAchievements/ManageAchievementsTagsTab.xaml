<UserControl x:Class="PlayniteAchievements.Views.ManageAchievements.ManageAchievementsTagsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="TagsTabBoolToVisibility"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The game's own tags, editable, beside the global list (edited in Settings > Metadata),
         greyed so it reads as available here but owned elsewhere. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="{DynamicResource LOCPlayAch_ManageAchievements_Tags_Hint}"
                       Style="{StaticResource PlayAch.MutedTextStyle}"
                       Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"
                       TextWrapping="Wrap"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource LOCPlayAch_ManageAchievements_Tags_GameTags}"
                               Style="{StaticResource PlayAch.SectionHeaderTextStyle}"/>
                    <controls:AchievementTagListEditor x:Name="Editor"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Opacity="{StaticResource PlayAch.Opacity.Hint}">
                    <TextBlock Text="{DynamicResource LOCPlayAch_ManageAchievements_Tags_GlobalTags}"
                               Style="{StaticResource PlayAch.SectionHeaderTextStyle}"/>
                    <ItemsControl x:Name="GlobalTags" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Height="36">
                                    <Grid Width="28" Height="28" Margin="0,0,8,0">
                                        <Rectangle Stroke="{DynamicResource PlayAch.Brush.Text}"
                                                   StrokeThickness="1"
                                                   StrokeDashArray="2 2"
                                                   RadiusX="4"
                                                   RadiusY="4"/>
                                        <Border BorderBrush="{DynamicResource PlayAch.Brush.ControlBorder}"
                                                Background="{DynamicResource PlayAch.Brush.Grid.Background}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Visibility="{Binding HasGlyph, Converter={StaticResource TagsTabBoolToVisibility}}">
                                            <controls:GlyphIcon Glyph="{Binding Glyph}"
                                                       FontFamily="{DynamicResource PlayAch.FontFamily.Icon}"
                                                       Size="18"
                                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <Border Width="14"
                                            Height="14"
                                            Margin="0,0,8,0"
                                            Background="{Binding Brush}"
                                            BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                            BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                                            Visibility="{Binding HasColor, Converter={StaticResource TagsTabBoolToVisibility}}"/>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
