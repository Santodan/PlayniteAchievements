<UserControl x:Class="PlayniteAchievements.Views.ManageAchievements.ManageAchievementsTagsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The game's own tags. The global list is edited in Settings > Metadata. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <TextBlock Text="{DynamicResource LOCTagsLabel}"
                       Style="{StaticResource PlayAch.SectionHeaderTextStyle}"/>
            <TextBlock Text="{DynamicResource LOCPlayAch_ManageAchievements_Tags_Hint}"
                       Style="{StaticResource PlayAch.MutedTextStyle}"
                       Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"
                       TextWrapping="Wrap"/>
            <controls:AchievementTagListEditor x:Name="Editor"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
