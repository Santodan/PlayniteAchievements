<UserControl x:Class="PlayniteAchievements.Views.ManageAchievements.ManageAchievementsTagsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/ManageAchievementsScopedControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="TagsTabBoolToVisibility"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Two cards like the Overview tab's: the game's own tags, editable, then the global list
         (edited in Settings > Metadata), greyed so it reads as available here but owned elsewhere. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource CardBorderStyle}" Margin="{StaticResource PlayAch.Thickness.Bottom.Md}">
                <controls:AchievementTagListEditor x:Name="Editor"/>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <ItemsControl x:Name="GlobalTags"
                              Focusable="False"
                              Opacity="{StaticResource PlayAch.Opacity.Hint}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Columns line up with the editor's rows above: drag handle, icon
                                 button, then the name. -->
                            <StackPanel Orientation="Horizontal" Height="36">
                                <Border Width="32"/>
                                <Grid Width="58" Margin="4,0" VerticalAlignment="Center">
                                    <controls:GlyphIcon Glyph="{Binding Glyph}"
                                                        FontFamily="{DynamicResource PlayAch.FontFamily.Icon}"
                                                        Size="16"
                                                        Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding HasGlyph, Converter={StaticResource TagsTabBoolToVisibility}}"/>
                                </Grid>
                                <TextBlock Text="{Binding Name}"
                                           Width="220"
                                           Margin="10,0,4,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           VerticalAlignment="Center"/>
                                <Border Width="22"
                                        Height="22"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="{Binding Brush}"
                                        BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                        BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                                        Visibility="{Binding HasColor, Converter={StaticResource TagsTabBoolToVisibility}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
