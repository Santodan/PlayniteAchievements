<UserControl x:Class="PlayniteAchievements.Views.ManageAchievements.ManageAchievementsTagsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             xmlns:converters="clr-namespace:PlayniteAchievements.Views.Converters"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/ManageAchievementsScopedControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="TagsTabBoolToVisibility"/>
            <converters:BrushToHexConverter x:Key="TagsTabBrushToHex"/>

            <!-- Same height as the editor's rows, so the two lists step down together. -->
            <Style x:Key="GlobalTagRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource AchievementRowStyle}">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Height" Value="36"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The global list (edited in Settings > Metadata) on the left, drawn as the editor's
         grid rows but greyed and inert so it reads as available here but owned elsewhere, and the
         game's own tags, editable, on the right. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- The global list is edited in Settings > Metadata; the gear goes there. -->
            <DockPanel Grid.Row="0"
                       Grid.Column="0"
                       LastChildFill="False"
                       Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}">
                <TextBlock Text="{DynamicResource LOCPlayAch_ManageAchievements_Tags_GlobalHeader}"
                           Style="{StaticResource SectionHeaderStyle}"
                           VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right"
                        Content="&#xEFE2;"
                        ToolTip="{DynamicResource LOCPlayAch_Landing_OpenSettings}"
                        AutomationProperties.Name="{DynamicResource LOCPlayAch_Landing_OpenSettings}"
                        Style="{StaticResource PlayAch.Button.ToolbarIconStyle}"
                        Click="OpenGlobalTagsSettings_Click"/>
            </DockPanel>
            <TextBlock Grid.Row="0"
                       Grid.Column="2"
                       Text="{DynamicResource LOCPlayAch_ManageAchievements_Tags_GameHeader}"
                       Style="{StaticResource SectionHeaderStyle}"
                       Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}"/>

            <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Top">
                <!-- Stands in for the empty grid; the editor's Add button stays below it. -->
                <TextBlock Text="{DynamicResource LOCPlayAch_ManageAchievements_Tags_Empty}"
                           Margin="4,8,4,4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PlayAch.MutedTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.Rows.Count, ElementName=Editor}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <controls:AchievementTagListEditor x:Name="Editor"/>
            </StackPanel>

            <Border Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Width="1"
                    Margin="16,0"
                    Background="{DynamicResource PlayAch.Brush.Border}"/>

            <DataGrid Grid.Row="1"
                      Grid.Column="0"
                      x:Name="GlobalTags"
                      VerticalAlignment="Top"
                      Style="{StaticResource PlayAch.DataGrid.BaseStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      IsHitTestVisible="False"
                      Focusable="False"
                      HeadersVisibility="None"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      Background="{DynamicResource PlayAch.Brush.Grid.Background}"
                      RowBackground="{DynamicResource PlayAch.Brush.Grid.RowBackground}"
                      Foreground="{DynamicResource PlayAch.Brush.Text}"
                      CellStyle="{StaticResource AchievementCellStyle}"
                      RowStyle="{StaticResource GlobalTagRowStyle}"
                      Opacity="{StaticResource PlayAch.Opacity.Hint}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <!-- As in the editor: the icon, or a dimmed tag when none is set. -->
                            <DataTemplate>
                                <Grid>
                                    <controls:GlyphIcon Glyph="&#xF004;"
                                                        FontFamily="{DynamicResource PlayAch.FontFamily.Icon}"
                                                        Size="16"
                                                        Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Opacity="{StaticResource PlayAch.Opacity.Hint}">
                                        <controls:GlyphIcon.Style>
                                            <Style TargetType="controls:GlyphIcon">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasGlyph}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:GlyphIcon.Style>
                                    </controls:GlyphIcon>
                                    <controls:GlyphIcon Glyph="{Binding Glyph}"
                                                        FontFamily="{DynamicResource PlayAch.FontFamily.Icon}"
                                                        Size="16"
                                                        Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding HasGlyph, Converter={StaticResource TagsTabBoolToVisibility}}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           Margin="4,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- As in the editor: the swatch and hex, the theme's text color when unset. -->
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                    <Grid Width="22" Height="22" VerticalAlignment="Center">
                                        <Border x:Name="DefaultSwatch"
                                                Background="{DynamicResource PlayAch.Brush.Text}"
                                                BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                                BorderThickness="{StaticResource PlayAch.Thickness.Border}"/>
                                        <Border Background="{Binding Brush}"
                                                BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                                BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                                                Visibility="{Binding HasColor, Converter={StaticResource TagsTabBoolToVisibility}}"/>
                                    </Grid>
                                    <TextBlock Width="70"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Brush, Converter={StaticResource TagsTabBrushToHex}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasColor}" Value="False">
                                                        <Setter Property="Text" Value="{Binding Background, ElementName=DefaultSwatch, Converter={StaticResource TagsTabBrushToHex}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </ScrollViewer>
</UserControl>
