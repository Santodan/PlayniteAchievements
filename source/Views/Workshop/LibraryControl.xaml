<UserControl x:Class="PlayniteAchievements.Views.Workshop.LibraryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             xmlns:vm="clr-namespace:PlayniteAchievements.ViewModels.Library"
             mc:Ignorable="d"
             d:DesignHeight="640"
             d:DesignWidth="980">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/PlayAchImplicitControlStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="LibraryRowStyle" TargetType="ListBoxItem" BasedOn="{StaticResource PlayAch.ListBoxItem.BaseStyle}">
                <Setter Property="Padding" Value="12,7"/>
            </Style>

            <!-- The button's glyph (its string Content) drawn as vector geometry with GlyphIcon:
                 a font glyph rendered as text comes out soft at this size. -->
            <DataTemplate x:Key="LibraryGlyphContentTemplate">
                <controls:GlyphIcon Glyph="{Binding}"
                                    Size="16"
                                    FontFamily="{DynamicResource PlayAch.FontFamily.Icon}"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True"/>
            </DataTemplate>
            <Style x:Key="LibraryIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayAch.Button.ToolbarIconStyle}">
                <Setter Property="Margin" Value="0,0,8,8"/>
                <Setter Property="ContentTemplate" Value="{StaticResource LibraryGlyphContentTemplate}"/>
            </Style>

            <!-- A small rounded state tag (In use, Edited, Update); the brush comes from the tag's own setter. -->
            <Style x:Key="LibraryTagStyle" TargetType="Border">
                <Setter Property="BorderThickness" Value="{StaticResource PlayAch.Thickness.Border}"/>
                <Setter Property="CornerRadius" Value="{StaticResource PlayAch.Radius.PillSmall}"/>
                <Setter Property="Padding" Value="8,1"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="LibraryTagTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Caption}"/>
            </Style>

            <!-- The thumbnail: the Workshop cover or preview, the color swatches of a color set, or the kind glyph. -->
            <DataTemplate x:Key="LibraryThumbnailTemplate" DataType="{x:Type vm:LibraryItemRow}">
                <Grid>
                    <!-- Uniform: the whole image fits the box instead of being cropped to fill it. -->
                    <Image helpers:AsyncImage.Uri="{Binding ThumbnailPath}"
                           helpers:AsyncImage.DecodePixel="144"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Swatches}"
                                  Visibility="{Binding HasSwatches, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Rectangle Fill="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <controls:GlyphIcon Glyph="{Binding KindGlyph}"
                                        FontFamily="{DynamicResource PlayAch.FontFamily.Icon}"
                                        Size="18"
                                        Foreground="{DynamicResource PlayAch.Brush.Text}"
                                        Opacity="{StaticResource PlayAch.Opacity.Muted}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding ShowGlyph, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="LibraryRowTemplate" DataType="{x:Type vm:LibraryItemRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="34"
                            Margin="0,0,12,0"
                            ClipToBounds="True"
                            Background="{DynamicResource PlayAch.Brush.Surface}"
                            BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                            BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                            CornerRadius="3">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LibraryThumbnailTemplate}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Secondary}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                   FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button Style="{StaticResource PlayAch.Workshop.LikeButtonStyle}"
                                Margin="0,0,6,0"/>
                        <Border Style="{StaticResource LibraryTagStyle}"
                                BorderBrush="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                Visibility="{Binding IsMine, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource LOCPlayAch_Workshop_Mine}"
                                       Style="{StaticResource LibraryTagTextStyle}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"/>
                        </Border>
                        <Border Style="{StaticResource LibraryTagStyle}"
                                BorderBrush="{DynamicResource PlayAch.Brush.AuthSuccess}"
                                Visibility="{Binding IsInUse, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource LOCPlayAch_Library_Applied}"
                                       Style="{StaticResource LibraryTagTextStyle}"
                                       Foreground="{DynamicResource PlayAch.Brush.AuthSuccess}"/>
                        </Border>
                        <Border Style="{StaticResource LibraryTagStyle}"
                                BorderBrush="{DynamicResource PlayAch.Brush.AuthPending}"
                                Visibility="{Binding IsEdited, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource LOCPlayAch_Library_Edited}"
                                       Style="{StaticResource LibraryTagTextStyle}"
                                       Foreground="{DynamicResource PlayAch.Brush.AuthPending}"/>
                        </Border>
                        <Border Style="{StaticResource LibraryTagStyle}"
                                BorderBrush="{DynamicResource PlayAch.Brush.Accent}"
                                Visibility="{Binding ShowUpdateTag, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding UpdateTag}"
                                       Style="{StaticResource LibraryTagTextStyle}"
                                       Foreground="{DynamicResource PlayAch.Brush.Accent}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="LibraryUseTemplate" DataType="{x:Type vm:LibraryUseRow}">
                <Border BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding State}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                       FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Goes to where the place is configured. LOCPlayAch_Common_Open is Playnite's own "Open". -->
                            <Button Content="&#xEF1F;"
                                    Style="{StaticResource PlayAch.Button.ToolbarIconStyle}"
                                    ContentTemplate="{StaticResource LibraryGlyphContentTemplate}"
                                    ToolTip="{DynamicResource LOCPlayAch_Common_Open}"
                                    AutomationProperties.Name="{DynamicResource LOCPlayAch_Common_Open}"
                                    Margin="8,0,0,0"
                                    Command="{Binding DataContext.OpenTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="&#xEE0B;"
                                    Style="{StaticResource PlayAch.Button.ToolbarIconStyle}"
                                    ContentTemplate="{StaticResource LibraryGlyphContentTemplate}"
                                    ToolTip="{DynamicResource LOCPlayAch_Common_Reset}"
                                    AutomationProperties.Name="{DynamicResource LOCPlayAch_Common_Reset}"
                                    Margin="4,0,0,0"
                                    Visibility="{Binding CanReset, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.ResetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="&#xEDF8;"
                                    Style="{StaticResource PlayAch.Button.ToolbarIconStyle}"
                                    ContentTemplate="{StaticResource LibraryGlyphContentTemplate}"
                                    ToolTip="{DynamicResource LOCPlayAch_Library_Unlink}"
                                    AutomationProperties.Name="{DynamicResource LOCPlayAch_Library_Unlink}"
                                    Margin="4,0,0,0"
                                    Command="{Binding DataContext.StopFollowingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="LibraryDetailTemplate" DataType="{x:Type vm:LibraryItemRow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16">
                        <Border Height="140"
                                Margin="0,0,0,12"
                                ClipToBounds="True"
                                Background="{DynamicResource PlayAch.Brush.Surface}"
                                BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                                CornerRadius="4">
                            <Grid>
                                <Image helpers:AsyncImage.Uri="{Binding ThumbnailPath}"
                                       helpers:AsyncImage.DecodePixel="768"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}"/>
                                <ItemsControl ItemsSource="{Binding Swatches}"
                                              Margin="24"
                                              Visibility="{Binding HasSwatches, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Rectangle Fill="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <controls:GlyphIcon Glyph="{Binding KindGlyph}"
                                                    FontFamily="{DynamicResource PlayAch.FontFamily.Icon}"
                                                    Size="56"
                                                    Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                    Opacity="{StaticResource PlayAch.Opacity.Muted}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding ShowGlyph, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding Name}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   FontSize="{DynamicResource PlayAch.FontSize.Title}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}" Margin="0,2,0,0" TextWrapping="Wrap">
                            <Run Text="{Binding KindLabel, Mode=OneWay}"/><Run Text="{Binding Secondary, Mode=OneWay, StringFormat=' · {0}'}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Description}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource LOCPlayAch_Common_Version}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                       Margin="0,0,14,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding VersionText}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           VerticalAlignment="Center"/>
                                <Border Style="{StaticResource LibraryTagStyle}"
                                        BorderBrush="{DynamicResource PlayAch.Brush.Accent}"
                                        Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding UpdateTag}"
                                               Style="{StaticResource LibraryTagTextStyle}"
                                               Foreground="{DynamicResource PlayAch.Brush.Accent}"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{DynamicResource LOCPlayAch_Library_UsedIn}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                   FontWeight="SemiBold"
                                   Margin="0,16,0,6"/>
                        <Border BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="4"
                                Visibility="{Binding HasUses, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding Uses}" ItemTemplate="{StaticResource LibraryUseTemplate}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Library_NotApplied}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasUses, Converter={StaticResource InverseBoolToVis}}"/>

                        <!-- Actions as icon buttons: update (download), reinstall (refresh), open on
                             GitHub (external link, for an item this install published), export or
                             share (upload, the shared two-way menu), rename (edit), delete. Game
                             data has no library copy, so it has no reinstall, export or rename. -->
                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="&#xEF08;"
                                    Style="{StaticResource LibraryIconButtonStyle}"
                                    ToolTip="{DynamicResource LOCPlayAch_Workshop_Update}"
                                    AutomationProperties.Name="{DynamicResource LOCPlayAch_Workshop_Update}"
                                    Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Button Content="&#xEFC2;"
                                    Style="{StaticResource LibraryIconButtonStyle}"
                                    ToolTip="{DynamicResource LOCPlayAch_Workshop_ApplyToGames}"
                                    AutomationProperties.Name="{DynamicResource LOCPlayAch_Workshop_ApplyToGames}"
                                    Visibility="{Binding CanApplyToGames, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.ApplyToGamesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Button Content="&#xEFD1;"
                                    Style="{StaticResource LibraryIconButtonStyle}"
                                    ToolTip="{DynamicResource LOCPlayAch_Workshop_Reinstall}"
                                    AutomationProperties.Name="{DynamicResource LOCPlayAch_Workshop_Reinstall}"
                                    Visibility="{Binding ShowReinstall, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.ReinstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Button Content="&#xEF1F;"
                                    Style="{StaticResource LibraryIconButtonStyle}"
                                    ToolTip="{DynamicResource LOCPlayAch_Workshop_OpenOnGitHub}"
                                    AutomationProperties.Name="{DynamicResource LOCPlayAch_Workshop_OpenOnGitHub}"
                                    Visibility="{Binding HasPublishedUrl, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.OpenPublishedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Button Content="&#xEBF9;"
                                    Style="{StaticResource LibraryIconButtonStyle}"
                                    ToolTip="{DynamicResource LOCPlayAch_Common_Edit}"
                                    AutomationProperties.Name="{DynamicResource LOCPlayAch_Common_Edit}"
                                    Visibility="{Binding IsMine, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.EditPublishedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Button Content="&#xEEAD;"
                                    Style="{StaticResource LibraryIconButtonStyle}"
                                    ToolTip="{DynamicResource LOCPlayAch_Workshop_RemoveFromWorkshop}"
                                    AutomationProperties.Name="{DynamicResource LOCPlayAch_Workshop_RemoveFromWorkshop}"
                                    Visibility="{Binding IsMine, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.RemovePublishedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Button Content="&#xF01C;"
                                    Style="{StaticResource LibraryIconButtonStyle}"
                                    ToolTip="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_ExportButton}"
                                    AutomationProperties.Name="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_ExportButton}"
                                    IsEnabled="{Binding HasFile}"
                                    Visibility="{Binding HasLibraryCopy, Converter={StaticResource BoolToVis}}"
                                    Click="Export_Click"/>
                            <Button Content="&#xEC55;"
                                    Style="{StaticResource LibraryIconButtonStyle}"
                                    ToolTip="{DynamicResource LOCPlayAch_Common_Rename}"
                                    AutomationProperties.Name="{DynamicResource LOCPlayAch_Common_Rename}"
                                    Visibility="{Binding HasLibraryCopy, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Button Content="&#xEE09;"
                                    Style="{StaticResource LibraryIconButtonStyle}"
                                    ToolTip="{DynamicResource LOCPlayAch_Common_Delete}"
                                    AutomationProperties.Name="{DynamicResource LOCPlayAch_Common_Delete}"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PlayAch.Brush.Panel}">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header and hint. -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="{DynamicResource LOCPlayAch_Showcase_Template_Library}"
                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                           FontSize="{DynamicResource PlayAch.FontSize.Title}"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource LOCPlayAch_Library_Hint}"
                           Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Kind chips with counts, and the search box. -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{Binding Filters}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LibraryKindFilter}">
                            <RadioButton Style="{StaticResource PlayAch.TimeRangeChip.Style}"
                                         GroupName="LibraryKindFilter"
                                         Margin="0,0,6,6"
                                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                                         Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         CommandParameter="{Binding}">
                                <TextBlock>
                                    <Run Text="{Binding Label, Mode=OneWay}"/>
                                    <Run Text="{Binding Count, Mode=OneWay}"
                                         Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"/>
                                </TextBlock>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Grid.Column="1"
                         Width="220"
                         Margin="8,0,0,6"
                         VerticalAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{DynamicResource LOCPlayAch_Common_Search}"/>
            </Grid>

            <!-- List grouped by kind, and the detail pane. -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" MinWidth="300"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4*" MinWidth="300"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource PlayAch.Brush.Surface}"
                        BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                        BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                        CornerRadius="4">
                    <Grid>
                        <ListBox Style="{StaticResource PlayAch.ListBox.BaseStyle}"
                                 ItemContainerStyle="{StaticResource LibraryRowStyle}"
                                 ItemsSource="{Binding RowsView}"
                                 SelectedItem="{Binding SelectedRow}"
                                 ItemTemplate="{StaticResource LibraryRowTemplate}"
                                 SelectionMode="Single"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="12,10,12,6">
                                                <Grid>
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding ItemCount}"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                        </ListBox>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Workshop_Empty}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

                <Border Grid.Column="2"
                        Background="{DynamicResource PlayAch.Brush.Surface}"
                        BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                        BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                        CornerRadius="4">
                    <ContentControl Content="{Binding SelectedRow}"
                                    ContentTemplate="{StaticResource LibraryDetailTemplate}"
                                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"/>
                </Border>
            </Grid>

            <!-- Status strip. -->
            <StackPanel Grid.Row="3" Margin="0,8,0,0">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource PlayAch.Brush.ErrorText}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"/>
                <ProgressBar Height="4"
                             IsIndeterminate="True"
                             Margin="0,4,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
