<UserControl x:Class="PlayniteAchievements.Views.Workshop.WorkshopControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             xmlns:vm="clr-namespace:PlayniteAchievements.ViewModels.Workshop"
             xmlns:workshop="clr-namespace:PlayniteAchievements.Services.Workshop"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1100"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/PlayAchImplicitControlStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- A small rounded state tag, as the Library rows draw theirs; the brush comes from the tag's own setter. -->
            <Style x:Key="WorkshopTagStyle" TargetType="Border">
                <Setter Property="BorderThickness" Value="{StaticResource PlayAch.Thickness.Border}"/>
                <Setter Property="CornerRadius" Value="{StaticResource PlayAch.Radius.PillSmall}"/>
                <Setter Property="Padding" Value="8,1"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </Style>
            <Style x:Key="WorkshopTagTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Caption}"/>
            </Style>

            <!-- Icon buttons drawn as vector geometry with GlyphIcon, as on the Library page:
                 a font glyph rendered as text comes out soft at this size. -->
            <DataTemplate x:Key="WorkshopGlyphContentTemplate">
                <controls:GlyphIcon Glyph="{Binding}"
                                    Size="16"
                                    FontFamily="{DynamicResource PlayAch.FontFamily.Icon}"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True"/>
            </DataTemplate>
            <Style x:Key="WorkshopIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayAch.Button.ToolbarIconStyle}">
                <Setter Property="Margin" Value="8,0,0,8"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="ContentTemplate" Value="{StaticResource WorkshopGlyphContentTemplate}"/>
            </Style>

            <!-- One row of the browse list. -->
            <DataTemplate x:Key="WorkshopItemRowTemplate" DataType="{x:Type vm:WorkshopItemViewModel}">
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Style="{StaticResource PlayAch.Workshop.LikeToggleStyle}"
                            Margin="0,0,6,0"/>
                    <Border Grid.Column="1"
                            Width="72" Height="48"
                            Margin="0,0,10,0"
                            Background="{DynamicResource PlayAch.Brush.Surface}"
                            BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                            BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                            CornerRadius="3">
                        <Grid>
                            <!-- Uniform: the whole cover or preview fits the box (a tall game data
                                 grid or a wide banner would lose its edges to a fill). -->
                            <Image helpers:AsyncImage.Uri="{Binding ThumbnailPath}"
                                   helpers:AsyncImage.DecodePixel="144"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <controls:GlyphIcon Glyph="{Binding KindGlyph}"
                                                FontFamily="{DynamicResource PlayAch.FontFamily.Icon}"
                                                Size="24"
                                                Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                Opacity="{StaticResource PlayAch.Opacity.Muted}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVis}}"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding KindLabel, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding Author, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding GameName}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}" Opacity="{StaticResource PlayAch.Opacity.Muted}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasGame, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding ContentsSummary}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}" Opacity="{StaticResource PlayAch.Opacity.Muted}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsBundle, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal"
                                        ToolTip="{DynamicResource LOCPlayAch_Workshop_Installs}"
                                        Visibility="{Binding HasStats, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xEF08;"
                                           FontFamily="{DynamicResource PlayAch.FontFamily.Icon}"
                                           FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding Installs}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Style="{StaticResource PlayAch.Workshop.LikeButtonStyle}"
                                    Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Workshop_UpdateAvailable}"
                                   Foreground="{DynamicResource PlayAch.Brush.Accent}"
                                   HorizontalAlignment="Right"
                                   Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding InstalledLabel}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}" Opacity="{StaticResource PlayAch.Opacity.Muted}"
                                   HorizontalAlignment="Right"
                                   Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"/>
                        <Border Style="{StaticResource WorkshopTagStyle}"
                                BorderBrush="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                Visibility="{Binding IsMine, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource LOCPlayAch_Workshop_Mine}"
                                       Style="{StaticResource WorkshopTagTextStyle}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- The right-hand detail pane. -->
            <DataTemplate x:Key="WorkshopItemDetailTemplate" DataType="{x:Type vm:WorkshopItemViewModel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16">
                        <Border Background="{DynamicResource PlayAch.Brush.Surface}"
                                BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                                CornerRadius="4"
                                Height="140"
                                Margin="0,0,0,12"
                                Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVis}}">
                            <controls:GlyphIcon Glyph="{Binding KindGlyph}"
                                                FontFamily="{DynamicResource PlayAch.FontFamily.Icon}"
                                                Size="56"
                                                Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                Opacity="{StaticResource PlayAch.Opacity.Muted}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="{DynamicResource PlayAch.Brush.Surface}"
                                BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                                CornerRadius="4"
                                MaxHeight="260"
                                Margin="0,0,0,12"
                                Cursor="Hand"
                                Tag="{Binding CoverPath}"
                                MouseLeftButtonUp="DetailImage_MouseLeftButtonUp"
                                Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                            <Image helpers:AsyncImage.Uri="{Binding CoverPath}"
                                   helpers:AsyncImage.DecodePixel="768"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <Border Background="{DynamicResource PlayAch.Brush.Surface}"
                                BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                                CornerRadius="4"
                                MaxHeight="260"
                                Margin="0,0,0,12"
                                Cursor="Hand"
                                Tag="{Binding PreviewPath}"
                                MouseLeftButtonUp="DetailImage_MouseLeftButtonUp"
                                Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                            <Image helpers:AsyncImage.Uri="{Binding PreviewPath}"
                                   helpers:AsyncImage.DecodePixel="768"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- The heart leads the title here as it leads the row in the list. -->
                            <Button Grid.Column="0"
                                    Style="{StaticResource PlayAch.Workshop.LikeToggleStyle}"
                                    Margin="-6,0,2,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       FontSize="{DynamicResource PlayAch.FontSize.Title}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </Grid>
                        <TextBlock Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}" Margin="0,2,0,0" TextWrapping="Wrap">
                            <Run Text="{Binding KindLabel, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{DynamicResource LOCPlayAch_Common_Author}"/><Run Text=": "/><Run Text="{Binding Author, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{DynamicResource LOCPlayAch_Common_Version}"/><Run Text=" "/><Run Text="{Binding Version, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasStats, Converter={StaticResource BoolToVis}}">
                            <Run Text="{DynamicResource LOCPlayAch_Workshop_Installs}"/><Run Text=": "/><Run Text="{Binding Installs, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}" Margin="0,2,0,0" TextWrapping="Wrap">
                            <Run Text="{Binding Updated, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasGame, Converter={StaticResource BoolToVis}}">
                            <Run Text="{DynamicResource LOCPlayAch_Column_Game}"/><Run Text=": "/><Run Text="{Binding GameName, Mode=OneWay}"/>
                            <Run Text=" → "/><Run Text="{Binding LocalGameName, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
                            <Run Text="{DynamicResource LOCPlayAch_Common_Tags}"/><Run Text=": "/><Run Text="{Binding Tags, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}" Margin="0,2,0,0" TextWrapping="Wrap">
                            <Run Text="{DynamicResource LOCPlayAch_Workshop_Contents}"/><Run Text=": "/><Run Text="{Binding ContentsSummary, Mode=OneWay}"/>
                        </TextBlock>

                        <!-- Where the item is used, read as the Library page's "Used in" list; its
                             actions (open, reset, unlink) stay on the Library page. -->
                        <StackPanel Visibility="{Binding HasUses, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource LOCPlayAch_Library_UsedIn}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                       FontWeight="SemiBold"
                                       Margin="0,16,0,6"/>
                            <Border BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                    BorderThickness="1,1,1,0"
                                    CornerRadius="4">
                                <ItemsControl ItemsSource="{Binding Uses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:WorkshopUseLine}">
                                            <Border BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="12,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}"
                                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding State}"
                                                               Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                                               FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding HasState, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <WrapPanel Orientation="Horizontal" Margin="0,12,0,4">
                            <Button Content="{Binding ActionLabel}"
                                    MinWidth="110"
                                    Margin="0,0,0,8"
                                    IsEnabled="{Binding CanInstall}"
                                    Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="{DynamicResource LOCPlayAch_Common_Preview}"
                                    Margin="8,0,0,8"
                                    Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="&#xEF1F;"
                                    Style="{StaticResource WorkshopIconButtonStyle}"
                                    ToolTip="{DynamicResource LOCPlayAch_Workshop_OpenOnGitHub}"
                                    AutomationProperties.Name="{DynamicResource LOCPlayAch_Workshop_OpenOnGitHub}"
                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="&#xEF2F;"
                                    Style="{StaticResource WorkshopIconButtonStyle}"
                                    ToolTip="{DynamicResource LOCPlayAch_Workshop_Report}"
                                    AutomationProperties.Name="{DynamicResource LOCPlayAch_Workshop_Report}"
                                    Command="{Binding DataContext.ReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="&#xEBF9;"
                                    Style="{StaticResource WorkshopIconButtonStyle}"
                                    ToolTip="{DynamicResource LOCPlayAch_Common_Edit}"
                                    AutomationProperties.Name="{DynamicResource LOCPlayAch_Common_Edit}"
                                    Visibility="{Binding IsMine, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="&#xEEAD;"
                                    Style="{StaticResource WorkshopIconButtonStyle}"
                                    ToolTip="{DynamicResource LOCPlayAch_Workshop_RemoveFromWorkshop}"
                                    AutomationProperties.Name="{DynamicResource LOCPlayAch_Workshop_RemoveFromWorkshop}"
                                    Visibility="{Binding IsMine, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding RequiresNewerPluginText}"
                                   Foreground="{DynamicResource PlayAch.Brush.Accent}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding RequiresNewerPlugin, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Text="{Binding Description}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>
                        <TextBox Text="{Binding Readme, Mode=OneWay}"
                                 Visibility="{Binding HasReadme, Converter={StaticResource BoolToVis}}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"/>
                    </StackPanel>
                </ScrollViewer>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource PlayAch.Brush.Window.Background}" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" x:Name="Tabs" Background="Transparent" BorderThickness="0">
                <!-- Browse -->
                <TabItem x:Name="BrowseTab" Header="{DynamicResource LOCPlayAch_Workshop_Tab_Browse}">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="320"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="4*" MinWidth="360"/>
                        </Grid.ColumnDefinitions>

                        <!-- Filters -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox Width="240"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{DynamicResource LOCPlayAch_Common_Search}"/>
                            <Grid Width="180" Margin="8,0,0,0">
                                <TextBox x:Name="TagFilterTextBox"
                                         Text="{Binding TagFilterText, UpdateSourceTrigger=PropertyChanged, Delay=100}"/>
                                <TextBlock Text="{DynamicResource LOCPlayAch_Common_Tags}"
                                           Tag="{Binding Text, ElementName=TagFilterTextBox}"
                                           Style="{StaticResource SearchPlaceholderTextStyle}"
                                           VerticalAlignment="Center"
                                           Margin="{StaticResource PlayAch.Thickness.Left.Sm}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           Opacity="{StaticResource PlayAch.Opacity.Placeholder}"
                                           IsHitTestVisible="False"/>
                            </Grid>
                            <ToggleButton IsChecked="{Binding ExcludeTags}" Margin="4,0,0,0" MinWidth="70">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                        <Setter Property="Content" Value="{DynamicResource LOCPlayAch_Common_Include}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Content" Value="{DynamicResource LOCPlayAch_Common_Exclude}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <ComboBox Width="180" Margin="8,0,0,0"
                                      ItemsSource="{Binding KindOptions}"
                                      SelectedItem="{Binding SelectedKind}"
                                      DisplayMemberPath="Label"
                                      Visibility="{Binding ShowKindFilter, Converter={StaticResource BoolToVis}}"/>
                            <ComboBox Width="160" Margin="8,0,0,0"
                                      ItemsSource="{Binding SortOptions}"
                                      SelectedItem="{Binding SelectedSort}"
                                      DisplayMemberPath="Label"/>
                            <CheckBox Content="{DynamicResource LOCPlayAch_Workshop_OnlyMyGames}"
                                      IsChecked="{Binding OnlyMyGames}"
                                      Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding ShowOnlyMyGames, Converter={StaticResource BoolToVis}}"/>
                            <CheckBox Content="{DynamicResource LOCPlayAch_Workshop_Mine}"
                                      IsChecked="{Binding OnlyMine}"
                                      Margin="12,0,0,0"
                                      VerticalAlignment="Center"/>
                            <Button Content="{DynamicResource LOCPlayAch_Button_Refresh}"
                                    Margin="12,0,0,0"
                                    Command="{Binding RefreshCommand}"/>
                        </StackPanel>

                        <!-- List -->
                        <Grid Grid.Row="1" Grid.Column="0">
                            <ListBox ItemsSource="{Binding ItemsView}"
                                     SelectedItem="{Binding SelectedItem}"
                                     ItemTemplate="{StaticResource WorkshopItemRowTemplate}"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"/>
                            <TextBlock Text="{DynamicResource LOCPlayAch_Workshop_Empty}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       x:Name="EmptyText"
                                       Visibility="Collapsed"/>
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{DynamicResource PlayAch.Brush.Accent}"
                                       TextWrapping="Wrap"
                                       Margin="12"
                                       VerticalAlignment="Top"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                        </Grid>

                        <GridSplitter Grid.Row="1" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

                        <!-- Detail -->
                        <Border Grid.Row="1" Grid.Column="2"
                                Background="{DynamicResource PlayAch.Brush.Panel}"
                                BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                                CornerRadius="4">
                            <ContentControl Content="{Binding SelectedItem}"
                                            ContentTemplate="{StaticResource WorkshopItemDetailTemplate}"
                                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"/>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Library: the user's own presets and Workshop items, hosted from code-behind. -->
                <TabItem x:Name="LibraryTab" Header="{DynamicResource LOCPlayAch_Showcase_Template_Library}"/>
            </TabControl>

            <!-- Status strip -->
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"/>
                    <ProgressBar Height="4"
                                 Minimum="0" Maximum="1"
                                 Value="{Binding ProgressFraction, Mode=OneWay}"
                                 Margin="0,4,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <ProgressBar Height="4"
                                 IsIndeterminate="True"
                                 Margin="0,4,0,0"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
