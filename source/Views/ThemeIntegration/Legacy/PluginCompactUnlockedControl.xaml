<local:CompactAchievementControlBase x:Class="PlayniteAchievements.Views.ThemeIntegration.Legacy.PluginCompactUnlockedControl"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:controls="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK"
                   xmlns:converters="clr-namespace:PlayniteAchievements.Views.Converters"
                   xmlns:local="clr-namespace:PlayniteAchievements.Views.ThemeIntegration.Base"
                   xmlns:localControls="clr-namespace:PlayniteAchievements.Views.ThemeIntegration.Legacy.Controls"
                   mc:Ignorable="d"
                   d:DesignHeight="100" d:DesignWidth="300"
                   MinHeight="{Binding RelativeSource={RelativeSource AncestorType=ContentControl}, Path=MinHeight}"
                   MaxHeight="{Binding RelativeSource={RelativeSource AncestorType=ContentControl}, Path=MaxHeight}">
    <!--
        SuccessStory-compatible compact unlocked control for theme integration.
        Programmatically creates grid columns to fit achievements, with "+X more" in the last column.
    -->
    <local:CompactAchievementControlBase.Style>
        <Style TargetType="local:CompactAchievementControlBase">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Persisted.EnableAchievementCompactUnlockedListControl}"
                             Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </local:CompactAchievementControlBase.Style>

    <local:CompactAchievementControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:CompactAchievementControlBase.Resources>

    <StackPanel ClipToBounds="False">
        <Border Padding="0,0,0,8"
                DataContext="{Binding FeaturedAchievement, RelativeSource={RelativeSource AncestorType=local:CompactAchievementControlBase}}">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="{Binding CompactFirstItemOffset, RelativeSource={RelativeSource AncestorType=local:CompactAchievementControlBase}}" />

                <localControls:AchievementImage Grid.Column="1"
                                                Width="44"
                                                Height="44"
                                                Margin="0,0,10,0"
                                                ToolTip="{Binding DisplayName}"
                                                Icon="{Binding UnlockedIconDisplay}"
                                                IconCustom="{Binding LockedIconDisplay}"
                                                IsLocked="False"
                                                Percent="{Binding RarityPercentValue}"
                                                HasRarityPercent="{Binding HasRarityPercent}"
                                                Rarity="{Binding Rarity}"
                                                RarityText="{Binding RarityText}"
                                                EnableRaretyIndicator="True"
                                                DisplayRaretyValue="True"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Description}"
                               Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock Grid.Column="3"
                           Margin="10,0,0,0"
                           VerticalAlignment="Top"
                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                           Text="{Binding DateUnlocked, StringFormat={}{0:g}}" />
            </Grid>
        </Border>

        <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                BorderThickness="{DynamicResource ControlBorderThickness}"
                Background="Transparent"
                Padding="5"
                BorderBrush="{DynamicResource PlayAch.Brush.Border}">
            <Grid Name="PART_GridContener"
                  MinHeight="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=IconHeight}"
                  Tag="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=IconHeight}">
                <Grid Name="PART_ScCompactView" x:FieldModifier="protected" />

                <!-- Empty state message -->
                <TextBlock Text="{DynamicResource LOCPlayAch_NoUnlockedAchievements}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=HasUnlocked}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                            <Setter Property="Visibility" Value="Visible" />
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </StackPanel>
</local:CompactAchievementControlBase>
