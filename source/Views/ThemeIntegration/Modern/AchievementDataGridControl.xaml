<base:ThemeControlBase x:Class="PlayniteAchievements.Views.ThemeIntegration.Modern.AchievementDataGridControl"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:base="clr-namespace:PlayniteAchievements.Views.ThemeIntegration.Base"
                   xmlns:modern="clr-namespace:PlayniteAchievements.Views.ThemeIntegration.Modern"
                   xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
                   mc:Ignorable="d"
                   d:DesignHeight="300" d:DesignWidth="600">

    <base:ThemeControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </base:ThemeControlBase.Resources>

    <base:ThemeControlBase.Style>
        <Style TargetType="base:ThemeControlBase">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Persisted.EnableAchievementDataGridControl}"
                             Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </base:ThemeControlBase.Style>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Game summary header row, mirroring the View Achievements window's top summary grid. -->
        <controls:GameSummariesGridControl x:Name="SummaryGrid"
                                           Grid.Row="0"
                                           ItemsSource="{Binding SummaryItems, RelativeSource={RelativeSource AncestorType=modern:AchievementDataGridControl}}"
                                           ColumnSettingsKey="DesktopThemeGameSummaries"
                                           UseCoverImages="{Binding DataContext.Persisted.DesktopThemeGameSummariesUseCoverImages, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                                           ShowMetadataPlatform="{Binding DataContext.Persisted.DesktopThemeGameSummariesShowMetadataPlatform, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                                           ShowMetadataPlaytime="{Binding DataContext.Persisted.DesktopThemeGameSummariesShowMetadataPlaytime, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                                           ShowMetadataRegion="{Binding DataContext.Persisted.DesktopThemeGameSummariesShowMetadataRegion, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                                           ShowCompletionGlow="{Binding DataContext.Persisted.DesktopThemeGameSummariesShowCompletionGlow, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                                           ShowColumnHeaders="{Binding DataContext.Persisted.ShowDesktopThemeGameSummariesGridColumnHeaders, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                                           FixedRowHeight="{Binding DataContext.Persisted.DesktopThemeGameSummariesGridRowHeight, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                                           DelayInitialRenderUntilNormalized="True"
                                           DisableRowSelection="True"
                                           RowPreviewMouseRightButtonDown="SummaryGrid_RowPreviewMouseRightButtonDown"
                                           RowPreviewMouseRightButtonUp="SummaryGrid_RowPreviewMouseRightButtonUp">
            <controls:GameSummariesGridControl.Style>
                <Style TargetType="controls:GameSummariesGridControl">
                    <Setter Property="Margin" Value="0,0,0,8"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSummaryItem, RelativeSource={RelativeSource AncestorType=modern:AchievementDataGridControl}}"
                                     Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:GameSummariesGridControl.Style>
        </controls:GameSummariesGridControl>

        <!-- Breadcrumb, shown only once a category is selected. The game name is the clickable
             back link (matching the other surfaces' breadcrumb headers); the category itself is
             plain text since it's the current location, not a navigation target. -->
        <controls:FlexibleRowPanel Grid.Row="1"
                    Margin="0,0,0,8"
                    Visibility="{Binding IsCategorySelected, RelativeSource={RelativeSource AncestorType=modern:AchievementDataGridControl}, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding GameName, RelativeSource={RelativeSource AncestorType=modern:AchievementDataGridControl}}"
                       Style="{StaticResource PlayAch.TextBlock.BreadcrumbRootStyle}"
                       Tag="True"
                       MouseLeftButtonUp="GameNameBreadcrumb_Click"/>
            <TextBlock Text=" > "
                       Style="{StaticResource PlayAch.TextBlock.HeaderSubtleStyle}"/>
            <ItemsControl ItemsSource="{Binding DrilledCategorySegments, ElementName=AchievementsGrid}"
                          ItemTemplate="{StaticResource PlayAch.CategoryPathSegmentTemplate}"
                          VerticalAlignment="Center"
                          controls:FlexibleRowPanel.Fill="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:CategoryPathPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </controls:FlexibleRowPanel>

        <controls:AchievementDataGridControl x:Name="AchievementsGrid"
                                             Grid.Row="2"
                                             ItemsSource="{Binding DisplayItems, Mode=OneWay, RelativeSource={RelativeSource AncestorType=modern:AchievementDataGridControl}}"
                                             ColumnSettingsKey="DesktopTheme"
                                             EnableCategoryMode="True"
                                             HideCategorySummaryRow="{Binding DataContext.Persisted.DesktopThemeAchievementGridHideCategorySummaryRow, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                                             DrilledCategory="{Binding SelectedCategoryName, Mode=OneWayToSource, RelativeSource={RelativeSource AncestorType=modern:AchievementDataGridControl}}"
                                             CategoryUseCoverImages="{Binding DataContext.Persisted.DesktopThemeCategorySummariesUseCoverImages, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                                             CategoryShowCompletionGlow="{Binding DataContext.Persisted.DesktopThemeCategorySummariesShowCompletionGlow, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                                             CategoryShowColumnHeaders="{Binding DataContext.Persisted.ShowDesktopThemeCategorySummariesGridColumnHeaders, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                                             CategoryFixedRowHeight="{Binding DataContext.Persisted.DesktopThemeCategorySummariesGridRowHeight, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                                             CategoryColumnSettingsKey="DesktopThemeCategorySummaries"
                                             ControlBar="{Binding ControlBar, RelativeSource={RelativeSource AncestorType=modern:AchievementDataGridControl}}"
                                             ShowControlBar="{Binding DataContext.Persisted.ShowDesktopThemeAchievementGridControlBar, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                                             ShowRarityGlow="{Binding DataContext.Persisted.DesktopThemeAchievementGridShowRarityGlow, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                                             ColorRarityColumnsByRarity="{Binding DataContext.Persisted.DesktopThemeAchievementGridColorRarityColumnsByRarity, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                                             ShowColumnHeaders="{Binding DataContext.Persisted.ShowDesktopThemeAchievementGridColumnHeaders, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                                             FixedRowHeight="{Binding DataContext.Persisted.DesktopThemeAchievementGridRowHeight, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                                             UseExternalSorting="True"
                                             Sorting="AchievementsGrid_Sorting"
                                             RowPreviewMouseRightButtonDown="AchievementsGrid_RowPreviewMouseRightButtonDown"
                                             RowPreviewMouseRightButtonUp="AchievementsGrid_RowPreviewMouseRightButtonUp"/>
    </Grid>
</base:ThemeControlBase>


