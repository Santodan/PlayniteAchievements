<base:ThemeControlBase x:Class="PlayniteAchievements.Views.ThemeIntegration.Modern.AchievementStatsControl"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:base="clr-namespace:PlayniteAchievements.Views.ThemeIntegration.Base"
                   mc:Ignorable="d"
                   d:DesignHeight="150" d:DesignWidth="300">

    <base:ThemeControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/RarityBadges.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </base:ThemeControlBase.Resources>

    <base:ThemeControlBase.Style>
        <Style TargetType="base:ThemeControlBase">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Persisted.EnableAchievementStatsControl}"
                             Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </base:ThemeControlBase.Style>

    <StackPanel>
        <!-- UltraRare Row -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Source="{DynamicResource BadgeRarityUltraRare}"
                   Width="18" Height="18"
                   Effect="{StaticResource BadgeShadow}"
                   Style="{StaticResource RarityIcon}"
                   VerticalAlignment="Center"
                   Margin="{StaticResource PlayAch.Thickness.Right.Sm}"/>
            <TextBlock Grid.Column="1"
                       Text="{DynamicResource LOCPlayAch_Rarity_UltraRare}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2"
                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                       VerticalAlignment="Center">
                <Run Text="{Binding UltraRare.Unlocked, Mode=OneWay, StringFormat={}{0:N0}}"/>
                <Run Text="/"/>
                <Run Text="{Binding UltraRare.Total, Mode=OneWay, StringFormat={}{0:N0}}"/>
            </TextBlock>
        </Grid>

        <!-- Rare Row -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Source="{DynamicResource BadgeRarityRare}"
                   Width="18" Height="18"
                   Effect="{StaticResource BadgeShadow}"
                   Style="{StaticResource RarityIcon}"
                   VerticalAlignment="Center"
                   Margin="{StaticResource PlayAch.Thickness.Right.Sm}"/>
            <TextBlock Grid.Column="1"
                       Text="{DynamicResource LOCPlayAch_Rarity_Rare}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2"
                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                       VerticalAlignment="Center">
                <Run Text="{Binding Rare.Unlocked, Mode=OneWay, StringFormat={}{0:N0}}"/>
                <Run Text="/"/>
                <Run Text="{Binding Rare.Total, Mode=OneWay, StringFormat={}{0:N0}}"/>
            </TextBlock>
        </Grid>

        <!-- Uncommon Row -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Source="{DynamicResource BadgeRarityUncommon}"
                   Width="18" Height="18"
                   Effect="{StaticResource BadgeShadow}"
                   Style="{StaticResource RarityIcon}"
                   VerticalAlignment="Center"
                   Margin="{StaticResource PlayAch.Thickness.Right.Sm}"/>
            <TextBlock Grid.Column="1"
                       Text="{DynamicResource LOCPlayAch_Rarity_Uncommon}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2"
                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                       VerticalAlignment="Center">
                <Run Text="{Binding Uncommon.Unlocked, Mode=OneWay, StringFormat={}{0:N0}}"/>
                <Run Text="/"/>
                <Run Text="{Binding Uncommon.Total, Mode=OneWay, StringFormat={}{0:N0}}"/>
            </TextBlock>
        </Grid>

        <!-- Common Row -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Source="{DynamicResource BadgeRarityCommon}"
                   Width="18" Height="18"
                   Effect="{StaticResource BadgeShadow}"
                   Style="{StaticResource RarityIcon}"
                   VerticalAlignment="Center"
                   Margin="{StaticResource PlayAch.Thickness.Right.Sm}"/>
            <TextBlock Grid.Column="1"
                       Text="{DynamicResource LOCPlayAch_Rarity_Common}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2"
                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                       VerticalAlignment="Center">
                <Run Text="{Binding Common.Unlocked, Mode=OneWay, StringFormat={}{0:N0}}"/>
                <Run Text="/"/>
                <Run Text="{Binding Common.Total, Mode=OneWay, StringFormat={}{0:N0}}"/>
            </TextBlock>
        </Grid>

        <!-- One row per tag the game's achievements carry -->
        <ItemsControl ItemsSource="{Binding TagStats}"
                      Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Icon, Mode=OneWay}"
                                   FontFamily="{DynamicResource PlayAch.FontFamily.Icon}"
                                   FontSize="14"
                                   Width="18"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource PlayAch.Thickness.Right.Sm}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasColor}" Value="True">
                                            <Setter Property="Foreground" Value="{Binding Color}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name, Mode=OneWay}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   VerticalAlignment="Center">
                            <Run Text="{Binding Unlocked, Mode=OneWay, StringFormat={}{0:N0}}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding Total, Mode=OneWay, StringFormat={}{0:N0}}"/>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</base:ThemeControlBase>

