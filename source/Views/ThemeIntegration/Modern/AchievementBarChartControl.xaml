<base:ThemeControlBase x:Class="PlayniteAchievements.Views.ThemeIntegration.Modern.AchievementBarChartControl"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
                   xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
                   xmlns:converters="clr-namespace:PlayniteAchievements.Views.Converters"
                   xmlns:base="clr-namespace:PlayniteAchievements.Views.ThemeIntegration.Base"
                   mc:Ignorable="d"
                   d:DesignHeight="200" d:DesignWidth="300"
                   MinHeight="{Binding RelativeSource={RelativeSource AncestorType=ContentControl}, Path=MinHeight, FallbackValue=200}"
                   Height="200"
                   MaxHeight="{Binding RelativeSource={RelativeSource AncestorType=ContentControl}, Path=MaxHeight}">

    <base:ThemeControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/AchievementResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Shadows the plugin-branded chip style from AchievementControlStyles.xaml so the
                 range selectors use the active Playnite theme's ToggleButton chrome. -->
            <Style x:Key="TimeRangeButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
                <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Caption}"/>
            </Style>
        </ResourceDictionary>
    </base:ThemeControlBase.Resources>

    <base:ThemeControlBase.Style>
        <Style TargetType="base:ThemeControlBase">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Persisted.EnableAchievementBarChartControl}"
                             Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </base:ThemeControlBase.Style>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Time range toggle buttons -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}">
            <RadioButton Content="{DynamicResource LOCPlayAch_TimeRange_7D}"
                         GroupName="DesktopTimeRange"
                         Style="{StaticResource TimeRangeButtonStyle}"
                         IsChecked="{Binding TimelineViewModel.TimelineRange, Converter={StaticResource EnumToBool}, ConverterParameter=SevenDays, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                         Command="{Binding TimelineViewModel.SetTimeRangeCommand, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                         CommandParameter="SevenDays"/>
            <RadioButton Content="{DynamicResource LOCPlayAch_TimeRange_1M}"
                         GroupName="DesktopTimeRange"
                         Style="{StaticResource TimeRangeButtonStyle}"
                         IsChecked="{Binding TimelineViewModel.TimelineRange, Converter={StaticResource EnumToBool}, ConverterParameter=OneMonth, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                         Command="{Binding TimelineViewModel.SetTimeRangeCommand, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                         CommandParameter="OneMonth"/>
            <RadioButton Content="{DynamicResource LOCPlayAch_TimeRange_3M}"
                         GroupName="DesktopTimeRange"
                         Style="{StaticResource TimeRangeButtonStyle}"
                         IsChecked="{Binding TimelineViewModel.TimelineRange, Converter={StaticResource EnumToBool}, ConverterParameter=ThreeMonths, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                         Command="{Binding TimelineViewModel.SetTimeRangeCommand, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                         CommandParameter="ThreeMonths"/>
            <RadioButton Content="{DynamicResource LOCPlayAch_TimeRange_6M}"
                         GroupName="DesktopTimeRange"
                         Style="{StaticResource TimeRangeButtonStyle}"
                         IsChecked="{Binding TimelineViewModel.TimelineRange, Converter={StaticResource EnumToBool}, ConverterParameter=SixMonths, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                         Command="{Binding TimelineViewModel.SetTimeRangeCommand, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                         CommandParameter="SixMonths"/>
            <RadioButton Content="{DynamicResource LOCPlayAch_TimeRange_1Y}"
                         GroupName="DesktopTimeRange"
                         Style="{StaticResource TimeRangeButtonStyle}"
                         IsChecked="{Binding TimelineViewModel.TimelineRange, Converter={StaticResource EnumToBool}, ConverterParameter=OneYear, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                         Command="{Binding TimelineViewModel.SetTimeRangeCommand, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                         CommandParameter="OneYear"/>
            <RadioButton Content="{DynamicResource LOCPlayAch_Common_All}"
                         GroupName="DesktopTimeRange"
                         Style="{StaticResource TimeRangeButtonStyle}"
                         IsChecked="{Binding TimelineViewModel.TimelineRange, Converter={StaticResource EnumToBool}, ConverterParameter=All, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                         Command="{Binding TimelineViewModel.SetTimeRangeCommand, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                         CommandParameter="All"/>
        </StackPanel>

        <!-- Shared unlocks-over-time chart. Theme-facing: the tooltip takes Playnite's own popup
             and text keys, which themes restyle. -->
        <controls:UnlockTimelineChart Grid.Row="1"
                                      Series="{Binding TimelineViewModel.TimelineSeries, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                                      Labels="{Binding TimelineViewModel.TimelineLabels, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                                      TooltipLabels="{Binding TimelineViewModel.TooltipLabels, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                                      XAxisMax="{Binding TimelineViewModel.XAxisMax, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                                      YAxisMax="{Binding TimelineViewModel.YAxisMax, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                                      YAxisStep="{Binding TimelineViewModel.YAxisStep, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                                      YLabelFormatter="{Binding TimelineViewModel.YAxisFormatter, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                                      IsEmpty="{Binding TimelineViewModel.IsEmpty, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                                      MaxTickCount="{Binding TimelineViewModel.MaxTickCount, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}, Mode=OneWayToSource}"
                                      MaxBarCount="{Binding TimelineViewModel.MaxBarCount, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}, Mode=OneWayToSource}"
                                      RenderRevision="{Binding TimelineViewModel.RenderRevision, RelativeSource={RelativeSource AncestorType=base:ThemeControlBase}}"
                                      TooltipSurfaceBrush="{DynamicResource PopupBackgroundBrush}"
                                      TooltipOutlineBrush="{DynamicResource PopupBorderBrush}"
                                      TooltipForeground="{DynamicResource TextBrush}"/>
    </Grid>
</base:ThemeControlBase>

