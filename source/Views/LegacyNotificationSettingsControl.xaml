                                                   Margin="0,0,0,8"/>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Sound:"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0"
                                                     Foreground="{DynamicResource TextBrush}"
                                                     FontWeight="SemiBold"/>
                                            <ComboBox x:Name="NotificationsBundledUnlockSoundComboBox"
                                                    MinWidth="240"
                                                    SelectionChanged="NotificationsBundledUnlockSoundComboBox_SelectionChanged"
                                                    DisplayMemberPath="DisplayName"/>
                                        </DockPanel>

                                        <DockPanel Margin="0,0,0,4" LastChildFill="False">
                                            <Button Content="Add File"
                                                Width="90"
                                                Click="NotificationsAddSoundFile_Click"/>
                                            <Button Content="Add Folder"
                                                Width="100"
                                                Margin="8,0,0,0"
                                                Click="NotificationsAddSoundFolder_Click"/>
                                            <Button x:Name="NotificationsRemoveSoundButton"
                                                Content="Remove"
                                                Width="90"
                                                Margin="8,0,0,0"
                                                Click="NotificationsRemoveSound_Click"/>
                                        </DockPanel>

                                        <DockPanel Margin="0,0,0,4">
                                            <Button x:Name="NotificationsTestUnlockSoundButton"
                                                Content="Test Notification"
                                                Width="130"
                                                    Padding="12,6"
                                                    Click="NotificationsTestUnlockSoundButton_Click"/>
                                            <TextBlock x:Name="NotificationsUnlockSoundStatusTextBlock"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource MutedTextStyle}"/>
                                        </DockPanel>

                                        <DockPanel Margin="0,0,0,4" LastChildFill="False">
                                            <TextBlock Text="Sound lead (ms):"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontWeight="SemiBold"/>
                                            <TextBox x:Name="NotificationsUnlockSoundLeadMillisecondsTextBox"
                                                     Width="90"
                                                     VerticalContentAlignment="Center"
                                                     TextChanged="NotificationsUnlockSoundLeadMillisecondsTextBox_TextChanged"
                                                     LostFocus="NotificationsUnlockSoundLeadMillisecondsTextBox_LostFocus"/>
                                        </DockPanel>

                                        <TextBlock Text="Positive values start the sound before the overlay. Negative values show the overlay first and delay the sound."
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="0,0,0,8"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Text="Steam is the default sound and cannot be removed. Use Add File or Add Folder to include more .wav sounds, then pick one from the Sound list."
                                                   Style="{StaticResource MutedTextStyle}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Separator Margin="0,16,0,16"/>

                                <!-- Collection / Prestige progress notifications -->
                                <Border Style="{StaticResource SettingGroupCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Score Progress Notifications" Style="{StaticResource SubSectionHeaderStyle}" Margin="0,0,0,6"/>
                                        <TextBlock Text="Reuse a saved custom-style slot when your Collection or Prestige score reaches a new level or tier. Tier notifications take priority when both happen together."
                                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                        <GroupBox Header="Collection Score" Margin="0,0,0,8">
                                            <StackPanel Margin="8">
                                                <WrapPanel Margin="0,0,0,6">
                                                    <CheckBox Content="Notify on level up" IsChecked="{Binding CollectionProgressNotifications.NotifyLevelUp, Mode=TwoWay}" Margin="0,0,18,0"/>
                                                    <CheckBox Content="Notify on tier up" IsChecked="{Binding CollectionProgressNotifications.NotifyTierUp, Mode=TwoWay}"/>
                                                </WrapPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock Text="Saved style:" Width="90" VerticalAlignment="Center"/>
                                                    <ComboBox ItemsSource="{Binding CustomOverlayStyleSlots}" DisplayMemberPath="Name" SelectedIndex="{Binding CollectionProgressNotifications.CustomStyleSlotIndex, Mode=TwoWay}" MinWidth="220"/>
                                                </DockPanel>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock Text="Sound:" Width="90" VerticalAlignment="Center"/>
                                                    <ComboBox x:Name="CollectionProgressSoundComboBox" Width="240" DisplayMemberPath="DisplayName"
                                                              SelectedValuePath="SoundPath" SelectedValue="{Binding CollectionProgressNotifications.SoundPath, Mode=TwoWay}"/>
                                                    <Button Content="Browse" Tag="Collection" Width="72" Margin="8,0,0,0" Click="ScoreProgressSoundBrowse_Click"/>
                                                    <TextBlock Text="Lead (ms):" Margin="12,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBox Width="70" Text="{Binding CollectionProgressNotifications.SoundLeadMilliseconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                                    <Button Content="Test" Tag="Collection" Width="58" Margin="8,0,0,0" Click="ScoreProgressNotificationTest_Click"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </GroupBox>

                                        <GroupBox Header="Prestige Score">
                                            <StackPanel Margin="8">
                                                <WrapPanel Margin="0,0,0,6">
                                                    <CheckBox Content="Notify on level up" IsChecked="{Binding PrestigeProgressNotifications.NotifyLevelUp, Mode=TwoWay}" Margin="0,0,18,0"/>
                                                    <CheckBox Content="Notify on tier up" IsChecked="{Binding PrestigeProgressNotifications.NotifyTierUp, Mode=TwoWay}"/>
                                                </WrapPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock Text="Saved style:" Width="90" VerticalAlignment="Center"/>
                                                    <ComboBox ItemsSource="{Binding CustomOverlayStyleSlots}" DisplayMemberPath="Name" SelectedIndex="{Binding PrestigeProgressNotifications.CustomStyleSlotIndex, Mode=TwoWay}" MinWidth="220"/>
                                                </DockPanel>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock Text="Sound:" Width="90" VerticalAlignment="Center"/>
                                                    <ComboBox x:Name="PrestigeProgressSoundComboBox" Width="240" DisplayMemberPath="DisplayName"
                                                              SelectedValuePath="SoundPath" SelectedValue="{Binding PrestigeProgressNotifications.SoundPath, Mode=TwoWay}"/>
                                                    <Button Content="Browse" Tag="Prestige" Width="72" Margin="8,0,0,0" Click="ScoreProgressSoundBrowse_Click"/>
                                                    <TextBlock Text="Lead (ms):" Margin="12,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBox Width="70" Text="{Binding PrestigeProgressNotifications.SoundLeadMilliseconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                                    <Button Content="Test" Tag="Prestige" Width="58" Margin="8,0,0,0" Click="ScoreProgressNotificationTest_Click"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer Grid.Column="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsSelected, ElementName=AchievementNotificationsMemoriesNavigationItem, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="20">
                            <Border Style="{StaticResource SectionBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Memories"
                                               Style="{StaticResource SectionHeaderStyle}"
                                               Margin="0,0,0,12"/>
                                    <TextBlock Text="Capture screenshots and video clips when achievements are unlocked."
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="0,0,0,16"
                                               TextWrapping="Wrap"/>

                                <!-- Screenshots -->
                                <Border Style="{StaticResource SettingGroupCardStyle}">
                                    <StackPanel>
                                        <CheckBox Content="Save a screenshot when a new achievement is detected"
                                                  IsChecked="{Binding EnableUnlockScreenshots, Mode=TwoWay}"
                                                  Margin="0,0,0,12"/>

                                        <StackPanel Margin="18,0,0,0"
                                                    IsEnabled="{Binding EnableUnlockScreenshots}">
                                            <CheckBox Content="Clean"
                                                      IsChecked="{Binding ScreenshotClean, Mode=TwoWay}"
                                                      Margin="0,0,0,4"/>
                                            <StackPanel Margin="18,0,0,10"
                                                        IsEnabled="{Binding ScreenshotClean}">
                                                <StackPanel Margin="0,0,0,6">
                                                    <TextBlock Text="Capture rarities:" Margin="0,0,0,4"/>
                                                    <WrapPanel x:Name="NotificationsScreenshotCleanRaritiesPanel">
                                                        <CheckBox Content="Common" Tag="Common" Checked="NotificationsScreenshotRarity_Checked" Unchecked="NotificationsScreenshotRarity_Checked" Margin="0,0,12,4"/>
                                                        <CheckBox Content="Uncommon" Tag="Uncommon" Checked="NotificationsScreenshotRarity_Checked" Unchecked="NotificationsScreenshotRarity_Checked" Margin="0,0,12,4"/>
                                                        <CheckBox Content="Rare" Tag="Rare" Checked="NotificationsScreenshotRarity_Checked" Unchecked="NotificationsScreenshotRarity_Checked" Margin="0,0,12,4"/>
                                                        <CheckBox Content="Ultra rare" Tag="UltraRare" Checked="NotificationsScreenshotRarity_Checked" Unchecked="NotificationsScreenshotRarity_Checked" Margin="0,0,12,4"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <CheckBox Content="Always capture game completion"
                                                          IsChecked="{Binding ScreenshotCleanAlwaysCaptureCompletion, Mode=TwoWay}"/>
                                            </StackPanel>

                                            <CheckBox Content="With notification"
                                                      IsChecked="{Binding ScreenshotWithNotification, Mode=TwoWay}"
                                                      Margin="0,0,0,4"/>
                                            <StackPanel Margin="18,0,0,10"
                                                        IsEnabled="{Binding ScreenshotWithNotification}">
                                                <StackPanel Margin="0,0,0,6">
                                                    <TextBlock Text="Capture rarities:" Margin="0,0,0,4"/>
                                                    <WrapPanel x:Name="NotificationsScreenshotWithToastRaritiesPanel">
                                                        <CheckBox Content="Common" Tag="Common" Checked="NotificationsScreenshotRarity_Checked" Unchecked="NotificationsScreenshotRarity_Checked" Margin="0,0,12,4"/>
                                                        <CheckBox Content="Uncommon" Tag="Uncommon" Checked="NotificationsScreenshotRarity_Checked" Unchecked="NotificationsScreenshotRarity_Checked" Margin="0,0,12,4"/>
                                                        <CheckBox Content="Rare" Tag="Rare" Checked="NotificationsScreenshotRarity_Checked" Unchecked="NotificationsScreenshotRarity_Checked" Margin="0,0,12,4"/>
                                                        <CheckBox Content="Ultra rare" Tag="UltraRare" Checked="NotificationsScreenshotRarity_Checked" Unchecked="NotificationsScreenshotRarity_Checked" Margin="0,0,12,4"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <CheckBox Content="Always capture game completion"
                                                          IsChecked="{Binding ScreenshotWithNotificationAlwaysCaptureCompletion, Mode=TwoWay}"/>
                                            </StackPanel>

                                            <CheckBox Content="Framed"
                                                      IsChecked="{Binding ScreenshotFramed, Mode=TwoWay}"
                                                      Margin="0,0,0,4"/>
                                            <StackPanel Margin="18,0,0,10"
                                                        IsEnabled="{Binding ScreenshotFramed}">
                                                <StackPanel Margin="0,0,0,6">
                                                    <TextBlock Text="Capture rarities:" Margin="0,0,0,4"/>
                                                    <WrapPanel x:Name="NotificationsScreenshotFramedRaritiesPanel">
                                                        <CheckBox Content="Common" Tag="Common" Checked="NotificationsScreenshotRarity_Checked" Unchecked="NotificationsScreenshotRarity_Checked" Margin="0,0,12,4"/>
                                                        <CheckBox Content="Uncommon" Tag="Uncommon" Checked="NotificationsScreenshotRarity_Checked" Unchecked="NotificationsScreenshotRarity_Checked" Margin="0,0,12,4"/>
                                                        <CheckBox Content="Rare" Tag="Rare" Checked="NotificationsScreenshotRarity_Checked" Unchecked="NotificationsScreenshotRarity_Checked" Margin="0,0,12,4"/>
                                                        <CheckBox Content="Ultra rare" Tag="UltraRare" Checked="NotificationsScreenshotRarity_Checked" Unchecked="NotificationsScreenshotRarity_Checked" Margin="0,0,12,4"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <CheckBox Content="Always capture game completion"
                                                          IsChecked="{Binding ScreenshotFramedAlwaysCaptureCompletion, Mode=TwoWay}"/>
                                            </StackPanel>

                                            <TextBlock Text="Filename suffixes" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <Grid Margin="18,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="160"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="Clean" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                                                         Text="{Binding ScreenshotSuffixClean, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Grid.Row="1" Text="With notification" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"
                                                         Text="{Binding ScreenshotSuffixWithNotification, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Grid.Row="2" Text="Framed" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,6"
                                                         Text="{Binding ScreenshotSuffixFramed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>

                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="Save folder:"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontWeight="SemiBold"/>
                                                <Button Content="{DynamicResource LOCPlayAch_Button_Browse}"
                                                        Width="90"
                                                        DockPanel.Dock="Right"
                                                        Margin="8,0,0,0"
                                                        Click="NotificationsScreenshotSaveFolder_Click"/>
                                                <TextBox x:Name="NotificationsScreenshotSaveFolderTextBox"
                                                         Text="{Binding ScreenshotSaveFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center"
                                                         SelectionChanged="ScreenshotTemplate_SelectionChanged"
                                                         ToolTip="Leave empty to use the default Pictures\PlayniteAchievements\UnlockScreenshots folder. Wildcards are supported."/>
                                            </DockPanel>

                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="Filename template:"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontWeight="SemiBold"/>
                                                <TextBox x:Name="NotificationsScreenshotFilenameTemplateTextBox"
                                                         Text="{Binding ScreenshotFilenameTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center"
                                                         SelectionChanged="ScreenshotTemplate_SelectionChanged"
                                                         ToolTip="Supported tokens: &lt;gameName&gt; &lt;achievementName&gt; &lt;date&gt; &lt;time&gt; &lt;dateTime&gt; &lt;source&gt; &lt;provider&gt; &lt;gameId&gt; &lt;unlockIndex&gt; &lt;unlockCount&gt;. PNG is added automatically."/>
                                            </DockPanel>

                                            <StackPanel Margin="0,0,0,6">
                                                <TextBlock Text="Click a wildcard to insert it at the cursor in the selected folder or filename field."
                                                           Style="{StaticResource MutedTextStyle}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,6"/>
                                                <WrapPanel>
                                                    <Button Content="&lt;gameName&gt;" Tag="&lt;gameName&gt;" Click="ScreenshotFilenameToken_Click" Margin="0,0,6,6"/>
                                                    <Button Content="&lt;achievementName&gt;" Tag="&lt;achievementName&gt;" Click="ScreenshotFilenameToken_Click" Margin="0,0,6,6"/>
                                                    <Button Content="&lt;date&gt;" Tag="&lt;date&gt;" Click="ScreenshotFilenameToken_Click" Margin="0,0,6,6"/>
                                                    <Button Content="&lt;time&gt;" Tag="&lt;time&gt;" Click="ScreenshotFilenameToken_Click" Margin="0,0,6,6"/>
                                                    <Button Content="&lt;dateTime&gt;" Tag="&lt;dateTime&gt;" Click="ScreenshotFilenameToken_Click" Margin="0,0,6,6"/>
                                                    <Button Content="&lt;source&gt;" Tag="&lt;source&gt;" Click="ScreenshotFilenameToken_Click" Margin="0,0,6,6"/>
                                                    <Button Content="&lt;provider&gt;" Tag="&lt;provider&gt;" Click="ScreenshotFilenameToken_Click" Margin="0,0,6,6"/>
                                                    <Button Content="&lt;gameId&gt;" Tag="&lt;gameId&gt;" Click="ScreenshotFilenameToken_Click" Margin="0,0,6,6"/>
                                                    <Button Content="&lt;unlockIndex&gt;" Tag="&lt;unlockIndex&gt;" Click="ScreenshotFilenameToken_Click" Margin="0,0,6,6"/>
                                                    <Button Content="&lt;unlockCount&gt;" Tag="&lt;unlockCount&gt;" Click="ScreenshotFilenameToken_Click" Margin="0,0,6,6"/>
                                                </WrapPanel>
                                            </StackPanel>

                                            <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                                <TextBlock Text="Capture delay (ms):"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           FontWeight="SemiBold"/>
                                                <TextBox Width="90"
                                                         VerticalContentAlignment="Center"
                                                         Text="{Binding ScreenshotDelayMilliseconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                            </DockPanel>

                                            <TextBlock Text="Uses the same game-window capture, notification compositing, frame compositing, rarity filters, and PNG output as the extension's standard screenshot feature. The folder and filename fields additionally support wildcards."
                                                       Style="{StaticResource MutedTextStyle}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Separator Margin="0,16,0,16"/>

                                <Border Style="{StaticResource SettingGroupCardStyle}">
                                    <StackPanel>
                                        <CheckBox Content="Save a video clip when an achievement is detected"
                                                  IsChecked="{Binding EnableUnlockRecordings, Mode=TwoWay}"
                                                  Margin="0,0,0,12"/>
                                        <StackPanel Margin="18,0,0,0" IsEnabled="{Binding EnableUnlockRecordings}">
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="Capture rarities:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <WrapPanel>
                                                    <CheckBox Content="Common" IsChecked="{Binding RecordingCaptureCommon, Mode=TwoWay}" Margin="0,0,12,4"/>
                                                    <CheckBox Content="Uncommon" IsChecked="{Binding RecordingCaptureUncommon, Mode=TwoWay}" Margin="0,0,12,4"/>
                                                    <CheckBox Content="Rare" IsChecked="{Binding RecordingCaptureRare, Mode=TwoWay}" Margin="0,0,12,4"/>
                                                    <CheckBox Content="Ultra rare" IsChecked="{Binding RecordingCaptureUltraRare, Mode=TwoWay}" Margin="0,0,12,4"/>
                                                </WrapPanel>
                                                <CheckBox Content="Always capture game completion" IsChecked="{Binding RecordingAlwaysCaptureCompletion, Mode=TwoWay}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="Save folder:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                                                <Button Content="{DynamicResource LOCPlayAch_Button_Browse}" Width="90" DockPanel.Dock="Right"
                                                        Margin="8,0,0,0" Click="NotificationsRecordingSaveFolder_Click"/>
                                                <TextBox x:Name="NotificationsRecordingSaveFolderTextBox"
                                                         Text="{Binding RecordingSaveFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         SelectionChanged="ScreenshotTemplate_SelectionChanged"
                                                         ToolTip="Wildcards are supported. Empty uses the screenshot folder."/>
                                            </DockPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="Filename template:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                                                <TextBox x:Name="NotificationsRecordingFilenameTemplateTextBox"
                                                         Text="{Binding RecordingFilenameTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         SelectionChanged="ScreenshotTemplate_SelectionChanged"/>
                                            </DockPanel>
                                            <WrapPanel Margin="0,0,0,6">
                                                <Button Content="&lt;gameName&gt;" Tag="&lt;gameName&gt;" Click="ScreenshotFilenameToken_Click" Margin="0,0,6,6"/>
                                                <Button Content="&lt;achievementName&gt;" Tag="&lt;achievementName&gt;" Click="ScreenshotFilenameToken_Click" Margin="0,0,6,6"/>
                                                <Button Content="&lt;date&gt;" Tag="&lt;date&gt;" Click="ScreenshotFilenameToken_Click" Margin="0,0,6,6"/>
                                                <Button Content="&lt;time&gt;" Tag="&lt;time&gt;" Click="ScreenshotFilenameToken_Click" Margin="0,0,6,6"/>
                                                <Button Content="&lt;dateTime&gt;" Tag="&lt;dateTime&gt;" Click="ScreenshotFilenameToken_Click" Margin="0,0,6,6"/>
                                                <Button Content="&lt;source&gt;" Tag="&lt;source&gt;" Click="ScreenshotFilenameToken_Click" Margin="0,0,6,6"/>
                                                <Button Content="&lt;provider&gt;" Tag="&lt;provider&gt;" Click="ScreenshotFilenameToken_Click" Margin="0,0,6,6"/>
                                                <Button Content="&lt;gameId&gt;" Tag="&lt;gameId&gt;" Click="ScreenshotFilenameToken_Click" Margin="0,0,6,6"/>
                                                <Button Content="&lt;unlockIndex&gt;" Tag="&lt;unlockIndex&gt;" Click="ScreenshotFilenameToken_Click" Margin="0,0,6,6"/>
                                                <Button Content="&lt;unlockCount&gt;" Tag="&lt;unlockCount&gt;" Click="ScreenshotFilenameToken_Click" Margin="0,0,6,6"/>
                                            </WrapPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="Pre-roll length (seconds):" Margin="0,0,8,6"/>
                                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RecordingClipSeconds, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,6"/>
                                                <TextBlock Grid.Row="1" Text="Frames per second:" Margin="0,0,8,6"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RecordingFps, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,6"/>
                                                <TextBlock Grid.Row="2" Text="Resolution:" Margin="0,0,8,6"/>
                                                <ComboBox Grid.Row="2" Grid.Column="1" SelectedValue="{Binding RecordingResolution}" SelectedValuePath="Tag" Margin="0,0,0,6">
                                                    <ComboBoxItem Content="Native" Tag="{x:Static settings:RecordingResolution.Native}"/>
                                                    <ComboBoxItem Content="1080p" Tag="{x:Static settings:RecordingResolution.P1080}"/>
                                                    <ComboBoxItem Content="720p" Tag="{x:Static settings:RecordingResolution.P720}"/>
                                                </ComboBox>
                                            </Grid>
                                            <CheckBox Content="Include system audio"
                                                      IsChecked="{Binding RecordingIncludeAudio, Mode=TwoWay}"
                                                      Margin="0,10,0,0"/>
                                            <StackPanel Margin="18,6,0,0" IsEnabled="{Binding RecordingIncludeAudio}">
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock Text="Audio source:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <ComboBox SelectedValue="{Binding RecordingAudioSource, Mode=TwoWay}" SelectedValuePath="Tag" MinWidth="180">
                                                        <ComboBoxItem Content="Full system" Tag="{x:Static settings:RecordingAudioSource.FullSystem}"/>
                                                        <ComboBoxItem Content="Game only" Tag="{x:Static settings:RecordingAudioSource.GameOnly}"/>
                                                    </ComboBox>
                                                </DockPanel>
                                                <CheckBox Content="Include microphone" IsChecked="{Binding RecordingIncludeMicrophone, Mode=TwoWay}"/>
                                            </StackPanel>
                                            <TextBlock Text="Recording uses Windows Graphics Capture and Media Foundation. Folder and filename wildcards use this custom notification configuration."
                                                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ================== TAB: PROVIDERS ================== -->
            <TabItem x:Name="ProvidersTab" AutomationProperties.Name="{DynamicResource LOCPlayAch_CustomRefresh_ProvidersHeader}">
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderWithIconStyle}">
                        <TextBlock Style="{StaticResource HeaderIconStyle}" Text="&#xef7b;"/>
                        <TextBlock Text="{DynamicResource LOCPlayAch_CustomRefresh_ProvidersHeader}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Background="{DynamicResource PanelBackgroundBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" MinWidth="190" MaxWidth="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BorderBrush="{DynamicResource NormalBorderBrush}"
                            BorderThickness="0,0,1,0"
                            Background="{DynamicResource ControlBackgroundBrush}">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Top"
                                    BorderBrush="{DynamicResource NormalBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="10,10,10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="&#xE721;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="{DynamicResource TextBrush}"
                                               Opacity="0.55"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>

                                    <TextBox Grid.Column="1"
                                             Height="24"
                                             Padding="6,2"
                                             Text="{Binding ProviderSearchText, ElementName=LegacyNotificationSettingsControlRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{DynamicResource LOCPlayAch_Button_Search}"/>
                                </Grid>
                            </Border>

                            <ListBox ItemsSource="{Binding ProviderNavigationItems, ElementName=LegacyNotificationSettingsControlRoot}"
                                     SelectedItem="{Binding SelectedProviderNavigationItem, ElementName=LegacyNotificationSettingsControlRoot, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource ProviderNavigationItemContainerStyle}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Padding="0">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Opacity="0.58"
                                                           Margin="10,10,8,3"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,3"
                                              MinHeight="30">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                            <Setter Property="Opacity" Value="0.55"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Image Width="18"
                                                   Height="18"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Source>
                                                    <MultiBinding Converter="{StaticResource ProviderIconConverter}">
                                                        <Binding Path="ProviderIconKey"/>
                                                        <Binding Path="ProviderColorHex"/>
                                                    </MultiBinding>
                                                </Image.Source>
                                            </Image>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        ToolTip="{Binding Subtitle}">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="{DynamicResource FontSize}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           Opacity="0.6"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <ContentControl Grid.Column="1"
                                    Content="{Binding SelectedProviderNavigationItem.SettingsView, ElementName=LegacyNotificationSettingsControlRoot}"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="ThemeMigrationTab" AutomationProperties.Name="{DynamicResource LOCPlayAch_ThemeMigration_Title}">
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderWithIconStyle}">
                        <TextBlock Style="{StaticResource HeaderIconStyle}" Text="&#xEFD2;"/>
                        <TextBlock Text="{DynamicResource LOCPlayAch_ThemeMigration_Title}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20">

                        <!-- ================== MIGRATION SECTION ================== -->
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCPlayAch_ThemeMigration_Title}"
                                           Style="{StaticResource SectionHeaderStyle}"
                                           Margin="0,0,0,12"/>

                                <TextBlock Text="{DynamicResource LOCPlayAch_ThemeMigration_Description}"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,0,0,16"
                                           TextWrapping="Wrap"/>

                                <!-- Theme Dropdown -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <ComboBox x:Name="LegacyThemeMigrationThemeComboBox"
                                              ItemsSource="{Binding AvailableThemes, ElementName=LegacyNotificationSettingsControlRoot}"
                                              DisplayMemberPath="BestDisplayName"
                                              SelectedValuePath="Path"
                                              SelectedValue="{Binding SelectedThemePath, ElementName=LegacyNotificationSettingsControlRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectionChanged="LegacyThemeMigrationThemeComboBox_SelectionChanged"
                                              VerticalContentAlignment="Center"
                                              IsEnabled="{Binding HasThemesToMigrate, ElementName=LegacyNotificationSettingsControlRoot}"/>
                                </Grid>

                                <CheckBox Content="Automatically migrate new themes"
                                          IsChecked="{Binding Persisted.EnableAutomaticThemeMigration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,8,0,0"
                                          ToolTip="Automatically migrate newly discovered themes and re-migrate themes after they are updated."/>

                                <CheckBox x:Name="LegacyUseScrollableAchievementsCheckBox"
                                          Content="Scrollable achievements"
                                          IsChecked="{Binding UseScrollableAchievementsForThemeMigration, ElementName=LegacyNotificationSettingsControlRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding HasThemesToMigrate, ElementName=LegacyNotificationSettingsControlRoot}"
                                          Margin="0,8,0,0"
                                          ToolTip="Use the modern scrollable compact achievement lists. Leave unchecked to retain the legacy +X layout."/>

                                <CheckBox x:Name="LegacyHighlightLatestAchievementCheckBox"
                                          Content="{DynamicResource LOCPlayAch_ThemeMigration_HighlightLatestAchievement}"
                                          IsChecked="{Binding HighlightLatestAchievementForThemeMigration, ElementName=LegacyNotificationSettingsControlRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding UseScrollableAchievementsForThemeMigration, ElementName=LegacyNotificationSettingsControlRoot}"
                                          Margin="0,8,0,0"
                                          ToolTip="{DynamicResource LOCPlayAch_ThemeMigration_HighlightLatestAchievement_Help}"/>

                                <!-- Migration Buttons -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            x:Name="ThemeMigrationPresetButtons"
                                            Margin="0,12,0,0">
                                    <Button Content="{DynamicResource LOCPlayAch_ThemeMigration_MigrationLimited}"
                                            Click="MigrateThemeLimited_Click"
                                            Padding="14,6"
                                            Margin="0,0,8,0"
                                            MinWidth="100"
                                            IsEnabled="{Binding HasThemesToMigrate, ElementName=LegacyNotificationSettingsControlRoot}"
                                            ToolTipService.ShowOnDisabled="True">
                                        <Button.ToolTip>
                                            <ToolTip>
                                                <TextBlock Text="{DynamicResource LOCPlayAch_ThemeMigration_Description}"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="250"/>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                    <Button Content="{DynamicResource LOCPlayAch_ThemeMigration_MigrationFull}"
                                            x:Name="ThemeMigrationFullButton"
                                            Click="MigrateThemeFull_Click"
                                            Padding="14,6"
                                            MinWidth="100"
                                            IsEnabled="{Binding HasThemesToMigrate, ElementName=LegacyNotificationSettingsControlRoot}"
                                            ToolTipService.ShowOnDisabled="True">
                                        <Button.ToolTip>
                                            <ToolTip>
                                                <TextBlock Text="{DynamicResource LOCPlayAch_ThemeMigration_Description}"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="250"/>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>

                                <Border Background="#12000000"
                                        x:Name="ThemeMigrationCustomContainer"
                                        BorderBrush="{DynamicResource NormalBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,16,0,0"
                                        Padding="0"
                                        IsEnabled="{Binding HasThemesToMigrate, ElementName=LegacyNotificationSettingsControlRoot}">
                                    <Expander x:Name="ThemeMigrationCustomExpander"
                                              IsExpanded="False"
                                              Expanded="ThemeMigrationCustomExpander_Expanded"
                                              Collapsed="ThemeMigrationCustomExpander_Collapsed"
                                              Background="Transparent"
                                              BorderThickness="0">
                                        <Expander.Header>
                                            <TextBlock Text="{DynamicResource LOCPlayAch_ThemeMigration_Custom}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontWeight="SemiBold"
                                                       Margin="-4,8,0,8"/>
                                        </Expander.Header>

                                        <StackPanel Margin="12,0,12,12">
                                            <TextBlock Text="{DynamicResource LOCPlayAch_ThemeMigration_Description}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       HorizontalAlignment="Left"
                                                       Margin="0,0,0,12"
                                                       MaxWidth="520"/>

                                            <Grid Margin="0,0,0,12"
                                                  HorizontalAlignment="Left">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="176"/>
                                                    <ColumnDefinition Width="108"/>
                                                    <ColumnDefinition Width="54"/>
                                                    <ColumnDefinition Width="108"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="1"
                                                        Content="{DynamicResource LOCPlayAch_ThemeMigration_AllLegacy}"
                                                        Click="ThemeMigrationSetAllLegacy_Click"
                                                        Style="{StaticResource MigrationChoiceButtonBaseStyle}"
                                                        Margin="0,0,8,0"/>
                                                <Button Grid.Column="3"
                                                        Content="{DynamicResource LOCPlayAch_ThemeMigration_AllModern}"
                                                        Click="ThemeMigrationSetAllModern_Click"
                                                        Style="{StaticResource MigrationChoiceButtonBaseStyle}"/>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding ThemeMigrationCustomOptions, ElementName=LegacyNotificationSettingsControlRoot}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,10"
                                                              HorizontalAlignment="Left">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="176"/>
                                                                <ColumnDefinition Width="108"/>
                                                                <ColumnDefinition Width="54"/>
                                                                <ColumnDefinition Width="108"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,12,0"/>

                                                            <Button Grid.Column="1"
                                                                    Content="{DynamicResource LOCPlayAch_ThemeMigration_ModeLegacy}"
                                                                    Style="{StaticResource MigrationChoiceLegacyButtonStyle}"
                                                                    Click="ThemeMigrationRowSetLegacy_Click"
                                                                    CommandParameter="{Binding}"
                                                                    Margin="0,0,8,0"/>

                                                            <ToggleButton Grid.Column="2"
                                                                          Style="{StaticResource MigrationSwitchToggleStyle}"
                                                                          IsChecked="{Binding IsModern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                            <Button Grid.Column="3"
                                                                    Content="{DynamicResource LOCPlayAch_ThemeMigration_ModeModern}"
                                                                    Style="{StaticResource MigrationChoiceModernButtonStyle}"
                                                                    Click="ThemeMigrationRowSetModern_Click"
                                                                    CommandParameter="{Binding}"
                                                                    Margin="8,0,0,0"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Button Content="{DynamicResource LOCPlayAch_ThemeMigration_MigrationCustom}"
                                                    Click="MigrateThemeCustom_Click"
                                                    Padding="14,6"
                                                    Margin="0,6,0,0"
                                                    MinWidth="100"
                                                    HorizontalAlignment="Right"
                                                    IsEnabled="{Binding HasThemesToMigrate, ElementName=LegacyNotificationSettingsControlRoot}"/>
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <!-- No themes message -->
                                <TextBlock Text="{DynamicResource LOCPlayAch_ThemeMigration_NoThemesMessage}"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,8,0,0"
                                           Visibility="{Binding ShowNoThemesMessage, ElementName=LegacyNotificationSettingsControlRoot, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>

                        <!-- ================== REVERT SECTION ================== -->
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCPlayAch_ThemeMigration_Revert}"
                                           Style="{StaticResource SectionHeaderStyle}"
                                           Margin="0,0,0,12"/>

                                <!-- Revertable Theme Dropdown and Revert Button -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding RevertableThemes, ElementName=LegacyNotificationSettingsControlRoot}"
                                              DisplayMemberPath="BestDisplayName"
                                              SelectedValuePath="Path"
                                              SelectedValue="{Binding SelectedRevertThemePath, ElementName=LegacyNotificationSettingsControlRoot}"
                                              VerticalContentAlignment="Center"
                                              IsEnabled="{Binding HasRevertableThemes, ElementName=LegacyNotificationSettingsControlRoot}"/>

                                    <Button Grid.Column="1"
                                            Content="{DynamicResource LOCPlayAch_ThemeMigration_RevertButton}"
                                            Click="RevertTheme_Click"
                                            Padding="14,6"
                                            Margin="16,0,0,0"
                                            MinWidth="100"
                                            IsEnabled="{Binding HasRevertableThemes, ElementName=LegacyNotificationSettingsControlRoot}"/>
                                </Grid>

                                <!-- No revertable themes message -->
                                <TextBlock Text="{DynamicResource LOCPlayAch_ThemeMigration_NoRevertableThemes}"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,8,0,0"
                                           Visibility="{Binding ShowNoRevertableThemesMessage, ElementName=LegacyNotificationSettingsControlRoot, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>

                        <!-- ================== STARTPAGE COMPATIBILITY SECTION ================== -->
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCPlayAch_ThemeMigration_StartPageCompatibility_Title}"
                                           Style="{StaticResource SectionHeaderStyle}"
                                           Margin="0,0,0,12"/>

                                <TextBlock Text="{DynamicResource LOCPlayAch_ThemeMigration_StartPageCompatibility_Description}"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,0,0,16"
                                           TextWrapping="Wrap"/>

                                <WrapPanel HorizontalAlignment="Right">
                                    <Button Content="{DynamicResource LOCPlayAch_ThemeMigration_StartPageCompatibility_RevertButton}"
                                            Click="RevertStartPageCompatibility_Click"
                                            Padding="14,6"
                                            Margin="0,0,8,0"
                                            MinWidth="160"
                                            Visibility="{Binding HasStartPageBackup, ElementName=LegacyNotificationSettingsControlRoot, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <Button Content="{DynamicResource LOCPlayAch_ThemeMigration_StartPageCompatibility_ApplyButton}"
                                            Click="ApplyStartPageCompatibility_Click"
                                            Padding="14,6"
                                            Margin="0,0,8,0"
                                            MinWidth="180"
                                            IsEnabled="{Binding HasStartPageInstalled, ElementName=LegacyNotificationSettingsControlRoot}"/>

                                    <Button Content="{DynamicResource LOCPlayAch_ThemeMigration_StartPageCompatibility_RestartPlayniteButton}"
                                            Click="RestartPlaynite_Click"
                                            Padding="14,6"
                                            MinWidth="140"/>
                                </WrapPanel>

                                <TextBlock Text="{DynamicResource LOCPlayAch_ThemeMigration_StartPageCompatibility_NotInstalled}"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,8,0,0"
                                           Visibility="{Binding ShowStartPageNotInstalledMessage, ElementName=LegacyNotificationSettingsControlRoot, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>








