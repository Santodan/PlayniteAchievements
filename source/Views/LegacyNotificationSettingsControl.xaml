                                                Style="{StaticResource PreviewThemeControlStyle}"
                                                ThemeDataOverride="{Binding PreviewThemeData, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ================== PIE CHART PREVIEW SECTION ================== -->
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_PieChartPreview}"
                                               Style="{StaticResource SectionHeaderStyle}"
                                               Margin="0"/>
                                    <CheckBox Grid.Column="1"
                                              Content="{DynamicResource LOCPlayAch_Common_Enabled}"
                                              IsChecked="{Binding Persisted.EnableAchievementPieChartControl}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                                <Border Style="{StaticResource SectionAccentRuleStyle}"/>
                                <Border Style="{StaticResource SettingGroupCardStyle}"
                                        Visibility="{Binding Persisted.EnableAchievementPieChartControl, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="PREVIEW"
                                                   Style="{StaticResource ContextLabelStyle}"/>
                                        <modern:AchievementPieChartControl
                                            Width="260"
                                            Height="260"
                                            Style="{StaticResource PreviewThemeControlStyle}"
                                            ThemeDataOverride="{Binding PreviewThemeData, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ================== BAR CHART PREVIEW SECTION ================== -->
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_BarChartPreview}"
                                               Style="{StaticResource SectionHeaderStyle}"
                                               Margin="0"/>
                                    <CheckBox Grid.Column="1"
                                              Content="{DynamicResource LOCPlayAch_Common_Enabled}"
                                              IsChecked="{Binding Persisted.EnableAchievementBarChartControl}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                                <Border Style="{StaticResource SectionAccentRuleStyle}"/>
                                <Border Style="{StaticResource SettingGroupCardStyle}"
                                        Visibility="{Binding Persisted.EnableAchievementBarChartControl, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="PREVIEW"
                                                   Style="{StaticResource ContextLabelStyle}"/>
                                        <modern:AchievementBarChartControl Width="280" Height="120"
                                            Style="{StaticResource PreviewThemeControlStyle}"
                                            ThemeDataOverride="{Binding PreviewThemeData, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedValue, ElementName=DisplaySectionListBox}" Value="StartPage">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel Margin="20">
                                <Border Style="{StaticResource SectionBorderStyle}"
                                        Background="{DynamicResource PanelBackgroundBrush}"
                                        BorderBrush="{DynamicResource NormalBorderBrush}">
                                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Display_StartPageSection}"
                                               Style="{StaticResource SectionHeaderStyle}"
                                               Margin="0"/>
                                </Border>

                                <Border Style="{StaticResource SectionBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LOCPlayAch_CustomRefresh_ScopeHeader}"
                                                   Style="{StaticResource SectionHeaderStyle}"
                                                   Margin="0,0,0,12"/>
                                        <Border Style="{StaticResource SectionAccentRuleStyle}"/>

                                        <Border Style="{StaticResource SettingGroupCardStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="0"
                                                           Text="{DynamicResource LOCPlayAch_Filter_ActivitySelectorPlaceholder}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,8"/>
                                                <Button x:Name="StartPageActivityScopeSelectionButton"
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Content="{Binding StartPageActivityScopeText, ElementName=LegacyNotificationSettingsControlRoot}"
                                                        Click="StartPageActivityScopeSelectionButton_Click"
                                                        MinWidth="220"
                                                        Height="30"
                                                        Margin="0,0,0,8"
                                                        HorizontalAlignment="Left">
                                                    <Button.ContextMenu>
                                                        <ContextMenu x:Name="StartPageActivityScopeSelectionContextMenu"/>
                                                    </Button.ContextMenu>
                                                </Button>

                                                <TextBlock Grid.Row="1"
                                                           Grid.Column="0"
                                                           Text="{DynamicResource LOCPlayAch_Progress}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0"/>
                                                <Button x:Name="StartPageProgressScopeSelectionButton"
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        Content="{Binding StartPageProgressScopeText, ElementName=LegacyNotificationSettingsControlRoot}"
                                                        Click="StartPageProgressScopeSelectionButton_Click"
                                                        MinWidth="220"
                                                        Height="30"
                                                        HorizontalAlignment="Left">
                                                    <Button.ContextMenu>
                                                        <ContextMenu x:Name="StartPageProgressScopeSelectionContextMenu"/>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Overview_GameSummaries}"
                                                   Style="{StaticResource SectionHeaderStyle}"
                                                   Margin="0,0,0,12"/>
                                        <Border Style="{StaticResource SectionAccentRuleStyle}"/>

                                        <Border Style="{StaticResource SettingGroupCardStyle}">
                                            <StackPanel>
                                                <CheckBox Content="{DynamicResource LOCPlayAch_UseCoverImages}"
                                                          IsChecked="{Binding Persisted.StartPageGameSummariesGrid.UseCoverImages}"
                                                          Margin="0,0,0,8"/>
                                                <CheckBox Content="{DynamicResource LOCPlayAch_Settings_ShowGamePlatformPlaytimeRegion}"
                                                          IsChecked="{Binding Persisted.StartPageGameSummariesGrid.ShowGameMetadata}"
                                                          Margin="0,0,0,8"/>
                                                <CheckBox Content="{DynamicResource LOCPlayAch_Settings_ShowCompletionBorder}"
                                                          IsChecked="{Binding Persisted.StartPageGameSummariesGrid.ShowCompletionBorder}"
                                                          Margin="0,0,0,8"/>
                                                <CheckBox Content="{DynamicResource LOCPlayAch_Settings_ShowGameSummariesGridColumnHeaders}"
                                                          IsChecked="{Binding Persisted.StartPageGameSummariesGrid.ShowColumnHeaders}"
                                                          Margin="0,0,0,12"/>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_GridRowHeight}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBox Text="{Binding Persisted.StartPageGameSummariesGrid.RowHeight, UpdateSourceTrigger=LostFocus, Converter={StaticResource NullableDoubleTextConverter}, ConverterParameter=32}"
                                                             Width="80" Margin="8,0,0,0"/>
                                                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_PixelsAutomaticUnit}"
                                                               VerticalAlignment="Center" Margin="4,0,0,0" Opacity="0.6"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_GridMaxRows}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBox Text="{Binding Persisted.StartPageGameSummariesGrid.MaxRows, UpdateSourceTrigger=LostFocus, Converter={StaticResource NullableIntTextConverter}, ConverterParameter=1}"
                                                             Width="80" Margin="8,0,0,0"/>
                                                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_RowsUnlimitedUnit}"
                                                               VerticalAlignment="Center" Margin="4,0,0,0" Opacity="0.6"/>
                                                </StackPanel>

                                                <TextBlock Text="{DynamicResource LOCPlayAch_Settings_SortBy}"
                                                           Style="{StaticResource SubSectionHeaderStyle}"
                                                           Margin="0,0,0,8"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <ComboBox SelectedValue="{Binding Persisted.StartPageGameSummariesGrid.SortMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              SelectedValuePath="Tag"
                                                              MinWidth="180">
                                                        <ComboBoxItem Content="{DynamicResource LOCPlayAch_Common_LastUnlock}" Tag="{x:Static settings:GameSummariesSortMode.RecentUnlock}"/>
                                                        <ComboBoxItem Content="{DynamicResource LOCPlayAch_Column_LastPlayed}" Tag="{x:Static settings:GameSummariesSortMode.LastPlayed}"/>
                                                        <ComboBoxItem Content="{DynamicResource LOCPlayAch_Column_Total}" Tag="{x:Static settings:GameSummariesSortMode.TotalAchievements}"/>
                                                        <ComboBoxItem Content="{DynamicResource LOCPlayAch_Progress}" Tag="{x:Static settings:GameSummariesSortMode.Progress}"/>
                                                        <ComboBoxItem Content="{DynamicResource LOCPlayAch_Column_Name}" Tag="{x:Static settings:GameSummariesSortMode.Alphabetical}"/>
                                                    </ComboBox>
                                                    <Button ToolTip="{DynamicResource LOCPlayAch_Settings_SortDirection_Tooltip}"
                                                            Margin="4,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Click="ToggleStartPageGameSummariesGridSortDescending">
                                                        <TextBlock FontFamily="{DynamicResource CommonFont}" FontSize="18">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="&#xea65;"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Persisted.StartPageGameSummariesGrid.SortDescending}" Value="True">
                                                                            <Setter Property="Text" Value="&#xea66;"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LOCPlayAch_RecentAchievements}"
                                                   Style="{StaticResource SectionHeaderStyle}"
                                                   Margin="0,0,0,12"/>
                                        <Border Style="{StaticResource SectionAccentRuleStyle}"/>
                                        <Border Style="{StaticResource SettingGroupCardStyle}">
                                            <StackPanel>
                                                <CheckBox Content="{DynamicResource LOCPlayAch_UseCoverImages}"
                                                          IsChecked="{Binding Persisted.StartPageRecentUnlocksGrid.UseCoverImages}"
                                                          Margin="0,0,0,8"/>
                                                <CheckBox Content="{DynamicResource LOCPlayAch_Settings_ShowAchievementGridColumnHeaders}"
                                                          IsChecked="{Binding Persisted.StartPageRecentUnlocksGrid.ShowColumnHeaders}"
                                                          Margin="0,0,0,12"/>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_GridRowHeight}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBox Text="{Binding Persisted.StartPageRecentUnlocksGrid.RowHeight, UpdateSourceTrigger=LostFocus, Converter={StaticResource NullableDoubleTextConverter}, ConverterParameter=32}"
                                                             Width="80" Margin="8,0,0,0"/>
                                                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_PixelsAutomaticUnit}"
                                                               VerticalAlignment="Center" Margin="4,0,0,0" Opacity="0.6"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_GridMaxRows}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBox Text="{Binding Persisted.StartPageRecentUnlocksGrid.MaxRows, UpdateSourceTrigger=LostFocus, Converter={StaticResource NullableIntTextConverter}, ConverterParameter=1}"
                                                             Width="80" Margin="8,0,0,0"/>
                                                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_RowsUnlimitedUnit}"
                                                               VerticalAlignment="Center" Margin="4,0,0,0" Opacity="0.6"/>
                                                </StackPanel>

                                                <TextBlock Text="{DynamicResource LOCPlayAch_Settings_SortBy}"
                                                           Style="{StaticResource SubSectionHeaderStyle}"
                                                           Margin="0,0,0,8"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <ComboBox SelectedValue="{Binding Persisted.StartPageRecentUnlocksGrid.SortMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              SelectedValuePath="Tag"
                                                              MinWidth="180">
                                                        <ComboBoxItem Content="{DynamicResource LOCPlayAch_Common_Default}" Tag="{x:Static settings:CompactListSortMode.None}"/>
                                                        <ComboBoxItem Content="{DynamicResource LOCPlayAch_Common_UnlockTime}" Tag="{x:Static settings:CompactListSortMode.UnlockTime}"/>
                                                        <ComboBoxItem Content="{DynamicResource LOCPlayAch_Column_Rarity}" Tag="{x:Static settings:CompactListSortMode.Rarity}"/>
                                                    </ComboBox>
                                                    <Button ToolTip="{DynamicResource LOCPlayAch_Settings_SortDirection_Tooltip}"
                                                            Margin="4,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Click="ToggleStartPageRecentUnlocksGridSortDescending">
                                                        <TextBlock FontFamily="{DynamicResource CommonFont}" FontSize="18">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="&#xea65;"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Persisted.StartPageRecentUnlocksGrid.SortDescending}" Value="True">
                                                                            <Setter Property="Text" Value="&#xea66;"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_PieChartPreview}"
                                                   Style="{StaticResource SectionHeaderStyle}"
                                                   Margin="0,0,0,12"/>
                                        <Border Style="{StaticResource SectionAccentRuleStyle}"/>
                                        <Border Style="{StaticResource SettingGroupCardStyle}">
                                            <StackPanel>
                                                <CheckBox Content="{DynamicResource LOCPlayAch_Settings_ShowOverviewPiePercentages}"
                                                          IsChecked="{Binding Persisted.StartPagePieCharts.ShowCenterPercentage}"
                                                          Margin="0,0,0,12"/>
                                                <TextBlock Text="{DynamicResource LOCPlayAch_Settings_OverviewPieSmallSliceMode}"
                                                           Style="{StaticResource SubSectionHeaderStyle}"
                                                           Margin="0,0,0,8"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Content="{DynamicResource LOCPlayAch_Settings_OverviewPieSmallSliceMode_Exact}"
                                                                 GroupName="StartPagePieSmallSliceMode"
                                                                 Style="{StaticResource OverviewPieModeRadioButtonStyle}"
                                                                 Margin="0,0,16,0"
                                                                 IsChecked="{Binding Persisted.StartPagePieCharts.SmallSliceMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBool}, ConverterParameter=Exact}"/>
                                                    <RadioButton Content="{DynamicResource LOCPlayAch_Common_Hide}"
                                                                 GroupName="StartPagePieSmallSliceMode"
                                                                 Style="{StaticResource OverviewPieModeRadioButtonStyle}"
                                                                 Margin="0,0,16,0"
                                                                 IsChecked="{Binding Persisted.StartPagePieCharts.SmallSliceMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBool}, ConverterParameter=Hide}"/>
                                                    <RadioButton Content="{DynamicResource LOCPlayAch_Settings_OverviewPieSmallSliceMode_Round}"
                                                                 GroupName="StartPagePieSmallSliceMode"
                                                                 Style="{StaticResource OverviewPieModeRadioButtonStyle}"
                                                                 IsChecked="{Binding Persisted.StartPagePieCharts.SmallSliceMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBool}, ConverterParameter=Round}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================== TAB: ACHIEVEMENT NOTIFICATIONS ================== -->
            <TabItem x:Name="AchievementNotificationsTab" AutomationProperties.Name="Achievement Notifications">
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderWithIconStyle}">
                        <TextBlock Style="{StaticResource HeaderIconStyle}" Text="&#xECA7;"/>
                        <TextBlock Text="Achievement Notifications" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Background="{DynamicResource PanelBackgroundBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" MinWidth="190" MaxWidth="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BorderBrush="{DynamicResource NormalBorderBrush}"
                            BorderThickness="0,0,1,0"
                            Background="{DynamicResource ControlBackgroundBrush}">
                        <ListBox BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Padding="0">
                            <ListBoxItem x:Name="AchievementNotificationsGeneralNavigationItem"
                                         Style="{StaticResource ProviderNavigationItemContainerStyle}"
                                         IsSelected="True">
                                <Grid Margin="8,3" MinHeight="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE713;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="General"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem x:Name="AchievementNotificationsStyleNavigationItem"
                                         Style="{StaticResource ProviderNavigationItemContainerStyle}">
                                <Grid Margin="8,3" MinHeight="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE790;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Notification Style"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem x:Name="AchievementNotificationsMemoriesNavigationItem"
                                         Style="{StaticResource ProviderNavigationItemContainerStyle}">
                                <Grid Margin="8,3" MinHeight="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE91B;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Memories"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </ListBoxItem>
                        </ListBox>
                    </Border>

                    <ScrollViewer Grid.Column="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, ElementName=AchievementNotificationsMemoriesNavigationItem}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel Margin="20">

                        <!-- ================== LOCAL ACHIEVEMENT NOTIFICATIONS SECTION ================== -->
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <StackPanel Visibility="{Binding IsSelected, ElementName=AchievementNotificationsGeneralNavigationItem, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Real-time Achievement Notifications"
                                           Style="{StaticResource SectionHeaderStyle}"
                                           Margin="0,0,0,12"/>

                                <TextBlock Text="Uses Playnite Achievements live polling to detect unlocks for the running game, then displays your custom Achievement Notification."
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,0,0,16"
                                           TextWrapping="Wrap"/>

                                <!-- Enable Monitoring -->
                                <CheckBox Content="Use custom Achievement Notification for live unlocks"
                                          IsChecked="{Binding EnableActiveGameMonitoring, Mode=TwoWay}"
                                          Margin="0,0,0,4"/>

                                <TextBlock Text="The v3 live poller performs the provider refresh and unlock detection. The separate Exophase / RetroAchievements API-verification monitor is no longer required."
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="18,0,0,10"
                                           TextWrapping="Wrap"/>

                                <!-- Polling Interval -->
                                <Grid Style="{StaticResource SettingRowStyle}"
                                      IsEnabled="{Binding EnableActiveGameMonitoring}"
                                      Margin="18,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Polling interval (seconds):"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold"/>
                                    <TextBox Grid.Column="1"
                                             Width="70"
                                             VerticalContentAlignment="Center"
                                             x:Name="NotificationsPollingIntervalSecondsTextBox"
                                             TextChanged="NotificationsPollingIntervalSecondsTextBox_TextChanged"
                                             LostFocus="NotificationsPollingIntervalSecondsTextBox_LostFocus"/>
                                </Grid>

                                <TextBlock Text="Choose a value between 1 and 60 seconds. This interval is used by the v3 live poller for every supported provider."
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="18,0,0,10"
                                           TextWrapping="Wrap"
                                           IsEnabled="{Binding EnableActiveGameMonitoring}"/>
                                <!-- Retained only for loading older saved settings; API verification
                                     is superseded by the v3 live-polling detection pipeline. -->
                                <TextBox x:Name="ApiVerificationPollingIntervalSecondsTextBox"
                                         Visibility="Collapsed"/>

                                <CheckBox Content="Debug achievement notification logging"
                                          IsChecked="{Binding EnableOverlayDebugLogging, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Checked="AchievementNotificationDebugLogging_Checked"
                                          Unchecked="AchievementNotificationDebugLogging_Unchecked"
                                          Margin="0,0,0,4"/>
                                <TextBlock Text="Writes notification detection, dispatch, assets, monitor, DPI, window-position, animation, topmost, and SAN renderer diagnostics to AchNotifDebug.log."
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="18,0,0,12"
                                           TextWrapping="Wrap"/>

                                <!-- Notification Options -->
                                <Border Style="{StaticResource SettingGroupCardStyle}"
                                        IsEnabled="{Binding EnableActiveGameMonitoring}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="Delivery mode:"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontWeight="SemiBold"/>
                                            <ComboBox SelectedValue="{Binding UnlockNotificationDeliveryMode, Mode=TwoWay}"
                                                      SelectedValuePath="Tag"
                                                      MinWidth="200">
                                                <ComboBoxItem Content="Windows toast only"
                                                              Tag="{x:Static local:LocalUnlockNotificationDeliveryMode.WindowsToast}"/>
                                                <ComboBoxItem Content="Overlay only"
                                                              Tag="{x:Static local:LocalUnlockNotificationDeliveryMode.Overlay}"/>
                                                <ComboBoxItem Content="Hybrid (Overlay + Toast)"
                                                              Tag="{x:Static local:LocalUnlockNotificationDeliveryMode.Hybrid}"/>
                                            </ComboBox>
                                        </DockPanel>

                                        <CheckBox Content="Show overlay on the active game's monitor (windowed or borderless fullscreen)"
                                                  IsChecked="{Binding ShowOverlayOnActiveGameMonitor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,0,0,4"/>
                                        <TextBlock Text="Keeps the notification above the game and follows it to another monitor. Exclusive fullscreen may block external Windows overlays; use borderless fullscreen when that happens."
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="18,0,0,12"
                                                   TextWrapping="Wrap"/>

                                        <CheckBox Content="Show in-app notification when achievement is unlocked"
                                                  IsChecked="{Binding EnableInAppUnlockNotifications, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,0,0,12"/>

                                        <CheckBox Content="Send System notification"
                                                  IsChecked="{Binding EnableWindowsToastNotifications, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,0,0,0"/>
                                        <TextBlock Text="Sends a system notification that appears in selected delivery mode."
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="18,4,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                </StackPanel>

                                <!-- Notification Style -->
                                <Border Visibility="{Binding IsSelected, ElementName=AchievementNotificationsStyleNavigationItem, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource SettingGroupCardStyle}"
                                    IsEnabled="{Binding EnableActiveGameMonitoring}">
                                    <StackPanel>
                                    <TextBlock Text="Notification Style"
                                           Style="{StaticResource SubSectionHeaderStyle}"
                                           Margin="0,0,0,8"/>

                                    <DockPanel Margin="0,0,0,6" Visibility="Collapsed">
                                        <TextBlock Text="Default style:"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold"/>
                                        <ComboBox x:Name="NotificationsGlobalStyleComboBox"
                                              MinWidth="220"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="NotificationsGlobalStyleComboBox_SelectionChanged"/>
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                        <TextBlock Text="Provider override:"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold"/>
