<!-- LegacyNotificationSettingsControl.xaml -->
<UserControl x:Class="PlayniteAchievements.Views.LegacyNotificationSettingsControl"
             x:Name="LegacyNotificationSettingsControlRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:PlayniteAchievements.Views.Converters"
             xmlns:base="clr-namespace:PlayniteAchievements.Views.ThemeIntegration.Base"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             xmlns:modern="clr-namespace:PlayniteAchievements.Views.ThemeIntegration.Modern"
             xmlns:settings="clr-namespace:PlayniteAchievements.Models.Settings"
             xmlns:local="clr-namespace:PlayniteAchievements.Providers.Local"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="700">

    <UserControl.Resources>
        <ResourceDictionary>
            <conv:NullableDoubleTextConverter x:Key="NullableDoubleTextConverter"/>
            <conv:NullableIntTextConverter x:Key="NullableIntTextConverter"/>
            <conv:EnumToBoolConverter x:Key="EnumToBool"/>
            <conv:BooleanConverter x:Key="BoolToVis" Mode="ToVisibility"/>
            <conv:ProviderIconConverter x:Key="ProviderIconConverter"/>

            <Style x:Key="PreviewThemeControlStyle"
                   TargetType="{x:Type base:ThemeControlBase}">
                <Setter Property="SettingsOverride"
                        Value="{Binding DataContext, ElementName=LegacyNotificationSettingsControlRoot}"/>
            </Style>

            <!-- Disable Steam auth buttons while busy -->
            <Style x:Key="SteamAuthActionButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SteamAuthBusy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Value="True">
                        <Setter Property="IsEnabled" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Disable GOG auth buttons while busy -->
            <Style x:Key="GogAuthActionButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding GogAuthBusy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Value="True">
                        <Setter Property="IsEnabled" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Disable Epic auth buttons while busy -->
            <Style x:Key="EpicAuthActionButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding EpicAuthBusy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Value="True">
                        <Setter Property="IsEnabled" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Disable PSN auth buttons while busy -->
            <Style x:Key="PsnAuthActionButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PsnAuthBusy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Value="True">
                        <Setter Property="IsEnabled" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Disable Xbox auth buttons while busy -->
            <Style x:Key="XboxAuthActionButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding XboxAuthBusy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Value="True">
                        <Setter Property="IsEnabled" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Disable Exophase auth buttons while busy -->
            <Style x:Key="ExophaseAuthActionButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ExophaseAuthBusy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Value="True">
                        <Setter Property="IsEnabled" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Section header style -->
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="Opacity" Value="1"/>
            </Style>

            <!-- Subsection header style -->
            <Style x:Key="SubSectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Opacity" Value="0.96"/>
            </Style>

            <Style x:Key="SectionAccentRuleStyle" TargetType="Border">
                <Setter Property="Height" Value="2"/>
                <Setter Property="Width" Value="44"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="CornerRadius" Value="1"/>
                <Setter Property="Background" Value="{DynamicResource HighlightGlyphBrush}"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
            </Style>

            <Style x:Key="ContextLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource HighlightGlyphBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style x:Key="SettingGroupCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="14"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
                <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="OverviewPieModeRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource HighlightGlyphBrush}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource HighlightGlyphBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.55"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Accent text style -->
            <Style x:Key="AccentTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="#4CC9F0"/>
            </Style>

            <!-- Modern button style -->
            <Style x:Key="ModernActionButton" TargetType="Button"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="18,8"/>
                <Setter Property="MinWidth" Value="120"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.85"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Opacity" Value="0.7"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Tab header with icon -->
            <Style x:Key="TabHeaderWithIconStyle" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0"/>
            </Style>

            <Style x:Key="HeaderIconStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource FontIcoFont}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Prominent link button shown at top of General tab -->
            <Style x:Key="ProminentLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="16,12"/>
                <Setter Property="Margin" Value="6,0"/>
                <Setter Property="MinWidth" Value="120"/>
                <Setter Property="MinHeight" Value="64"/>
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="8" ShadowDepth="1"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource HighlightGlyphBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#10FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Section container style with shadow -->
            <Style x:Key="SectionBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="18"/>
                <Setter Property="Margin" Value="0,0,0,20"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- Setting row style -->
            <Style x:Key="SettingRowStyle" TargetType="Grid">
                <Setter Property="Margin" Value="0,0,0,14"/>
            </Style>

            <!-- Muted text style -->
            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Opacity" Value="0.6"/>
                <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- Implicit styles: ensure all Button/ComboBox/TextBox controls inherit the Playnite theme -->
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"/>
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"/>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"/>
            <Style x:Key="ProviderNavigationItemContainerStyle" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="BackgroundBorder"
                                    Background="{TemplateBinding Background}">
                                <Grid>
                                    <Border x:Name="SelectionAccent"
                                            Width="3"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource HighlightGlyphBrush}"
                                            Visibility="Collapsed"/>
                                    <ContentPresenter Margin="3,0,0,0"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BackgroundBorder" Property="Background" Value="#10FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="BackgroundBorder" Property="Background" Value="#1CFFFFFF"/>
                                    <Setter TargetName="SelectionAccent" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24,20,24,24">
        <TabControl x:Name="SettingsTabControl" SelectionChanged="TabControl_SelectionChanged" BorderThickness="0">
            <!-- ================== TAB: GENERAL SETTINGS ================== -->
            <TabItem x:Name="GeneralTab" AutomationProperties.Name="{DynamicResource LOCPlayAch_Common_General}">
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderWithIconStyle}">
                        <TextBlock Style="{StaticResource HeaderIconStyle}" Text="&#xEF39;"/>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Common_General}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20">

                        <!-- Settings Header -->
                        <Border Style="{StaticResource SectionBorderStyle}"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource NormalBorderBrush}">
                            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Description}"
                                       Style="{StaticResource SectionHeaderStyle}"
                                       Margin="0"/>
                        </Border>

                        <!-- Prominent quick links to other settings tabs -->
                        <Grid Margin="0,12,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource ProminentLinkButtonStyle}"
                                    Click="JumpToDisplay_Click"
                                    ToolTip="{DynamicResource LOCPlayAch_Settings_TabDisplay}"
                                    AutomationProperties.Name="{DynamicResource LOCPlayAch_Settings_TabDisplay}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="{DynamicResource FontIcoFont}"
                                               FontSize="20" Margin="0,0,10,0" Text="&#xEFB3;" Foreground="{DynamicResource HighlightGlyphBrush}"/>
                                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_TabDisplay}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1" Style="{StaticResource ProminentLinkButtonStyle}"
                                    Click="JumpToProviders_Click"
                                    ToolTip="{DynamicResource LOCPlayAch_CustomRefresh_ProvidersHeader}"
                                    AutomationProperties.Name="{DynamicResource LOCPlayAch_CustomRefresh_ProvidersHeader}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="{DynamicResource FontIcoFont}"
                                               FontSize="20" Margin="0,0,10,0" Text="&#xEF7B;" Foreground="{DynamicResource HighlightGlyphBrush}"/>
                                    <TextBlock Text="{DynamicResource LOCPlayAch_CustomRefresh_ProvidersHeader}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Style="{StaticResource ProminentLinkButtonStyle}"
                                    Click="JumpToThemeMigration_Click"
                                    ToolTip="{DynamicResource LOCPlayAch_ThemeMigration_Title}"
                                    AutomationProperties.Name="{DynamicResource LOCPlayAch_ThemeMigration_Title}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="{DynamicResource FontIcoFont}"
                                               FontSize="20" Margin="0,0,10,0" Text="&#xEFD2;" Foreground="{DynamicResource HighlightGlyphBrush}"/>
                                    <TextBlock Text="{DynamicResource LOCPlayAch_ThemeMigration_Title}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- ================== LANGUAGE ================== -->
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Language}"
                                           Style="{StaticResource SectionHeaderStyle}"/>

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Language}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,2"/>
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_LanguageHint}"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                    </StackPanel>

                                    <ComboBox Grid.Column="1"
                                              Width="200"
                                              SelectedValuePath="Tag"
                                              SelectedValue="{Binding Persisted.GlobalLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBoxItem Content="English" Tag="english"/>
                                        <ComboBoxItem Content="German (Deutsch)" Tag="german"/>
                                        <ComboBoxItem Content="French (FranÃ§ais)" Tag="french"/>
                                        <ComboBoxItem Content="Spanish (EspaÃ±ol)" Tag="spanish"/>
                                        <ComboBoxItem Content="Italian (Italiano)" Tag="italian"/>
                                        <ComboBoxItem Content="Portuguese" Tag="portuguese"/>
                                        <ComboBoxItem Content="Brazilian Portuguese" Tag="brazilian"/>
                                        <ComboBoxItem Content="Russian (Ð ÑƒÑÑÐºÐ¸Ð¹)" Tag="russian"/>
                                        <ComboBoxItem Content="Polish (Polski)" Tag="polish"/>
                                        <ComboBoxItem Content="Dutch (Nederlands)" Tag="dutch"/>
                                        <ComboBoxItem Content="Swedish (Svenska)" Tag="swedish"/>
                                        <ComboBoxItem Content="Finnish (Suomi)" Tag="finnish"/>
                                        <ComboBoxItem Content="Danish (Dansk)" Tag="danish"/>
                                        <ComboBoxItem Content="Norwegian (Norsk)" Tag="norwegian"/>
                                        <ComboBoxItem Content="Hungarian (Magyar)" Tag="hungarian"/>
                                        <ComboBoxItem Content="Czech (ÄŒeÅ¡tina)" Tag="czech"/>
                                        <ComboBoxItem Content="Romanian (RomÃ¢nÄƒ)" Tag="romanian"/>
                                        <ComboBoxItem Content="Turkish (TÃ¼rkÃ§e)" Tag="turkish"/>
                                        <ComboBoxItem Content="Greek (Î•Î»Î»Î·Î½Î¹ÎºÎ¬)" Tag="greek"/>
                                        <ComboBoxItem Content="Bulgarian (Ð‘ÑŠÐ»Ð³Ð°Ñ€ÑÐºÐ¸)" Tag="bulgarian"/>
                                        <ComboBoxItem Content="Ukrainian (Ð£ÐºÑ€Ð°Ñ—Ð½ÑÑŒÐºÐ°)" Tag="ukrainian"/>
                                        <ComboBoxItem Content="Thai (à¹„à¸—à¸¢)" Tag="thai"/>
                                        <ComboBoxItem Content="Vietnamese (Tiáº¿ng Viá»‡t)" Tag="vietnamese"/>
                                        <ComboBoxItem Content="Japanese (æ—¥æœ¬èªž)" Tag="japanese"/>
                                        <ComboBoxItem Content="Korean (í•œêµ­ì–´)" Tag="koreana"/>
                                        <ComboBoxItem Content="Simplified Chinese (ç®€ä½“ä¸­æ–‡)" Tag="schinese"/>
                                        <ComboBoxItem Content="Traditional Chinese (ç¹é«”ä¸­æ–‡)" Tag="tchinese"/>
                                        <ComboBoxItem Content="Arabic (Ø§Ù„Ø¹Ø±Ø¨ÙŠØ©)" Tag="arabic"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ================== SYNC & UPDATES ================== -->
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCPlayAch_Section_SyncUpdates}"
                                           Style="{StaticResource SectionHeaderStyle}"/>

                                <!-- Periodic Updates -->
                                <Grid Style="{StaticResource SettingRowStyle}" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                            <CheckBox Content="{DynamicResource LOCPlayAch_Settings_EnablePeriodicUpdates}"
                                                          IsChecked="{Binding Persisted.EnablePeriodicUpdates}"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_HoursBetweenUpdates}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                            <TextBox Text="{Binding Persisted.PeriodicUpdateHours, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="50"
                                                     IsEnabled="{Binding Persisted.EnablePeriodicUpdates}"
                                                 TextAlignment="Right"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,16">
                                    <CheckBox Content="{DynamicResource LOCPlayAch_Settings_IncludeHiddenGamesInBulkRefreshes}"
                                              IsChecked="{Binding Persisted.IncludeHiddenGamesInBulkScans}"
                                              Margin="0,0,0,4"/>
                                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_IncludeHiddenGamesInBulkRefreshes_Description}"
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="18,0,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Recent Refresh -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource LOCPlayAch_RefreshMode_Recent}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,2"/>
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_RecentRefresh_Description}"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_RecentRefresh_RecentGames}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                            <TextBox Text="{Binding Persisted.RecentRefreshGamesCount, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="50"
                                                 TextAlignment="Right"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Include Unplayed Games -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                            <CheckBox Content="{DynamicResource LOCPlayAch_IncludeUnplayedGames}"
                                                          IsChecked="{Binding Persisted.IncludeUnplayedGames}"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource LOCPlayAch_IncludeUnplayedGames_Help}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="20,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_SidebarDefaultsHeader}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,2"/>
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_SidebarDefaultsDescription}"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_SidebarDefaultRefreshMode}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   Margin="0,0,0,4"/>
                                        <ComboBox Width="170"
                                                  SelectedValuePath="Tag"
                                                  SelectedValue="{Binding Persisted.SidebarDefaultRefreshModeKey, Mode=TwoWay}">
                                            <ComboBoxItem Tag="Installed" Content="{DynamicResource LOCPlayAch_RefreshModeShort_Installed}"/>
                                            <ComboBoxItem Tag="Recent" Content="{DynamicResource LOCPlayAch_RefreshModeShort_Recent}"/>
                                            <ComboBoxItem Tag="Full" Content="{DynamicResource LOCPlayAch_RefreshModeShort_Full}"/>
                                            <ComboBoxItem Tag="Favorites" Content="{DynamicResource LOCPlayAch_RefreshModeShort_Favorites}"/>
                                            <ComboBoxItem Tag="Missing" Content="{DynamicResource LOCPlayAch_RefreshModeShort_Missing}"/>
                                        </ComboBox>

                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_SidebarDefaultPlayStatus}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   Margin="0,10,0,4"/>
                                        <ComboBox Width="170"
                                                  SelectedValuePath="Tag"
                                                  SelectedValue="{Binding Persisted.SidebarDefaultPlayStatusFilter, Mode=TwoWay}">
                                            <ComboBoxItem Tag="none" Content="{DynamicResource LOCPlayAch_Common_None}"/>
                                            <ComboBoxItem Tag="played" Content="{DynamicResource LOCPlayAch_Filter_Played}"/>
                                            <ComboBoxItem Tag="unplayed" Content="{DynamicResource LOCPlayAch_Filter_Unplayed}"/>
                                            <ComboBoxItem Tag="noprogress" Content="{DynamicResource LOCPlayAch_Filter_NoProgress}"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Provider Execution Mode -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <CheckBox Content="{DynamicResource LOCPlayAch_Settings_EnableParallelProviderRefresh}"
                                                  IsChecked="{Binding Persisted.EnableParallelProviderRefresh}"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_EnableParallelProviderRefresh_Help}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="20,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ================== HOTKEYS ================== -->
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCPlayAch_Hotkeys_Title}"
                                           Style="{StaticResource SectionHeaderStyle}"/>

                                <TextBlock Text="{DynamicResource LOCPlayAch_Hotkeys_Description}"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,0,0,14"
                                           TextWrapping="Wrap"/>

                                <CheckBox Content="{DynamicResource LOCPlayAch_Hotkeys_Enable}"
                                          IsChecked="{Binding Persisted.EnableAchievementHotkeys}"
                                          Margin="0,0,0,8"/>

                                <CheckBox Content="{DynamicResource LOCPlayAch_Hotkeys_EnableGlobal}"
                                          IsChecked="{Binding Persisted.EnableGlobalAchievementHotkeys}"
                                          IsEnabled="{Binding Persisted.EnableAchievementHotkeys}"
                                          Margin="18,0,0,8"/>

                                <TextBlock Text="{DynamicResource LOCPlayAch_Hotkeys_GlobalHelp}"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="18,0,0,14"
                                           TextWrapping="Wrap"/>

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Menu_ViewAchievements}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <Button x:Name="ViewAchievementsHotkeyCaptureButton"
                                            Grid.Column="1"
                                            Content="{Binding ViewAchievementsHotkeyButtonText, ElementName=LegacyNotificationSettingsControlRoot}"
                                            Click="ViewAchievementsHotkeyCapture_Click"
                                            PreviewKeyDown="HotkeyCapture_PreviewKeyDown"
                                            IsEnabled="{Binding Persisted.EnableAchievementHotkeys}"
                                            Margin="12,0,8,0"/>

                                    <Button Grid.Column="2"
                                            Content="{DynamicResource LOCPlayAch_Button_Reset}"
                                            Click="ResetViewAchievementsHotkey_Click"
                                            IsEnabled="{Binding Persisted.EnableAchievementHotkeys}"
                                            MinWidth="74"/>
                                </Grid>

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Menu_ManageAchievements}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <Button x:Name="ManageAchievementsHotkeyCaptureButton"
                                            Grid.Column="1"
                                            Content="{Binding ManageAchievementsHotkeyButtonText, ElementName=LegacyNotificationSettingsControlRoot}"
                                            Click="ManageAchievementsHotkeyCapture_Click"
                                            PreviewKeyDown="HotkeyCapture_PreviewKeyDown"
                                            IsEnabled="{Binding Persisted.EnableAchievementHotkeys}"
                                            Margin="12,0,8,0"/>

                                    <Button Grid.Column="2"
                                            Content="{DynamicResource LOCPlayAch_Button_Reset}"
                                            Click="ResetManageAchievementsHotkey_Click"
                                            IsEnabled="{Binding Persisted.EnableAchievementHotkeys}"
                                            MinWidth="74"/>
                                </Grid>

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Menu_OpenOverview}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <Button x:Name="OverviewHotkeyCaptureButton"
                                            Grid.Column="1"
                                            Content="{Binding OverviewHotkeyButtonText, ElementName=LegacyNotificationSettingsControlRoot}"
                                            Click="OverviewHotkeyCapture_Click"
                                            PreviewKeyDown="HotkeyCapture_PreviewKeyDown"
                                            IsEnabled="{Binding Persisted.EnableAchievementHotkeys}"
                                            Margin="12,0,8,0"/>

                                    <Button Grid.Column="2"
                                            Content="{DynamicResource LOCPlayAch_Button_Reset}"
                                            Click="ResetOverviewHotkey_Click"
                                            IsEnabled="{Binding Persisted.EnableAchievementHotkeys}"
                                            MinWidth="74"/>
                                </Grid>

                                <TextBlock Text="{Binding HotkeyCaptureStatusText, ElementName=LegacyNotificationSettingsControlRoot}"
                                           Style="{StaticResource MutedTextStyle}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- ================== NOTIFICATIONS ================== -->
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCPlayAch_Section_Notifications}"
                                           Style="{StaticResource SectionHeaderStyle}"/>

                                <StackPanel>
                                        <CheckBox Content="{DynamicResource LOCPlayAch_Settings_EnableNotifications}"
                                                  IsChecked="{Binding Persisted.EnableNotifications}"
                                              Margin="0,0,0,10"/>
                                    <CheckBox Content="{DynamicResource LOCPlayAch_Settings_NotifyPeriodicUpdates}"
                                                  IsChecked="{Binding Persisted.NotifyPeriodicUpdates}"
                                              Margin="18,0,0,10"
                                                  IsEnabled="{Binding Persisted.EnableNotifications}"/>
                                    <CheckBox Content="{DynamicResource LOCPlayAch_Settings_NotifyOnRebuild}"
                                                  IsChecked="{Binding Persisted.NotifyOnRebuild}"
                                              Margin="18,0,0,0"
                                                  IsEnabled="{Binding Persisted.EnableNotifications}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ================== TAGGING ================== -->
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCPlayAch_Settings_TaggingHeader}"
                                           Style="{StaticResource SectionHeaderStyle}"/>

                                <TextBlock Text="{DynamicResource LOCPlayAch_Settings_TaggingDescription}"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,0,0,16"
                                           TextWrapping="Wrap"/>

                                <CheckBox Content="{DynamicResource LOCPlayAch_Settings_EnableTagging}"
                                          IsChecked="{Binding Persisted.TaggingSettings.EnableTagging, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,12"/>

                                <!-- Tag Configuration Grid - only visible when tagging is enabled -->
                                <StackPanel Margin="18,0,0,0"
                                            Visibility="{Binding Persisted.TaggingSettings.EnableTagging, Converter={StaticResource BooleanToVisibilityConverter}}">

                                    <TextBlock Text="{DynamicResource LOCPlayAch_Settings_TaggingSection}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Margin="0,0,0,12"/>

                                    <!-- Tag List -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Has Achievements Tag -->
                                        <CheckBox Grid.Row="0" Grid.Column="0"
                                                  IsChecked="{Binding Persisted.TaggingSettings.HasAchievementsConfig.IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,6"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{DynamicResource LOCPlayAch_Tagging_HasAchievements}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,6"/>
                                        <TextBox Grid.Row="0" Grid.Column="2"
                                                 x:Name="HasAchievementsTagTextBox"
                                                 Text="{Binding Persisted.TaggingSettings.HasAchievementsConfig.DisplayName, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                                 Margin="0,0,0,6"/>

                                        <!-- In Progress Tag -->
                                        <CheckBox Grid.Row="1" Grid.Column="0"
                                                  IsChecked="{Binding Persisted.TaggingSettings.InProgressConfig.IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,6"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Text="{DynamicResource LOCPlayAch_Tagging_InProgress}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,6"/>
                                        <TextBox Grid.Row="1" Grid.Column="2"
                                                 x:Name="InProgressTagTextBox"
                                                 Text="{Binding Persisted.TaggingSettings.InProgressConfig.DisplayName, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                                 Margin="0,0,0,6"/>

                                        <!-- Completed Tag -->
                                        <CheckBox Grid.Row="2" Grid.Column="0"
                                                  IsChecked="{Binding Persisted.TaggingSettings.CompletedConfig.IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,6"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1"
                                                   Text="{DynamicResource LOCPlayAch_Completed}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,6"/>
                                        <TextBox Grid.Row="2" Grid.Column="2"
                                                 x:Name="CompletedTagTextBox"
                                                 Text="{Binding Persisted.TaggingSettings.CompletedConfig.DisplayName, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                                 Margin="0,0,0,6"/>

                                        <!-- No Achievements Tag -->
                                        <CheckBox Grid.Row="3" Grid.Column="0"
                                                  IsChecked="{Binding Persisted.TaggingSettings.NoAchievementsConfig.IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,6"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1"
                                                   Text="{DynamicResource LOCPlayAch_Tagging_NoAchievements}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,6"/>
                                        <TextBox Grid.Row="3" Grid.Column="2"
                                                 x:Name="NoAchievementsTagTextBox"
                                                 Text="{Binding Persisted.TaggingSettings.NoAchievementsConfig.DisplayName, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                                 Margin="0,0,0,6"/>

                                        <!-- Customized Tag -->
                                        <CheckBox Grid.Row="4" Grid.Column="0"
                                                  IsChecked="{Binding Persisted.TaggingSettings.CustomizedConfig.IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,6"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1"
                                                   Text="{DynamicResource LOCPlayAch_Tagging_Customized}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,6"/>
                                        <TextBox Grid.Row="4" Grid.Column="2"
                                                 x:Name="CustomizedTagTextBox"
                                                 Text="{Binding Persisted.TaggingSettings.CustomizedConfig.DisplayName, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                                 Margin="0,0,0,6"/>

                                        <!-- Not Customized Tag -->
                                        <CheckBox Grid.Row="5" Grid.Column="0"
                                                  IsChecked="{Binding Persisted.TaggingSettings.NotCustomizedConfig.IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,6"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1"
                                                   Text="{DynamicResource LOCPlayAch_Tagging_NotCustomized}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,6"/>
                                        <TextBox Grid.Row="5" Grid.Column="2"
                                                 x:Name="NotCustomizedTagTextBox"
                                                 Text="{Binding Persisted.TaggingSettings.NotCustomizedConfig.DisplayName, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                                 Margin="0,0,0,6"/>

                                        <!-- Excluded Tag -->
                                        <CheckBox Grid.Row="6" Grid.Column="0"
                                                  IsChecked="{Binding Persisted.TaggingSettings.ExcludedConfig.IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,6"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1"
                                                   Text="{DynamicResource LOCPlayAch_GameOptions_Status_Excluded}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,6"/>
                                        <TextBox Grid.Row="6" Grid.Column="2"
                                                 x:Name="ExcludedTagTextBox"
                                                 Text="{Binding Persisted.TaggingSettings.ExcludedConfig.DisplayName, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                                 Margin="0,0,0,6"/>

                                        <!-- Excluded from Summaries Tag -->
                                        <CheckBox Grid.Row="7" Grid.Column="0"
                                                  IsChecked="{Binding Persisted.TaggingSettings.ExcludedFromSummariesConfig.IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"/>
                                        <TextBlock Grid.Row="7" Grid.Column="1"
                                                   Text="{DynamicResource LOCPlayAch_GameOptions_Status_ExcludedFromSummaries}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                                        <TextBox Grid.Row="7" Grid.Column="2"
                                                 x:Name="ExcludedFromSummariesTagTextBox"
                                                 Text="{Binding Persisted.TaggingSettings.ExcludedFromSummariesConfig.DisplayName, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                                 Margin="0,0,0,0"/>
                                    </Grid>

                                    <!-- Completion Status -->
                                    <CheckBox Content="{DynamicResource LOCPlayAch_Settings_SetCompletionStatus}"
                                              IsChecked="{Binding Persisted.TaggingSettings.SetCompletionStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="0,12,0,8"/>

                                    <!-- Action Buttons -->
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Content="{DynamicResource LOCPlayAch_Settings_ApplyAndSync}"
                                                Click="ApplyAndSync_Click"
                                                Margin="0,0,8,0"
                                                Padding="12,6"/>
                                        <Button Content="{DynamicResource LOCPlayAch_Settings_RemoveAllTags}"
                                                Click="RemoveAllTags_Click"
                                                Padding="12,6"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ================== THEME INTEGRATION ================== -->
                        <!-- <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Theme Integration"
                                           Style="{StaticResource SectionHeaderStyle}"/>

                                <TextBlock Style="{StaticResource MutedTextStyle}"
                                           Margin="0,0,0,16">
                                    PlayniteAchievements is the single source for both Desktop and Fullscreen themes.
                                    Both modern and SuccessStory-compatible properties are always populated so themes can bind to either surface.
                                </TextBlock>

                                 <Separator Margin="0,16,0,16" />

                                <TextBlock Text="Modern PlayniteAchievements theme integration"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />

                                <TextBlock Style="{StaticResource MutedTextStyle}"
                                           Margin="0,0,0,0">
                                    Modern controls and properties (prefixed differently) are always available to themes.
                                    Theme authors should use the modern PlayniteAchievements prefix for new themes.
                                </TextBlock>
                            </StackPanel>
                        </Border> -->

                        <!-- ================== MAINTENANCE ================== -->
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Maintenance_Title}"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                                <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Maintenance_Description}"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,0,0,16"/>

                                <Border Style="{StaticResource SettingGroupCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_CachedAchievementData_Title}"
                                                   Style="{StaticResource SubSectionHeaderStyle}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_CachedAchievementData_Description}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="0,0,0,12"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource LOCPlayAch_Settings_CachedAchievementData_ClearDescription}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       VerticalAlignment="Center"/>

                                            <Button Grid.Column="1"
                                                    Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                                    Click="WipeCache_Click"
                                                    Padding="14,6"
                                                    Margin="16,0,0,0"
                                                    MinWidth="130"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingGroupCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_AchievementIconCache_Title}"
                                                   Style="{StaticResource SubSectionHeaderStyle}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_IconCache_Description}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="0,0,0,12"/>

                                        <Grid Style="{StaticResource SettingRowStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource LOCPlayAch_Settings_IconCache_ClearAllDescription}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       VerticalAlignment="Center"/>

                                            <Button Grid.Column="1"
                                                    Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                                    Click="ClearAllIconCache_Click"
                                                    Padding="14,6"
                                                    Margin="16,0,0,0"
                                                    MinWidth="130"/>
                                        </Grid>

                                        <Grid Style="{StaticResource SettingRowStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource LOCPlayAch_Settings_IconCache_ClearCompressedDescription}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       VerticalAlignment="Center"/>

                                            <Button Grid.Column="1"
                                                    Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                                    Click="ClearCompressedIconCache_Click"
                                                    Padding="14,6"
                                                    Margin="16,0,0,0"
                                                    MinWidth="130"/>
                                        </Grid>

                                        <Grid Style="{StaticResource SettingRowStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource LOCPlayAch_Settings_IconCache_ClearFullResolutionDescription}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       VerticalAlignment="Center"/>

                                            <Button Grid.Column="1"
                                                    Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                                    Click="ClearFullResolutionIconCache_Click"
                                                    Padding="14,6"
                                                    Margin="16,0,0,0"
                                                    MinWidth="130"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource LOCPlayAch_Settings_IconCache_ClearLockedDescription}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       VerticalAlignment="Center"/>

                                            <Button Grid.Column="1"
                                                    Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                                    Click="ClearLockedIconCache_Click"
                                                    Padding="14,6"
                                                    Margin="16,0,0,0"
                                                    MinWidth="130"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingGroupCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Utilities_Title}"
                                                   Style="{StaticResource SubSectionHeaderStyle}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Utilities_Description}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="0,0,0,12"/>

                                        <Grid Style="{StaticResource SettingRowStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource LOCPlayAch_Settings_ResetFirstTimeSetup}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       VerticalAlignment="Center"/>

                                            <Button Grid.Column="1"
                                                    Content="{DynamicResource LOCPlayAch_Settings_ResetFirstTimeSetupButton}"
                                                    Click="ResetFirstTimeSetup_Click"
                                                    Padding="14,6"
                                                    Margin="16,0,0,0"
                                                    MinWidth="130"/>
                                        </Grid>

                                        <Grid Style="{StaticResource SettingRowStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource LOCPlayAch_Settings_ExportDatabase}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       VerticalAlignment="Center"/>

                                            <Button Grid.Column="1"
                                                    Content="{DynamicResource LOCPlayAch_Settings_ExportDatabaseButton}"
                                                    Click="ExportDatabase_Click"
                                                    Padding="14,6"
                                                    Margin="16,0,0,0"
                                                    MinWidth="130"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource LOCPlayAch_Settings_OpenDataFolder}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       VerticalAlignment="Center"/>

                                            <Button Grid.Column="1"
                                                    Content="{DynamicResource LOCPlayAch_Settings_OpenDataFolderButton}"
                                                    Click="OpenDataFolder_Click"
                                                    Padding="14,6"
                                                    Margin="16,0,0,0"
                                                    MinWidth="130"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================== TAB: DISPLAY ================== -->
            <TabItem x:Name="DisplayTab" AutomationProperties.Name="{DynamicResource LOCPlayAch_Settings_TabDisplay}">
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderWithIconStyle}">
                        <TextBlock Style="{StaticResource HeaderIconStyle}" Text="&#xEFB3;"/>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_TabDisplay}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Background="{DynamicResource PanelBackgroundBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" MinWidth="190" MaxWidth="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BorderBrush="{DynamicResource NormalBorderBrush}"
                            BorderThickness="0,0,1,0"
                            Background="{DynamicResource ControlBackgroundBrush}">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Top"
                                    BorderBrush="{DynamicResource NormalBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,12,12,10">
                                <TextBlock Text="{DynamicResource LOCPlayAch_Settings_TabDisplay}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="{DynamicResource FontSize}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>

                            <ListBox x:Name="DisplaySectionListBox"
                                     SelectedValuePath="Tag"
                                     SelectedIndex="0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Padding="0">
                                <ListBoxItem Tag="General"
                                             Style="{StaticResource ProviderNavigationItemContainerStyle}">
                                    <Grid Margin="8,3" MinHeight="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE713;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   Opacity="0.68"
                                                   FontSize="16"
                                                   Margin="0,0,9,0"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource LOCPlayAch_Common_General}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="{DynamicResource FontSize}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </ListBoxItem>

                                <ListBoxItem Tag="Overview"
                                             Style="{StaticResource ProviderNavigationItemContainerStyle}">
                                    <Grid Margin="8,3" MinHeight="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE8A7;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   Opacity="0.68"
                                                   FontSize="16"
                                                   Margin="0,0,9,0"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_Display_OverviewSection}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="{DynamicResource FontSize}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </ListBoxItem>

                                <ListBoxItem Tag="Library"
                                             Style="{StaticResource ProviderNavigationItemContainerStyle}">
                                    <Grid Margin="8,3" MinHeight="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE8F1;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   Opacity="0.68"
                                                   FontSize="16"
                                                   Margin="0,0,9,0"
                                                   VerticalAlignment="Center"/>
