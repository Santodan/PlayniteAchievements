<UserControl x:Class="PlayniteAchievements.Views.StartPage.StartPageScoreCardWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid Margin="4">
        <controls:ScoreCardControl Width="300"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   ScoreCard="{Binding ScoreCard}"/>
        <!-- The info glyph belongs to the host, not the card: one per surface. -->
        <Button Style="{DynamicResource PlayAch.Button.InfoGlyphStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,0,2,0"
                ToolTip="{DynamicResource LOCPlayAch_Score_Info_ButtonTooltip}"
                Click="ScoreInfoButton_Click"/>
    </Grid>
</UserControl>
