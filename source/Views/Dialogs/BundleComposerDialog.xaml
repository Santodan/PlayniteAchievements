<UserControl x:Class="PlayniteAchievements.Views.Dialogs.BundleComposerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dialogs="clr-namespace:PlayniteAchievements.Views.Dialogs"
             mc:Ignorable="d"
             d:DesignHeight="280" d:DesignWidth="560">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/PlayAchImplicitControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource PlayAch.Brush.Window.Background}" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding Hint}"
                       Style="{DynamicResource PlayAch.TextBlock.BaseStyle}"
                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                       Opacity="{StaticResource PlayAch.Opacity.Hint}"
                       TextWrapping="Wrap"
                       Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>

            <!-- One row per theme part: include it or not, and which source feeds it. -->
            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding Rows}"
                          Grid.IsSharedSizeScope="True"
                          Margin="{StaticResource PlayAch.Thickness.Bottom.Md}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type dialogs:BundleComposerRow}">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="PartLabel"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      Content="{Binding Label}"
                                      IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                      IsEnabled="{Binding IsEnabled}"
                                      VerticalAlignment="Center"
                                      MinWidth="150"
                                      Margin="0,0,12,0"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Sources}"
                                      SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      IsEnabled="{Binding CanPickSource}"
                                      MinWidth="260"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{DynamicResource LOCPlayAch_Common_OK}"
                        Click="OkButton_Click"
                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                        MinWidth="80"
                        Margin="{StaticResource PlayAch.Thickness.Right.Sm}"
                        IsDefault="True"/>

                <Button Content="{DynamicResource LOCPlayAch_Common_Cancel}"
                        Click="CancelButton_Click"
                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                        MinWidth="80"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
