<UserControl x:Class="PlayniteAchievements.Views.Dialogs.CustomProviderEditorDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:PlayniteAchievements.ViewModels"
             xmlns:converters="clr-namespace:PlayniteAchievements.Views.Converters"
             mc:Ignorable="d"
             d:DesignHeight="320" d:DesignWidth="560"
             d:DataContext="{d:DesignInstance vm:CustomProviderEditorViewModel}"
             FocusManager.FocusedElement="{Binding ElementName=NameTextBox}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/PlayAchImplicitControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BooleanConverter x:Key="BoolToVis" Mode="ToVisibility" />
            <converters:BooleanConverter x:Key="InverseBoolToVis" Mode="InvertedToVisibility" />

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource PlayAch.TextBlock.BaseStyle}">
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}" />
                <Setter Property="Opacity" Value="{StaticResource PlayAch.Opacity.Hint}" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource PlayAch.Brush.Window.Background}" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Live preview: the imported geometry (or the default icon) in the chosen color. -->
                <Border Grid.Column="0"
                        Width="88"
                        Height="88"
                        CornerRadius="6"
                        Margin="0,0,16,0"
                        VerticalAlignment="Top"
                        BorderBrush="{DynamicResource NormalBorderBrush}"
                        BorderThickness="1"
                        Background="{DynamicResource PanelBackgroundBrush}">
                    <Image Margin="12"
                           Stretch="Uniform"
                           Source="{Binding PreviewImage}" />
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource LOCPlayAch_Column_Name}"
                               Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="NameTextBox"
                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6"
                             VerticalContentAlignment="Center"
                             MaxLength="64" />

                    <TextBlock Text="{DynamicResource LOCPlayAch_Common_Color}"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,12,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Swatch mirrors the Display > Appearance platform color rows. -->
                        <Border Grid.Column="0"
                                Width="30"
                                Height="30"
                                CornerRadius="4"
                                Margin="0,0,6,0"
                                BorderBrush="{DynamicResource NormalBorderBrush}"
                                BorderThickness="1"
                                Background="{Binding ColorBrush}" />
                        <TextBox Grid.Column="1"
                                 Width="120"
                                 Padding="8,6"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding ColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2"
                                Content="{DynamicResource LOCPlayAch_Button_Pick}"
                                Command="{Binding PickColorCommand}"
                                Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                Margin="8,0,0,0" />
                    </Grid>

                    <TextBlock Text="{DynamicResource LOCPlayAch_Column_Icon}"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,12,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Link or local path to an SVG; blank keeps the default icon. Commits on Enter or focus loss. -->
                        <TextBox x:Name="IconSourceTextBox"
                                 Grid.Column="0"
                                 Padding="8,6"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding IconSource, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 KeyDown="IconSourceTextBox_KeyDown" />
                        <Button Grid.Column="1"
                                Content="{DynamicResource LOCPlayAch_Button_Browse}"
                                Command="{Binding BrowseCommand}"
                                Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                Margin="8,0,0,0" />
                        <Button Grid.Column="2"
                                Content="{DynamicResource LOCPlayAch_Button_Clear}"
                                Command="{Binding ClearIconCommand}"
                                Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                                Margin="8,0,0,0" />
                    </Grid>

                    <TextBlock Text="{DynamicResource LOCPlayAch_ManageAchievements_Custom_ProviderHint}"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVis}}" />
                    <TextBlock Text="{Binding StatusText}"
                               Style="{DynamicResource PlayAch.TextBlock.BaseStyle}"
                               Foreground="{DynamicResource PlayAch.Brush.ErrorText}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="{Binding HasStatusText, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Button Content="{DynamicResource LOCPlayAch_Common_Delete}"
                        Click="DeleteButton_Click"
                        HorizontalAlignment="Left"
                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                        MinWidth="80"
                        Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVis}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource LOCPlayAch_Button_Ok}"
                            Click="OkButton_Click"
                            IsEnabled="{Binding CanConfirm}"
                            Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                            MinWidth="80"
                            Margin="{StaticResource PlayAch.Thickness.Right.Sm}"
                            IsDefault="True" />
                    <Button Content="{DynamicResource LOCPlayAch_Button_Cancel}"
                            Click="CancelButton_Click"
                            Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                            MinWidth="80"
                            IsCancel="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
