<UserControl x:Class="PlayniteAchievements.Views.Dialogs.CategoryPickerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="200"
             d:DesignWidth="500">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/PlayAchImplicitControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource PlayAch.Brush.Window.Background}" Padding="16">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="{StaticResource PlayAch.Thickness.Bottom.Md}">
            <TextBlock Text="{Binding Hint}"
                       Style="{DynamicResource PlayAch.TextBlock.BaseStyle}"
                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                       Opacity="{StaticResource PlayAch.Opacity.Hint}"
                       TextWrapping="Wrap"
                       Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>

            <controls:CategoryPickerBox x:Name="PickerBox"
                                        Categories="{Binding Categories}"
                                        Placeholder="{DynamicResource LOCPlayAch_ManageAchievements_Category_InputPlaceholder}"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{DynamicResource LOCPlayAch_Button_Ok}"
                    Click="OkButton_Click"
                    Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                    MinWidth="80"
                    Margin="{StaticResource PlayAch.Thickness.Right.Sm}"
                    IsDefault="True"/>

            <Button Content="{DynamicResource LOCPlayAch_Button_Cancel}"
                    Click="CancelButton_Click"
                    Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                    MinWidth="80"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
    </Border>
</UserControl>
