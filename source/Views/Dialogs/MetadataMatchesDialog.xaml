<UserControl x:Class="PlayniteAchievements.Views.Dialogs.MetadataMatchesDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/PlayAchImplicitControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="MatchIconStyle" TargetType="Image">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
                <Setter Property="helpers:AsyncImage.DecodePixel" Value="64"/>
            </Style>

            <Style x:Key="MatchNameStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
                <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Body}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="MatchDetailStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text.Secondary}"/>
                <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Caption}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource PlayAch.Brush.Window.Background}" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- The game's achievements. -->
            <DockPanel Grid.Row="0" Grid.Column="0" Margin="{StaticResource PlayAch.Thickness.Bottom.Md}">
                <CheckBox DockPanel.Dock="Right"
                          Content="{DynamicResource LOCPlayAch_ManageAchievements_Overview_MetadataMatches_UnmatchedOnly}"
                          IsChecked="{Binding UnmatchedOnly, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="{StaticResource PlayAch.Thickness.Left.Sm}"/>
                <TextBox Text="{Binding TargetSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{DynamicResource LOCSearchLabel}"
                         Padding="8,6"
                         VerticalContentAlignment="Center"/>
            </DockPanel>

            <ListBox Grid.Row="1" Grid.Column="0"
                     ItemsSource="{Binding Targets}"
                     SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,3" ToolTip="{Binding Description}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Style="{StaticResource MatchIconStyle}" helpers:AsyncImage.Uri="{Binding Icon}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource MatchNameStyle}" Text="{Binding Name, Mode=OneWay}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="16" Height="16"
                                           Margin="0,0,4,0"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           helpers:AsyncImage.Uri="{Binding Trophy.Icon}"
                                           helpers:AsyncImage.DecodePixel="32"
                                           Visibility="{Binding IsMatched, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Style="{StaticResource MatchDetailStyle}" Text="{Binding PairingText, Mode=OneWay}"/>
                                    <TextBlock Style="{StaticResource MatchDetailStyle}"
                                               Text="{DynamicResource LOCPlayAch_ManageAchievements_Overview_MetadataLink_SetByYou}"
                                               Margin="{StaticResource PlayAch.Thickness.Left.Sm}"
                                               FontStyle="Italic"
                                               Visibility="{Binding IsUserSet, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- The source's rows. -->
            <TextBox Grid.Row="0" Grid.Column="2"
                     Text="{Binding TrophySearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{DynamicResource LOCSearchLabel}"
                     Padding="8,6"
                     VerticalContentAlignment="Center"
                     Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>

            <ListBox x:Name="TrophyList"
                     Grid.Row="1" Grid.Column="2"
                     ItemsSource="{Binding Trophies}"
                     SelectedItem="{Binding SelectedTrophy, Mode=TwoWay}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     MouseDoubleClick="TrophyList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,3" ToolTip="{Binding Description}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Style="{StaticResource MatchIconStyle}" helpers:AsyncImage.Uri="{Binding Icon}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource MatchNameStyle}" Text="{Binding Name, Mode=OneWay}"/>
                                <TextBlock Style="{StaticResource MatchDetailStyle}"
                                           Text="{Binding PairedWith, Mode=OneWay}"
                                           Visibility="{Binding IsPaired, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Pair the selections, or set the selected achievement to none or back to matching. -->
            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                        Orientation="Horizontal"
                        Margin="0,12,0,0">
                <Button Content="{DynamicResource LOCPlayAch_ManageAchievements_Overview_MetadataMatches_Pair}"
                        Command="{Binding PairCommand}"
                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                        Margin="{StaticResource PlayAch.Thickness.Right.Sm}"/>
                <Button Content="{DynamicResource LOCNone}"
                        Command="{Binding NoneCommand}"
                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                        Margin="{StaticResource PlayAch.Thickness.Right.Sm}"/>
                <Button Content="{DynamicResource LOCAutomatic}"
                        Command="{Binding AutomaticCommand}"
                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button Content="{DynamicResource LOCSaveLabel}"
                        Click="SaveButton_Click"
                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                        MinWidth="88"
                        Margin="{StaticResource PlayAch.Thickness.Right.Sm}"
                        IsDefault="True"/>
                <Button Content="{DynamicResource LOCCancelLabel}"
                        Click="CancelButton_Click"
                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                        MinWidth="88"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
