<UserControl x:Class="PlayniteAchievements.Views.Dialogs.GamePickerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="640">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/PlayAchImplicitControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource PlayAch.Brush.Window.Background}" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="SearchBox"
                     Grid.Row="0"
                     Padding="8,6"
                     VerticalContentAlignment="Center"
                     Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"
                     ToolTip="{DynamicResource LOCPlayAch_Common_Search}"
                     TextChanged="SearchBox_TextChanged"
                     KeyDown="SearchBox_KeyDown"/>

            <ListBox x:Name="GamesList"
                     Grid.Row="1"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     MouseDoubleClick="GamesList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      VerticalAlignment="Center"
                                      Margin="{StaticResource PlayAch.Thickness.Right.Sm}"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      IsEnabled="{Binding CanToggle, Mode=OneWay}"
                                      Visibility="{Binding ShowCheck, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name, Mode=OneWay}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           FontSize="{DynamicResource PlayAch.FontSize.Body}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Metadata, Mode=OneWay}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                           FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding HasMetadata, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Margin="{StaticResource PlayAch.Thickness.Left.Sm}"
                                       Text="{DynamicResource LOCPlayAch_Library_Applied}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                       FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                       Visibility="{Binding IsLocked, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button Content="{DynamicResource LOCPlayAch_Common_OK}"
                        Click="OkButton_Click"
                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                        MinWidth="88"
                        Margin="{StaticResource PlayAch.Thickness.Right.Sm}"
                        IsDefault="True"/>
                <Button Content="{DynamicResource LOCPlayAch_Common_Cancel}"
                        Click="CancelButton_Click"
                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                        MinWidth="88"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
