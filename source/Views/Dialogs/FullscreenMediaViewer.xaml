<UserControl x:Class="PlayniteAchievements.Views.Dialogs.FullscreenMediaViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280"
             Focusable="True">

    <UserControl.Resources>
        <!-- Self-contained white-on-translucent close button for the black lightbox. -->
        <Style x:Key="FullscreenCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="20" Background="#66000000">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#AA000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Black">
        <!-- Screenshot -->
        <Image x:Name="Img"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"
               helpers:AsyncImage.DecodePixel="-1"/>

        <!-- Video -->
        <MediaElement x:Name="Player"
                      Stretch="Uniform"
                      Visibility="Collapsed"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      ScrubbingEnabled="True"
                      MediaOpened="Player_MediaOpened"
                      MediaEnded="Player_MediaEnded"
                      MediaFailed="Player_MediaFailed"/>

        <!-- Transparent click layer: closes for images, toggles play/pause for video. -->
        <Border x:Name="ClickLayer"
                Background="Transparent"
                MouseLeftButtonUp="ClickLayer_MouseLeftButtonUp"/>

        <TextBlock x:Name="ErrorText"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Foreground="White"
                   Visibility="Collapsed"
                   Text="{DynamicResource LOCPlayAch_Captures_VideoError}"/>

        <!-- Declared after the click layer so the transport takes its own clicks instead of
             toggling playback through the layer beneath it. -->
        <controls:MediaTransportBar x:Name="Transport"
                                    VerticalAlignment="Bottom"
                                    Margin="24"
                                    MaxWidth="900"
                                    Visibility="Collapsed"/>

        <Button x:Name="CloseButton"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="16"
                Content="&#xE711;"
                Style="{StaticResource FullscreenCloseButtonStyle}"
                Click="CloseButton_Click"/>
    </Grid>
</UserControl>
