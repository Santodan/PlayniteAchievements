<UserControl x:Class="PlayniteAchievements.Views.Dialogs.IcoFontPickerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="520">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/PlayAchImplicitControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource PlayAch.Brush.Window.Background}" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="SearchBox"
                     Grid.Row="0"
                     Padding="8,6"
                     VerticalContentAlignment="Center"
                     ToolTip="{DynamicResource LOCSearchLabel}"
                     TextChanged="SearchBox_TextChanged"
                     Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>

            <!-- One button per glyph; the name is the tooltip and what the search matches. -->
            <ListBox x:Name="GlyphList"
                     Grid.Row="1"
                     SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="GlyphList_MouseDoubleClick">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Glyph}"
                                   ToolTip="{Binding Name}"
                                   FontFamily="{DynamicResource PlayAch.FontFamily.Icon}"
                                   FontSize="22"
                                   Width="32"
                                   Height="32"
                                   TextAlignment="Center"
                                   Padding="0,4,0,0"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   TextOptions.TextFormattingMode="Display"
                                   TextOptions.TextRenderingMode="Grayscale"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2" Margin="{StaticResource PlayAch.Thickness.Top.Md}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="{DynamicResource LOCNone}"
                        Click="NoneButton_Click"
                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                        MinWidth="80"/>

                <TextBlock x:Name="SelectedName"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Margin="12,0"
                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                           Opacity="{StaticResource PlayAch.Opacity.Hint}"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="{DynamicResource LOCOKLabel}"
                            Click="OkButton_Click"
                            Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                            MinWidth="80"
                            Margin="{StaticResource PlayAch.Thickness.Right.Sm}"
                            IsDefault="True"/>
                    <Button Content="{DynamicResource LOCCancelLabel}"
                            Click="CancelButton_Click"
                            Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                            MinWidth="80"
                            IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
