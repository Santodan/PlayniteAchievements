<UserControl x:Class="PlayniteAchievements.Views.Dialogs.GameSearchDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="720">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/PlayAchImplicitControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource PlayAch.Brush.Window.Background}" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:GameSearchPanel x:Name="SearchPanel"
                                      Grid.Row="0"
                                      Accepted="SearchPanel_Accepted"
                                      Cancelled="SearchPanel_Cancelled"/>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button Content="{DynamicResource LOCPlayAch_Button_Apply}"
                        Click="ApplyButton_Click"
                        IsEnabled="{Binding CanAccept}"
                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                        MinWidth="88"
                        Margin="{StaticResource PlayAch.Thickness.Right.Sm}"/>
                <Button Content="{DynamicResource LOCPlayAch_Common_Cancel}"
                        Click="CancelButton_Click"
                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                        MinWidth="88"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
