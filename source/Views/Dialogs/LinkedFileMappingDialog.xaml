<UserControl x:Class="PlayniteAchievements.Views.Dialogs.LinkedFileMappingDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:PlayniteAchievements.ViewModels"
             xmlns:converters="clr-namespace:PlayniteAchievements.Views.Converters"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="980"
             d:DataContext="{d:DesignInstance vm:LinkedFileMappingViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/PlayAchImplicitControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BooleanConverter x:Key="BoolToVis" Mode="ToVisibility" />

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource PlayAch.TextBlock.BaseStyle}">
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}" />
                <Setter Property="Opacity" Value="{StaticResource PlayAch.Opacity.Hint}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource PlayAch.TextBlock.BaseStyle}">
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="HintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PlayAch.TextBlock.BaseStyle}">
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}" />
                <Setter Property="Opacity" Value="{StaticResource PlayAch.Opacity.Hint}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="OptionCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Margin" Value="0,0,16,6" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayAch.Button.ToolbarIconStyle}">
                <Setter Property="Margin" Value="4,0,0,0" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            </Style>

            <!-- The match column's header is plain text; the file columns' headers host a field picker. -->
            <Style x:Key="MatchColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                <Setter Property="VerticalContentAlignment" Value="Bottom" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <DataTemplate x:Key="MatchColumnHeaderTemplate">
                <TextBlock Text="{Binding}" Margin="2" TextTrimming="CharacterEllipsis" />
            </DataTemplate>

            <Style x:Key="MatchCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PlayAch.TextBlock.BaseStyle}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMatched}" Value="False">
                        <Setter Property="Opacity" Value="{StaticResource PlayAch.Opacity.Hint}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource PlayAch.Brush.Window.Background}" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Source: the file, its format and the options its format needs, and presets -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="{DynamicResource LOCPlayAch_Common_Source}" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathTextBox"
                             Grid.Column="0"
                             VerticalContentAlignment="Center"
                             MinHeight="{StaticResource PlayAch.Size.Control.Height}"
                             Text="{Binding FilePath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             AutomationProperties.Name="{DynamicResource LOCPlayAch_LinkedFile_File}"
                             KeyDown="CommitOnEnter_KeyDown" />
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Content="{DynamicResource LOCPlayAch_Button_Browse}"
                            Command="{Binding BrowseCommand}" />
                    <TextBlock Grid.Column="2" Margin="16,0,8,0" Text="{DynamicResource LOCPlayAch_LinkedFile_Format}" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox Grid.Column="3"
                              Width="170"
                              ItemsSource="{Binding FormatOptions}"
                              SelectedItem="{Binding SelectedFormat, Mode=TwoWay}"
                              DisplayMemberPath="Name" />
                </Grid>

                <DockPanel Margin="0,8,0,0" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="{DynamicResource LOCPlayAch_Presets_Header}" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Width="200"
                                  ItemsSource="{Binding SavedNames}"
                                  SelectedItem="{Binding SelectedSavedName, Mode=TwoWay}" />
                        <Button x:Name="PresetActionsButton"
                                Content="&#xEFA2;"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="{DynamicResource LOCPlayAch_Presets_Header}"
                                AutomationProperties.Name="{DynamicResource LOCPlayAch_Presets_Header}"
                                Click="PresetActionsButton_Click" />
                    </StackPanel>

                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsDelimited, Converter={StaticResource BoolToVis}}" Margin="0,0,16,6">
                            <TextBlock Text="{DynamicResource LOCPlayAch_LinkedFile_Delimiter}" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Width="120"
                                      IsEditable="True"
                                      ItemsSource="{Binding DelimiterOptions}"
                                      Text="{Binding DelimiterText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                      SelectionChanged="CommitOnSelection_SelectionChanged"
                                      KeyDown="CommitOnEnter_KeyDown" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsXlsx, Converter={StaticResource BoolToVis}}" Margin="0,0,16,6">
                            <TextBlock Text="{DynamicResource LOCPlayAch_LinkedFile_Sheet}" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Width="200"
                                      IsEditable="True"
                                      ItemsSource="{Binding SheetNames}"
                                      Text="{Binding SheetName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                      SelectionChanged="CommitOnSelection_SelectionChanged"
                                      KeyDown="CommitOnEnter_KeyDown" />
                        </StackPanel>
                        <CheckBox Content="{DynamicResource LOCPlayAch_LinkedFile_HasHeader}"
                                  IsChecked="{Binding HasHeader, Mode=TwoWay}"
                                  Style="{StaticResource OptionCheckBoxStyle}"
                                  Visibility="{Binding UsesHeaderRow, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding UsesRootPath, Converter={StaticResource BoolToVis}}" Margin="0,0,16,6">
                            <TextBlock Text="{DynamicResource LOCPlayAch_LinkedFile_RootPath}" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Width="260"
                                      IsEditable="True"
                                      ItemsSource="{Binding RowPaths}"
                                      Text="{Binding RootPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                      ToolTip="{DynamicResource LOCPlayAch_LinkedFile_RootPathHint}"
                                      SelectionChanged="CommitOnSelection_SelectionChanged"
                                      KeyDown="CommitOnEnter_KeyDown" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsXml, Converter={StaticResource BoolToVis}}" Margin="0,0,16,6">
                            <TextBlock Text="{DynamicResource LOCPlayAch_LinkedFile_RowElementPath}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Width="260"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding RowElementPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="{DynamicResource LOCPlayAch_LinkedFile_RowElementPathHint}"
                                     KeyDown="CommitOnEnter_KeyDown" />
                        </StackPanel>
                    </WrapPanel>
                </DockPanel>
            </StackPanel>

            <!-- Columns: each file column's header picks the field it feeds; the first column shows the match -->
            <DockPanel Grid.Row="1" Margin="0,10,0,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right"
                            Content="&#xEFD1;"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="{DynamicResource LOCPlayAch_Button_Refresh}"
                            AutomationProperties.Name="{DynamicResource LOCPlayAch_Button_Refresh}"
                            Command="{Binding RereadCommand}" />
                    <TextBlock DockPanel.Dock="Right"
                               Margin="0,0,4,0"
                               Text="{Binding PreviewCountText}"
                               Style="{StaticResource HintTextStyle}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource LOCPlayAch_Common_Columns}" Style="{StaticResource SectionHeaderStyle}" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,0,0,6"
                           Text="{Binding ReadMessage}"
                           Foreground="{DynamicResource PlayAch.Brush.AuthError}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasReadMessage, Converter={StaticResource BoolToVis}}" />
                <DataGrid x:Name="PreviewGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserSortColumns="False"
                          CanUserReorderColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          SelectionUnit="FullRow"
                          FrozenColumnCount="1"
                          EnableColumnVirtualization="True"
                          EnableRowVirtualization="True"
                          MinColumnWidth="140"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ItemsSource="{Binding PreviewRows}">
                    <!-- A preview, not a list to act on: a clicked row keeps the grid's own look. -->
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <StackPanel Margin="2">
                                            <ComboBox ItemsSource="{Binding DataContext.FieldOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      SelectedItem="{Binding SelectedField, Mode=TwoWay}"
                                                      DisplayMemberPath="Name"
                                                      MinWidth="120" />
                                            <TextBlock Text="{Binding ColumnName}"
                                                       Margin="2,4,0,0"
                                                       Style="{StaticResource HintTextStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                </DataGrid>
            </DockPanel>

            <!-- Settings that only matter for some mappings show only then -->
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock Text="{DynamicResource LOCPlayAch_Common_Settings}" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding UsesTimeOptions, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource LOCPlayAch_LinkedFile_TimeFormat}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,6" />
                        <ComboBox Width="170"
                                  Margin="0,0,8,6"
                                  ItemsSource="{Binding TimeFormatOptions}"
                                  SelectedItem="{Binding SelectedTimeFormat, Mode=TwoWay}"
                                  DisplayMemberPath="Name" />
                        <TextBox Width="160"
                                 Margin="0,0,8,6"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding CustomTimeFormat, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Visibility="{Binding IsCustomTimeFormat, Converter={StaticResource BoolToVis}}"
                                 KeyDown="CommitOnEnter_KeyDown" />
                        <CheckBox Content="{DynamicResource LOCPlayAch_LinkedFile_TimesAreLocal}" IsChecked="{Binding TimesAreLocal, Mode=TwoWay}" Style="{StaticResource OptionCheckBoxStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding UsesUnlockedValues, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource LOCPlayAch_LinkedFile_UnlockedValues}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,6" />
                        <TextBox Width="160"
                                 Margin="0,0,16,6"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding UnlockedValues, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="{DynamicResource LOCPlayAch_LinkedFile_UnlockedValuesHint}"
                                 KeyDown="CommitOnEnter_KeyDown" />
                    </StackPanel>
                    <CheckBox Content="{DynamicResource LOCPlayAch_LinkedFile_CreateUnmatched}"
                              IsChecked="{Binding CreateUnmatched, Mode=TwoWay}"
                              ToolTip="{DynamicResource LOCPlayAch_LinkedFile_CreateUnmatchedHint}"
                              Style="{StaticResource OptionCheckBoxStyle}" />
                </WrapPanel>
            </StackPanel>

            <!-- What applying would do -->
            <StackPanel Grid.Row="3" Margin="0,4,0,0">
                <TextBlock Text="{Binding ProblemText}"
                           Foreground="{DynamicResource PlayAch.Brush.AuthError}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4"
                           Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}" />
                <DockPanel>
                    <!-- Pairs achievements with file rows by hand (IcoFont pencil-alt-2, as on the Overview's metadata matches). -->
                    <Button DockPanel.Dock="Right"
                            Content="&#xEBF6;"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="{DynamicResource LOCPlayAch_Common_Edit}"
                            AutomationProperties.Name="{DynamicResource LOCPlayAch_Common_Edit}"
                            Command="{Binding EditPairingsCommand}"
                            VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ResultText}" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" />
                </DockPanel>
                <Expander Margin="0,6,0,0"
                          Header="{Binding UnmatchedAchievementsHeader}"
                          Visibility="{Binding HasUnmatchedAchievements, Converter={StaticResource BoolToVis}}">
                    <ListBox ItemsSource="{Binding UnmatchedAchievements}" MaxHeight="120" />
                </Expander>
            </StackPanel>

            <!-- Footer -->
            <DockPanel Grid.Row="4" Margin="0,14,0,0">
                <Button DockPanel.Dock="Left"
                        Content="{DynamicResource LOCPlayAch_LinkedFile_Unlink}"
                        Command="{Binding UnlinkCommand}"
                        Visibility="{Binding HasStoredLink, Converter={StaticResource BoolToVis}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource LOCPlayAch_Button_Apply}"
                            Command="{Binding ApplyNowCommand}"
                            ToolTip="{DynamicResource LOCPlayAch_LinkedFile_OverwriteHint}"
                            Margin="0,0,8,0" />
                    <Button Content="{DynamicResource LOCPlayAch_Common_Cancel}" Click="Cancel_Click" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
