<UserControl x:Class="PlayniteAchievements.Views.Showcase.ShowcaseWidgetControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             SizeChanged="OnSizeChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Views/Showcase/ShowcaseWidgetTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border x:Name="RootBorder"
            BorderBrush="{DynamicResource PlayAch.Brush.Border}"
            CornerRadius="{StaticResource PlayAch.Radius.Section}"
            ClipToBounds="True">
        <!-- Fill and outline are style setters, not local values, so the ShowCardChrome
             trigger can clear them. Transparent (not null) keeps gaps hit-testable. -->
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.Surface}"/>
                <Setter Property="BorderThickness" Value="{StaticResource PlayAch.Thickness.Border}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowCardChrome, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Value="False">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <!-- Clipped to the card's rounded inner outline in code (OnRootContentSizeChanged):
             ClipToBounds only clips to the rectangle, so full-bleed content drew over the
             rounded corners and the border. -->
        <Grid x:Name="RootContent" SizeChanged="OnRootContentSizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border x:Name="HeaderBorder"
                    Grid.Row="0"
                    Background="{StaticResource PlayAch.Brush.Overlay.Tint.08}"
                    Padding="9,5"
                    Visibility="Collapsed">
                <TextBlock x:Name="TitleText"
                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                           FontWeight="SemiBold"
                           FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
            <ContentControl x:Name="BodyHost"
                            Grid.Row="1"
                            Margin="8"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
        </Grid>
    </Border>
</UserControl>
