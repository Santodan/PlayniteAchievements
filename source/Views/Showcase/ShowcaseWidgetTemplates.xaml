<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
                    xmlns:converters="clr-namespace:PlayniteAchievements.Views.Converters"
                    xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
                    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
                    xmlns:showcase="clr-namespace:PlayniteAchievements.Views.Showcase"
                    xmlns:widgets="clr-namespace:PlayniteAchievements.ViewModels.Showcase.Widgets">

    <converters:BooleanConverter x:Key="BoolToVis" Mode="ToVisibility"/>
    <converters:ResourceKeyToImageSourceConverter x:Key="ShowcaseResourceKeyToImage"/>
    <converters:RaritySelectionIncludesCompletedConverter x:Key="RaritySelectionIncludesCompleted"/>
    <converters:ProviderIconConverter x:Key="ShowcaseProviderIcon"/>

    <!-- Mosaics can hold 64 tiles, each carrying artwork, a glow effect, and a ray burst that
         redraws while it is on screen. A plain ItemsControl in a ScrollViewer realizes all of
         them at once; this container virtualizes so only the tiles in view exist, while keeping
         the item chrome invisible (the tiles draw themselves). -->
    <Style x:Key="ShowcaseMosaicItemStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Value/label tile used by the Statistics widget. -->
    <DataTemplate x:Key="ShowcaseStatTileTemplate">
        <Border Background="{DynamicResource PlayAch.Brush.Overlay.Tint.08}"
                CornerRadius="{StaticResource PlayAch.Radius.Card}"
                Margin="3"
                Padding="8,6"
                ClipToBounds="True">
            <StackPanel>
                <TextBlock Text="{Binding Value}"
                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                           FontWeight="SemiBold"
                           FontSize="{DynamicResource PlayAch.FontSize.SectionHeader}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Label}"
                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                           Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                           FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Implicit templates: the widget host sets BodyHost.Content to a per-kind view model and
         WPF resolves the matching template by runtime type. One template per kind. -->

    <!-- Profile: avatar + name/subtitle over the provider identity (manual overrides win),
         with a medal-count row and a stat strip over the instance's configured stat slots.
         The zero-size image owns the avatar decode (AsyncImage wants a loaded Image); the
         rounded border's brush consumes its Source so the art clips to the corner radius. -->
    <DataTemplate DataType="{x:Type widgets:ProfileWidgetViewModel}">
        <Grid>
            <!-- The banner renders at full strength (no wash — a flat opacity reads as a tint
                 over the card surface) and only fades out toward the stat strip; the drop
                 shadows on the foreground elements keep them legible over the art. An
                 OpacityMask only samples alpha, so the white gradient stops carry no tint.
                 A full-bleed banner follows the card's rounded corners through the widget
                 host's rounded clip. Center alignment keeps the overflowing UniformToFill art
                 centered in the card; Stretch alignment anchors the overflow at the top-left. -->
            <Image Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Visibility="{Binding HasBackground, Converter={StaticResource BoolToVis}}"
                   helpers:AsyncImage.Uri="{Binding BackgroundPath}"
                   helpers:AsyncImage.DecodePixel="{Binding BackgroundDecodePixel}">
                <Image.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                        <GradientStop Color="#CCFFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Image.OpacityMask>
            </Image>
            <Grid Margin="{Binding ContentPadding}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Beside (default): avatar left, text right. Centered: avatar stacked over the
                     text, both spanning the width. Layout properties the triggers change live in
                     style setters, since a local attribute would outrank the trigger. -->
                <!-- Centered layout: the same row, sized to its content and centered. -->
                <Grid VerticalAlignment="Center">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCenteredRow}" Value="True">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVis}}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Margin" Value="0,0,14,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStacked}" Value="True">
                                        <Setter Property="Grid.ColumnSpan" Value="2"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="0,0,0,10"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Image x:Name="ProfileAvatarSource"
                               Width="0"
                               Height="0"
                               Opacity="0"
                               IsHitTestVisible="False"
                               helpers:AsyncImage.Uri="{Binding AvatarPath}"
                               helpers:AsyncImage.DecodePixel="{Binding AvatarDecodePixel}"/>
                        <Border Width="{Binding AvatarSize}"
                                Height="{Binding AvatarSize}"
                                CornerRadius="{Binding AvatarCornerRadius}"
                                SnapsToDevicePixels="True">
                            <Border.Background>
                                <ImageBrush Stretch="UniformToFill"
                                            ImageSource="{Binding Source, ElementName=ProfileAvatarSource}"/>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.4"/>
                            </Border.Effect>
                        </Border>
                    </Grid>
                    <!-- One shadow per content block (not per element): each Effect renders its
                         subtree through one intermediate, so container-level shadows keep the
                         card at three effect surfaces total. -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Grid.Column" Value="1"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStacked}" Value="True">
                                        <Setter Property="Grid.Column" Value="0"/>
                                        <Setter Property="Grid.ColumnSpan" Value="2"/>
                                        <Setter Property="Grid.Row" Value="1"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.6"/>
                        </StackPanel.Effect>
                        <TextBlock Text="{Binding DisplayName}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   FontWeight="Bold"
                                   FontSize="{DynamicResource PlayAch.FontSize.SectionHeader}"
                                   TextAlignment="{Binding TextAlignment}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Subtitle}"
                                   TextAlignment="{Binding TextAlignment}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                                   FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ShowSubtitle, Converter={StaticResource BoolToVis}}"/>
                        <!-- Platform profile links: one provider icon per link, opening the
                             profile page in the browser. -->
                        <ItemsControl ItemsSource="{Binding Links}"
                                      Margin="0,6,0,0"
                                      Focusable="False"
                                      Visibility="{Binding ShowLinks, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStacked}" Value="True">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding OpenCommand}"
                                            ToolTip="{Binding ToolTip}"
                                            Cursor="Hand"
                                            Focusable="False"
                                            Margin="0,0,8,2">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="LinkBorder"
                                                        Background="Transparent"
                                                        Opacity="0.85">
                                                    <Image Width="18"
                                                           Height="18"
                                                           SnapsToDevicePixels="True"
                                                           RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.Source>
                                                            <MultiBinding Converter="{StaticResource ShowcaseProviderIcon}">
                                                                <Binding Path="IconKey"/>
                                                                <Binding Path="ColorHex"/>
                                                            </MultiBinding>
                                                        </Image.Source>
                                                    </Image>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="LinkBorder" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Medals}"
                                      Margin="0,6,0,0"
                                      Visibility="{Binding ShowMedals, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStacked}" Value="True">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- A trailing-only gap would pull a centered row left, so the
                                         centered layout splits it across both sides. -->
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Margin" Value="0,0,12,2"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsStacked, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                        <Setter Property="Margin" Value="6,0,6,2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Image Source="{Binding IconKey, Converter={StaticResource ShowcaseResourceKeyToImage}}"
                                               Width="16"
                                               Height="16"
                                               VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CountText}"
                                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                   FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
                <!-- Open value/label columns under a hairline, instead of the Statistics widget's
                     boxed tiles, so the strip reads as part of the card. -->
                <StackPanel Grid.Row="1"
                            Margin="0,8,0,0"
                            Visibility="{Binding ShowStatStrip, Converter={StaticResource BoolToVis}}">
                    <StackPanel.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.6"/>
                    </StackPanel.Effect>
                    <Rectangle Height="1"
                               Fill="{DynamicResource PlayAch.Brush.Border}"
                               Opacity="0.4"
                               SnapsToDevicePixels="True"/>
                    <ItemsControl ItemsSource="{Binding Stats}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <showcase:ShowcaseStatGridPanel Columns="{Binding StatColumns}"
                                                                CenterLastRow="{Binding CenterStats}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Margin" Value="3,2,10,2"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsStacked, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                    <Setter Property="Margin" Value="6,2,6,2"/>
                                                </DataTrigger>
                                                <!-- Centered: the strip keeps its equal columns across the card and
                                                     each stat centers within its own column (centering the whole
                                                     strip shrank the columns together). -->
                                                <DataTrigger Binding="{Binding DataContext.IsCenteredRow, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                    <Setter Property="Margin" Value="6,2,6,2"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding Value}"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               FontWeight="SemiBold"
                                               FontSize="{DynamicResource PlayAch.FontSize.SectionHeader}"
                                               TextAlignment="{Binding DataContext.TextAlignment, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                                               FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                               TextAlignment="{Binding DataContext.TextAlignment, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- Scores: reuses ScoreCardControl for the collection and/or prestige card, with a
         cumulative score-over-time line under each card outside compact. -->
    <DataTemplate DataType="{x:Type widgets:ScoresWidgetViewModel}">
      <Grid>
        <!-- One info affordance for the widget. The cards themselves carry none: with both the
             collection and prestige card on screen, a per-card glyph appeared twice and competed
             with the label that tells the two cards apart. -->
        <Button Style="{DynamicResource PlayAch.Button.InfoGlyphStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Panel.ZIndex="1"
                Margin="0,2,4,0"
                ToolTip="{DynamicResource LOCPlayAch_Score_Info_ButtonTooltip}"
                showcase:ScoreCardInfoBehavior.Enabled="True"/>
        <ItemsControl ItemsSource="{Binding Cards}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="{Binding Rows}"
                                 Columns="{Binding Columns}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Grid rows (not a StackPanel) so the chart row takes whatever height the
                         cell has left: a tall cell grows the chart, a small cell compresses it
                         instead of clipping the date labels off the bottom. A card without a
                         chart has nothing to grow, so it centers in the cell instead. -->
                    <Grid Margin="4"
                          MaxWidth="{Binding DataContext.MaxCardWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="VerticalAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowChart}" Value="False">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <controls:ScoreCardControl
                            ScoreCard="{Binding Card}"
                            IsFeatured="{Binding DataContext.IsFeatured, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Flat="True"
                            MinWidth="0"
                            HorizontalAlignment="Stretch"/>
                        <TextBlock Grid.Row="1"
                                   Margin="6,2,6,0"
                                   Text="{Binding HistoryCaption}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                                   FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                   Visibility="{Binding ShowChart, Converter={StaticResource BoolToVis}}"/>
                        <lvc:CartesianChart Grid.Row="2"
                                            MinHeight="34"
                                            LegendLocation="None"
                                            Hoverable="True"
                                            DisableAnimations="True"
                                            Margin="6,2,6,0"
                                            TooltipTimeout="0:0:0.1"
                                            Visibility="{Binding ShowChart, Converter={StaticResource BoolToVis}}">
                            <lvc:CartesianChart.DataTooltip>
                                <controls:CartesianChartTooltip/>
                            </lvc:CartesianChart.DataTooltip>
                            <lvc:CartesianChart.Series>
                                <lvc:LineSeries Title="{Binding Card.Label}"
                                                Values="{Binding HistoryValues}"
                                                Stroke="{Binding Card.AccentBrush}"
                                                Fill="{Binding Card.AccentBackgroundBrush}"
                                                StrokeThickness="2"
                                                PointGeometry="{x:Null}"
                                                LineSmoothness="0"/>
                            </lvc:CartesianChart.Series>
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Labels="{Binding HistoryLabels}" ShowLabels="False">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator IsEnabled="False"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <!-- Floor at the window minimum, ceiling just above the window
                                     maximum (or at the next tier when that is close), so the
                                     line spans the chart height; the sections mark the current
                                     tier's start and the next tier when it is the ceiling. -->
                                <lvc:Axis ShowLabels="True"
                                          FontSize="10"
                                          Foreground="{DynamicResource PlayAch.Brush.Text}"
                                          LabelFormatter="{Binding YLabelFormatter}"
                                          MinValue="{Binding HistoryMinValue}"
                                          MaxValue="{Binding HistoryAxisMax}"
                                          Sections="{Binding TierSections}">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator Stroke="{DynamicResource PlayAch.Brush.Border}" Opacity="0.2"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                        <Grid Grid.Row="3"
                              Margin="6,1,6,0"
                              Visibility="{Binding ShowChart, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding HistoryStartText}"
                                       HorizontalAlignment="Left"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       Opacity="{StaticResource PlayAch.Opacity.Muted}"
                                       FontSize="{DynamicResource PlayAch.FontSize.Caption}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding HistoryEndText}"
                                       HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       Opacity="{StaticResource PlayAch.Opacity.Muted}"
                                       FontSize="{DynamicResource PlayAch.FontSize.Caption}"/>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </DataTemplate>

    <!-- IconMosaic: centered wrap of reused AchievementCompactItemControl icons. A click opens
         the View Achievements window on the achievement, as the compact lists do. -->
    <DataTemplate DataType="{x:Type widgets:IconMosaicWidgetViewModel}">
      <DockPanel>
        <controls:GridControlBarControl DockPanel.Dock="Top"
                                        Margin="0,0,0,8"
                                        ControlBar="{Binding ControlBar}"
                                        ShowControlBar="{Binding ShowControlBar}"/>
        <ListBox ItemsSource="{Binding Items}"
                 showcase:ShowcaseMosaicClickBehavior.IsEnabled="True"
                 Cursor="Hand"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="6"
                 ItemContainerStyle="{StaticResource ShowcaseMosaicItemStyle}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- Packs the tiles at the spacing option's gap and centers them. -->
                    <showcase:ShowcaseMosaicWrapPanel Orientation="Horizontal"
                                                      VirtualizingPanel.CacheLengthUnit="Item"
                                                      VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <controls:AchievementCompactItemControl
                        IconSize="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        ShowRarityGlow="{Binding DataContext.ShowRarityGlow, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        ShowRarityBarOverride="{Binding DataContext.ShowRarityBar, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        GlowWhenLocked="{Binding DataContext.GlowWhenLocked, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        AnimateRarityGlows="{Binding DataContext.AnimateRarityGlows, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        UseLargeRarityGlow="True"
                        Margin="{Binding DataContext.TileMargin, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </DataTemplate>

    <!-- Pie: reuses PieChartWithRadialIcons with an optional legend on the right; the pair is centered. -->
    <DataTemplate DataType="{x:Type widgets:PieWidgetViewModel}">
        <showcase:ShowcasePieLegendPanel>
            <controls:PieChartWithRadialIcons
                PieSeries="{Binding Chart.PieSeries}"
                LegendItems="{Binding Chart.LegendItems}"
                HighlightedLabels="{Binding Chart.HighlightedLabels}"
                ExactUnlockedCount="{Binding Chart.ExactUnlockedCount}"
                ExactTotalCount="{Binding Chart.ExactTotalCount}"
                ShowCenterPercentage="{Binding Chart.ShowCenterPercentage}"
                PieMargin="23"
                MinHeight="70"/>
            <ItemsControl ItemsSource="{Binding LegendRows}"
                          VerticalAlignment="Center"
                          Margin="16,0,0,0"
                          Visibility="{Binding ShowLegend, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="8"
                                    Height="8"
                                    CornerRadius="4"
                                    Margin="0,0,7,0"
                                    VerticalAlignment="Center"
                                    Background="{Binding Swatch}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Label}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       Opacity="{StaticResource PlayAch.Opacity.Hint}"
                                       FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding CountText}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </showcase:ShowcasePieLegendPanel>
    </DataTemplate>

    <!-- Timeline: the reused LiveCharts column chart with range buttons, identical at every size. -->
    <DataTemplate DataType="{x:Type widgets:TimelineWidgetViewModel}">
        <Grid>
            <TextBlock Text="{DynamicResource LOCPlayAch_Showcase_NoData}"
                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                       Opacity="{StaticResource PlayAch.Opacity.Placeholder}"
                       FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}"/>
            <Grid Visibility="{Binding ShowChart, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <lvc:CartesianChart Series="{Binding Timeline.TimelineSeries}"
                                    LegendLocation="None"
                                    Hoverable="True"
                                    TooltipTimeout="0:0:0.1"
                                    DisableAnimations="True">
                    <lvc:CartesianChart.DataTooltip>
                        <controls:CartesianChartTooltip/>
                    </lvc:CartesianChart.DataTooltip>
                    <lvc:CartesianChart.Resources>
                        <Style TargetType="lvc:ColumnSeries">
                            <Setter Property="Fill" Value="{DynamicResource PlayAch.Brush.Accent}"/>
                        </Style>
                    </lvc:CartesianChart.Resources>
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Labels="{Binding Timeline.TimelineLabels}"
                                  ShowLabels="True"
                                  LabelsRotation="45"
                                  FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                  Foreground="{DynamicResource PlayAch.Brush.Text}">
                            <lvc:Axis.Separator>
                                <lvc:Separator Step="1" IsEnabled="False"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisX>
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis MinValue="0"
                                  LabelFormatter="{Binding Timeline.YAxisFormatter}"
                                  FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                  Foreground="{DynamicResource PlayAch.Brush.Text}">
                            <lvc:Axis.Separator>
                                <lvc:Separator Stroke="{DynamicResource PlayAch.Brush.Border}" Opacity="0.2"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>
                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding Ranges}"
                              HorizontalAlignment="Center"
                              Margin="0,5,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}"
                                    Command="{Binding DataContext.SetRangeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Value}"
                                    Margin="2,0"
                                    Padding="6,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- Statistics: scrolling grid of value/label tiles. -->
    <DataTemplate DataType="{x:Type widgets:StatisticsWidgetViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Tiles}"
                          ItemTemplate="{StaticResource ShowcaseStatTileTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding Columns}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </DataTemplate>

    <!-- NativePoints: horizontal bars of top-N points by provider or game. -->
    <DataTemplate DataType="{x:Type widgets:NativePointsWidgetViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource PlayAch.Brush.Overlay.Tint.08}"
                                CornerRadius="{StaticResource PlayAch.Radius.Card}"
                                Margin="0,1,0,5"
                                Padding="8,5"
                                ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ValueText}"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               FontWeight="SemiBold"
                                               FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                               Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding SecondaryText}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           Opacity="{StaticResource PlayAch.Opacity.Muted}"
                                           FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSecondary}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ProgressBar Grid.Row="2"
                                             Minimum="0"
                                             Maximum="1"
                                             Value="{Binding Fraction, Mode=OneWay}"
                                             Height="3"
                                             Margin="0,4,0,0"
                                             VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DataTemplate>

    <!-- PinnedAchievements: an instance-owned achievement grid over the selected collection with pin reordering.
         Display DPs bind through GridOptions, the widget's live grid-options record; when it is
         null (no catalog supplied) each DP keeps its default. -->
    <DataTemplate DataType="{x:Type widgets:PinnedAchievementsWidgetViewModel}">
        <showcase:ShowcaseAchievementGridControl ItemsSource="{Binding Items}"
                                                 ColumnSettingsKey="{Binding ColumnSettingsKey}"
                                                 PinCollectionId="{Binding PinCollectionId}"
                                                 ControlBar="{Binding ControlBar}"
                                                 ShowControlBar="{Binding GridOptions.ShowControlBar, FallbackValue=False}"
                                                 EnablePinReorder="True"
                                                 ShowColumnHeaders="{Binding GridOptions.ShowColumnHeaders, FallbackValue=True}"
                                                 FixedRowHeight="{Binding GridOptions.RowHeight, FallbackValue={x:Null}}"
                                                 UseCoverImages="{Binding GridOptions.UseCoverImages, FallbackValue=False}"
                                                 ShowRarityGlow="{Binding GridOptions.ShowRarityGlow, FallbackValue=True}"
                                                 ColorNamesByRarity="{Binding GridOptions.ColorNamesByRarity, FallbackValue=False}"
                                                 ColorRarityColumnsByRarity="{Binding GridOptions.ColorRarityColumnsByRarity, FallbackValue=False}"/>
    </DataTemplate>

    <!-- Pinned games: the shared game-summaries grid over pinned (or favorite) games. -->
    <DataTemplate DataType="{x:Type widgets:FavoriteGamesWidgetViewModel}">
        <showcase:ShowcaseGameGridControl ItemsSource="{Binding Items}"
                                          ColumnSettingsKey="{Binding ColumnSettingsKey}"
                                          PinCollectionId="{Binding PinCollectionId}"
                                          ControlBar="{Binding ControlBar}"
                                          ShowControlBar="{Binding GridOptions.ShowControlBar, FallbackValue=False}"
                                          EnablePinReorder="{Binding PinReorderEnabled}"
                                          ShowColumnHeaders="{Binding GridOptions.ShowColumnHeaders, FallbackValue=True}"
                                          FixedRowHeight="{Binding GridOptions.RowHeight, FallbackValue={x:Null}}"
                                          UseCoverImages="{Binding GridOptions.UseCoverImages, FallbackValue=False}"
                                          ShowCompletionGlow="{Binding GridOptions.ShowCompletionGlow, FallbackValue=True}"
                                          ShowMetadataPlatform="{Binding GridOptions.ShowMetadataPlatform, FallbackValue=True}"
                                          ShowMetadataPlaytime="{Binding GridOptions.ShowMetadataPlaytime, FallbackValue=True}"
                                          ShowMetadataRegion="{Binding GridOptions.ShowMetadataRegion, FallbackValue=True}"/>
    </DataTemplate>

    <!-- RecentAchievements: the shared achievement grid over the latest unlocks. -->
    <DataTemplate DataType="{x:Type widgets:RecentAchievementsWidgetViewModel}">
        <showcase:ShowcaseAchievementGridControl ItemsSource="{Binding Items}"
                                                 ColumnSettingsKey="{Binding ColumnSettingsKey}"
                                                 ControlBar="{Binding ControlBar}"
                                                 ShowControlBar="{Binding GridOptions.ShowControlBar, FallbackValue=False}"
                                                 ShowColumnHeaders="{Binding GridOptions.ShowColumnHeaders, FallbackValue=True}"
                                                 FixedRowHeight="{Binding GridOptions.RowHeight, FallbackValue={x:Null}}"
                                                 UseCoverImages="{Binding GridOptions.UseCoverImages, FallbackValue=False}"
                                                 ShowRarityGlow="{Binding GridOptions.ShowRarityGlow, FallbackValue=True}"
                                                 ColorNamesByRarity="{Binding GridOptions.ColorNamesByRarity, FallbackValue=False}"
                                                 ColorRarityColumnsByRarity="{Binding GridOptions.ColorRarityColumnsByRarity, FallbackValue=False}"/>
    </DataTemplate>

    <!-- GameSummaries: the shared game-summaries grid over the whole library. -->
    <DataTemplate DataType="{x:Type widgets:GameSummariesWidgetViewModel}">
        <showcase:ShowcaseGameGridControl ItemsSource="{Binding Items}"
                                          ColumnSettingsKey="{Binding ColumnSettingsKey}"
                                          ControlBar="{Binding ControlBar}"
                                          ShowControlBar="{Binding GridOptions.ShowControlBar, FallbackValue=False}"
                                          ShowColumnHeaders="{Binding GridOptions.ShowColumnHeaders, FallbackValue=True}"
                                          FixedRowHeight="{Binding GridOptions.RowHeight, FallbackValue={x:Null}}"
                                          UseCoverImages="{Binding GridOptions.UseCoverImages, FallbackValue=False}"
                                          ShowCompletionGlow="{Binding GridOptions.ShowCompletionGlow, FallbackValue=True}"
                                          ShowMetadataPlatform="{Binding GridOptions.ShowMetadataPlatform, FallbackValue=True}"
                                          ShowMetadataPlaytime="{Binding GridOptions.ShowMetadataPlaytime, FallbackValue=True}"
                                          ShowMetadataRegion="{Binding GridOptions.ShowMetadataRegion, FallbackValue=True}"/>
    </DataTemplate>

    <!-- GameMosaic: dense wrap of game cover tiles. A click opens the game in the library; the
         right-click menu (ShowcaseMosaicClickBehavior) offers Open and, for pinned-source
         tiles, reorder/unpin. -->
    <DataTemplate DataType="{x:Type widgets:GameMosaicWidgetViewModel}">
      <DockPanel>
        <controls:GridControlBarControl DockPanel.Dock="Top"
                                        Margin="0,0,0,8"
                                        ControlBar="{Binding ControlBar}"
                                        ShowControlBar="{Binding ShowControlBar}"/>
        <ListBox ItemsSource="{Binding Tiles}"
                 showcase:ShowcaseMosaicClickBehavior.IsEnabled="True"
                 Cursor="Hand"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 ItemContainerStyle="{StaticResource ShowcaseMosaicItemStyle}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- Packs the tiles at the spacing option's gap and centers them. -->
                    <showcase:ShowcaseMosaicWrapPanel Orientation="Horizontal"
                                                      VirtualizingPanel.CacheLengthUnit="Item"
                                                      VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DataTemplate.Resources>
                            <!-- Shared by the visible art and the glow-layer copies so the bloom
                                 tracks the exact same artwork, size, and stretch. -->
                            <Style x:Key="MosaicTileArtStyle" TargetType="Image">
                                <Setter Property="Width" Value="{Binding CoverWidth}"/>
                                <Setter Property="Height" Value="{Binding CoverHeight}"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Setter Property="helpers:AsyncImage.DecodePixel" Value="{Binding DecodePixel}"/>
                                <Setter Property="helpers:AsyncImage.Uri" Value="{Binding CoverPath}"/>
                                <Setter Property="Stretch" Value="UniformToFill"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCover}" Value="False">
                                        <Setter Property="Stretch" Value="Uniform"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataTemplate.Resources>
                        <!-- With the glow option on, every tile reserves the clearance the effect
                             needs (bloom blur 14 + depth 2, ray reach ~0.275 of the art per side);
                             at the dense margin the neighbors' art paints over the overflow and
                             only the rays' pale inner copies survive in the gutters. -->
                        <!-- TileMargin is the widget's spacing, raised to the glow clearance
                             while the completion glow is on. -->
                        <Grid ToolTip="{Binding GameName}"
                              Margin="{Binding TileMargin}">
                            <!-- Completion glow: the game summaries grid's rays and edge line,
                                 with the aura underlay below carrying the bloom, gated on the
                                 same soft/ray tier selections and pulse toggle exposed as
                                 ancestor DPs by ShowcaseWidgetControl. -->
                            <controls:RarityRayBurst UseCompletedColors="True"
                                                     BurstScale="1.55"
                                                     CornerRadiusRatio="0.14"
                                                     SubjectUri="{Binding CoverPath}">
                                <controls:RarityRayBurst.Style>
                                    <Style TargetType="controls:RarityRayBurst">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ShowCompletionGlow}" Value="True"/>
                                                    <Condition Binding="{Binding RayGlowTiers, RelativeSource={RelativeSource AncestorType=showcase:ShowcaseWidgetControl}, Converter={StaticResource RaritySelectionIncludesCompleted}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ShowCompletionGlow}" Value="True"/>
                                                    <Condition Binding="{Binding RayGlowTiers, RelativeSource={RelativeSource AncestorType=showcase:ShowcaseWidgetControl}, Converter={StaticResource RaritySelectionIncludesCompleted}}" Value="True"/>
                                                    <Condition Binding="{Binding AnimateRarityGlows, RelativeSource={RelativeSource AncestorType=showcase:ShowcaseWidgetControl}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="IsActive" Value="True"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:RarityRayBurst.Style>
                            </controls:RarityRayBurst>
                            <Border CacheMode="BitmapCache"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ShowCompletionGlow}" Value="True"/>
                                                    <Condition Binding="{Binding SoftGlowTiers, RelativeSource={RelativeSource AncestorType=showcase:ShowcaseWidgetControl}, Converter={StaticResource RaritySelectionIncludesCompleted}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ShowCompletionGlow}" Value="True"/>
                                                    <Condition Binding="{Binding SoftGlowTiers, RelativeSource={RelativeSource AncestorType=showcase:ShowcaseWidgetControl}, Converter={StaticResource RaritySelectionIncludesCompleted}}" Value="True"/>
                                                    <Condition Binding="{Binding AnimateRarityGlows, RelativeSource={RelativeSource AncestorType=showcase:ShowcaseWidgetControl}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="helpers:RarityGlowPulse.IsActive" Value="True"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <!-- Bloom underlay: at tile size the grid's art-copy shadow
                                         bloom survives only as a thin rim past the opaque cover,
                                         so a blurred rect carries the bloom instead — styled to
                                         the shadows it stands in for: overhang 2 mirrors their
                                         ShadowDepth, blur 14 their BlurRadius, and the diagonal
                                         gradient their 135/315 color bias. Opacity matches the
                                         grid rim's brightness. -->
                                    <Rectangle Margin="-2"
                                               RadiusX="5"
                                               RadiusY="5"
                                               Opacity="0.65"
                                               Fill="{DynamicResource PlayAch.Brush.CompletedGlowBloom}">
                                        <Rectangle.Effect>
                                            <BlurEffect Radius="14"/>
                                        </Rectangle.Effect>
                                    </Rectangle>
                                    <Image Effect="{DynamicResource PlayAch.Effect.CompletedGlowEdge}">
                                        <Image.Style>
                                            <Style TargetType="Image" BasedOn="{StaticResource MosaicTileArtStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RayGlowTiers, RelativeSource={RelativeSource AncestorType=showcase:ShowcaseWidgetControl}, Converter={StaticResource RaritySelectionIncludesCompleted}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Grid>
                            </Border>
                            <Border Background="{DynamicResource PlayAch.Brush.Overlay.Tint.08}"
                                    ClipToBounds="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="{StaticResource PlayAch.Radius.Small}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSeamless}" Value="True">
                                                <Setter Property="CornerRadius" Value="0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Image Style="{StaticResource MosaicTileArtStyle}"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </DataTemplate>

    <!-- ActivityCalendar: contributions-style heatmap of unlocks per day. -->
    <!-- Legend swatches only; the calendar grid itself is drawn by ActivityCalendarHeatmap,
         which owns the matching intensity ramp. -->
    <DataTemplate x:Key="ShowcaseActivityCellTemplate" DataType="{x:Type widgets:ActivityCalendarDayViewModel}">
        <Border Width="10" Height="10" CornerRadius="2" Margin="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.Accent}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Intensity}" Value="0">
                            <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.Overlay.Tint.08}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Intensity}" Value="1">
                            <Setter Property="Opacity" Value="0.30"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Intensity}" Value="2">
                            <Setter Property="Opacity" Value="0.55"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Intensity}" Value="3">
                            <Setter Property="Opacity" Value="0.78"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type widgets:ActivityCalendarWidgetViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.RowSpan="2"
                       Text="{DynamicResource LOCPlayAch_Showcase_NoData}"
                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                       Opacity="{StaticResource PlayAch.Opacity.Placeholder}"
                       FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}"/>
            <!-- The calendar sizes itself from the plugin's title font size (see
                 ActivityCalendarMetrics) instead of stretching to fill the widget; long
                 ranges overflow into a horizontal scrollbar pinned to the latest weeks,
                 with the mouse wheel mapped to horizontal scrolling. The weekday gutter
                 and the legend sit outside the scroll area so they stay put while the
                 calendar scrolls, and the gutter shares the heatmap's metrics so its
                 rows line up. -->
            <Grid TextElement.FontSize="{DynamicResource PlayAch.FontSize.Title}"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <showcase:ActivityCalendarDayGutter Labels="{Binding WeekdayLabels}"
                                                    ShowMonthBand="True"
                                                    VerticalAlignment="Top"/>
                <ScrollViewer Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              showcase:ActivityCalendarScrollBehavior.Enabled="True">
                    <!-- Single custom-drawn visual: one element for the whole grid of cells,
                         with tooltips served from hit tests. -->
                    <showcase:ActivityCalendarHeatmap Weeks="{Binding Weeks}"
                                                      ShowMonthLabels="True"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Top"/>
                </ScrollViewer>
            </Grid>
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,4,0,0">
                <TextBlock Text="{DynamicResource LOCPlayAch_Showcase_ActivityLegend_Less}"
                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                           Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                           FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                           Margin="0,0,4,0"
                           VerticalAlignment="Center"/>
                <ItemsControl ItemsSource="{Binding LegendCells}"
                              ItemTemplate="{StaticResource ShowcaseActivityCellTemplate}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="{DynamicResource LOCPlayAch_Showcase_ActivityLegend_More}"
                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                           Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                           FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
