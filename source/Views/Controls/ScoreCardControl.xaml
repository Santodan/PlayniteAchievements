<UserControl x:Class="PlayniteAchievements.Views.Controls.ScoreCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             xmlns:settings="clr-namespace:PlayniteAchievements.Models.Settings"
             x:Name="Root"
             FontFamily="{DynamicResource CommonFont}"
             FontSize="{DynamicResource PlayAch.FontSize.Body}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/AchievementResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ScoreCardPanelStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="7"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="9,7"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <!-- Background and border live in the style (not local values) so the Flat
                     trigger below can strip them for hosts that provide their own chrome. -->
                <Setter Property="Background" Value="{Binding AccentBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{Binding AccentBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <!-- A points card has no rank to explain, so it opens no score info dialog. -->
                    <DataTrigger Binding="{Binding IsPoints}" Value="True">
                        <Setter Property="Cursor" Value="Arrow"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFeatured, ElementName=Root}" Value="True">
                        <Setter Property="CornerRadius" Value="10"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Padding" Value="15,13"/>
                        <Setter Property="MinHeight" Value="96"/>
                    </DataTrigger>
                    <!-- The showcase block's surface, so the Overview header matches the showcase
                         Scores widget instead of tinting by tier. -->
                    <DataTrigger Binding="{Binding Compact, ElementName=Root}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.GridSurface}"/>
                        <Setter Property="CornerRadius" Value="{DynamicResource PlayAch.Radius.Section}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Flat, ElementName=Root}" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="MinHeight" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Badge column: spans the text column's height, the tier badge centered in what the
                 mastery line (docked to the bottom, level with the caption) leaves over. It docks
                 to the BadgePosition side, with the gap toward the text column. -->
            <Style x:Key="ScoreCardBadgeColumnStyle" TargetType="DockPanel">
                <Setter Property="DockPanel.Dock" Value="Left"/>
                <Setter Property="LastChildFill" Value="True"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFeatured, ElementName=Root}" Value="True">
                        <Setter Property="Margin" Value="0,0,14,0"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BadgePosition, ElementName=Root}" Value="{x:Static settings:ScoreCardBadgePosition.Right}">
                        <Setter Property="DockPanel.Dock" Value="Right"/>
                        <Setter Property="Margin" Value="10,0,0,0"/>
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsFeatured, ElementName=Root}" Value="True"/>
                            <Condition Binding="{Binding BadgePosition, ElementName=Root}" Value="{x:Static settings:ScoreCardBadgePosition.Right}"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Margin" Value="14,0,0,0"/>
                    </MultiDataTrigger>
                    <DataTrigger Binding="{Binding BadgeOnly, ElementName=Root}" Value="True">
                        <Setter Property="Margin" Value="0"/>
                    </DataTrigger>
                    <!-- A points card has no rank badge. -->
                    <DataTrigger Binding="{Binding IsPoints}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ScoreCardBadgeStyle" TargetType="Image" BasedOn="{StaticResource RarityIcon}">
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="43"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Effect" Value="{StaticResource BadgeShadow}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFeatured, ElementName=Root}" Value="True">
                        <Setter Property="Width" Value="54"/>
                        <Setter Property="Height" Value="61"/>
                    </DataTrigger>
                    <!-- Sized to the compact card's two rows (tier line and bar). -->
                    <DataTrigger Binding="{Binding Compact, ElementName=Root}" Value="True">
                        <Setter Property="Width" Value="28"/>
                        <Setter Property="Height" Value="32"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ScoreCardMasteryLineStyle" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,3,0,0"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasMastery}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFeatured, ElementName=Root}" Value="True">
                        <Setter Property="Margin" Value="0,5,0,0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ScoreCardMasteryIconStyle" TargetType="Image" BasedOn="{StaticResource RarityIcon}">
                <Setter Property="Width" Value="11"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="Margin" Value="0,0,3,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFeatured, ElementName=Root}" Value="True">
                        <Setter Property="Width" Value="14"/>
                        <Setter Property="Height" Value="16"/>
                        <Setter Property="Margin" Value="0,0,4,0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ScoreCardMasteryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PlayAch.TextBlock.BaseStyle}">
                <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Caption}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFeatured, ElementName=Root}" Value="True">
                        <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Body}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- A points card's platform icon, on the badge side and sized like the tier badge, so a
                 points card and a rank card side by side line up. -->
            <Style x:Key="ScoreCardPlatformIconStyle" TargetType="Image">
                <Setter Property="DockPanel.Dock" Value="Left"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="43"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPoints}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <!-- The game's own art takes the slot when the card shows one game. -->
                    <DataTrigger Binding="{Binding HasGameArt}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFeatured, ElementName=Root}" Value="True">
                        <Setter Property="Width" Value="54"/>
                        <Setter Property="Height" Value="61"/>
                        <Setter Property="Margin" Value="0,0,14,0"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Compact, ElementName=Root}" Value="True">
                        <Setter Property="Width" Value="28"/>
                        <Setter Property="Height" Value="32"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BadgePosition, ElementName=Root}" Value="{x:Static settings:ScoreCardBadgePosition.Right}">
                        <Setter Property="DockPanel.Dock" Value="Right"/>
                        <Setter Property="Margin" Value="10,0,0,0"/>
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsFeatured, ElementName=Root}" Value="True"/>
                            <Condition Binding="{Binding BadgePosition, ElementName=Root}" Value="{x:Static settings:ScoreCardBadgePosition.Right}"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Margin" Value="14,0,0,0"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

            <!-- A points card's game cover or icon in the platform icon's slot: the same height and
                 side, with the width following the image so a cover keeps its shape. -->
            <Style x:Key="ScoreCardGameArtStyle" TargetType="Image" BasedOn="{StaticResource ScoreCardPlatformIconStyle}">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MaxWidth" Value="96"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <!-- Both states are stated: the base style's IsPoints trigger would otherwise
                         keep an empty art slot, and its margin, on every points card. -->
                    <DataTrigger Binding="{Binding HasGameArt}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasGameArt}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFeatured, ElementName=Root}" Value="True">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="MaxWidth" Value="128"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Compact, ElementName=Root}" Value="True">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="MaxWidth" Value="64"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Text lives in the style so the Compact trigger can fold the label into the tier.
                 The tier docks toward the badge; the points fill the rest of the line. -->
            <Style x:Key="ScoreCardTierTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PlayAch.TextBlock.BaseStyle}">
                <Setter Property="DockPanel.Dock" Value="Left"/>
                <Setter Property="Text" Value="{Binding TierText}"/>
                <Setter Property="Foreground" Value="{Binding AccentBrush}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="VerticalAlignment" Value="Bottom"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFeatured, ElementName=Root}" Value="True">
                        <Setter Property="FontSize" Value="22"/>
                        <Setter Property="Margin" Value="0,3,0,0"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Compact, ElementName=Root}" Value="True">
                        <Setter Property="Text" Value="{Binding CompactTierText}"/>
                        <Setter Property="Margin" Value="0"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BadgePosition, ElementName=Root}" Value="{x:Static settings:ScoreCardBadgePosition.Right}">
                        <Setter Property="DockPanel.Dock" Value="Right"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ScoreCardPointsTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PlayAch.TextBlock.BaseStyle}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
                <Setter Property="Opacity" Value="{StaticResource PlayAch.Opacity.Emphasis}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Bottom"/>
                <Setter Property="Margin" Value="8,0,0,1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFeatured, ElementName=Root}" Value="True">
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Margin" Value="10,0,0,2"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BadgePosition, ElementName=Root}" Value="{x:Static settings:ScoreCardBadgePosition.Right}">
                        <Setter Property="HorizontalAlignment" Value="Left"/>
                        <Setter Property="Margin" Value="0,0,8,1"/>
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsFeatured, ElementName=Root}" Value="True"/>
                            <Condition Binding="{Binding BadgePosition, ElementName=Root}" Value="{x:Static settings:ScoreCardBadgePosition.Right}"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Margin" Value="0,0,10,2"/>
                    </MultiDataTrigger>
                    <!-- A points card's main line already states the points earned. -->
                    <DataTrigger Binding="{Binding IsPoints}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- One cell per level of the current rank. The negative right margin cancels the
                 trailing gap of the last segment so the bar ends flush with the text above it.
                 With the badge on the right the bar fills from the badge too: the cells run
                 right to left, and the margin (laid out by the parent) flips by hand. -->
            <Style x:Key="ScoreCardSegmentBarStyle" TargetType="ItemsControl">
                <Setter Property="Height" Value="6"/>
                <Setter Property="Margin" Value="0,6,-3,0"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Focusable" Value="False"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFeatured, ElementName=Root}" Value="True">
                        <Setter Property="Height" Value="8"/>
                        <Setter Property="Margin" Value="0,9,-3,0"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BadgePosition, ElementName=Root}" Value="{x:Static settings:ScoreCardBadgePosition.Right}">
                        <Setter Property="FlowDirection" Value="RightToLeft"/>
                        <Setter Property="Margin" Value="-3,6,0,0"/>
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsFeatured, ElementName=Root}" Value="True"/>
                            <Condition Binding="{Binding BadgePosition, ElementName=Root}" Value="{x:Static settings:ScoreCardBadgePosition.Right}"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Margin" Value="-3,9,0,0"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ScoreCardCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PlayAch.TextBlock.BaseStyle}">
                <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Caption}"/>
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
                <Setter Property="Opacity" Value="{StaticResource PlayAch.Opacity.Muted}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="Margin" Value="0,5,0,0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFeatured, ElementName=Root}" Value="True">
                        <Setter Property="Margin" Value="0,7,0,0"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BadgePosition, ElementName=Root}" Value="{x:Static settings:ScoreCardBadgePosition.Right}">
                        <Setter Property="HorizontalAlignment" Value="Right"/>
                    </DataTrigger>
                    <!-- A points card has no level to caption, but keeps the line's height so its
                     text and bar sit level with a rank card beside it. Compact cards have no
                     caption line at all; that trigger comes later so it wins. -->
                    <DataTrigger Binding="{Binding IsPoints}" Value="True">
                        <Setter Property="Visibility" Value="Hidden"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Compact, ElementName=Root}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ScoreCardTooltipBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.PopupSurface}"/>
                <Setter Property="BorderBrush" Value="{Binding AccentBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Width" Value="300"/>
                <Setter Property="MaxWidth" Value="300"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <Style x:Key="ScoreCardTooltipTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PlayAch.TextBlock.BaseStyle}">
                <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Body}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="ScoreCardTooltipRowStyle" TargetType="Grid">
                <Setter Property="Margin" Value="0,5,0,0"/>
            </Style>

            <Style x:Key="ScoreCardTooltipLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PlayAch.TextBlock.BaseStyle}">
                <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Caption}"/>
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
                <Setter Property="Opacity" Value="{StaticResource PlayAch.Opacity.Muted}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
            </Style>

            <Style x:Key="ScoreCardTooltipValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PlayAch.TextBlock.BaseStyle}">
                <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Caption}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <!-- The tooltip sits outside the control's namescope, so the control reaches it as the
                 ToolTip's Tag. Only compact cards drop the caption, so only their tooltip needs
                 the next level; badge-only cards also drop the tier and points, so the title
                 names the score and carries the points. -->
            <Style x:Key="ScoreCardTooltipTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource ScoreCardTooltipTitleTextStyle}">
                <Setter Property="Text" Value="{Binding TooltipTitleText}"/>
                <Setter Property="Foreground" Value="{Binding AccentBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag.Compact, RelativeSource={RelativeSource AncestorType=ToolTip}}" Value="True">
                        <Setter Property="Text" Value="{Binding CompactTooltipTitleText}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ScoreCardTooltipPointsStyle" TargetType="TextBlock" BasedOn="{StaticResource ScoreCardTooltipValueTextStyle}">
                <Setter Property="Text" Value="{Binding PointsText}"/>
                <Setter Property="Margin" Value="12,0,0,6"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag.BadgeOnly, RelativeSource={RelativeSource AncestorType=ToolTip}}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <!-- A points card's tooltip has no rank rows, so it always states earned out of total. -->
                    <DataTrigger Binding="{Binding IsPoints}" Value="True">
                        <Setter Property="Text" Value="{Binding CountsText}"/>
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ScoreCardTooltipNextLevelStyle" TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Tag.Compact, RelativeSource={RelativeSource AncestorType=ToolTip}}" Value="True"/>
                            <Condition Binding="{Binding HasNextLevel}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

            <!-- The click hint: a points card opens nothing. -->
            <Style x:Key="ScoreCardTooltipHintStyle" TargetType="StackPanel">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPoints}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Level, rank and next-level rows: a points card has none of them. -->
            <Style x:Key="ScoreCardTooltipRankRowsStyle" TargetType="StackPanel">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPoints}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ScoreCardTooltipSeparatorStyle" TargetType="Border">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Margin" Value="0,5,0,0"/>
                <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.Border}"/>
                <Setter Property="Opacity" Value="{StaticResource PlayAch.Opacity.Disabled}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid DataContext="{Binding ScoreCard, ElementName=Root}">
        <Border x:Name="PanelBorder"
                Style="{StaticResource ScoreCardPanelStyle}"
                Tag="{Binding ElementName=Root}"
                MouseLeftButtonDown="Panel_MouseLeftButtonDown"
                MouseLeftButtonUp="Panel_MouseLeftButtonUp"
                LostMouseCapture="Panel_LostMouseCapture">
            <Border.ToolTip>
                <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                         Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                         Placement="Bottom"
                         HorizontalOffset="0"
                         VerticalOffset="4"
                         Width="300"
                         Padding="{StaticResource PlayAch.Thickness.None}"
                         BorderThickness="0"
                         Background="{DynamicResource PlayAch.Brush.PopupSurface}"
                         HorizontalContentAlignment="Stretch"
                         HasDropShadow="True">
                    <!-- The card face states where you are; the tooltip states the ladder it sits
                         on, so no line here repeats one on the card. -->
                    <Border Style="{StaticResource ScoreCardTooltipBorderStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource ScoreCardTooltipTitleStyle}"/>
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource ScoreCardTooltipPointsStyle}"/>
                            </Grid>

                            <StackPanel Style="{StaticResource ScoreCardTooltipRankRowsStyle}">
                                <Border Style="{StaticResource ScoreCardTooltipSeparatorStyle}"/>
                                <Grid Style="{StaticResource ScoreCardTooltipRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TooltipLevelLabel}"
                                               Style="{StaticResource ScoreCardTooltipLabelTextStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TooltipLevelValueText}"
                                               Style="{StaticResource ScoreCardTooltipValueTextStyle}"/>
                                </Grid>

                                <Border Style="{StaticResource ScoreCardTooltipSeparatorStyle}"/>
                                <Grid Style="{StaticResource ScoreCardTooltipRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TooltipRankPositionLabel}"
                                               Style="{StaticResource ScoreCardTooltipLabelTextStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TooltipRankPositionValueText}"
                                               Style="{StaticResource ScoreCardTooltipValueTextStyle}"/>
                                </Grid>

                                <StackPanel Style="{StaticResource ScoreCardTooltipNextLevelStyle}">
                                    <Border Style="{StaticResource ScoreCardTooltipSeparatorStyle}"/>
                                    <Grid Style="{StaticResource ScoreCardTooltipRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TooltipNextLevelLabel}"
                                                   Style="{StaticResource ScoreCardTooltipLabelTextStyle}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TooltipNextLevelValueText}"
                                                   Style="{StaticResource ScoreCardTooltipValueTextStyle}"/>
                                    </Grid>
                                </StackPanel>

                                <Border Style="{StaticResource ScoreCardTooltipSeparatorStyle}"/>
                                <Grid Style="{StaticResource ScoreCardTooltipRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TooltipNextRankLabel}"
                                               Style="{StaticResource ScoreCardTooltipLabelTextStyle}"
                                               Foreground="{Binding NextTierAccentBrush}"
                                               Opacity="{StaticResource PlayAch.Opacity.Full}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TooltipNextRankValueText}"
                                               Style="{StaticResource ScoreCardTooltipValueTextStyle}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Style="{StaticResource ScoreCardTooltipHintStyle}">
                                <Border Style="{StaticResource ScoreCardTooltipSeparatorStyle}"/>
                                <TextBlock Text="{DynamicResource LOCPlayAch_Score_Info_CardHint}"
                                           Style="{StaticResource ScoreCardTooltipLabelTextStyle}"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ToolTip>
            </Border.ToolTip>

            <DockPanel LastChildFill="True">
                <DockPanel Style="{StaticResource ScoreCardBadgeColumnStyle}">
                    <!-- The completed-game badge marks mastery, as it marks the Master tier. The
                     line hangs below the badge; a spacer of the same height above keeps the badge
                     centered in the card, so a mastery count never lifts it. -->
                    <StackPanel x:Name="MasteryLine"
                                DockPanel.Dock="Bottom"
                                Style="{StaticResource ScoreCardMasteryLineStyle}">
                        <Image Source="{Binding MasteryIconKey, Converter={StaticResource ResourceKeyToImage}}"
                               Style="{StaticResource ScoreCardMasteryIconStyle}"/>
                        <TextBlock Text="{Binding MasteryText}"
                                   Style="{StaticResource ScoreCardMasteryTextStyle}"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Top"
                            Height="{Binding ActualHeight, ElementName=MasteryLine}"
                            Margin="{Binding Margin, ElementName=MasteryLine}"
                            Visibility="{Binding Visibility, ElementName=MasteryLine}"/>

                    <Image Source="{Binding BadgeIconKey, Converter={StaticResource ResourceKeyToImage}}"
                           Style="{StaticResource ScoreCardBadgeStyle}"/>
                </DockPanel>

                <Image Source="{Binding PlatformIcon}"
                       Style="{StaticResource ScoreCardPlatformIconStyle}"/>
                <Image helpers:AsyncImage.Uri="{Binding GameArtPath}"
                       helpers:AsyncImage.DecodePixel="256"
                       Style="{StaticResource ScoreCardGameArtStyle}"/>

                <Grid x:Name="TextColumn">
                    <!-- Centered against the badge column, so the text and the badge share a
                         center line and any extra height from the badge or mastery line splits
                         evenly above and below. -->
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BadgeOnly, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <!-- A points card has no badge to collapse to, so it keeps its text. -->
                                <DataTrigger Binding="{Binding IsPoints}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Rank is the card's identity; the score rides alongside it rather than
                         above it, so the bar below reads as the rank's own progress. The card has
                         no title line: its host names it. -->
                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <TextBlock Style="{StaticResource ScoreCardTierTextStyle}"/>
                        <TextBlock Text="{Binding PointsText}"
                                   Style="{StaticResource ScoreCardPointsTextStyle}"/>
                    </DockPanel>

                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding Segments}"
                                  Style="{StaticResource ScoreCardSegmentBarStyle}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Fill}"
                                        CornerRadius="2"
                                        Margin="0,0,3,0"
                                        SnapsToDevicePixels="True"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Row="2"
                               Text="{Binding CaptionText}"
                               Style="{StaticResource ScoreCardCaptionTextStyle}"/>

                    <!-- A points card's rarity badges sit on the caption line, which a points card
                         keeps empty. -->
                    <ItemsControl Grid.Row="2"
                                  ItemsSource="{Binding RarityBadges}"
                                  Margin="0,5,0,0"
                                  Focusable="False">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRarityBadges}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BadgePosition, ElementName=Root}" Value="{x:Static settings:ScoreCardBadgePosition.Right}">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Compact, ElementName=Root}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                    <Image Source="{Binding IconKey, Converter={StaticResource ResourceKeyToImage}}"
                                           Width="16"
                                           Height="16"
                                           VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CountText}"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                               Margin="4,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
