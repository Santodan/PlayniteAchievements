<UserControl x:Class="PlayniteAchievements.Views.Controls.AchievementTagListEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="700">
    <!-- DataContext: AchievementTagListViewModel. One row per tag: drag handle, icon, name, color
         (swatch, hex, Pick, Reset), then Make Global (a game's own tags) and Remove. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="TagEditorBoolToVisibility"/>

            <Style x:Key="TagRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource AchievementRowStyle}">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Style>

            <Style x:Key="TagIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayAch.Button.ToolbarIconStyle}">
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
            </Style>

            <!-- A square slot: the chosen glyph in a solid frame, or an empty dashed frame when the
                 tag has no icon, so an unset icon reads as empty rather than as a picture. -->
            <Style x:Key="TagIconSlotStyle" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Width="28" Height="28" Background="Transparent">
                                <Rectangle x:Name="EmptyFrame"
                                           Stroke="{DynamicResource PlayAch.Brush.Text}"
                                           StrokeThickness="1"
                                           StrokeDashArray="2 2"
                                           RadiusX="4"
                                           RadiusY="4"
                                           Opacity="{StaticResource PlayAch.Opacity.Hint}"/>
                                <Border x:Name="Frame"
                                        BorderBrush="{DynamicResource PlayAch.Brush.ControlBorder}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Visibility="Collapsed">
                                    <TextBlock Text="{Binding Glyph}"
                                               FontFamily="{DynamicResource PlayAch.FontFamily.Icon}"
                                               FontSize="16"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextOptions.TextFormattingMode="Display"
                                               TextOptions.TextRenderingMode="Grayscale"/>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasGlyph}" Value="True">
                                    <Setter TargetName="EmptyFrame" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="Frame" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="EmptyFrame" Property="Opacity" Value="1"/>
                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <Grid HorizontalAlignment="Left">
            <DataGrid x:Name="TagGrid"
                      Style="{StaticResource PlayAch.DataGrid.BaseStyle}"
                      ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserResizeColumns="False"
                      CanUserReorderColumns="False"
                      CanUserSortColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="None"
                      IsReadOnly="False"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      Background="{DynamicResource PlayAch.Brush.Grid.Background}"
                      RowBackground="{DynamicResource PlayAch.Brush.Grid.RowBackground}"
                      Foreground="{DynamicResource PlayAch.Brush.Text}"
                      CellStyle="{StaticResource AchievementCellStyle}"
                      RowStyle="{StaticResource TagRowStyle}"
                      AllowDrop="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="32" MinWidth="32" MaxWidth="32" CanUserResize="False" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Tag="DragHandle"
                                        Background="Transparent"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Cursor="SizeAll">
                                    <TextBlock Tag="DragHandle"
                                               Text="☰"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               Opacity="0.65"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="40" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding PickIconCommand}"
                                        Style="{StaticResource TagIconSlotStyle}"
                                        ToolTip="{DynamicResource LOCPlayAch_Common_ChooseIcon}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="Auto" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                         Width="220"
                                         VerticalAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Padding="6,3"
                                         Margin="4,2"
                                         KeyDown="CommitOnEnter_KeyDown"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Color, laid out like Display > Colors: swatch, hex, Pick, Reset. -->
                    <DataGridTemplateColumn Width="Auto" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,4,0">
                                    <Grid Width="22" Height="22" VerticalAlignment="Center">
                                        <Rectangle Stroke="{DynamicResource PlayAch.Brush.Text}"
                                                   StrokeThickness="1"
                                                   StrokeDashArray="2 2"
                                                   Opacity="{StaticResource PlayAch.Opacity.Hint}"/>
                                        <Border Background="{Binding Brush}"
                                                BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                                BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                                                Visibility="{Binding HasColor, Converter={StaticResource TagEditorBoolToVisibility}}"/>
                                    </Grid>
                                    <TextBox Text="{Binding ColorText, UpdateSourceTrigger=LostFocus}"
                                             Width="90"
                                             Margin="8,0,0,0"
                                             VerticalAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             Padding="6,3"
                                             KeyDown="CommitOnEnter_KeyDown"/>
                                    <Button Content="{DynamicResource LOCPlayAch_Button_Pick}"
                                            Command="{Binding PickColorCommand}"
                                            Margin="8,0,0,0"
                                            MinWidth="58"/>
                                    <Button Content="{DynamicResource LOCResetLabel}"
                                            Command="{Binding ClearColorCommand}"
                                            IsEnabled="{Binding HasColor}"
                                            Margin="8,0,0,0"
                                            MinWidth="58"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="Auto" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                    <Button Content="&#xEF3E;"
                                            Command="{Binding MakeGlobalCommand}"
                                            ToolTip="{DynamicResource LOCPlayAch_ManageAchievements_Tags_MakeGlobal}"
                                            Style="{StaticResource TagIconButtonStyle}"
                                            Visibility="{Binding CanMakeGlobal, Converter={StaticResource TagEditorBoolToVisibility}}"/>
                                    <!-- System tags carry behavior, so they can be renamed and recolored
                                         but not removed; a lock stands where Remove would be. -->
                                    <Button Command="{Binding DeleteCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource TagIconButtonStyle}">
                                                <Setter Property="Content" Value="&#xEC53;"/>
                                                <Setter Property="ToolTip" Value="{DynamicResource LOCRemoveTitle}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                                        <Setter Property="Content" Value="&#xEC61;"/>
                                                        <Setter Property="ToolTip" Value="{DynamicResource LOCPlayAch_Common_BuiltInTagHint}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border x:Name="DropInsertLine"
                    Height="2"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource PlayAch.Brush.Accent}"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    Panel.ZIndex="10"/>

            <Popup x:Name="DragCountPopup"
                   Placement="AbsolutePoint"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   IsHitTestVisible="False">
                <Border Background="{StaticResource PlayAch.Brush.DialogBackdrop}"
                        BorderBrush="{DynamicResource PlayAch.Brush.Accent}"
                        BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                        CornerRadius="10"
                        Padding="8,3">
                    <TextBlock x:Name="DragCountText"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="{DynamicResource PlayAch.FontSize.Caption}"/>
                </Border>
            </Popup>
        </Grid>

        <Button Content="{DynamicResource LOCAddTitle}"
                Command="{Binding AddCommand}"
                HorizontalAlignment="Left"
                Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                MinWidth="80"
                Margin="{StaticResource PlayAch.Thickness.Top.Sm}"/>
    </StackPanel>
</UserControl>
