<UserControl x:Class="PlayniteAchievements.Views.Controls.ProviderPathListEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Providers/ProviderSettingsScopedControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="PathRowStatusVisibility"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <ItemsControl x:Name="RowsHost" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="{DynamicResource PlayAch.FontSize.Body}"
                                   VerticalAlignment="Center"
                                   ToolTip="{Binding StatusText}"
                                   Visibility="{Binding HasStatus, Converter={StaticResource PathRowStatusVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE783;"/>
                                    <Setter Property="Foreground" Value="{StaticResource PlayAch.Brush.AuthError}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsValid}" Value="True">
                                            <Setter Property="Text" Value="&#xE73E;"/>
                                            <Setter Property="Foreground" Value="{StaticResource PlayAch.Brush.AuthSuccess}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBox Grid.Column="1"
                                 Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Padding="4"
                                 Margin="{StaticResource PlayAch.Thickness.Right.Sm}"
                                 KeyDown="PathTextBox_KeyDown"/>
                        <Button Grid.Column="2"
                                Content="{DynamicResource LOCPlayAch_Button_Browse}"
                                Click="Browse_Click"
                                Margin="{StaticResource PlayAch.Thickness.Right.Sm}"
                                Padding="{StaticResource PlayAch.Thickness.ButtonPadding.Compact}"/>
                        <Button Grid.Column="3"
                                Content="{DynamicResource LOCPlayAch_Button_Remove}"
                                Click="Remove_Click"
                                Padding="{StaticResource PlayAch.Thickness.ButtonPadding.Compact}"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="{DynamicResource LOCPlayAch_Button_Add}"
                HorizontalAlignment="Left"
                Click="Add_Click"
                Padding="{StaticResource PlayAch.Thickness.ButtonPadding.Compact}"/>
    </StackPanel>
</UserControl>
