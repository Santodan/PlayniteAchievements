<UserControl x:Class="PlayniteAchievements.Views.Controls.GameSearchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:PlayniteAchievements.ViewModels"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="720"
             d:DataContext="{d:DesignInstance vm:GameSearchViewModel}"
             x:Name="Root">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/ManageAchievementsScopedControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search bar: a name, or an id or address the source recognizes. -->
        <Grid Grid.Row="0" Margin="{StaticResource PlayAch.Thickness.Bottom.Md}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox x:Name="SearchTextBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                         Style="{StaticResource ManageAchievementsSearchTextBoxStyle}"
                         PreviewKeyDown="SearchTextBox_PreviewKeyDown"/>
                <TextBlock Text="{DynamicResource LOCPlayAch_Filter_Games}"
                           Tag="{Binding Text, ElementName=SearchTextBox}"
                           Style="{StaticResource ManageAchievementsSearchPlaceholderTextStyle}"/>
                <Button x:Name="ClearSearchTextButton"
                        Tag="{Binding Text, ElementName=SearchTextBox}"
                        Click="ClearSearchTextButton_Click"
                        Style="{StaticResource ClearSearchButtonStyle}"/>
            </Grid>

            <Button x:Name="SearchButton"
                    Grid.Column="1"
                    Content="{DynamicResource LOCPlayAch_Common_Search}"
                    Command="{Binding SearchCommand}"
                    Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                    MinWidth="80"
                    Margin="{StaticResource PlayAch.Thickness.Left.Sm}"/>
        </Grid>

        <!-- The games picked so far, for a source whose link can name several. -->
        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding Picked}"
                      Focusable="False"
                      Margin="{StaticResource PlayAch.Thickness.Bottom.Sm}"
                      Visibility="{Binding HasPicked, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource MetaChipStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name, Mode=OneWay}"
                                       Style="{StaticResource ChipTextStyle}"
                                       VerticalAlignment="Center"
                                       MaxWidth="260"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name, Mode=OneWay}"/>
                            <Button Style="{StaticResource ClearSearchButtonStyle}"
                                    Tag="x"
                                    Margin="{StaticResource PlayAch.Thickness.Left.Sm}"
                                    ToolTip="{DynamicResource LOCPlayAch_Common_Remove}"
                                    Command="{Binding DataContext.RemovePickCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <DataGrid x:Name="ResultsDataGrid"
                  Grid.Row="2"
                  Style="{StaticResource PlayAch.DataGrid.BaseStyle}"
                  ItemsSource="{Binding Results}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  KeyboardNavigation.DirectionalNavigation="Continue"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="False"
                  RowHeight="68"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  VirtualizingStackPanel.ScrollUnit="Pixel"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column"
                  BorderThickness="0"
                  Background="{DynamicResource PlayAch.Brush.Grid.Background}"
                  RowBackground="{DynamicResource PlayAch.Brush.Grid.RowBackground}"
                  Foreground="{DynamicResource PlayAch.Brush.Text}"
                  ColumnHeaderStyle="{StaticResource ManageAchievementsColumnHeaderStyle}"
                  helpers:DataGridHoverScrollBarBehavior.IsEnabled="True"
                  helpers:DataGridAlignmentBehavior.IsEnabled="True"
                  PreviewMouseLeftButtonDown="ResultsDataGrid_PreviewMouseLeftButtonDown"
                  PreviewKeyDown="ResultsDataGrid_PreviewKeyDown"
                  Tag="ControllerCellFocus"
                  MouseDoubleClick="ResultsDataGrid_MouseDoubleClick">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource ManageAchievementsControllerCellStyle}"/>
            </DataGrid.CellStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource ManageAchievementsDataGridRowStyle}">
                    <Setter Property="MinHeight" Value="64"/>
                    <Setter Property="ClipToBounds" Value="True"/>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <!-- Picked, for a source whose link can name several games. -->
                <DataGridTemplateColumn x:Name="PickColumn"
                                        Width="40"
                                        IsReadOnly="True"
                                        Visibility="Collapsed">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      IsChecked="{Binding IsChecked, Mode=OneWay}"
                                      Command="{Binding ToggleCommand}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Bound straight to the address: store art comes in any shape, and the plugin's
                     image cache decodes small and squares what it caches. -->
                <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_Common_Icon}" Width="108" IsReadOnly="True"
                                        CellStyle="{StaticResource ManageAchievementsIconCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Width="96"
                                  Height="54">
                                <Image Source="{Binding IconUrl, Mode=OneWay}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="{DynamicResource LOCPlayAch_Common_Name}"
                                    Binding="{Binding Name, Mode=OneWay}"
                                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource EllipsisWrappedDataGridTextStyle}">
                            <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
                            <Setter Property="ToolTip" Value="{Binding Name, Mode=OneWay}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn x:Name="PlatformColumn"
                                    Header="{DynamicResource LOCPlayAch_Common_Platform}"
                                    Binding="{Binding Platforms, Mode=OneWay}"
                                    Width="140"
                                    Visibility="Collapsed">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource EllipsisWrappedDataGridTextStyle}">
                            <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
                            <Setter Property="ToolTip" Value="{Binding Platforms, Mode=OneWay}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- A game the search cannot find: its page link or id, added once the source reads it. -->
        <Grid Grid.Row="4" Margin="{StaticResource PlayAch.Thickness.Top.Sm}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{DynamicResource LOCPlayAch_GameSearch_LinkOrId}"
                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                       VerticalAlignment="Center"
                       Margin="{StaticResource PlayAch.Thickness.Right.Sm}"/>
            <TextBox x:Name="LinkTextBox"
                     Grid.Column="1"
                     Text="{Binding LinkText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                     Padding="8,4"
                     VerticalContentAlignment="Center"
                     PreviewKeyDown="LinkTextBox_PreviewKeyDown"/>
            <Button x:Name="AddLinkButton"
                    Grid.Column="2"
                    Content="{DynamicResource LOCPlayAch_Common_Add}"
                    Command="{Binding AddLinkCommand}"
                    Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                    MinWidth="80"
                    Margin="{StaticResource PlayAch.Thickness.Left.Sm}"/>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                   Opacity="{StaticResource PlayAch.Opacity.Hint}"
                   TextWrapping="Wrap"
                   Margin="{StaticResource PlayAch.Thickness.Top.Sm}"/>
    </Grid>
</UserControl>
