<UserControl x:Class="PlayniteAchievements.Views.Controls.UnlockTimelineChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             x:Name="Root"
             Focusable="False">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="UnlockTimelineBoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The axes, separators, and tooltip are LiveCharts objects outside this control's logical
         tree, so the code-behind creates them and binds them with Source-based bindings; only the
         chart shell and the empty caption live here. -->
    <Grid>
        <lvc:CartesianChart x:Name="Chart"
                            Series="{Binding Series, ElementName=Root}"
                            LegendLocation="None"
                            Hoverable="True"
                            TooltipTimeout="0:0:0.1"
                            DisableAnimations="True">
            <lvc:CartesianChart.Resources>
                <Style TargetType="lvc:ColumnSeries" BasedOn="{StaticResource PlayAch.ChartColumnSeriesStyle}"/>
            </lvc:CartesianChart.Resources>
        </lvc:CartesianChart>

        <TextBlock Text="{Binding EmptyText, ElementName=Root}"
                   Foreground="{Binding AxisForeground, ElementName=Root}"
                   Opacity="{StaticResource PlayAch.Opacity.Placeholder}"
                   FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   IsHitTestVisible="False"
                   Visibility="{Binding IsEmpty, ElementName=Root, Converter={StaticResource UnlockTimelineBoolToVis}}"/>
    </Grid>
</UserControl>
