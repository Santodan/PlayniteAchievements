<UserControl x:Class="PlayniteAchievements.Views.Controls.AchievementCompactItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             xmlns:converters="clr-namespace:PlayniteAchievements.Views.Converters"
             xmlns:vm="clr-namespace:PlayniteAchievements.ViewModels.Items"
             mc:Ignorable="d"
             d:DesignHeight="48" d:DesignWidth="48"
             d:DataContext="{d:DesignInstance vm:AchievementDisplayItem}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Cursor="Hand">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/AchievementResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The transparent background is what makes the whole tile hoverable. An Image hit-tests
         only the pixels it actually draws, so with Stretch="Uniform" a non-square icon leaves
         dead letterbox bands, and a tile whose icon is still loading or never resolved has no
         hit-test surface at all - in both cases the tooltip simply never appears. -->
    <Grid x:Name="RootGrid"
          Background="Transparent"
          Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
          Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
          ClipToBounds="False"
          UseLayoutRounding="True"
          SnapsToDevicePixels="True">
        <Grid.ToolTip>
            <!-- The body is a shared template (AchievementControlStyles.xaml), built when it opens. -->
            <ToolTip x:Name="ItemToolTip"
                     MaxWidth="300"
                     Content="{Binding}"
                     ContentTemplate="{StaticResource PlayAch.CompactItem.ToolTipTemplate}"
                     Closed="ItemToolTip_OnClosed"/>
        </Grid.ToolTip>

        <!-- Achievement icon with glow effect - keep glow on a backing layer so the front icon stays sharp -->
        <Grid Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
              Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
              ClipToBounds="False"
              UseLayoutRounding="True"
              SnapsToDevicePixels="True">
            <!-- Rays glow style: arrows riding the icon's own silhouette, replacing the soft halo. -->
            <controls:RarityRayBurst Rarity="{Binding Rarity}"
                                     HasRarityData="{Binding HasRarityPercent}"
                                     SubjectUri="{Binding DisplayIcon, Mode=OneWay}"
                                     CornerRadiusPx="{DynamicResource PlayAch.Radius.AchievementIcon}"
                                     Style="{StaticResource PlayAch.CompactItem.RayBurst}"/>
            <Border IsHitTestVisible="False"
                    CacheMode="BitmapCache"
                    Style="{StaticResource PlayAch.CompactItem.SoftGlow}">
                <Image Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True"
                       Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       helpers:AsyncImage.Uri="{Binding DisplayIcon, Mode=OneWay}"
                       helpers:AsyncImage.DecodePixel="256"
                       helpers:RoundedClip.Radius="{DynamicResource PlayAch.Radius.AchievementIcon}"/>
            </Border>

            <!-- Edge that comes with the rays: the same layer as the halo above at a blur small enough
                 to read as a line. A blur of the artwork, so it hugs the alpha on any shape. -->
            <Border IsHitTestVisible="False"
                    CacheMode="BitmapCache"
                    Style="{StaticResource PlayAch.CompactItem.RayEdge}">
                <Image Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True"
                       Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       helpers:AsyncImage.Uri="{Binding DisplayIcon, Mode=OneWay}"
                       helpers:AsyncImage.DecodePixel="256"
                       helpers:RoundedClip.Radius="{DynamicResource PlayAch.Radius.AchievementIcon}"/>
            </Border>

            <Image Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SnapsToDevicePixels="True"
                   Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   helpers:AsyncImage.Uri="{Binding DisplayIcon, Mode=OneWay}"
                   helpers:AsyncImage.DecodePixel="256"
                   helpers:RoundedClip.Radius="{DynamicResource PlayAch.Radius.AchievementIcon}"/>

            <!-- Solid rarity border for Hardcore achievements (replaces the glow).
                 Negative margin draws the border just OUTSIDE the icon so it never shrinks it. -->
            <Border Margin="-3"
                    BorderThickness="3"
                    CornerRadius="{DynamicResource PlayAch.CornerRadius.AchievementIcon}"
                    Background="Transparent"
                    IsHitTestVisible="False"
                    SnapsToDevicePixels="True"
                    BorderBrush="{Binding Rarity, Converter={StaticResource RarityToShineBrush}}"
                    Style="{StaticResource PlayAch.CompactItem.HardcoreBorder}"/>
        </Grid>

        <!-- Rarity bar overlay at bottom - shows global unlock percentage -->
        <Grid VerticalAlignment="Bottom"
              Style="{StaticResource PlayAch.CompactItem.RarityBarHost}">
            <ProgressBar Style="{StaticResource PlayAch.ProgressBar.RarityBar}"
                         Value="{Binding RarityPercentValue, Mode=OneWay}"/>
        </Grid>
    </Grid>
</UserControl>
