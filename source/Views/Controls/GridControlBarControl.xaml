<UserControl x:Class="PlayniteAchievements.Views.Controls.GridControlBarControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             xmlns:converters="clr-namespace:PlayniteAchievements.Views.Converters"
             xmlns:vm="clr-namespace:PlayniteAchievements.ViewModels.Items"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/AchievementControlStyles.xaml"/>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/AchievementGridStyles.xaml"/>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/RarityBadges.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="GridControlBarBoolToVis"/>
            <converters:ControlBarItemWidthConverter x:Key="GridControlBarItemWidth"/>

            <!-- Toolbar mode toggle (category-summaries mode), rendered as the right half of a
                 segmented unit: a bordered, icon-only button that butts flush against the category
                 dropdown on its left. The glyph stays a fixed color; the checked state uses the
                 same selected background + accent border as the Unlocked/Locked/Hidden filter
                 toggles. Whenever the adjacent dropdown is not shown the segment stands alone and
                 rounds all four corners. -->
            <Style x:Key="GridModeToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Seg"
                                    Background="{DynamicResource PlayAch.Brush.Button.Background}"
                                    BorderBrush="{DynamicResource PlayAch.Brush.Button.Border}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,0"
                                    SnapsToDevicePixels="True">
                                <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                                    <Path x:Name="Glyph"
                                          Data="M0,1.5 H3 V4.5 H0 Z M5.5,1.5 H16 V4.5 H5.5 Z M0,6.5 H3 V9.5 H0 Z M5.5,6.5 H16 V9.5 H5.5 Z M0,11.5 H3 V14.5 H0 Z M5.5,11.5 H16 V14.5 H5.5 Z"
                                          Fill="{DynamicResource PlayAch.Brush.Glyph}"/>
                                </Viewbox>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Seg" Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.Accent}"/>
                                    <Setter TargetName="Seg" Property="Background" Value="{DynamicResource PlayAch.Brush.Button.Background.Hover}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding Connected}" Value="True">
                                    <Setter TargetName="Seg" Property="CornerRadius" Value="0,4,4,0"/>
                                </DataTrigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Seg" Property="Background" Value="{DynamicResource PlayAch.Brush.Button.Background.Selected}"/>
                                    <Setter TargetName="Seg" Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Seg" Property="Opacity" Value="{StaticResource PlayAch.Opacity.Disabled}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ProviderFilterRowToggleStyle" TargetType="ToggleButton">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
                <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Body}"/>
                <Setter Property="FontFamily" Value="{DynamicResource PlayAch.FontFamily.Body}"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="RowBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                                    CornerRadius="3"
                                    SnapsToDevicePixels="True">
                                <Grid Margin="4,5,10,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="16" Height="16" SnapsToDevicePixels="True">
                                        <Border x:Name="CheckBorder"
                                                Background="{DynamicResource PlayAch.Brush.Control.Background}"
                                                BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="3"/>
                                        <Path x:Name="CheckMark"
                                              Data="M 3.5 8 L 6.5 11 L 12.5 5"
                                              Stroke="{DynamicResource PlayAch.Brush.Accent}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Visibility="Collapsed"/>
                                        <Path x:Name="DashMark"
                                              Data="M 3.5 8 L 12.5 8"
                                              Stroke="{DynamicResource PlayAch.Brush.Accent}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Visibility="Collapsed"/>
                                    </Grid>
                                    <ContentPresenter Grid.Column="2"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      RecognizesAccessKey="True"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.Accent}"/>
                                    <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource PlayAch.Brush.Control.Background.Hover}"/>
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="{x:Null}">
                                    <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.Accent}"/>
                                    <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource PlayAch.Brush.Control.Background.Hover}"/>
                                    <Setter TargetName="DashMark" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource PlayAch.Brush.Grid.RowHoverBackground}"/>
                                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ProviderFilterChevronToggleStyle" TargetType="ToggleButton">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width" Value="30"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="ChevronBorder"
                                    Background="Transparent"
                                    CornerRadius="3"
                                    SnapsToDevicePixels="True">
                                <Path x:Name="Arrow"
                                      Width="8" Height="5"
                                      Data="M 0,0 L 8,0 L 4,5 Z"
                                      Fill="{DynamicResource PlayAch.Brush.Text}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="-90"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="0"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ChevronBorder" Property="Background" Value="{DynamicResource PlayAch.Brush.Grid.RowHoverBackground}"/>
                                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource PlayAch.Brush.Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="PlatformFilterOptionTemplate" DataType="{x:Type vm:PlatformFilterOption}">
                <ToggleButton Style="{StaticResource ProviderFilterRowToggleStyle}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              Content="{Binding PlatformName}"/>
            </DataTemplate>

            <DataTemplate x:Key="ProviderFilterGroupTemplate" DataType="{x:Type vm:ProviderFilterGroup}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton Grid.Column="0"
                                      Style="{StaticResource ProviderFilterRowToggleStyle}"
                                      IsThreeState="True"
                                      IsChecked="{Binding SelectionState, Mode=OneWay}"
                                      Command="{Binding ToggleAllCommand}"
                                      Content="{Binding DisplayName}"/>
                        <ToggleButton Grid.Column="1"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                      Style="{StaticResource ProviderFilterChevronToggleStyle}"
                                      Visibility="{Binding HasMultiplePlatforms, Converter={StaticResource GridControlBarBoolToVis}}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Platforms}"
                                  ItemTemplate="{StaticResource PlatformFilterOptionTemplate}"
                                  Margin="18,0,0,0"
                                  Visibility="{Binding IsExpanded, Converter={StaticResource GridControlBarBoolToVis}}"/>
                </StackPanel>
            </DataTemplate>

            <Style x:Key="ProviderFilterContextMenuStyle" TargetType="ContextMenu">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.PopupSurface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.PopupBorder}"/>
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
                <Setter Property="MinWidth" Value="180"/>
                <Setter Property="MaxWidth" Value="280"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="4"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                                    <ItemsControl ItemsSource="{TemplateBinding ItemsSource}"
                                                  ItemTemplate="{StaticResource ProviderFilterGroupTemplate}"/>
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate DataType="{x:Type vm:GridSearchControl}">
                <Grid MinWidth="{Binding MinWidth}">
                    <TextBox x:Name="SearchTextBox"
                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, Delay=100}"
                             KeyDown="SearchTextBox_KeyDown"
                             Style="{StaticResource ClearableSearchTextBoxStyle}"/>
                    <TextBlock Text="{Binding Placeholder}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource PlayAch.Thickness.Left.Sm}"
                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                               FontSize="{DynamicResource PlayAch.FontSize.Body}"
                               FontFamily="{DynamicResource PlayAch.FontFamily.Body}"
                               Opacity="{StaticResource PlayAch.Opacity.Placeholder}"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Tag="{Binding Text}"
                            Click="ClearSearch_Click"
                            Style="{StaticResource ClearSearchButtonStyle}"/>
                </Grid>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:GridMultiSelectFilter}">
                <Grid Margin="{StaticResource PlayAch.Thickness.Left.Xs}"
                      VerticalAlignment="Center"
                      Visibility="{Binding EffectiveIsVisible, Converter={StaticResource GridControlBarBoolToVis}}">
                    <Button x:Name="FilterButton"
                            Style="{StaticResource AchievementSelectorButtonStyle}"
                            Content="{Binding ButtonText}"
                            Click="MultiSelectFilter_Click"
                            MinWidth="{Binding MinWidth}"
                            Height="{StaticResource PlayAch.Size.Control.Height}"
                            ToolTip="{Binding ButtonToolTip}">
                        <Button.Width>
                            <MultiBinding Converter="{StaticResource GridControlBarItemWidth}">
                                <Binding Path="Width"/>
                                <Binding Path="FillsWidth" ElementName="Root"/>
                                <Binding Path="ActualWidth" ElementName="Root"/>
                            </MultiBinding>
                        </Button.Width>
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource AchievementSelectorContextMenuStyle}"
                                         ItemContainerStyle="{StaticResource AchievementMultiSelectMenuItemStyle}"/>
                        </Button.ContextMenu>
                    </Button>
                    <!-- The picked options' badges in place of their names, where the text sits. -->
                    <ItemsControl ItemsSource="{Binding SelectedIconKeys}"
                                  IsHitTestVisible="False"
                                  Margin="10,0,20,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  ClipToBounds="True"
                                  Visibility="{Binding ShowsSelectedIcons, Converter={StaticResource GridControlBarBoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- A gap before every badge but the first. -->
                                <Image helpers:ImageResourceKey.Key="{Binding}"
                                       Width="16"
                                       Height="16"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Margin" Value="4,0,0,0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                                    <Setter Property="Margin" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <DataTemplate.Triggers>
                    <!-- Segmented with the mode toggle on its right: flat right edge. The toggle
                         carries the 1px overlap that closes the seam. -->
                    <DataTrigger Binding="{Binding ConnectedRight}" Value="True">
                        <Setter TargetName="FilterButton" Property="Style" Value="{StaticResource AchievementSelectorButtonConnectedRightStyle}"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:GridProviderPlatformFilter}">
                <Button Style="{StaticResource AchievementSelectorButtonStyle}"
                        Content="{Binding DisplayText}"
                        Click="ProviderFilter_Click"
                        MinWidth="{Binding MinWidth}"
                        Height="{StaticResource PlayAch.Size.Control.Height}"
                        Margin="{StaticResource PlayAch.Thickness.Left.Xs}"
                        VerticalAlignment="Center"
                        ToolTip="{Binding ToolTip}"
                        Visibility="{Binding EffectiveIsVisible, Converter={StaticResource GridControlBarBoolToVis}}">
                    <Button.Width>
                            <MultiBinding Converter="{StaticResource GridControlBarItemWidth}">
                                <Binding Path="Width"/>
                                <Binding Path="FillsWidth" ElementName="Root"/>
                                <Binding Path="ActualWidth" ElementName="Root"/>
                            </MultiBinding>
                    </Button.Width>
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource ProviderFilterContextMenuStyle}"
                                     Closed="ProviderFilterContextMenu_Closed"/>
                    </Button.ContextMenu>
                </Button>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:GridToggleFilter}">
                <ToggleButton Style="{StaticResource PlayAch.ToggleButton.FilterStyle}"
                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              Height="{StaticResource PlayAch.Size.Control.Height}"
                              VerticalAlignment="Center"
                              Margin="{StaticResource PlayAch.Thickness.Left.Xs}"
                              ToolTip="{Binding Content}"
                              Visibility="{Binding EffectiveIsVisible, Converter={StaticResource GridControlBarBoolToVis}}">
                    <!-- Content is one of: text label (Icon=None), or a Status-column glyph
                         (checkmark / padlock) or the IcoFont hidden glyph. The localized name
                         is surfaced via the ToolTip. -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="TextGlyph"
                                   Text="{Binding Content}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                        <Viewbox x:Name="CheckGlyph"
                                 Width="15" Height="15"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed">
                            <Path Data="{StaticResource GeoCheck}"
                                  Stroke="{DynamicResource PlayAch.Brush.Glyph}"
                                  StrokeThickness="2.3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Viewbox>
                        <Viewbox x:Name="LockGlyph"
                                 Width="15" Height="15"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed">
                            <Path Data="{StaticResource GeoLock}"
                                  Fill="{DynamicResource PlayAch.Brush.Glyph}"/>
                        </Viewbox>
                        <controls:GlyphIcon x:Name="HiddenGlyph"
                                            Glyph="&#xEF22;"
                                            Size="15"
                                            FontFamily="{DynamicResource PlayAch.FontFamily.Icon}"
                                            Foreground="{DynamicResource PlayAch.Brush.Glyph}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            SnapsToDevicePixels="True"
                                            Visibility="Collapsed"/>
                        <!-- Same star the friend grids draw in their favorite gutters. -->
                        <TextBlock x:Name="FavoriteGlyph"
                                   Text="&#x2605;"
                                   Foreground="{DynamicResource PlayAch.Brush.Glyph}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </ToggleButton>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Icon}" Value="None">
                        <Setter TargetName="TextGlyph" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Icon}" Value="Unlocked">
                        <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Icon}" Value="Locked">
                        <Setter TargetName="LockGlyph" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Icon}" Value="Hidden">
                        <Setter TargetName="HiddenGlyph" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Icon}" Value="Favorite">
                        <Setter TargetName="FavoriteGlyph" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="GridActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.Button.Background}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.Button.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <TextBlock Text="{TemplateBinding Content}"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.Accent}"/>
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource PlayAch.Brush.Button.Background.Hover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate DataType="{x:Type vm:GridActionButton}">
                <Button Style="{StaticResource GridActionButtonStyle}"
                        Content="{Binding Content}"
                        Click="ActionButton_Click"
                        MinWidth="{Binding MinWidth}"
                        Height="{StaticResource PlayAch.Size.Control.Height}"
                        Margin="{StaticResource PlayAch.Thickness.Left.Xs}"
                        VerticalAlignment="Center"
                        ToolTip="{Binding ToolTip}"
                        Visibility="{Binding EffectiveIsVisible, Converter={StaticResource GridControlBarBoolToVis}}"/>
            </DataTemplate>

            <!-- A from-to day range, shaped like the other filters: a dropdown button reading the
                 range (or "Unlocked" while there is none) whose popup holds the plugin's themed
                 date pickers and a clear button. An empty end leaves that side open. -->
            <DataTemplate DataType="{x:Type vm:GridDateRangeFilter}">
                <Grid Margin="{StaticResource PlayAch.Thickness.Left.Xs}"
                      VerticalAlignment="Center"
                      Visibility="{Binding EffectiveIsVisible, Converter={StaticResource GridControlBarBoolToVis}}">
                    <Button x:Name="RangeButton"
                            Style="{StaticResource AchievementSelectorButtonStyle}"
                            Content="{Binding DisplayText}"
                            Click="DateRange_Click"
                            Tag="{Binding ElementName=RangePopup}"
                            Height="{StaticResource PlayAch.Size.Control.Height}"
                            VerticalAlignment="Center">
                        <Button.Width>
                            <MultiBinding Converter="{StaticResource GridControlBarItemWidth}">
                                <Binding Path="Width"/>
                                <Binding Path="FillsWidth" ElementName="Root"/>
                                <Binding Path="ActualWidth" ElementName="Root"/>
                            </MultiBinding>
                        </Button.Width>
                    </Button>
                    <Popup x:Name="RangePopup"
                           PlacementTarget="{Binding ElementName=RangeButton}"
                           Placement="Bottom"
                           VerticalOffset="2"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           Closed="DateRangePopup_Closed">
                        <Border Background="{DynamicResource PlayAch.Brush.PopupSurface}"
                                BorderBrush="{DynamicResource PlayAch.Brush.PopupBorder}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- Either end alone makes a one-way range (since a day, or until
                                     one); each clears on its own. -->
                                <TextBlock Text="{DynamicResource LOCPlayAch_DateRange_From}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,6"/>
                                <DatePicker Grid.Column="1"
                                            Style="{DynamicResource PlayAch.DatePicker.BaseStyle}"
                                            SelectedDate="{Binding From, Mode=TwoWay}"
                                            Height="{StaticResource PlayAch.Size.Control.Height}"
                                            Margin="0,0,0,6"/>
                                <Button Grid.Column="2"
                                        Style="{StaticResource GridActionButtonStyle}"
                                        Content="&#x00D7;"
                                        Click="DateRangeClearFrom_Click"
                                        Padding="0"
                                        Width="24"
                                        Height="{StaticResource PlayAch.Size.Control.Height}"
                                        Margin="6,0,0,6"
                                        ToolTip="{DynamicResource LOCPlayAch_Common_Clear}"
                                        Visibility="{Binding HasFrom, Converter={StaticResource GridControlBarBoolToVis}}"/>
                                <TextBlock Grid.Row="1"
                                           Text="{DynamicResource LOCPlayAch_DateRange_To}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <DatePicker Grid.Row="1"
                                            Grid.Column="1"
                                            Style="{DynamicResource PlayAch.DatePicker.BaseStyle}"
                                            SelectedDate="{Binding To, Mode=TwoWay}"
                                            Height="{StaticResource PlayAch.Size.Control.Height}"/>
                                <Button Grid.Row="1"
                                        Grid.Column="2"
                                        Style="{StaticResource GridActionButtonStyle}"
                                        Content="&#x00D7;"
                                        Click="DateRangeClearTo_Click"
                                        Padding="0"
                                        Width="24"
                                        Height="{StaticResource PlayAch.Size.Control.Height}"
                                        Margin="6,0,0,0"
                                        ToolTip="{DynamicResource LOCPlayAch_Common_Clear}"
                                        Visibility="{Binding HasTo, Converter={StaticResource GridControlBarBoolToVis}}"/>
                                <Button Grid.Row="2"
                                        Grid.ColumnSpan="3"
                                        Style="{StaticResource GridActionButtonStyle}"
                                        Content="{DynamicResource LOCPlayAch_Common_Clear}"
                                        Click="DateRangeClear_Click"
                                        HorizontalAlignment="Right"
                                        Height="{StaticResource PlayAch.Size.Control.Height}"
                                        Margin="0,8,0,0"
                                        IsEnabled="{Binding HasRange}"/>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:GridModeToggle}">
                <ToggleButton x:Name="ModeToggleButton"
                              Style="{StaticResource GridModeToggleButtonStyle}"
                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              Height="{StaticResource PlayAch.Size.Control.Height}"
                              Margin="{StaticResource PlayAch.Thickness.Left.Xs}"
                              VerticalAlignment="Center"
                              ToolTip="{Binding ToolTip}"
                              Visibility="{Binding EffectiveIsVisible, Converter={StaticResource GridControlBarBoolToVis}}"/>
                <DataTemplate.Triggers>
                    <!-- Overlap the dropdown's right border by 1px so the seam reads as a single
                         line and recolors on the toggle's own hover/checked state. -->
                    <DataTrigger Binding="{Binding Connected}" Value="True">
                        <Setter TargetName="ModeToggleButton" Property="Margin" Value="-1,0,0,0"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Children in order: leading items, search box, filter items. With WrapItems the filters
         drop below the search box when the bar is too narrow, and wrap across lines there. -->
    <controls:ControlBarLayoutPanel KeyboardNavigation.DirectionalNavigation="Continue"
                                    Wrap="{Binding (controls:GridControlBarControl.WrapItems), ElementName=Root}">
        <ItemsControl ItemsSource="{Binding ControlBar.LeadingItems, ElementName=Root}"
                      VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <ContentControl Content="{Binding ShownSearch, ElementName=Root}"/>

        <ItemsControl ItemsSource="{Binding ShownItems, ElementName=Root}"
                      VerticalAlignment="Center">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Style.Triggers>
                        <!-- Offsets the item margins below, so one line keeps its height. -->
                        <DataTrigger Binding="{Binding (controls:GridControlBarControl.WrapItems), ElementName=Root}" Value="True">
                            <Setter Property="Margin" Value="0,-2"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Style.Triggers>
                        <!-- Gap between wrapped lines. -->
                        <DataTrigger Binding="{Binding (controls:GridControlBarControl.WrapItems), RelativeSource={RelativeSource AncestorType=controls:GridControlBarControl}}" Value="True">
                            <Setter Property="Margin" Value="0,2"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:CenteredWrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </controls:ControlBarLayoutPanel>
</UserControl>
