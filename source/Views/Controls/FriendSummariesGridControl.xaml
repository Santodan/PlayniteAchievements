<UserControl x:Class="PlayniteAchievements.Views.Controls.FriendSummariesGridControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/OverviewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FriendSummariesGridRowStyle"
                   TargetType="DataGridRow"
                   BasedOn="{StaticResource GameSummariesGridRowBaseStyle}">
                <Setter Property="MinHeight" Value="56"/>
                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGridRow_PreviewMouseLeftButtonDown"/>
                <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown"/>
                <EventSetter Event="PreviewMouseRightButtonUp" Handler="DataGridRow_PreviewMouseRightButtonUp"/>
            </Style>

            <Style x:Key="FriendSummaryTextStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource PlayAch.TextBlock.BaseStyle}">
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="TextAlignment"
                        Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellTextAlignment)}"/>
                <Setter Property="HorizontalAlignment"
                        Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellHorizontalAlignment)}"/>
                <Setter Property="VerticalAlignment"
                        Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellVerticalAlignment)}"/>
            </Style>

            <!-- Level cells: the level, then a mastery star once a friend has completed a pass. -->
            <Style x:Key="FriendSummaryLevelPanelStyle" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal"/>
                <Setter Property="HorizontalAlignment"
                        Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellHorizontalAlignment)}"/>
                <Setter Property="VerticalAlignment"
                        Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellVerticalAlignment)}"/>
            </Style>

            <!-- Tag carries the mastery count so one style serves both level columns. -->
            <Style x:Key="FriendSummaryMasteryStarStyle" TargetType="Viewbox">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="Margin" Value="5,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Style.Triggers>
                    <Trigger Property="Tag" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Fixed white on the fixed rainbow star art. -->
            <Style x:Key="FriendSummaryMasteryNumberStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource CommonFont}"/>
                <Setter Property="FontSize" Value="48"/>
                <Setter Property="FontWeight" Value="Black"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,10,0,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <controls:GridControlBarControl x:Name="ControlBarHost"
                                    Grid.Row="0"
                                    Margin="0,0,0,8"
                                    ControlBar="{Binding ControlBar, RelativeSource={RelativeSource AncestorType=controls:FriendSummariesGridControl}}"
                                    ShowControlBar="{Binding ShowControlBar, RelativeSource={RelativeSource AncestorType=controls:FriendSummariesGridControl}}"/>

    <DataGrid x:Name="FriendSummariesGrid"
              Style="{StaticResource PlayAch.DataGrid.BaseStyle}"
              Grid.Row="1"
              KeyboardNavigation.DirectionalNavigation="Contained"
              ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=controls:FriendSummariesGridControl}}"
              SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=controls:FriendSummariesGridControl}, Mode=TwoWay}"
              SelectionChanged="DataGrid_SelectionChanged"
              Sorting="DataGrid_Sorting"
              LoadingRow="FriendSummariesGrid_LoadingRow"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              SelectionMode="Single"
              GridLinesVisibility="None"
              HeadersVisibility="Column"
              BorderThickness="0"
              CanUserResizeColumns="True"
              CanUserResizeRows="False"
              CanUserReorderColumns="True"
              Background="{DynamicResource PlayAch.Brush.Grid.Background}"
              RowBackground="{DynamicResource PlayAch.Brush.Grid.RowBackground}"
              CanUserSortColumns="True"
              EnableRowVirtualization="True"
              VirtualizingStackPanel.IsVirtualizing="True"
              VirtualizingStackPanel.VirtualizationMode="Recycling"
              ColumnHeaderStyle="{StaticResource AchievementColumnHeaderWithMenuStyle}"
              VirtualizingStackPanel.ScrollUnit="Pixel"
              ScrollViewer.CanContentScroll="True"
              ScrollViewer.VerticalScrollBarVisibility="Visible"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.IsDeferredScrollingEnabled="False"
              UseLayoutRounding="True"
              SnapsToDevicePixels="True"
              Tag="ControllerCellFocus"
              helpers:DataGridHoverScrollBarBehavior.IsEnabled="True"
              helpers:DataGridAlignmentBehavior.IsEnabled="True"
              PreviewMouseRightButtonUp="DataGrid_PreviewMouseRightButtonUp">
        <DataGrid.CellStyle>
            <Style TargetType="DataGridCell"
                   BasedOn="{StaticResource GameSummariesGridCellStyle}"/>
        </DataGrid.CellStyle>
        <DataGrid.RowStyle>
            <Style TargetType="DataGridRow"
                   BasedOn="{StaticResource FriendSummariesGridRowStyle}"/>
        </DataGrid.RowStyle>
        <DataGrid.Columns>
            <DataGridTemplateColumn Width="44" MinWidth="32" MaxWidth="96" CanUserResize="True"
                                    Header="{DynamicResource LOCPlayAch_Column_Avatar}"
                                    CanUserSort="False"
                                    helpers:ColumnVisibilityHelper.ColumnKey="Avatar">
                <DataGridTemplateColumn.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Opacity="0"/>
                    </DataTemplate>
                </DataGridTemplateColumn.HeaderTemplate>
                <DataGridTemplateColumn.CellStyle>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource GameSummariesImageCellStyle}">
                        <Setter Property="ToolTip" Value="{Binding DisplayName}"/>
                    </Style>
                </DataGridTemplateColumn.CellStyle>
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Border CornerRadius="{StaticResource PlayAch.Radius.Small}"
                                ClipToBounds="True"
                                Margin="6,2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource PlayAch.Brush.Control.Background}">
                            <Image Stretch="Uniform"
                                   helpers:AsyncImage.Uri="{Binding AvatarPath}"
                                   helpers:AsyncImage.DecodePixel="64"/>
                        </Border>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Width="1.4*" MinWidth="88" CanUserResize="True"
                                    Header="{DynamicResource LOCPlayAch_Column_Friend}"
                                    SortMemberPath="DisplayName"
                                    helpers:ColumnVisibilityHelper.ColumnKey="FriendSummaryFriend">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <DockPanel LastChildFill="True">
                            <!-- Fixed-width star gutter keeps friend names aligned whether or not
                                 the friend is favorited (star is transparent when not a favorite).
                                 The whole gutter collapses when no friend in the list is favorited. -->
                            <!-- Match the name's font metrics and column vertical alignment so the
                                 star sits on the same visual centerline as the text beside it. -->
                            <TextBlock DockPanel.Dock="Left"
                                       Text="&#x2605;"
                                       Width="14"
                                       TextAlignment="Center"
                                       VerticalAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}, Path=Column.(helpers:DataGridAlignmentBehavior.CellVerticalAlignment)}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       ToolTip="{DynamicResource LOCPlayAch_Column_Favorite}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PlayAch.TextBlock.BaseStyle}">
                                        <Setter Property="Opacity" Value="0"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAnyFavorites, RelativeSource={RelativeSource AncestorType={x:Type controls:FriendSummariesGridControl}}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding DisplayName}"
                                       Style="{StaticResource FriendSummaryTextStyle}"/>
                        </DockPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Width="*" MinWidth="56" CanUserResize="True"
                                Header="{DynamicResource LOCPlayAch_Column_SharedGames}"
                                Binding="{Binding SharedGamesCount, Converter={StaticResource BlankZeroNumber}}"
                                SortMemberPath="SharedGamesCount"
                                ElementStyle="{StaticResource FriendSummaryTextStyle}"
                                helpers:ColumnVisibilityHelper.ColumnKey="FriendSummarySharedGames"/>
            <DataGridTextColumn Width="*" MinWidth="56" CanUserResize="True"
                                Header="{DynamicResource LOCPlayAch_Column_Unlocks}"
                                Binding="{Binding UnlockedAchievementsCount, Converter={StaticResource BlankZeroNumber}}"
                                SortMemberPath="UnlockedAchievementsCount"
                                ElementStyle="{StaticResource FriendSummaryTextStyle}"
                                helpers:ColumnVisibilityHelper.ColumnKey="FriendSummaryUnlocks"/>
            <DataGridTextColumn Width="*" MinWidth="72" CanUserResize="True"
                                Header="{DynamicResource LOCPlayAch_Score_Prestige}"
                                Binding="{Binding PrestigeScore, Converter={StaticResource BlankZeroNumber}}"
                                SortMemberPath="PrestigeScore"
                                ElementStyle="{StaticResource FriendSummaryTextStyle}"
                                helpers:ColumnVisibilityHelper.ColumnKey="FriendSummaryPrestigeScore"/>
            <DataGridTextColumn Width="*" MinWidth="72" CanUserResize="True"
                                Header="{DynamicResource LOCPlayAch_Score_Collection}"
                                Binding="{Binding CollectionScore, Converter={StaticResource BlankZeroNumber}}"
                                SortMemberPath="CollectionScore"
                                ElementStyle="{StaticResource FriendSummaryTextStyle}"
                                helpers:ColumnVisibilityHelper.ColumnKey="FriendSummaryCollectionScore"/>
            <DataGridTemplateColumn Width="*" MinWidth="64" CanUserResize="True"
                                    Header="{DynamicResource LOCPlayAch_Column_PrestigeLevel}"
                                    SortMemberPath="PrestigeLevel"
                                    helpers:ColumnVisibilityHelper.ColumnKey="FriendSummaryPrestigeLevel">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Style="{StaticResource FriendSummaryLevelPanelStyle}">
                            <TextBlock Text="{Binding PrestigeLevel, Converter={StaticResource BlankZeroNumber}}"
                                       Style="{StaticResource FriendSummaryTextStyle}"
                                       TextWrapping="NoWrap"/>
                            <Viewbox Tag="{Binding PrestigeMastery}" Style="{StaticResource FriendSummaryMasteryStarStyle}">
                                <Grid Width="128" Height="128">
                                    <Image Source="{DynamicResource ScoreBadgeMasteryStar}"/>
                                    <TextBlock Text="{Binding PrestigeMastery}" Style="{StaticResource FriendSummaryMasteryNumberStyle}"/>
                                </Grid>
                            </Viewbox>
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Width="*" MinWidth="64" CanUserResize="True"
                                    Header="{DynamicResource LOCPlayAch_Column_CollectionLevel}"
                                    SortMemberPath="CollectionLevel"
                                    helpers:ColumnVisibilityHelper.ColumnKey="FriendSummaryCollectionLevel">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Style="{StaticResource FriendSummaryLevelPanelStyle}">
                            <TextBlock Text="{Binding CollectionLevel, Converter={StaticResource BlankZeroNumber}}"
                                       Style="{StaticResource FriendSummaryTextStyle}"
                                       TextWrapping="NoWrap"/>
                            <Viewbox Tag="{Binding CollectionMastery}" Style="{StaticResource FriendSummaryMasteryStarStyle}">
                                <Grid Width="128" Height="128">
                                    <Image Source="{DynamicResource ScoreBadgeMasteryStar}"/>
                                    <TextBlock Text="{Binding CollectionMastery}" Style="{StaticResource FriendSummaryMasteryNumberStyle}"/>
                                </Grid>
                            </Viewbox>
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>
    </DataGrid>
    </Grid>
</UserControl>
