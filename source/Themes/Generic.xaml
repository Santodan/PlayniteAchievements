<!--
    Default templates for this assembly's own custom controls. A Control subclass resolves its
    default template from the theme dictionary, not from a merged dictionary in the window's scope,
    so a template that lives anywhere else leaves the control rendering as nothing at all. Enabled
    by the ThemeInfo attribute in ThemeInfo.cs.

    Tokens are merged in because StaticResource must resolve when this dictionary loads. Brushes
    stay DynamicResource so they resolve against the hosting window's scoped dictionary and keep
    following Playnite's theme.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
                    xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- One settings row: description left, control immediately to its right, hint on a
         hover/focus (i) rather than a second line under the control. The label column shares a size
         group so every row in one Grid.IsSharedSizeScope section agrees on where the controls start
         — sized to the widest label rather than stretched to the panel's full width, so a short
         label does not leave its control stranded at the far edge. A page only writes
         <controls:SettingRow Label="..." Hint="...">{the control}</controls:SettingRow>. -->
    <Style TargetType="{x:Type controls:SettingRow}">
        <Setter Property="Margin" Value="{StaticResource PlayAch.Thickness.Bottom.SettingRow}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
        <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Body}"/>
        <Setter Property="FontFamily" Value="{DynamicResource PlayAch.FontFamily.Body}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="PlayAch.SettingRow.Label"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0"
                              VerticalAlignment="Center"
                              Margin="{StaticResource PlayAch.Thickness.Right.Md}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- MaxWidth so one long label wraps instead of widening the shared
                                 label column, which would push every row's control to the right.
                                 Wide enough for the pages whose labels are whole sentences, such
                                 as the maintenance actions; the column is Auto, so short labels
                                 still sit right beside their control. -->
                            <TextBlock Grid.Column="0"
                                       Text="{TemplateBinding Label}"
                                       TextWrapping="Wrap"
                                       MaxWidth="420"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontFamily="{TemplateBinding FontFamily}"/>
                            <!-- Tag carries the hint so the tooltip, which sits in its own visual
                                 tree, can reach it through PlacementTarget. -->
                            <Button Grid.Column="1"
                                    Style="{StaticResource PlayAch.Button.InfoGlyphStyle}"
                                    Margin="{StaticResource PlayAch.Thickness.Left.Sm}"
                                    Tag="{TemplateBinding Hint}"
                                    Visibility="{Binding Hint, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StringToVisibility}}"
                                    ToolTipService.InitialShowDelay="150"
                                    ToolTipService.ShowDuration="60000"
                                    ToolTipService.ShowOnDisabled="True">
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource PlayAch.ToolTip.BaseStyle}"
                                             DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                             Placement="Right"
                                             HorizontalOffset="4">
                                        <TextBlock Text="{Binding}"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="340"
                                                   Foreground="{DynamicResource PlayAch.Brush.Text}"/>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>
                        </Grid>

                        <ContentPresenter Grid.Column="1"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{StaticResource PlayAch.Opacity.Disabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Time window picker: one line of preset chips and a Custom chip. The From and To date
         pickers live in a popup under the Custom chip, so the strip never grows and the layout
         below it never shifts; while a custom range is active the chip shows the range itself.
         The chips are RadioButtons in a per-instance group so the strip can be instantiated twice
         on one view model. Date pickers take the shared PlayAch DatePicker style explicitly because
         the fullscreen theme ships none and the start page merges no implicit styles. A blank
         picker shows a dash marker instead of watermark text. -->
    <Style TargetType="{x:Type controls:TimeWindowPicker}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ChipStyle" Value="{StaticResource PlayAch.TimeRangeChip.Style}"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
        <Setter Property="FontFamily" Value="{DynamicResource PlayAch.FontFamily.Body}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TimeWindowPicker}">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <!-- The control bars' dropdown: a selector button opening a menu of the
                                 units, with the ones the window cannot honor (Day across years, say)
                                 greyed out. The styles come from the app-level grid styles, which
                                 this dictionary does not merge, hence the dynamic lookups. -->
                            <Button x:Name="PART_Granularity"
                                    DockPanel.Dock="Right"
                                    MinWidth="96"
                                    Height="{StaticResource PlayAch.Size.Control.Height}"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{DynamicResource AchievementSelectorButtonStyle}"
                                    Visibility="{Binding ShowGranularity, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}">
                                <Button.ContextMenu>
                                    <ContextMenu Style="{DynamicResource AchievementSelectorContextMenuStyle}"/>
                                </Button.ContextMenu>
                            </Button>
                            <WrapPanel VerticalAlignment="Center">
                                <ItemsControl x:Name="PART_Presets"
                                              ItemsSource="{TemplateBinding PresetItems}"
                                              IsTabStop="False"
                                              Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Content="{Binding Label}"
                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                         GroupName="{Binding ChipGroupName, RelativeSource={RelativeSource AncestorType={x:Type controls:TimeWindowPicker}}}"
                                                         Style="{Binding ChipStyle, RelativeSource={RelativeSource AncestorType={x:Type controls:TimeWindowPicker}}}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <RadioButton x:Name="PART_CustomChip"
                                             Content="{TemplateBinding CustomChipText}"
                                             ToolTip="{TemplateBinding CustomChipToolTip}"
                                             GroupName="{TemplateBinding ChipGroupName}"
                                             Style="{TemplateBinding ChipStyle}"/>
                                <Popup x:Name="PART_CustomPopup"
                                       PlacementTarget="{Binding ElementName=PART_CustomChip}"
                                       Placement="Bottom"
                                       VerticalOffset="4"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade">
                                    <Border Background="{DynamicResource PlayAch.Brush.PopupSurface}"
                                            BorderBrush="{DynamicResource PlayAch.Brush.PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource PlayAch.Radius.Layout}"
                                            Padding="8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Grid VerticalAlignment="Center">
                                                    <DatePicker x:Name="PART_From"
                                                                Style="{StaticResource PlayAch.DatePicker.BaseStyle}"
                                                                Width="118"
                                                                ToolTip="{DynamicResource LOCPlayAch_DateRange_From}"/>
                                                    <TextBlock Text="&#x2014;"
                                                               IsHitTestVisible="False"
                                                               VerticalAlignment="Center"
                                                               Margin="10,0,24,0"
                                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                               Opacity="{StaticResource PlayAch.Opacity.Placeholder}"
                                                               Visibility="{Binding IsFromBlank, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                                <TextBlock Text="&#x2013;"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0"
                                                           Foreground="{DynamicResource PlayAch.Brush.Text}"/>
                                                <Grid VerticalAlignment="Center">
                                                    <DatePicker x:Name="PART_To"
                                                                Style="{StaticResource PlayAch.DatePicker.BaseStyle}"
                                                                Width="118"
                                                                ToolTip="{DynamicResource LOCPlayAch_DateRange_To}"/>
                                                    <TextBlock Text="&#x2014;"
                                                               IsHitTestVisible="False"
                                                               VerticalAlignment="Center"
                                                               Margin="10,0,24,0"
                                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                               Opacity="{StaticResource PlayAch.Opacity.Placeholder}"
                                                               Visibility="{Binding IsToBlank, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                                <Button x:Name="PART_Clear"
                                                        Content="{DynamicResource LOCPlayAch_Common_Clear}"
                                                        Style="{StaticResource PlayAch.Button.BaseStyle}"
                                                        Padding="10,0"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Stretch"/>
                                            </StackPanel>
                                            <TextBlock x:Name="PART_Error"
                                                       Text="{TemplateBinding ErrorText}"
                                                       Foreground="{DynamicResource PlayAch.Brush.ErrorText}"
                                                       FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                                       Margin="0,6,0,0"
                                                       MaxWidth="320"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding HasError, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </WrapPanel>
                        </DockPanel>

                        <!-- Inline editor (InlineCustomEditor=True, the widget settings rows): the
                             pickers sit on their own line under the chips, always visible, and the
                             Custom chip is hidden because the dates show the state themselves. -->
                        <StackPanel x:Name="PART_InlinePanel" Visibility="Collapsed" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid VerticalAlignment="Center">
                                    <DatePicker x:Name="PART_InlineFrom"
                                                Style="{StaticResource PlayAch.DatePicker.BaseStyle}"
                                                Width="118"
                                                ToolTip="{DynamicResource LOCPlayAch_DateRange_From}"/>
                                    <TextBlock Text="&#x2014;"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"
                                               Margin="10,0,24,0"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               Opacity="{StaticResource PlayAch.Opacity.Placeholder}"
                                               Visibility="{Binding IsFromBlank, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                                <TextBlock Text="&#x2013;"
                                           VerticalAlignment="Center"
                                           Margin="8,0"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"/>
                                <Grid VerticalAlignment="Center">
                                    <DatePicker x:Name="PART_InlineTo"
                                                Style="{StaticResource PlayAch.DatePicker.BaseStyle}"
                                                Width="118"
                                                ToolTip="{DynamicResource LOCPlayAch_DateRange_To}"/>
                                    <TextBlock Text="&#x2014;"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"
                                               Margin="10,0,24,0"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               Opacity="{StaticResource PlayAch.Opacity.Placeholder}"
                                               Visibility="{Binding IsToBlank, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                                <Button x:Name="PART_InlineClear"
                                        Content="{DynamicResource LOCPlayAch_Common_Clear}"
                                        Style="{StaticResource PlayAch.Button.BaseStyle}"
                                        Padding="10,0"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Stretch"/>
                            </StackPanel>
                            <TextBlock Text="{TemplateBinding ErrorText}"
                                       Foreground="{DynamicResource PlayAch.Brush.ErrorText}"
                                       FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasError, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="InlineCustomEditor" Value="True">
                            <Setter TargetName="PART_CustomChip" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_InlinePanel" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="HasError" Value="True">
                            <Setter TargetName="PART_From" Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.ErrorText}"/>
                            <Setter TargetName="PART_To" Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.ErrorText}"/>
                            <Setter TargetName="PART_InlineFrom" Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.ErrorText}"/>
                            <Setter TargetName="PART_InlineTo" Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.ErrorText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A notification card: everything of the card that is not its content, in the arrangement the
         notification service can rest as separate layers (ToastLayer). Behind the content it draws
         the rays around the card, the glow or shadow with the surface that casts it, and over that
         surface the user's background image or the live blur and its tint. A template only writes
         <controls:ToastCard>{the content}</controls:ToastCard>; its DataContext is the
         AchievementToastViewModel, which every binding below reads.

         Background, BorderBrush, BorderThickness and CornerRadius shape the surface. A background
         image or a blurred background takes the surface's place as the settings ask, as the
         triggers at the end say. Size and the room for the glow follow the notification's own
         settings unless a template sets Width, Height or Margin itself. -->
    <Style TargetType="{x:Type controls:ToastCard}">
        <Setter Property="Width" Value="{Binding ToastCardWidth}"/>
        <Setter Property="Height" Value="{Binding ToastCardHeight}"/>
        <Setter Property="MinHeight" Value="64"/>
        <Setter Property="Margin" Value="{Binding ToastGlowMargin}"/>
        <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.PopupSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.PopupBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ToastCard}">
                    <ControlTemplate.Resources>
                        <BooleanToVisibilityConverter x:Key="PlayAch.ToastCard.BooleanToVisibility"/>
                    </ControlTemplate.Resources>
                    <Grid>
                    <!-- One loaded Image owns background decoding. Its Source is a stable mutable bitmap
                         for GIFs; the single background brush below consumes that object. It remains in
                         the visual tree at zero size because an unloaded Image stops its GIF. -->
                    <Image x:Name="ToastBackgroundSourceHost"
                           Width="0"
                           Height="0"
                           Opacity="0"
                           IsHitTestVisible="False"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           helpers:AsyncImage.Uri="{Binding ToastBackgroundRenderSource}"
                           helpers:AsyncImage.DecodePixel="768"
                           helpers:AsyncImage.PhaseLock="{Binding IsPreview}"/>
                    <!-- Rays around the card itself, behind everything. No SubjectUri: there is no artwork to
                         trace here, so the burst rides the card's own rectangle. The reach is a small multiple
                         because it scales with the subject, and the card is far larger than an icon; the
                         surrounding margin widens to match so the arrows are not clipped by the window.
                         Gated on the notification-level glow rather than the icon's, so the card's halo and
                         its rays come and go together. IsRasterized fills the arrows into one bitmap: this
                         burst has some 200 of them, and their wide copies overlap. -->
                    <controls:RarityRayBurst Rarity="{Binding Rarity}"
                                             helpers:ToastLayer.Role="Rays"
                                             UseCompletedColors="{Binding UsesCompletionColors}"
                                             IsActive="{Binding AnimateRarityGlows}"
                                             PhaseLock="{Binding IsPreview}"
                                             BurstScale="1.14"
                                             CornerRadiusRatio="0.09"
                                             IsRasterized="True"
                                             Visibility="{Binding ShowCardRayBurst, Converter={StaticResource PlayAch.ToastCard.BooleanToVisibility}}"/>
                    <!-- Background and shadow / glow layer. The background is rendered once: its border
                         carries the effect as well as the visible image. Text and icons remain in the
                         separate effect-free content layer below, so they stay crisp at every DPI. -->
                    <Grid helpers:RarityGlowPulse.Target="Effect"
                          helpers:ToastLayer.Role="Back"
                          helpers:RarityGlowPulse.PhaseLock="{Binding IsPreview}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12"
                                                          ShadowDepth="3"
                                                          Direction="300"
                                                          Opacity="0.5"
                                                          Color="#000000"/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasBorderGlow}" Value="True">
                                        <Setter Property="Effect" Value="{Binding BorderGlowEffect}"/>
                                    </DataTrigger>
                                    <!-- Fade the outer border glow in and out when AnimateRarityGlows is on. -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasBorderGlow}" Value="True"/>
                                            <Condition Binding="{Binding AnimateRarityGlows}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="helpers:RarityGlowPulse.IsActive" Value="True"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <!-- Opaque card surface: the shadow caster for a normal card. Goes transparent when
                             a user background image defines the card shape, so the drop shadow / glow then
                             wraps the image's own (possibly rounded/transparent) alpha via the blurred
                             backing image below, instead of a solid rectangle. A blurred card keeps it
                             opaque, so its glow keeps the full card shape and never shows through the
                             translucent tint; the live blur covers it from the content layer. Named so the
                             saved-output renders can leave it out (ToastBlurLayers). Marked as the surface:
                             while the card rests it is the base of the background layer (ToastLayer), under
                             the live blur and tint or alone where the card has no image. -->
                        <Border x:Name="CardSurface"
                                helpers:ToastLayer.Role="Surface"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"/>
                        <!-- Backing copy of the user background, present so the shadow / glow wraps the
                             image's real shape instead of a solid rectangle. Not what the user sees: this one
                             is inside the effect, so it renders through an effect intermediate. The crisp copy
                             sits directly on top of it in the content layer below. Both consume the single
                             decoding Image above, so there is one decode and one animation clock. -->
                        <Border CornerRadius="{TemplateBinding CornerRadius}"
                                Visibility="{Binding HasToastBackground, Converter={StaticResource PlayAch.ToastCard.BooleanToVisibility}}">
                            <Border.Background>
                                <ImageBrush Stretch="UniformToFill"
                                            ImageSource="{Binding Source, ElementName=ToastBackgroundSourceHost}"/>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <!-- Content layer: no effect, so every text line and icon renders as a crisp vector.
                         Clipped to the card's rounded shape. -->
                    <Border CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <Grid>
                            <!-- Live blurred background: the game behind the card, captured and blurred by
                                 the plugin every frame (ToastLiveBackdrop), with the tint over it. Until the
                                 first frame arrives the image is empty and the opaque card surface shows
                                 through the tint. Named so the saved-output renders can leave the image out:
                                 screenshots and clips blur their own frame under the card. -->
                            <Border x:Name="LiveBlurImage"
                                    helpers:ToastLayer.Role="Background"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    RenderOptions.BitmapScalingMode="Linear"
                                    Visibility="{Binding HasToastBlur, Converter={StaticResource PlayAch.ToastCard.BooleanToVisibility}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding LiveBackdrop}"
                                                Viewbox="{Binding LiveBackdropViewbox}"
                                                ViewboxUnits="RelativeToBoundingBox"
                                                Stretch="Fill"/>
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="{TemplateBinding CornerRadius}"
                                    helpers:ToastLayer.Role="Background"
                                    Background="{Binding ToastBlurTintBrush}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    Visibility="{Binding HasToastBlur, Converter={StaticResource PlayAch.ToastCard.BooleanToVisibility}}"/>

                            <!-- Crisp user background image (what is actually seen), full-bleed behind the
                                 content and covering the backing copy above. It is here rather than reusing
                                 that copy because this layer carries no effect: content inside an effect is
                                 rasterized to an intermediate first, and the card's DPI compensation applies a
                                 fractional LayoutTransform, so an intermediate would resample the image.
                                 Shares the decoding Image above, so animated backgrounds stay in step with the
                                 backing copy for free. Marked as the background layer: while the card rests
                                 it can be shown from a window of its own (ToastLayer). -->
                            <Border CornerRadius="{TemplateBinding CornerRadius}"
                                    helpers:ToastLayer.Role="Background"
                                    Visibility="{Binding HasToastBackground, Converter={StaticResource PlayAch.ToastCard.BooleanToVisibility}}">
                                <Border.Background>
                                    <ImageBrush Stretch="UniformToFill"
                                                ImageSource="{Binding Source, ElementName=ToastBackgroundSourceHost}"/>
                                </Border.Background>
                            </Border>

                            <ContentPresenter/>
                        </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- An image defines the card's shape: the surface goes transparent, so
                             the glow wraps the image's own alpha through the backing copy. -->
                        <DataTrigger Binding="{Binding HasToastBackground}" Value="True">
                            <Setter TargetName="CardSurface" Property="Background" Value="Transparent"/>
                            <Setter TargetName="CardSurface" Property="BorderThickness" Value="0"/>
                        </DataTrigger>
                        <!-- Fully opaque even when the surface brush is not, and without its
                             border: the tint layer draws the card's one edge. -->
                        <DataTrigger Binding="{Binding HasToastBlur}" Value="True">
                            <Setter TargetName="CardSurface" Property="Background" Value="{Binding ToastBlurSurfaceBrush}"/>
                            <Setter TargetName="CardSurface" Property="BorderThickness" Value="0"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
