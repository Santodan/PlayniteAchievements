    <sys:String x:Key="LOCPlayAch_Settings_RaRarityStats">Thống kê độ hiếm</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_RaRarityStats_Casual">Casual</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_RaRarityStats_Description">Sets which rarity (hardcore or softcore) is shown for locked achievements. Unlocked achievements always use their own unlock mode.</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_RaEmulatorLogTracking">Mở khóa tức thời (nhật ký trình giả lập)</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_RaEmulatorLogTracking_Help">Phát hiện các lần mở khóa ngay lập tức từ tệp nhật ký của trình giả lập thay vì liên tục kiểm tra trang web RetroAchievements. Hãy bật tính năng ghi nhật ký vào tệp trong trình giả lập; chỉ đặt đường dẫn tùy chỉnh bên dưới nếu không tự động tìm thấy tệp nhật ký.</sys:String>

    <!-- Provider: Guild Wars 2 -->
    <sys:String x:Key="LOCPlayAch_Settings_GW2_Help">Thành tựu Guild Wars 2 được lấy từ API chính thức của ArenaNet, yêu cầu một khóa API miễn phí được liên kết với tài khoản Guild Wars 2 của bạn:</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_GW2_SetupStep2">2. Tạo một khóa mới và tích chọn tiến trình. Đây là quyền duy nhất mà phần bổ trợ này cần; một khóa chỉ được cấp quyền này sẽ không thể đọc thông tin về ví, túi đồ hoặc lịch sử chợ giao dịch của bạn.</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_GW2_SetupStep3">3. Sao chép khoá vào ô bên dưới, sau đó nhấp vào Kiểm tra.</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_GW2_NoDatesNote">Guild Wars 2 không ghi lại thời điểm đạt thành tựu và không công bố tỷ lệ hoàn thành, vì vậy các thành tựu trong Guild Wars 2 không hiển thị ngày mở khóa và độ hiếm.</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_GW2_ApiKey_Help">The key is stored in the plugin settings in readable form and sent only to api.guildwars2.com. It can only read, and you can delete it at any time on the page where you created it.</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_GW2_MissingProgression">Khóa hợp lệ nhưng thiếu quyền truy cập tiến trình. Hãy tạo khóa mới và đánh dấu vào mục tiến trình.</sys:String>

    <!-- Provider: Hypixel -->
    <sys:String x:Key="LOCPlayAch_Settings_Hypixel_NoDatesNote">Thành tựu được lấy từ hồ sơ Hypixel công khai của bạn. Hypixel không ghi lại thời điểm đạt thành tựu, vì vậy các thành tựu Hypixel không hiển thị ngày mở khóa.</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_Hypixel_PlayerNotFound">Không tìm thấy người chơi Hypixel nào có tên người dùng đó.</sys:String>
    <!-- Hypixel_Unavailable: leave the domain "hypixel.net" untranslated. -->
    <sys:String x:Key="LOCPlayAch_Settings_Hypixel_Unavailable">không thể truy cập hypixel.net để tra cứu người chơi. Vui lòng thử lại sau.</sys:String>

    <!-- Provider: Minecraft -->
    <sys:String x:Key="LOCPlayAch_Settings_MinecraftGameFoldersHint">Add a launcher folder such as %AppData%\PrismLauncher to read all of its instances, or a single instance or .minecraft folder. Empty reads %AppData%\.minecraft.</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_MinecraftPlayerUuid">Player UUID</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_MinecraftPlayerUuid_Help">Optional. Leave empty to use the accounts signed in to your launchers.</sys:String>

    <!-- Provider: Riot -->
    <sys:String x:Key="LOCPlayAch_Settings_Riot_Help">Việc đọc Thử thách trong League of Legends sử dụng API chính thức của Riot, yêu cầu một khóa API miễn phí được liên kết với tài khoản Riot của bạn. Riot không cung cấp điểm cuối API theo từng người chơi nào có thể hoạt động mà không cần khóa:</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_Riot_SetupStep2">2. Sao chép khóa API phát triển hiển thị trên bảng điều khiển vào ô Khóa API bên dưới. Nếu khóa đã hết hạn, hãy sử dụng nút tạo lại tại đó.</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_Riot_SetupStep3">3. Nhập ID Riot của bạn và chọn vùng bạn đang chơi rồi nhấp Kiểm tra.</sys:String>
