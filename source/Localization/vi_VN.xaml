    <sys:String x:Key="LOCPlayAch_Settings_RaPointsMode_Points">Điểm tiêu chuẩn</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_RaPointsMode_Scaled">TrueRatio (Theo tỷ lệ)</sys:String>
