    <!-- Provider: Battle.net -->
    <sys:String x:Key="LOCPlayAch_Settings_BattleNet_WowSection">World of Warcraft</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_BattleNet_WowRealm">Realm</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_BattleNet_WowCharacter">Nhân vật</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_BattleNet_ClientId">ID Ứng dụng khách</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_BattleNet_ClientSecret">Mã bí mật Ứng dụng khách</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_BattleNet_RedirectUri">URI chuyển hướng</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_BattleNet_AggregateAccountCharacters">Gập thành tựu từ mọi nhân vật trong tài khoản</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_BattleNet_OAuthHelp">Việc đọc thành tựu WoW sử dụng API chính thức của Blizzard, yêu cầu một ứng dụng khách API miễn phí được liên kết với tài khoản Battle.net của bạn. Bạn chỉ cần thiết lập tính năng này một lần:</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_BattleNet_SetupStep1">1. Mở {0} và tạo một ứng dụng khách mới (bạn có thể đặt tên và điền thông tin tùy ý).</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_BattleNet_SetupStep2">2. Đặt URI chuyển hướng của Ứng dụng khách chính xác theo giá trị hiển thị bên dưới (mặc định là http://127.0.0.1:55431/).</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_BattleNet_SetupStep3">3. Sao chép ID Ứng dụng khách và Mã bí mật Ứng dụng khách của ứng dụng khách vào các trường bên dưới.</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_BattleNet_SetupStep4">4. Nhấp vào Đăng nhập bên dưới và chấp thuận quyền truy cập khi trình duyệt mở ra.</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_BattleNet_SetupSample">Cần hướng dẫn? Xem {0}.</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_BattleNet_Status_WowReady">Nhân vật đã sẵn sàng</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_BattleNet_Status_WowIncomplete">Thiếu thiết lập nhân vật</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_BattleNet_Status_MissingOAuthSetup">Thiếu thông tin xác thực ứng dụng khách Battle.net hoặc URI chuyển hướng</sys:String>

    <!-- Provider: Epic -->
    <sys:String x:Key="LOCPlayAch_Settings_Epic_AltAuthCodePrompt">Dán giá trị &quot;authorizationCode&quot; từ trang đó vào đây:</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_Epic_AltAuthInstructions">1. Đăng nhập vào Epic bằng trình duyệt mặc định khi trình duyệt mở ra
2. Sau khi đăng nhập, tìm giá trị &quot;authorizationCode&quot; trên trang
3. Sao chép và dán giá trị đó vào hộp thoại tiếp theo</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_Epic_LoginAlternative">Đăng nhập thay thế</sys:String>

    <!-- Provider: Game Jolt -->
    <sys:String x:Key="LOCPlayAch_Settings_GameJolt_Help">Đăng nhập vào Game Jolt trong cửa sổ trình duyệt để đọc các cúp bạn đã mở khóa. Thành tựu trên Game Jolt chỉ được theo dõi đối với những trò chơi được thêm bằng tiện ích mở rộng Game Jolt Library hoặc những trò chơi đã được gán ID trò chơi Game Jolt theo cách thủ công trong mục Quản lý thành tựu.</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_GameJolt_Note">Lưu ý: Chỉ các cúp bạn đã mở khóa mới được đọc; Game Jolt không cung cấp dữ liệu thành tựu nếu chưa đăng nhập.</sys:String>

    <!-- Provider: Meta Quest -->
    <sys:String x:Key="LOCPlayAch_Settings_Meta_Help">Log in to Meta in the browser window to read your unlocked achievements. Meta Quest achievements are tracked for games added by the Meta Quest/Oculus Library extension, or for games given a manual Meta app ID in Manage Achievements.</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_Meta_Note">Note: Meta records the day an achievement was unlocked but not the time, and publishes no completion rates, so Meta Quest achievements show no unlock time and no rarity.</sys:String>

    <!-- Provider: Exophase -->
    <sys:String x:Key="LOCPlayAch_Settings_Exophase_EnableProvider_Help">Khi bật, Exophase có thể tự động theo dõi thành tựu của các trò chơi trên những nền tảng được quản lý.</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_Exophase_Help">Xác thực với Exophase để làm mới dữ liệu được theo dõi và sử dụng các liên kết thủ công của Exophase.</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_Exophase_ManagedPlatforms">Nền tảng được quản lý</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_Exophase_ManagedPlatforms_Help">Games on checked platforms use Exophase instead of native support. Include games on other platforms individually in Manage Achievements.</sys:String>
    <sys:String x:Key="LOCPlayAch_Exophase_SelectPlatforms">Chọn nền tảng</sys:String>

    <!-- Provider: HoYoverse -->
    <sys:String x:Key="LOCPlayAch_Settings_Hoyoverse_ExportFiles">Tệp xuất dữ liệu trình theo dõi</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_Hoyoverse_ExportFiles_Help">Optional public tracker exports used to mark achievements unlocked.</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_Hoyoverse_Instructions">Cách lấy JSON</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_Hoyoverse_Instructions_Step1">1. Mở {0} và đăng nhập.</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_Hoyoverse_Instructions_StarDbImporter">Trình nhập thành tựu StarDB</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_Hoyoverse_Instructions_Step2">2. Tải xuống và chạy {0}, sau đó làm theo hướng dẫn cho đến khi tệp JSON xuất được sao chép vào bộ nhớ tạm.</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_Hoyoverse_Instructions_StarDbExporter">stardb-exporter</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_Hoyoverse_Instructions_Step3">3. Lưu đoạn văn bản đã sao chép dưới dạng tệp .json, rồi chọn tệp đó bên dưới cho trò chơi tương ứng.</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_Hoyoverse_Instructions_Step4">4. Bạn cũng có thể dán JSON đã sao chép vào StarDB để trình theo dõi StarDB luôn được đồng bộ.</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_Hoyoverse_Instructions_Note">Các định dạng được hỗ trợ: JSON của stardb-exporter, StarDB, Paimon.moe, SEELIE.me và rng.moe, cùng với tệp .dat của Star Rail Station.</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_Hoyoverse_InvalidExportPath">Một hoặc nhiều tệp xuất đã cấu hình không tồn tại.</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_Hoyoverse_NoExportConfigured">Chưa cấu hình tệp xuất nào. Thao tác làm mới sẽ chỉ nhập dữ liệu định nghĩa thành tựu đang khóa.</sys:String>

    <sys:String x:Key="LOCPlayAch_Settings_ExportDatabase">Xuất các bảng cơ sở dữ liệu sang CSV để gỡ lỗi</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_ExportDatabaseButton">Xuất CSV</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_FallbackIcons">Hình ảnh bìa</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_FallbackIcons_Help">These images cover a locked or hidden icon until it is revealed. Drag in an image link or file, or browse for one; Clear restores the built-in image.</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_ForceHashIndexRebuild">Xây dựng lại bộ nhớ đệm quét tệp</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_HashIndexMaxAgeDays">Thời gian lưu tối đa bộ nhớ đệm quét tệp (ngày)</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_HiddenAchievements">Khả năng hiển thị thành tựu</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_HiddenAchievements_Description">Chọn những chi tiết mà một thành tựu bị khóa hoặc ẩn có thể tiết lộ. Bỏ chọn một ô để che chi tiết đó cho đến khi bạn nhấp vào thành tựu để hiển thị.</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_HoursBetweenUpdates">Làm mới mỗi bao nhiêu giờ:</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_IconCache_ClearAllDescription">Làm sạch mọi tệp biểu tượng trong bộ nhớ đệm.</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_IconCache_ClearLockedDescription">Chỉ làm sạch các biểu tượng bị khoá riêng biệt. Lần làm mới tiếp theo sẽ phục hồi chúng.</sys:String>
