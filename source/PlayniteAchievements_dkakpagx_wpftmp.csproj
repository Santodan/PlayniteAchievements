      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="packages.config" />
  </ItemGroup>
  <ItemGroup>
    <!-- UnlockedAchIcon is needed as a loose file too: HoyoverseDefinitionClient resolves it by path
         as the icon fallback. HiddenAchIcon is only ever loaded through its pack:// URI, so it ships
         as a Resource alone. -->
    <Content Include="Resources\UnlockedAchIcon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Hoyoverse\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Bundled unlock sounds ship as loose files: the sound host process opens them by path. -->
    <Content Include="Resources\Sounds\*.mp3;Resources\Sounds\notices.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
