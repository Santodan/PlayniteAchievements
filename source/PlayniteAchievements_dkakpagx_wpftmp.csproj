  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <!-- No symbols in the packed .pext: the .pdb was 3.58 MB of a 10.36 MB package, and logged
         exceptions are overwhelmingly environmental (HTTP/socket/IO/JSON), where the exception type
         and the method name in the trace are the whole diagnosis. Traces still carry exception type,
         message, inner exceptions, and namespace-qualified method names; only the trailing
         "in [file]:line N" is lost. DebugType=portable is NOT an alternative: .NET Framework cannot
         read portable PDBs, so it drops line numbers anyway at a fifth of the size. Build Debug to
         get symbols while developing. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <LangVersion>preview</LangVersion>
    <!-- Release output is what Toolbox packs into the .pext. Suppress the .pdb and IntelliSense .xml
         files MSBuild otherwise copies next to each referenced assembly: neither is loaded at runtime,
         and together they accounted for 1.59 MB of the 10.36 MB 3.1.2 package. This also cleared an
         orphaned protobuf-net.pdb, whose DLL Toolbox already strips because Playnite provides it. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <ItemGroup>
    <!-- Plugin dependencies -->
    <!-- D3D11 device + texture read-back for WGC HDR capture (Services\Capture). -->
    <!-- Media Foundation H.264 encode (GPU-resident) for WGC unlock video. -->
    <!-- WinRT projections for Windows.Graphics.Capture (WGC). The winmds are compile-time metadata
         (Private=False: the OS provides the types at runtime); System.Runtime.WindowsRuntime carries
         the projection glue (IAsyncOperation/AsTask, WinRT events). Requires TargetPlatformVersion. -->
  </ItemGroup>
  <ItemGroup>
    <!-- Helper is its own exe project (see below); its sources must not compile into the plugin. -->
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**;Helper\**;**\*.g.cs;**\*.g.i.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Builds the unlock-sound host before this project (ReferenceOutputAssembly=false: the plugin
         never references the exe) and ships only its exe as loose content beside the plugin dll, so
         Toolbox packs it. No second NAudio.dll and no .pdb come along; the copy is tracked by
         FileWrites so Clean removes it. -->
    <ProjectReference Include="Helper\PlayniteAchievements.Helper.csproj">
      <Project>{7A2E4C51-9B3D-4F6E-8C1A-2D5F7E9B0C43}</Project>
      <Name>PlayniteAchievements.Helper</Name>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <Content Include="Helper\bin\$(Configuration)\PlayniteAchievementsHelper.exe">
      <Link>PlayniteAchievementsHelper.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <None Include="extension.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="icon.png">
