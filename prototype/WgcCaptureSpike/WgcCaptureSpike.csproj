<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone WGC capture feasibility spike. Deliberately SDK-style (PackageReference) so
    Microsoft.Windows.SDK.Contracts + Vortice restore cleanly. The PLUGIN stays old-style
    packages.config net462; if this spike passes, the Branch A integration wires the same WinRT
    reference into the plugin via <TargetPlatformVersion> + winmd (see README).

    Hard constraint: TargetFramework MUST stay net462 (no bump). Proving the WinRT interop works
    here at net462 is GATE 1.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AssemblyName>WgcCaptureSpike</AssemblyName>
    <RootNamespace>WgcCaptureSpike</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinRT projections (Windows.Graphics.Capture / DirectX). Version = a Windows 10 SDK you have. -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.0" />
    <!-- D3D11 device + texture read-back. SharpDX ships net45 libs (loads on net462); modern
         Vortice dropped netstandard2.0 so it can't target net462. -->
    <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" />
    <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
