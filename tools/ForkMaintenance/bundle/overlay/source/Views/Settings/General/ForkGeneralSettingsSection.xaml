<UserControl x:Class="PlayniteAchievements.Views.Settings.General.ForkGeneralSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/SettingsScopedControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <Border Style="{StaticResource SettingGroupCardStyle}">
                <StackPanel>
                    <TextBlock Text="Cached unlock protection" Style="{StaticResource SubSectionHeaderStyle}"/>
                    <controls:SettingRow Label="Preserve cached unlocks on refresh"
                                         Hint="When enabled, refreshes keep previously unlocked achievements even if the provider reports them locked. Disable to accept the selected account's current unlock states, including zero unlocks. Failed or empty responses remain protected.">
                        <CheckBox IsChecked="{Binding Persisted.PreserveCachedUnlocksOnRefresh, Mode=TwoWay}"/>
                    </controls:SettingRow>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingGroupCardStyle}">
                <StackPanel>
                    <TextBlock Text="Logs" Style="{StaticResource SubSectionHeaderStyle}"/>
                    <controls:SettingRow Label="Debug mode"
                                         Hint="Record detailed performance diagnostics during polling, including thread activity, CPU timings, memory statistics, and Steam/shared CEF browser lifecycle events, in PollingDebug.log. Enable only while investigating a problem.">
                        <CheckBox x:Name="DebugModeCheckBox"
                                  IsChecked="{Binding EnablePollingDebugLogging, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Checked="DebugMode_Changed" Unchecked="DebugMode_Changed"/>
                    </controls:SettingRow>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Open logs" Click="OpenLogs_Click" MinWidth="130" Margin="0,0,8,8"
                                Padding="{StaticResource PlayAch.Thickness.ButtonPadding.Wide}"/>
                        <Button Content="Copy Logs" Click="CopyLogs_Click" MinWidth="130" Margin="0,0,8,8"
                                Padding="{StaticResource PlayAch.Thickness.ButtonPadding.Wide}"/>
                        <Button Content="Delete Logs" Click="DeleteLogs_Click" MinWidth="130" Margin="0,0,0,8"
                                Padding="{StaticResource PlayAch.Thickness.ButtonPadding.Wide}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
