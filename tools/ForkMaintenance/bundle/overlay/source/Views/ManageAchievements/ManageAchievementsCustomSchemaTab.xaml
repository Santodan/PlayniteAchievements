<UserControl x:Class="PlayniteAchievements.Views.ManageAchievements.ManageAchievementsCustomSchemaTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource LOCPlayAch_GameOptions_Tab_CustomSchema}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />
            <TextBlock Text="Load an achievement schema JSON file or enter its parameters manually below. Achievement keys/API names are correlated with the selected game's Local achievement file; after saving, the correlated achievements are loaded into the Editor."
                       Foreground="{DynamicResource TextBrush}"
                       Opacity="0.75"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="{Binding LocalCustomSchemaStatusText}"
                   Foreground="{DynamicResource TextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <CheckBox Grid.Row="2"
                  Content="{DynamicResource LOCPlayAch_GameOptions_CustomSchemaEnabled}"
                  IsChecked="{Binding LocalCustomSchemaEnabled, Mode=TwoWay}"
                  Margin="0,0,0,10" />

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding LocalCustomSchemaOverrideInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6"
                     ToolTip="Path to the schema JSON file" />
            <Button Grid.Column="1"
                    Content="{DynamicResource LOCPlayAch_Button_Browse}"
                    Command="{Binding BrowseLocalCustomSchemaOverrideCommand}"
                    Padding="12,6"
                    Margin="8,0,0,0" />
            <Button Grid.Column="2"
                    Content="{DynamicResource LOCPlayAch_Button_Apply}"
                    Command="{Binding ApplyLocalCustomSchemaOverrideCommand}"
                    Padding="12,6"
                    Margin="8,0,0,0" />
            <Button Grid.Column="3"
                    Content="{DynamicResource LOCPlayAch_Button_Clear}"
                    Command="{Binding ClearLocalCustomSchemaOverrideCommand}"
                    Padding="12,6"
                    Margin="8,0,0,0" />
        </Grid>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="{DynamicResource LOCPlayAch_Button_Reload}"
                        Command="{Binding ReloadCustomSchemaEditorCommand}"
                        Padding="12,6"
                        Margin="0,0,8,0" />
                <Button Content="{DynamicResource LOCPlayAch_Button_Save}"
                        Command="{Binding SaveCustomSchemaEditorCommand}"
                        Padding="12,6" />
            </StackPanel>
            <TextBox Grid.Row="1"
                     Text="{Binding CustomSchemaEditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas"
                     FontSize="12"
                     Padding="8" />
        </Grid>

        <TextBlock Grid.Row="5"
                   Text="{Binding CustomSchemaEditorStatus}"
                   Foreground="{DynamicResource TextBrush}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Opacity="0.82">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CustomSchemaEditorStatusIsError}" Value="True">
                            <Setter Property="Foreground" Value="#FFE07070" />
                            <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
