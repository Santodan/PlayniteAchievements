+            finally
+            {
+                DeleteDirectory(themesRoot);
+            }
+        }
+
+        private static int CountOccurrences(string content, string value)
+        {
+            var count = 0;
+            var index = 0;
+            while ((index = content.IndexOf(value, index, StringComparison.Ordinal)) >= 0)
+            {
+                count++;
+                index += value.Length;
+            }
+
+            return count;
+        }
