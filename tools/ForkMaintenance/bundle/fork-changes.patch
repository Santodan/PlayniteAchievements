+        private string ResolveCompletenessFilterToken(string token)
+        {
+            switch ((token ?? string.Empty).Trim().ToLowerInvariant())
+            {
+                case "complete":
+                    return L("LOCPlayAch_Filter_Complete");
+                case "incomplete":
+                case "inprogress":
+                    return L("LOCPlayAch_Filter_InProgress");
+                case "noprogress":
+                    return L("LOCPlayAch_Filter_NoProgress");
+                default:
+                    return token;
+            }
+        }
+
+        private string ResolvePlayStatusFilterToken(string token)
