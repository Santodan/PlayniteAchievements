+                    });
+                }
+                finally
+                {
+                    Dispatcher.Invoke(() =>
+                    {
+                        _steamImportCts?.Dispose();
+                        _steamImportCts = null;
+                        SetAuthBusy(false);
+                    });
+                }
+            });
+        }
