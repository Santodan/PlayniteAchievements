+        private static string JsString(string value)
+        {
+            if (value == null)
+            {
+                return "''";
+            }
+
+            return "'" + value
+                .Replace("\\", "\\\\")
+                .Replace("'", "\\'")
+                .Replace("\r", "\\r")
+                .Replace("\n", "\\n") + "'";
+        }
