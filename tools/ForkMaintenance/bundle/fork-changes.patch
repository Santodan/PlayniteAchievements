+            {
+                case "collectiontier":
+                    return scores.CollectionTier;
+                case "collectionnexttier":
+                    return scores.CollectionNextTier;
+                case "prestigetier":
+                    return scores.PrestigeTier;
+                case "prestigenexttier":
