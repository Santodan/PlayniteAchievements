+
+                var geoKey = iconKey.StartsWith("Geo", StringComparison.Ordinal)
+                    ? iconKey
+                    : "Geo" + iconKey.Replace("ProviderIcon", string.Empty);
+                var geometry = Application.Current?.TryFindResource(geoKey) as Geometry;
+                if (geometry == null)
