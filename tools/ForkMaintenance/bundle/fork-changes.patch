+                    break;
+                case "prestigelevel":
+                    value = scores.PrestigeLevel;
+                    break;
+                case "prestigeexp":
+                    value = scores.PrestigeExp;
+                    break;
+                case "prestigeexptotal":
+                    value = scores.PrestigeExpTotal;
+                    break;
+                case "prestigeexpuntilnextlevel":
