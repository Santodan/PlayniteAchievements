+        private static RarityTier ResolveNotificationRarityTier(string rarity)
+        {
+            var key = ResolveRarityKey(rarity, null);
+            switch (key)
+            {
+                case "UltraRare":
+                    return RarityTier.UltraRare;
+                case "Rare":
