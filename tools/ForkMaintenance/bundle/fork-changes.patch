+        private const uint SetWindowPosNoSize = 0x0001;
+        private const uint SetWindowPosNoMove = 0x0002;
+        private const uint SetWindowPosNoActivate = 0x0010;
+        private const uint SetWindowPosShowWindow = 0x0040;
+
