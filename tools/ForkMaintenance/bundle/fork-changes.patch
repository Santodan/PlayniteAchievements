+        private static bool IsDefaultFontFamily(string fontFamily)
+        {
+            return string.IsNullOrWhiteSpace(fontFamily) ||
+                   string.Equals(fontFamily.Trim(), "Default", StringComparison.OrdinalIgnoreCase);
+        }
