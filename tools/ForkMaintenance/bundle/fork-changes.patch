+                case "unplayed":
+                    return L("LOCPlayAch_Filter_Unplayed");
+                default:
+                    return token;
+            }
+        }
+
+        private string GetCompletenessFilterToken(string value)
+        {
+            if (string.Equals(value, L("LOCPlayAch_Filter_Complete"), StringComparison.OrdinalIgnoreCase))
