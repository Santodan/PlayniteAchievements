diff --git a/source/Common/PathExpansion.cs b/source/Common/PathExpansion.cs
index de320b154be7529178565021f5f84bd3350ffeb9..86cbd38b903d59b30ba8aa46143fec91534e2c97 100644
--- a/source/Common/PathExpansion.cs
