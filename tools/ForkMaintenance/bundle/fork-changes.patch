+        private static void ApplyCustomLineTextEffect(TextBlock line, LocalSettings settings, int lineIndex)
+        {
+            if (line == null || settings == null)
+            {
+                return;
+            }
+
+            bool outlineEnabled;
+            bool shadowEnabled;
+            string outlineColor;
+            string shadowColor;
